.version 9.0
.target sm_103a
.address_size 64
.visible .entry k() {
 .shared .align 8 .b8 cells[24];
 .reg .b32 %r0, %r1, %r2;
 .reg .b64 %old;
 .reg .pred %bad;
 mov.u32 %r0, %tid.x;
 mul.lo.u32 %r1, %r0, 8;
 mov.u32 %r2, cells;
 add.u32 %r1, %r1, %r2;
 st.shared.u64 [%r1], 0;
 bar.sync 0;
 atom.shared.max.u64 %old, [%r1], 1;
 setp.ne.u64 %bad, %old, 0;
 @%bad trap;
 ret;
}
