.version 9.0
.target sm_103a
.address_size 64
.visible .entry k() {
 .shared .align 8 .b64 cell;
 .reg .b32 %r0;
 .reg .b64 %old;
 .reg .pred %init, %bad;
 mov.u32 %r0, %tid.x;
 setp.eq.u32 %init, %r0, 0;
 @%init st.shared.u64 [cell], 0;
 bar.sync 0;
 @!%init bra DONE;
 atom.shared.max.u64 %old, [cell], 1;
 setp.ne.u64 %bad, %old, 0;
 @%bad trap;
DONE:
 ret;
}
