  let o ← strict_memory_globals.address_value address.base bindings
  match o with
  | none => ok none
  | some value => let o1 ← strict_memory_globals.address_value address.base2 bindings
                  match o1 with
                  | none => ok none
                  | some value1 => let i ← lift (IScalar.hcast .U64 address.off)
                                   let i1 ← lift (core.num.U64.wrapping_add i value)
                                   let i2 ← lift (core.num.U64.wrapping_add i1 value1)
                                   ok (some i2)

