def strict_memory_globals.address_value (value : Option ptxv_ir.Val) (bindings : Slice (Std.U8 × Std.U32 × Std.U64)) : Result (Option Std.U64) := do
  match value with
  | none => ok (some 0#u64)
  | some v =>
    match v with
    | ptxv_ir.Val.Reg _ _ => ok none
    | ptxv_ir.Val.Imm value1 => ok (some value1)
    | ptxv_ir.Val.Const _ _ => ok none
    | ptxv_ir.Val.SReg s =>
      match s with
      | ptxv_ir.SReg.Tid _ => ok none
      | ptxv_ir.SReg.NTid _ => ok none
      | ptxv_ir.SReg.CtaId _ => ok none
      | ptxv_ir.SReg.NCtaId _ => ok none
      | ptxv_ir.SReg.LaneId => ok none
      | ptxv_ir.SReg.WarpId => ok none
      | ptxv_ir.SReg.ClusterCtaRank => ok none
      | ptxv_ir.SReg.ClusterNCtaRank => ok none
      | ptxv_ir.SReg.ClusterCtaId _ => ok none
      | ptxv_ir.SReg.ClusterNCtaId _ => ok none
      | ptxv_ir.SReg.ClusterId _ => ok none
      | ptxv_ir.SReg.NClusterId _ => ok none
      | ptxv_ir.SReg.CgaShape => ok none
      | ptxv_ir.SReg.LaneMaskLt => ok none
      | ptxv_ir.SReg.LaneMaskLe => ok none
      | ptxv_ir.SReg.LaneMaskGe => ok none
      | ptxv_ir.SReg.LaneMaskGt => ok none
      | ptxv_ir.SReg.LaneMaskEq => ok none
      | ptxv_ir.SReg.SmId => ok none
      | ptxv_ir.SReg.NSmId => ok none
      | ptxv_ir.SReg.Clock => ok none
      | ptxv_ir.SReg.ClockLo32 => ok none
      | ptxv_ir.SReg.ClockHi32 => ok none
      | ptxv_ir.SReg.SharedAddr _ => ok none
      | ptxv_ir.SReg.SharedWindowHi => ok none
      | ptxv_ir.SReg.GlobalAddr index => strict_memory_globals.global_address index bindings

