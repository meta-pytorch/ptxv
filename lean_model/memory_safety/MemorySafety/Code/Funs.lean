/-- [ptxv_sim::strict_memory_admission::project]:
    Source: 'crates/sim/src/strict_memory_admission.rs', lines 256:0-279:1
    Visibility: public -/
def strict_memory_admission.project (kernel : ptxv_ir.Kernel) (launch : machine.Launch) : Result (core.result.Result ptxv_memory_write.memory_safety.Program strict_memory_admission.Refusal) := do
  let r ← strict_memory_admission.validate_launch kernel launch
  match r with
  | core.result.Result.Ok count =>
    let grid ← alloc.vec.Vec.index (core.slice.index.SliceIndexUsizeSlice machine.Grid) launch.grids 0#usize
    let r1 ← strict_memory_launch.project_allocations launch
    match r1 with
    | core.result.Result.Ok allocations => let s := alloc.vec.Vec.deref kernel.code
                                           let s1 := alloc.vec.Vec.deref grid.cbank_relocs
                                           let r2 ← strict_memory_globals.specialize_code s s1
                                           match r2 with
                                           | core.result.Result.Ok instructions => let s2 := alloc.vec.Vec.deref instructions
                                                                                   let i ← lift (IScalar.hcast .Usize 0#isize)
                                                                                   let i1 ← Array.index_usize kernel.nregs i
                                                                                   let r3 ← strict_memory_admission.project_code s2 i1
                                                                                   match r3 with
                                                                                   | core.result.Result.Ok instructions1 => let s3 := alloc.vec.Vec.deref instructions1
                                                                                                                            let threads ← strict_memory_launch.replicate_code s3 count
                                                                                                                            ok (core.result.Result.Ok { allocations, threads })
                                                                                   | core.result.Result.Err reason => ok (core.result.Result.Err reason)
                                           | core.result.Result.Err reason => ok (core.result.Result.Err reason)
    | core.result.Result.Err reason => ok (core.result.Result.Err reason)
  | core.result.Result.Err reason => ok (core.result.Result.Err reason)

