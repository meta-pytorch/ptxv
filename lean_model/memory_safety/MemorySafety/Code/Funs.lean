/-- [ptxv_sim::strict_memory::check]:
    Source: 'crates/sim/src/strict_memory.rs', lines 155:0-186:1
    Visibility: public -/
def strict_memory.check (kernel : ptxv_ir.Kernel) (launch : machine.Launch) (state_cap : Std.Usize) : Result strict_memory.Report := do
  let r ← strict_memory_admission.project kernel launch
  match r with
  | core.result.Result.Ok program => let c ← strict_memory.candidate program state_cap
                                     match c with
                                     | strict_memory.Candidate.Complete certificate => let s := alloc.vec.Vec.deref certificate
                                                                                       let status ← strict_memory_status.status_for_certificate kernel launch s
                                                                                       let i := alloc.vec.Vec.len certificate
                                                                                       let b ← (strict_memory_status.Status.is_safe status : Result Bool)
                                                                                       if b
                                                                                       then ok { scope := (toStr "typed_ir_ptx_constant_global_memory"), status, states := i, state_cap, reason := none }
                                                                                       else ok { scope := (toStr "typed_ir_ptx_constant_global_memory"), status, states := i, state_cap, reason := (some strict_memory.Reason.CertificateRejected) }
                                     | strict_memory.Candidate.Unsafe states => ok { scope := (toStr "typed_ir_ptx_constant_global_memory"), status := strict_memory_status.Status.Unsafe, states, state_cap, reason := (some strict_memory.Reason.BadState) }
                                     | strict_memory.Candidate.Inconclusive states reason => strict_memory.Report.inconclusive states state_cap reason
  | core.result.Result.Err reason => strict_memory.Report.inconclusive 0#usize state_cap (strict_memory.Reason.Admission reason)

