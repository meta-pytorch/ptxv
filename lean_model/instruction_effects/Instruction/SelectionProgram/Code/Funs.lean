    Source: 'crates/sim/src/seg/bound.rs', lines 104:4-110:5
    Visibility: public -/
def seg.bound.Evaluator.Insts.Ptxv_simSegProgramProgramEvaluator.evaluate
  {C : Type _} {F : Type _} (ComparisonPrimitiveInst :
  seg.bound.ComparisonPrimitive C) (coremarkerCopyInst : core.marker.Copy C)
  (FallbackEvaluatorInst : seg.bound.FallbackEvaluator F)
  (self : seg.bound.Evaluator C F) (instruction : seg.SOp)
  (args : Slice Std.U32) (prior : Slice Std.U64) :
  Result ((core.result.Result Std.U64 String) × (seg.bound.Evaluator C F))
  := do
  let o ←
    seg.bound.try_evaluate ComparisonPrimitiveInst coremarkerCopyInst
      instruction { args, prior } self.comparison
  match o with
  | none =>
    let (r, t) ←
      FallbackEvaluatorInst.evaluate self.fallback instruction { args, prior }
    ok (r, { self with fallback := t })
  | some bits => ok (core.result.Result.Ok bits, self)

