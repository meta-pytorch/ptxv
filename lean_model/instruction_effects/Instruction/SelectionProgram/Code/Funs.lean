/-- [ptxv_sim::seg::bound::try_evaluate]:
    Source: 'crates/sim/src/seg/bound.rs', lines 81:0-101:1
    Visibility: public -/
def seg.bound.try_evaluate
  {C : Type _} (ComparisonPrimitiveInst : seg.bound.ComparisonPrimitive C)
  (coremarkerCopyInst : core.marker.Copy C) (instruction : seg.SOp)
  (inputs : seg.binding.Inputs) (comparison : C) :
  Result (Option Std.U64)
  := do
  match instruction.kind with
  | seg.SKind.Inst op _ regs _ =>
    let b ← (seg.bound.eligible op : Result Bool)
    if b
    then
      let s := alloc.vec.Vec.deref regs
      let (o, _) ←
        seg.comparison_instruction
          (seg.bound.Sources.Insts.Ptxv_simSegComparisonEvaluator
          ComparisonPrimitiveInst) op { bindings := s, inputs, comparison }
      match o with
      | none => ok none
      | some bits => let i ← lift (UScalar.cast .U64 bits)
                     ok (some i)
    else ok none
  | seg.SKind.Guard _ _ _ _ => ok none
  | seg.SKind.DivRn _ _ => ok none

