def guard_certificate.move_count
  (destination : Reg) (operand : Val) : Result Std.U16 := do
  let b ←
    (match operand with
     | Val.Reg _ _ => ok false
     | Val.Imm _ => ok false
     | Val.Const _ i => match i with
                        | 16#uscalar => ok true
                        | _ => ok false
     | Val.SReg _ => ok false : Result Bool)
  if b
  then ok 4#u16
  else
    let b1 ←
      (File.Insts.CoreCmpPartialEqFile.eq destination.file File.V : Result
        Bool)
    if b1
    then ok 1#u16
    else
      match operand with
      | Val.Reg _ count =>
        let i ← lift (UScalar.cast .U16 count)
        ok (core.cmp.impls.OrdU16.max i 1#u16)
      | Val.Imm _ => ok 1#u16
      | Val.Const _ bytes =>
        let i ← lift (UScalar.cast .U16 bytes)
        let i1 ← i / 4#u16
        ok (core.cmp.impls.OrdU16.max i1 1#u16)
      | Val.SReg _ => ok 1#u16

