  let i2 ← lift (mask &&& 2#u8)
  let i3 ← lift (UScalar.cast_fromBool .U16 (i2 != 0#u8))
  let i4 ← i1 + i3
  let i5 ← lift (mask &&& 4#u8)
  let i6 ← lift (UScalar.cast_fromBool .U16 (i5 != 0#u8))
  let i7 ← i4 + i6
  let i8 ← lift (mask &&& 8#u8)
  let i9 ← lift (UScalar.cast_fromBool .U16 (i8 != 0#u8))
  i7 + i9

