def atomic_cancel.cancels (operation : Op) (register : Reg) : Result Bool := do
  match operation with
  | Op.Mov _ _ => ok false
  | Op.Int io i d v v1 =>
    match i with
    | 32#uscalar =>
      match v with
      | Val.Reg left i1 =>
        match v1 with
        | Val.Reg right i2 =>
          match i1 with
          | 1#uscalar =>
            match i2 with
            | 1#uscalar =>
              match io with
              | IntOp.AddSatS => ok false
              | IntOp.SubSatS => ok false
              | IntOp.Add => ok false
              | IntOp.Sub =>
                let b ←
                  (File.Insts.CoreCmpPartialEqFile.eq d.file File.V : Result
                    Bool)
                if b
                then
                  let b1 ←
                    (atomic_cancel.same_register left register : Result Bool)
                  if b1
                  then atomic_cancel.same_register right register
                  else ok false
                else ok false
              | IntOp.Mul => ok false
              | IntOp.Shl => ok false
              | IntOp.ShrU => ok false
              | IntOp.ShrS => ok false
              | IntOp.And => ok false
              | IntOp.Or => ok false
