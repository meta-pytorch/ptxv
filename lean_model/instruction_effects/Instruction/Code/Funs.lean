  := do
  let o ←
    (store_window.descriptor operation : Result (Option (Reg × Std.U8 × Std.U8
      × Bool)))
  match o with
  | none => ok (alloc.vec.Vec.new (Reg × Std.U32 × Std.U32))
  | some t =>
    let (first, elements, bytes, exchange) :=
      (t : (Reg × Std.U8 × Std.U8 × Bool))
    let b ←
      (File.Insts.CoreCmpPartialEqFile.eq first.file File.V : Result Bool)
    if b
    then
      match front with
      | Front.Ptx => store_window.assemble first elements bytes exchange
      | Front.Sass =>
        if exchange
        then ok (alloc.vec.Vec.new (Reg × Std.U32 × Std.U32))
        else
          let b1 ←
            (register_effect.repeated_virtual Front.Sass first.file elements
              bytes : Result Bool)
          if b1
          then
            if bytes > 8#u8
            then store_window.repeated_windows first bytes
            else ok (alloc.vec.Vec.new (Reg × Std.U32 × Std.U32))
          else ok (alloc.vec.Vec.new (Reg × Std.U32 × Std.U32))
