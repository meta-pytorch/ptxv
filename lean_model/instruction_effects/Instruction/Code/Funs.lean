/-- [ptxv_ir::control_transfer::with_fallthrough]:
    Source: 'src/control_transfer.rs', lines 60:0-77:1 -/
def control_transfer.with_fallthrough
  (taken : control_transfer.Outcome) (pc : Std.U32) :
  Result control_transfer.Outcome
  := do
  let o ← lift (U32.checked_add pc 1#u32)
  match o with
  | none =>
    ok (control_transfer.Outcome.Wild control_transfer.Fault.PcOverflow)
  | some next =>
    match taken with
    | control_transfer.Outcome.Next => ok control_transfer.Outcome.Next
    | control_transfer.Outcome.Jump target =>
      let targets ← alloc.vec.Vec.push (alloc.vec.Vec.new Std.U32) target
      let targets1 ← alloc.vec.Vec.push targets next
      ok (control_transfer.Outcome.Fork targets1)
    | control_transfer.Outcome.Fork targets =>
      let targets1 ← alloc.vec.Vec.push targets next
      ok (control_transfer.Outcome.Fork targets1)
    | control_transfer.Outcome.Wild _ => ok taken

