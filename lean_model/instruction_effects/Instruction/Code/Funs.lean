/-- [ptxv_ir::comparison_select::evaluate]:
    Source: 'src/comparison_select.rs', lines 55:0-63:1
    Visibility: public -/
def comparison_select.evaluate
  {C : Type _} (ComparatorInst : comparison_select.Comparator C)
  (plan : comparison_select.Plan) (x : Std.U32) (y : Std.U32) (comparator : C)
  :
  Result Std.U32
  := do
  let b ← (ComparatorInst.compare comparator plan.comparison x y : Result Bool)
  if b != plan.negate
  then if plan.swap
       then ok y
       else ok x
  else if plan.swap
       then ok x
       else ok y

/-- [ptxv_ir::comparison_select::operations]:
    Source: 'src/comparison_select.rs', lines 66:0-109:1
    Visibility: public -/
def comparison_select.operations
  (plan : comparison_select.Plan) : Result (Op × Op) := do
  let (i, i1) ← if plan.swap
                then ok (1#u16, 0#u16)
                else ok (0#u16, 1#u16)
  let a := (Array.repeat 2#usize false : Array Bool 2#usize)
  let a1 := (Array.repeat 2#usize false : Array Bool 2#usize)
  ok (Op.Fsetp { file := File.P, idx := 0#u16 } plan.comparison (Val.Reg
    { file := File.R, idx := 0#u16 } 1#u8) (Val.Reg
    { file := File.R, idx := 1#u16 } 1#u8) a a1 { reg := none, neg := false }
    BoolOp.And false, Op.Sel { file := File.R, idx := 2#u16 } (Val.Reg
    { file := File.R, idx := i } 1#u8) (Val.Reg { file := File.R, idx := i1 }
    1#u8)
    { reg := (some { file := File.P, idx := 0#u16 }), neg := plan.negate })

/-- [ptxv_ir::comparison_select::same_register]:
    Source: 'src/comparison_select.rs', lines 115:0-117:1 -/
def comparison_select.same_register
  (left : Reg) (right : Reg) : Result Bool := do
  let i := read_discriminant left.file
  let i1 ← lift (IScalar.hcast .U8 i)
  let i2 := read_discriminant right.file
  let i3 ← lift (IScalar.hcast .U8 i2)
  if i1 = i3
  then ok (left.idx = right.idx)
  else ok false

/-- [ptxv_ir::register_owner::comparison_plan]:
    Source: 'src/register_owner.rs', lines 111:0-130:1
    Visibility: public -/
def register_owner.comparison_plan
  (thread : Std.Usize) (front : Front) (destination : Reg) (plain : Bool) :
  Result register_owner.ComparisonPlan
  := do
  let normalized ←
    register_owner.normalize_predicate front
      { reg := (some destination), neg := false }
  let i ← lift (UScalar.cast .U32 thread)
  let i1 := read_discriminant destination.file
  let i2 ← lift (IScalar.hcast .U8 i1)
  if plain
  then
    let b ←
      (match destination.file with
       | File.V => ok false
       | File.R => ok false
       | File.UR => ok false
       | File.P => ok true
       | File.UP => ok true : Result Bool)
    if b
    then
      let b1 := (core.option.Option.is_some normalized.reg : Bool)
      ok { key := (i, i2, destination.idx), remember := b1 }
    else ok { key := (i, i2, destination.idx), remember := false }
  else ok { key := (i, i2, destination.idx), remember := false }

