def register_effect.atomic_sources
  (result : alloc.vec.Vec Reg) (op : AtomOp) (bytes : Std.U8) (v : Val)
  (new : Option Val) :
  Result (alloc.vec.Vec Reg)
  := do
  let result1 ← register_effect.atomic_value_sources result op bytes v
  match new with
  | none =>
    match op with
    | AtomOp.Or => ok result1
    | AtomOp.And => ok result1
    | AtomOp.Xor => ok result1
    | AtomOp.Add => ok result1
    | AtomOp.Exch => ok result1
    | AtomOp.FAddFtz => ok result1
    | AtomOp.FAdd64 => ok result1
    | AtomOp.AddBf16x2 => ok result1
    | AtomOp.AddBf16 => ok result1
    | AtomOp.CasSpin => register_effect.implicit_cas_sources result1 bytes v
    | AtomOp.Cas => register_effect.implicit_cas_sources result1 bytes v
    | AtomOp.MinU => ok result1
    | AtomOp.MaxU => ok result1
    | AtomOp.MinS => ok result1
    | AtomOp.MaxS => ok result1
    | AtomOp.Inc => ok result1
    | AtomOp.Dec => ok result1
  | some value => register_effect.slots result1 value

