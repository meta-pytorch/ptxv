def register_effect.vector
  (result : alloc.vec.Vec Reg) (value : Val) : Result (alloc.vec.Vec Reg) := do
  match value with
  | Val.Reg first count =>
    let b ←
      (File.Insts.CoreCmpPartialEqFile.eq first.file File.V : Result Bool)
    if b
    then
      let i ← lift (UScalar.cast .U16 count)
      let i1 ← lift (core.cmp.impls.OrdU16.max i 1#u16)
      register_effect.append result first i1
    else register_effect.slots result value
  | Val.Imm _ => register_effect.slots result value
  | Val.Const _ _ => register_effect.slots result value
  | Val.SReg _ => register_effect.slots result value

