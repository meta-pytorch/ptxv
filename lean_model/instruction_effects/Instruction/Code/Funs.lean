/-- [ptxv_ir::store_window::narrow_sink]:
    Source: 'src/store_window.rs', lines 167:0-176:1 -/
def store_window.narrow_sink
  (operation : Op) (control : Slice Reg) :
  Result (Option (Reg × Std.U32))
  := do
  let o ← store_window.narrow_descriptor operation
  match o with
  | none => ok none
  | some p =>
    let (register, _) := p
    let b ←
      (File.Insts.CoreCmpPartialEqFile.eq register.file File.V : Result Bool)
    if b
    then ok none
    else
      let b1 ← (store_window.has_register control register : Result Bool)
      if b1
      then ok none
      else ok o

/-- [ptxv_ir::store_window::metadata_sources]:
    Source: 'src/store_window.rs', lines 179:0-191:1
    Visibility: public -/
def store_window.metadata_sources
  (front : Front) (operation : Op) :
  Result ((alloc.vec.Vec (Reg × Std.U32 × Std.U32)) × (alloc.vec.Vec Reg) ×
    (Option (Reg × Std.U32)))
  := do
  let windows ← store_window.sources front operation
  let o ← register_effect.memory_control_reads operation
  let control ←
    match o with
    | none => ok (alloc.vec.Vec.new Reg)
    | some control1 => ok control1
  let s := alloc.vec.Vec.deref windows
  let s1 := alloc.vec.Vec.deref control
  let deferred ← store_window.deferred_registers s s1
  let s2 := alloc.vec.Vec.deref control
  let narrow ← store_window.narrow_sink operation s2
  ok (windows, deferred, narrow)

