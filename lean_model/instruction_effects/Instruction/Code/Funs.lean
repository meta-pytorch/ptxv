def guard_certificate.post_value
  {C : Type _} (ConstantsInst : guard_certificate.Constants C)
  (context : guard_certificate.Evaluation C) (register : Reg) :
  Result (Option Std.U64)
  := do
  let old ← guard_certificate.lookup context.facts register
  let guard ←
    (guard_certificate.decision context.front context.facts
      context.instruction.guard : Result (Option Bool))
  let b ←
    (match guard with
     | none => ok false
     | some b1 => if b1
                  then ok false
                  else ok true : Result Bool)
  if b
  then ok old
  else
    let o ← guard_certificate.frame context.instruction.op
    let cf ← core.option.Option.Insts.CoreOpsTry_traitTry.branch o
    match cf with
    | core.ops.control_flow.ControlFlow.Continue val =>
      let written ←
        (guard_certificate.post_value_loop register val 0#usize false : Result
          Bool)
      if written
      then
        let o1 ←
          guard_certificate.assignment ConstantsInst context.front
            context.instruction context.facts context.constants
        let old1 ←
          match o1 with
          | none => ok none
          | some fact =>
            do
            let b1 ←
              (guard_certificate.same_register fact.register register : Result
                Bool)
            if b1
            then ok (some fact.value)
            else ok none
        let b1 ←
          (match guard with
           | none => ok false
           | some b2 => if b2
                        then ok true
                        else ok false : Result Bool)
        if b1
        then ok old1
        else ok none
      else ok old
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.option.Option.Insts.CoreOpsTry_traitFromResidualOptionNever.from_residual
        Std.U64 residual

