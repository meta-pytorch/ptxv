def register_effect.cas_count
  (file : File) (bytes : Std.U8) : Result Std.U16 := do
  if bytes = 8#u8
  then
    let b ←
      (core.cmp.PartialEq.ne.trait_default File.Insts.CoreCmpPartialEqFile file
        File.V : Result Bool)
    if b
    then ok 2#u16
    else ok 1#u16
  else ok 1#u16

/-- [ptxv_ir::register_effect::implicit_cas_sources]:
    Source: 'src/register_effect.rs', lines 314:0-327:1 -/
def register_effect.implicit_cas_sources
  (result : alloc.vec.Vec Reg) (bytes : Std.U8) (compare : Val) :
  Result (alloc.vec.Vec Reg)
  := do
  match compare with
  | Val.Reg first _ =>
    let count ← register_effect.cas_count first.file bytes
    let i ← first.idx + count
    register_effect.append result { first with idx := i } count
  | Val.Imm _ => ok result
  | Val.Const _ _ => ok result
  | Val.SReg _ => ok result

/-- [ptxv_ir::register_effect::atomic_sources]:
