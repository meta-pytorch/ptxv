def register_effect.floating_sources
  (result : alloc.vec.Vec Reg) (value : Val) (bytes : Std.U8) :
  Result (alloc.vec.Vec Reg)
  := do
  if bytes > 4#u8
  then
    match value with
    | Val.Reg first _ =>
      let i ← bytes / 4#u8
      let i1 ← lift (UScalar.cast .U16 i)
      register_effect.append result first i1
    | Val.Imm _ => register_effect.slots result value
