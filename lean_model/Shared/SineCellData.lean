def polynomialQ (x : Rat) : Rat :=
  x-x^3/6+x^5/120-x^7/5040+x^9/362880-x^11/39916800+
    x^13/6227020800-x^15/1307674368000+x^17/355687428096000

def centerSin (j : Nat) : Rat := sinCenters[j]!/2^60
def centerCos (j : Nat) : Rat := cosCenters[j]!/2^60

def nativeCoefficients (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := MufuTables.sin.coefficients[j/4]!
  let k : Rat := ((j%4:Nat):Rat)*32768
  (a/2^25+b*k/2^38+c*k*k/2^56,
   b*32768/2^38+2*c*k*32768/2^56,c*32768^2/2^56)

def differences (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := nativeCoefficients j
  let step := SineTaylor.piRat/512
  (a-centerSin j,b-centerCos j*step,c+centerSin j*step^2/2)

abbrev CellValid (j : Nat) : Prop :=
  let (a,b,c) := differences j;
  -(1/1000000000000) ≤ centerSin j-polynomialQ (SineTaylor.piRat*j/512) ∧
  centerSin j-polynomialQ (SineTaylor.piRat*j/512) ≤ 1/1000000000000 ∧
  -(1/1000000000000) ≤ centerCos j-polynomialQ (SineTaylor.piRat*(256-j)/512) ∧
  centerCos j-polynomialQ (SineTaylor.piRat*(256-j)/512) ≤ 1/1000000000000 ∧
  -(1/5000000) ≤ a ∧ a ≤ 1/5000000 ∧ -(1/5000000) ≤ a+b/2 ∧ a+b/2 ≤ 1/5000000 ∧
  -(1/5000000) ≤ a+b+c ∧ a+b+c ≤ 1/5000000

theorem cells_valid : ∀ j : Fin 256, CellValid j.val := by decide +kernel

#print axioms cells_valid
end GB300Math.SineCells
