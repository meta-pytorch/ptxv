def center (j : Nat) : Rat := centers[j]!/2^60
def linear (j : Nat) : Rat := linears[j]!/2^60
def quadratic (j : Nat) : Rat := quadratics[j]!/2^60
def x (j : Nat) : Rat := 1+j/512
def l2 : Rat := Log2Series.polynomialQ 2
def nativeCoefficients (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := MufuTables.lg2.coefficients[j/8]!
  let k : Rat := ((j%8:Nat):Rat)*16384
  (a/2^26+857088/2^48+b*k/2^38+c*k*k/2^60,
   b*16384/2^38+2*c*k*16384/2^60,c*16384^2/2^60)
def differences (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := nativeCoefficients j
  (a-center j,b-linear j,c-quadratic j)
abbrev CellValid (j : Nat) : Prop :=
  let (a,b,c) := differences j
  |center j-Log2Series.polynomialQ (x j)/l2| ≤ 1/1000000000000 ∧
  |linear j-1/(512*x j*l2)| ≤ 1/1000000000000 ∧
  |quadratic j-(-(1:Rat)/(2*512^2*(x j)^2*l2))| ≤ 1/1000000000000 ∧
  |a| ≤ 14/100000000 ∧ |a+b/2| ≤ 14/100000000 ∧ |a+b+c| ≤ 14/100000000

theorem cells_valid : ∀ j : Fin 512, CellValid j.val := by decide +kernel
#print axioms cells_valid
end GB300Math.Log2Cells
