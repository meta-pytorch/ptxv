def center (j : Nat) : Rat := centers[j]!/2^60

def nativeCoefficients (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := MufuTables.ex2.coefficients[j/4]!
  let u : Rat := ((j%4:Nat):Rat)*32768
  (((a:Rat)*2^32+3205496832+(b:Rat)*u*2^19+(c:Rat)*u^2)/2^57,
   ((b:Rat)*32768*2^19+2*(c:Rat)*u*32768)/2^57,
   ((c:Rat)*32768^2)/2^57)

def differences (j : Nat) : Rat × Rat × Rat :=
  let (a,b,c) := nativeCoefficients j
  (a-center j,b-center j*(logRat/256),c-center j*(logRat/256)^2/2)

def CellValid (j : Nat) : Prop :=
  |seriesQ (logRat*j/256)-center j|≤1/10^12 ∧
  let (a,b,c) := differences j
  0≤a ∧ a≤175/10^9 ∧ 0≤a+b/2 ∧ a+b/2≤175/10^9 ∧ 0≤a+b+c ∧ a+b+c≤175/10^9
instance (j : Nat) : Decidable (CellValid j) := inferInstanceAs (Decidable (_ ∧ _))

theorem cells_valid : ∀j:Fin 256,CellValid j.val := by decide +kernel

theorem bernstein_between (a b c t upper : ℝ) (ht : 0≤t ∧ t≤1)
    (h0 : 0≤a ∧ a≤upper) (h1 : 0≤a+b/2 ∧ a+b/2≤upper)
    (h2 : 0≤a+b+c ∧ a+b+c≤upper) : 0≤a+b*t+c*t^2 ∧ a+b*t+c*t^2≤upper := by
  have w0 : 0≤(1-t)^2 := sq_nonneg _
  have w1 : 0≤2*t*(1-t) := mul_nonneg (mul_nonneg (by norm_num) ht.1) (sub_nonneg.mpr ht.2)
  have w2 : 0≤t^2 := sq_nonneg _
  have p0 := mul_le_mul_of_nonneg_right h0.2 w0
  have p1 := mul_le_mul_of_nonneg_right h1.2 w1
  have p2 := mul_le_mul_of_nonneg_right h2.2 w2
  have n0 := mul_nonneg h0.1 w0
  have n1 := mul_nonneg h1.1 w1
  have n2 := mul_nonneg h2.1 w2
  constructor <;> nlinarith only [p0,p1,p2,n0,n1,n2]

noncomputable def nativePoly (j : Nat) (t : ℝ) : ℝ :=
  let (a,b,c) := nativeCoefficients j
  (a:ℝ)+(b:ℝ)*t+(c:ℝ)*t^2

noncomputable def localTaylor (j : Nat) (t : ℝ) : ℝ :=
  (center j:ℝ)*(1+(logRat:ℝ)/256*t+((logRat:ℝ)/256*t)^2/2)

theorem difference_identity (j : Nat) (t : ℝ) :
    let (a,b,c) := differences j
    (a:ℝ)+(b:ℝ)*t+(c:ℝ)*t^2=nativePoly j t-localTaylor j t := by
  unfold differences nativePoly localTaylor
  rcases nativeCoefficients j with ⟨a,b,c⟩
  dsimp only
  push_cast
  ring

theorem polynomial_between (j : Fin 256) (t : ℝ) (ht : 0≤t ∧ t≤1) :
    0≤nativePoly j.val t-localTaylor j.val t ∧
    nativePoly j.val t-localTaylor j.val t≤175/10^9 := by
  rcases hd : differences j.val with ⟨a,b,c⟩
  have hv := (cells_valid j).2
  change _ at hv
  rw [hd] at hv
  dsimp only at hv
  have h0 : 0≤(a:ℝ) ∧ (a:ℝ)≤175/10^9 := by
    constructor
    · exact (Rat.cast_nonneg (K:=ℝ)).mpr hv.1
    · simpa using (Rat.cast_le (K:=ℝ)).mpr hv.2.1
  have h1 : 0≤(a:ℝ)+(b:ℝ)/2 ∧ (a:ℝ)+(b:ℝ)/2≤175/10^9 := by
    constructor
    · simpa using (Rat.cast_nonneg (K:=ℝ)).mpr hv.2.2.1
    · simpa using (Rat.cast_le (K:=ℝ)).mpr hv.2.2.2.1
  have h2 : 0≤(a:ℝ)+(b:ℝ)+(c:ℝ) ∧ (a:ℝ)+(b:ℝ)+(c:ℝ)≤175/10^9 := by
    constructor
    · simpa using (Rat.cast_nonneg (K:=ℝ)).mpr hv.2.2.2.2.1
    · simpa using (Rat.cast_le (K:=ℝ)).mpr hv.2.2.2.2.2
  have hi:=difference_identity j.val t
  rw [hd] at hi
  dsimp only at hi
  rw [←hi]
  exact bernstein_between _ _ _ _ _ ht h0 h1 h2

def LowerValid (j : Nat) : Prop :=
  let (a,b,c):=differences j
  50/10^9≤a ∧ 50/10^9≤a+b/2 ∧ 50/10^9≤a+b+c
noncomputable instance (j : Nat) : Decidable (LowerValid j) := inferInstanceAs (Decidable (_ ∧ _))
theorem lower_valid : ∀j:Fin 256,LowerValid j.val := by decide +kernel

theorem polynomial_lower (j : Fin 256) (t : ℝ) (ht : 0≤t ∧ t≤1) :
    (50/10^9:ℝ)≤nativePoly j.val t-localTaylor j.val t := by
  rcases hd:differences j.val with ⟨a,b,c⟩
  have hv:=lower_valid j
  unfold LowerValid at hv
  rw [hd] at hv
  dsimp only at hv
  have h0 : (50/10^9:ℝ)≤(a:ℝ) := by simpa using (Rat.cast_le (K:=ℝ)).mpr hv.1
  have h1 : (50/10^9:ℝ)≤(a:ℝ)+(b:ℝ)/2 := by simpa using (Rat.cast_le (K:=ℝ)).mpr hv.2.1
  have h2 : (50/10^9:ℝ)≤(a:ℝ)+(b:ℝ)+(c:ℝ) := by simpa using (Rat.cast_le (K:=ℝ)).mpr hv.2.2
  have w0 : 0≤(1-t)^2 := sq_nonneg _
  have w1 : 0≤2*t*(1-t) := mul_nonneg (mul_nonneg (by norm_num) ht.1) (sub_nonneg.mpr ht.2)
  have w2 : 0≤t^2 := sq_nonneg _
  have p0:=mul_le_mul_of_nonneg_right h0 w0
  have p1:=mul_le_mul_of_nonneg_right h1 w1
  have p2:=mul_le_mul_of_nonneg_right h2 w2
  have hi:=difference_identity j.val t
  rw [hd] at hi
  dsimp only at hi
  rw [←hi]
  nlinarith only [p0,p1,p2]

#print axioms lower_valid
#print axioms polynomial_lower
#print axioms cells_valid
#print axioms bernstein_between
#print axioms difference_identity
#print axioms polynomial_between
end GB300Math.Exp2Cells
