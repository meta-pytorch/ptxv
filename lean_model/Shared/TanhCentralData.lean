  let v:=center e u
  let s:=step e
  #[a*(1+v)+v-1,b*(1+v)-2*s*v*(a+1),
    c*(1+v)-2*s*v*b+2*s^2*v*(a+1),-2*s*v*c+2*s^2*v*b,2*s^2*v*c]

def BernsteinValid (e u:Nat) : Prop :=
  let r:=residual e u
  |r[0]!|≤1/100000 ∧ |r[0]!+r[1]!/4|≤1/100000 ∧
  |r[0]!+r[1]!/2+r[2]!/6|≤1/100000 ∧
  |r[0]!+3*r[1]!/4+r[2]!/2+r[3]!/4|≤1/100000 ∧
  |r[0]!+r[1]!+r[2]!+r[3]!+r[4]!|≤1/100000
noncomputable instance (e u:Nat) : Decidable (BernsteinValid e u) := inferInstanceAs (Decidable (_ ∧ _))

def Valid (e u : Nat) : Prop :=
  0≤start e u ∧ start e u≤8 ∧ 0<step e ∧ step e≤1/128 ∧
  0≤center e u ∧ center e u≤1 ∧
  0≤seriesQ (-start e u/8) ∧ seriesQ (-start e u/8)≤1 ∧
  |(seriesQ (-start e u/8))^16-center e u|≤1/10^15 ∧
  BernsteinValid e u
noncomputable instance (e u : Nat) : Decidable (Valid e u) := inferInstanceAs (Decidable (_ ∧ _))

end GB300Math.TanhCentralCells
