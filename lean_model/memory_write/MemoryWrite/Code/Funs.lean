              intermediate := { state with pending, transactions := i3 },
              after :=
                {
                  state
                    with
                    pending := state.expected, transactions := i3, phase := i4
                },
              completed,
              fault := none
            }
        else
          ok
            {
              intermediate := { state with pending, transactions := i3 },
              after := { state with pending, transactions := i3 },
              completed,
              fault := none
            }

