  (active : Bool) (guard_dependent : Bool) (hook_wrote : Bool)
  (source_tainted : Bool) :
  Result symbolic.DestinationPlan
  := do
  let touched ← (if active
                 then ok true
                 else ok guard_dependent : Result Bool)
  let b ←
    (if touched
     then if guard_dependent
          then ok true
          else ok (¬ hook_wrote)
     else ok false : Result Bool)
  if active
  then
    ok
      {
        touched,
        clear_history := b,
        forget_half := guard_dependent,
        clear_bits := touched,
        active_taint := (some source_tainted),
        force_taint := guard_dependent
      }
  else
    ok
      {
        touched,
        clear_history := b,
        forget_half := guard_dependent,
        clear_bits := touched,
        active_taint := none,
        force_taint := guard_dependent
      }

