                  with
                  value := byte.value,
                  origin := byte.origin,
                  tainted := byte.tainted,
                  defined := byte.defined,
                  written := true,
                  word := byte.word
              }
          else
            ok
              {
                cell
                  with
                  value := byte.value,
                  origin := byte.origin,
                  tainted := byte.tainted,
                  defined := byte.defined,
                  written := true,
                  word := o
