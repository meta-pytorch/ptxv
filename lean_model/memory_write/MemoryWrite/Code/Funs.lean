def barrier.transition
  (state : barrier.Counters) (delta : barrier.TransactionDelta)
  (arrivals : Std.U32) :
  Result barrier.Transition
  := do
  let difference ←
    match delta with
    | barrier.TransactionDelta.Add value => ok (IScalar.cast .I128 value)
    | barrier.TransactionDelta.Subtract value =>
      do
      let i ← lift (IScalar.cast .I128 value)
      -. i
  let i ← lift (IScalar.cast .I128 state.transactions)
  let transactions ← i + difference
  let i1 ← lift (IScalar.cast .I128 core.num.I64.MIN)
  if transactions < i1
  then barrier.rejected state barrier.Fault.TransactionOverflow
  else
    let i2 ← lift (IScalar.cast .I128 core.num.I64.MAX)
    if transactions > i2
    then barrier.rejected state barrier.Fault.TransactionOverflow
    else
      let i3 ← lift (IScalar.cast .I64 transactions)
      let o ← reduction.arrival_pending state.pending arrivals
      match o with
      | none =>
        barrier.rejected { state with transactions := i3 }
          barrier.Fault.OverArrival
      | some pending =>
        let completed ←
          (reduction.phase_completes pending (i3 = 0#i64) : Result Bool)
        if completed
        then
          let i4 ← lift (core.num.U32.wrapping_add state.phase 1#u32)
          ok
