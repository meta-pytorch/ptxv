def store.prepare_word
  (input : store.WordStoreInput) : Result checked.PreparedWrite := do
  let decision ←
    symbolic.control input.guard input.address_low input.address_high
  let bytes ← lift (core.num.U32.to_le_bytes input.source.captured)
  let (o, word) ←
    match input.source.history with
    | none => ok (none, none)
    | some id => ok (input.source.history, some (WordHistory.Known id))
  let i ← Array.index_usize bytes 0#usize
  let pb ← store.payload_byte i { input.source with history := o } word
  let payload ← alloc.vec.Vec.push (alloc.vec.Vec.new PayloadByte) pb
  let i1 ← Array.index_usize bytes 1#usize
  let pb1 ← store.payload_byte i1 { input.source with history := o } none
  let payload1 ← alloc.vec.Vec.push payload pb1
  let i2 ← Array.index_usize bytes 2#usize
  let pb2 ← store.payload_byte i2 { input.source with history := o } none
  let payload2 ← alloc.vec.Vec.push payload1 pb2
  let i3 ← Array.index_usize bytes 3#usize
  let pb3 ← store.payload_byte i3 { input.source with history := o } none
  let payload3 ← alloc.vec.Vec.push payload2 pb3
  let i4 ← lift (UScalar.cast .U64 input.address_low.captured)
  let i5 ← lift (UScalar.cast .U64 input.address_high.captured)
  let i6 ← i5 <<< 32#i32
  let i7 ← lift (i4 ||| i6)
  ok
    {
      «class» := checked.WriteClass.Store,
      destination :=
        { space := input.space, allocation := input.allocation, offset := i7 },
      payload := payload3,
      words := (alloc.vec.Vec.new words.WordPatch),
      enabled := decision.enabled,
      address_dependent := decision.address_dependent,
      guard_dependent := decision.guard_dependent
    }

