// An integer division per thread: 1000 / d. good: d is a parameter (7); DATA: d is the input
// element minus 96 (zero only in CTA 3's slice); POS: d is %ctaid - 3 (zero only in CTA 3).
// CVTA: cvta.to.shared of an address that leaves the shared window when the input element is
// 96; LDC: a table parameter read at an index past the parameters when it is 96.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_rep_divzero(.param .u64 out_p, .param .u64 in_p, .param .u32 dv, .param .align 4 .b8 tbl[16])
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<24>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 S;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u32 %r8, [dv];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    shl.b32 %r3, %r2, 5;
    add.u32 %r4, %r3, %r1;
    mul.wide.u32 %rd3, %r4, 4;
    add.s64 %rd4, %rd2, %rd3;
    ld.global.u32 %r5, [%rd4];
    mov.u32 %r6, %r8;                     // @DIV
    div.s32 %r7, 1000, %r6;
    add.u32 %r9, %r7, %r5;
    mov.u32 %r10, 0;                      // @EXTRA
    add.u32 %r9, %r9, %r10;
    add.s64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r9;
    ret;
}
