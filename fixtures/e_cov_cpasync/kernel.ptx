// Input words copied to shared memory by cp.async, read back, tested by a branch and used as
// a store index (an address that ptxas keeps on the SASS front).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cov_cpasync(.param .u64 out_p, .param .u64 in_p)
.reqntid 32
{
    .reg .b32 %r<20>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    .shared .align 16 .b8 S[512];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 16;
    add.s64 %rd4, %rd2, %rd3;
    mov.u32 %r2, S;
    shl.b32 %r3, %r1, 4;
    add.u32 %r4, %r2, %r3;
    cp.async.cg.shared.global [%r4], [%rd4], 16;
    cp.async.commit_group; cp.async.wait_group 0;
    ld.shared.u32 %r5, [%r4];
    mov.u32 %r6, 1;
    setp.lt.u32 %p1, %r5, 64;
    @!%p1 bra SKIP;
    mov.u32 %r6, 2;
SKIP:
    shr.u32 %r8, %r5, 2;                           // iota input: in[4t] = 4t, index t
    and.b32 %r7, %r8, 31;                          // the store's index is input data
    mul.wide.u32 %rd5, %r7, 4;
    add.s64 %rd6, %rd1, %rd5;
    st.global.u32 [%rd6], %r6;
    ret;
}
