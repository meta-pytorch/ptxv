// E-DRF for tensor memory: TMEM accesses are not scheduling points, so a TMEM race must be found
// by the vector clocks alone. Warp 0 and warp 4 share TMEM lane quadrant 0. Warp 0 stores its
// lane id + 100 to column 0 (tcgen05.st), waits, and warp 4 loads the column (tcgen05.ld) and
// writes it to out.
//   good: st; wait::st; fence::before_thread_sync; bar.sync 0; fence::after_thread_sync; ld.
//   NOBAR: the barrier between the store and the load deleted: race.
//   NOWAIT: tcgen05.wait::st deleted: the store may still be in flight at the barrier: race.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_drf_tmem(.param .u64 out_p)
{
    .shared .align 4 .b32 slot;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %q<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    shr.u32 %r1, %r0, 5;                 // warp
    and.b32 %r2, %r0, 31;                // lane
    mov.u32 %r3, slot;
    setp.ne.u32 %q0, %r1, 0;
    @%q0 bra ALLOCED;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
ALLOCED:
    tcgen05.fence::before_thread_sync;
    bar.sync 1;
    tcgen05.fence::after_thread_sync;
    ld.shared.u32 %r4, [slot];           // TMEM address: lane 0, column base
    @%q0 bra STORED;
    add.u32 %r5, %r2, 100;
    tcgen05.st.sync.aligned.32x32b.x1.b32 [%r4], {%r5};
    tcgen05.wait::st.sync.aligned;       // @WAIT
STORED:
    tcgen05.fence::before_thread_sync;
    bar.sync 0;                          // @BAR
    tcgen05.fence::after_thread_sync;
    setp.ne.u32 %q1, %r1, 4;
    @%q1 bra LOADED;
    tcgen05.ld.sync.aligned.32x32b.x1.b32 {%r6}, [%r4];
    tcgen05.wait::ld.sync.aligned;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r6;
LOADED:
    tcgen05.fence::before_thread_sync;
    bar.sync 2;
    tcgen05.fence::after_thread_sync;
    @%q0 bra DONE;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r4, 32;
DONE:
    ret;
}
