// RMK4 A10: the inval of `a` is ordered before t32's reuse of `a` only through shared-memory-only
// happens-before (S-MBAR-SCOPE): t0 invals a, fence.release.sync_restrict::shared::cta.cluster,
// relaxed cluster arrive on b; t32 relaxed cluster wait on b, fence.acquire.sync_restrict::
// shared::cluster.cluster, then reuses a (plain store: STORE, or re-init: good / INITP).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_mbar_init_restrict(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b8 a[8];
    .shared .align 8 .b8 b[8];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, a;
    mov.u32 %r3, b;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra AFTER_INIT;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    mbarrier.init.shared::cta.b64 [%r3], 1;
AFTER_INIT:
    bar.sync 0;
    @%p2 bra NOINV;
    mbarrier.inval.shared::cta.b64 [%r2];
    fence.release.sync_restrict::shared::cta.cluster;          // @REL
    mbarrier.arrive.relaxed.cluster.shared::cta.b64 _, [%r3];
NOINV:
    setp.eq.u32 %p4, %r1, 32;
    @!%p4 bra NOUSE;
SPIN:
    mbarrier.try_wait.parity.relaxed.cluster.shared::cta.b64 %p5, [%r3], 0;
    @!%p5 bra SPIN;
    fence.acquire.sync_restrict::shared::cluster.cluster;      // @ACQ
    mbarrier.init.shared::cta.b64 [%r2], 1;                    // @USE
NOUSE:
    bar.sync 0;
    @%p2 bra DONE;
    mov.u32 %r9, 1;
    st.global.u32 [%rd1], %r9;
DONE:
    ret;
}
