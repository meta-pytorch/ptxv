// fixtures/mbar_count_order: counted mbarrier arrivals whose order matters. The barrier expects 3 arrivals. Warp 0 lane 0
// writes data then arrives (count 1), warp 2 arrives with count 3, warp 3 waits for phase 0
// and reads data. If warp 2 arrives first it completes phase 0 alone: the consumer may read
// data before warp 0 writes it (race). If it arrives second, its count exceeds the pending
// count (fault). Warp 1 and the other lanes exit at once.
.version 9.0
.target sm_100a
.address_size 64

.visible .entry mbar_count_order(.param .u64 out)
{
    .reg .pred %p<8>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .shared .align 8 .b64 bar;
    .shared .align 4 .b32 data;
    mov.u32 %r0, %tid.x;
    and.b32 %r1, %r0, 31;
    shr.u32 %r2, %r0, 5;
    mov.u32 %r3, bar;
    mov.u32 %r4, data;
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r3], 3;
    st.shared.u32 [%r4], 0;
SKIP_INIT:
    bar.sync 0;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra PRODUCER;
    setp.eq.u32 %p2, %r2, 1;
    @%p2 bra DONE;
    setp.eq.u32 %p2, %r2, 2;
    @%p2 bra ARRIVE2;
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r3], 0;
    @!%p3 bra WAIT;
    ld.shared.u32 %r5, [%r4];
    ld.param.u64 %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    st.global.u32 [%rd1], %r5;
    bra DONE;
PRODUCER:
    st.shared.u32 [%r4], 42;
    mbarrier.arrive.shared::cta.b64 _, [%r3];
    bra DONE;
ARRIVE1:
    mbarrier.arrive.shared::cta.b64 _, [%r3];
    bra DONE;
ARRIVE2:
    mov.u32 %r6, 3;
    mbarrier.arrive.shared::cta.b64 _, [%r3], %r6; // @COUNT
DONE:
    ret;
}
