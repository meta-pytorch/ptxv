// Fixture for S-MBAR-SCOPE / S-TCGEN05 (2-CTA tensor-memory hand-back): r1c_2sm's pair MMA run
// twice over the same TMEM accumulator. Between the rounds every thread of both CTAs reads D
// (tcgen05.ld; wait::ld), the CTA syncs (tcgen05.fence::before_thread_sync; bar.sync), and
// t0 of each CTA arrives on the leader's `empty` barrier: rank 1 remotely with
// mbarrier.arrive.release.cluster.shared::cluster, rank 0 locally. The leader's t0 waits on
// `empty` with acquire.cluster, then issues round 2's MMAs, which overwrite D in both CTAs'
// TMEM, so the peer's round-1 reads must happen-before them through the remote arrive.
//
// Barriers (bars + offset): full +0 (rank 0), done +8 (both), done2 +16 (both), empty +24
// (rank 0, count 2).
//
// Mutants (case.toml): RCTA the peer's hand-back arrive is .release.cta (the default
// semantics of mbarrier.arrive.shared::cluster): not morally strong with the leader's wait,
// so round 2's MMA races with the peer's reads (PTX), and ptxas emits a bare arrive (SASS).
// ACTA the leader's wait is .acquire.cta (try_wait's default): a race on the PTX front; on
// the SASS front PHASECHK (no CCTL.IVALL) acquires the peer's release for SM-local memory,
// tensor memory included, so round 2's MMA is ordered after the peer's reads: clean.
// ACTANW ACTA without the peer's round-1 tcgen05.wait::ld: a race and an undefined-register
// violation on PTX; SASS clean (ptxas makes the stores of the loaded registers wait for the
// LDTM, so the SASS is ordered as before).
// ACTAE ACTA with the peer handing D back before its round-1 tcgen05.ld (the arrive moved
// ahead of the reads): round 2's MMA races with the peer's reads on both fronts.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_tc_handback(
    .param .align 64 .b8 tmap_a[128],
    .param .align 64 .b8 tmap_b[128],
    .param .u64 d_ptr
)
.maxntid 128, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .pred  %p<16>;
    .reg .b16   %rs<4>;
    .reg .b32   %r<64>;
    .reg .b64   %rd<32>;
    .shared .align 16 .b32 tmem_slot;
    .shared .align 8 .b8 bars[32];
    .shared .align 1024 .b8 smA[16384];
    .shared .align 1024 .b8 smB[1024];

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;                    // warp
    mov.u32         %r2, %cluster_ctarank;
    mov.u32         %r3, bars;
    mov.u32         %r4, tmem_slot;
    mov.u32         %r5, smA;
    mov.u32         %r6, smB;
    setp.ne.u32     %p0, %r1, 0;
    @%p0 bra        SKIP_ALLOC;
    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r4], 32;
    tcgen05.relinquish_alloc_permit.cta_group::2.sync.aligned;
SKIP_ALLOC:
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r3], 1;          // full (rank 0)
    add.u32         %r8, %r3, 8;
    mbarrier.init.shared::cta.b64 [%r8], 1;          // done
    add.u32         %r8, %r3, 16;
    mbarrier.init.shared::cta.b64 [%r8], 1;          // done2
    add.u32         %r8, %r3, 24;
    mbarrier.init.shared::cta.b64 [%r8], 2;          // empty (rank 0)
    fence.mbarrier_init.release.cluster;
SKIP_INIT:
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    barrier.cluster.arrive.relaxed.aligned;
    barrier.cluster.wait.aligned;
    ld.shared.b32   %r9, [%r4];                     // TMEM accumulator address
    add.u32         %r13, %r3, 8;                   // done
    @%p1 bra        EPILOGUE;

    // ---- t0 of each CTA: loads (leader's barrier) ---------------------------------------
    mov.b64         %rd0, tmap_a;
    cvta.param.u64  %rd1, %rd0;
    mov.b64         %rd2, tmap_b;
    cvta.param.u64  %rd3, %rd2;
    mapa.shared::cluster.u32 %r10, %r3, 0;          // rank 0's full
    setp.eq.u32     %p2, %r2, 0;
    @!%p2 bra       LOADS;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r3], 34816;     // 2 x (16 KB A + 1 KB B)
LOADS:
    shl.b32         %r14, %r2, 7;                   // A row base = 128 * rank
    shl.b32         %r15, %r2, 3;                   // B row base = 8 * rank
    mov.u32         %r16, 0;
    cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes.cta_group::2 [%r5], [%rd1, {%r16, %r14}], [%r10];
    cp.async.bulk.tensor.2d.shared::cluster.global.mbarrier::complete_tx::bytes.cta_group::2 [%r6], [%rd3, {%r16, %r15}], [%r10];
    @!%p2 bra       EPILOGUE;

    // ---- rank 0 t0: the pair's MMA ------------------------------------------------------
F_WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p6, [%r3], 0;
    @!%p6 bra       F_WAIT;
    tcgen05.fence::after_thread_sync;
    mov.u32         %r26, 0x10040490;               // idesc: f32 <- bf16 x bf16, N = 16, M = 256
    shr.u32         %r20, %r5, 4;
    cvt.u64.u32     %rd4, %r20;
    or.b64          %rd5, %rd4, 0x4000404000010000;
    shr.u32         %r21, %r6, 4;
    cvt.u64.u32     %rd6, %r21;
    or.b64          %rd7, %rd6, 0x4000404000010000;
    setp.ne.u32     %p7, %r0, %r0;                  // false: first MMA overwrites D
    setp.eq.u32     %p8, %r0, %r0;                  // true
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd5, %rd7, %r26, %p7;
    add.u64         %rd8, %rd5, 2;
    add.u64         %rd9, %rd7, 2;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd8, %rd9, %r26, %p8;
    add.u64         %rd10, %rd5, 4;
    add.u64         %rd11, %rd7, 4;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd10, %rd11, %r26, %p8;
    add.u64         %rd12, %rd5, 6;
    add.u64         %rd13, %rd7, 6;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd12, %rd13, %r26, %p8;
    mov.b16         %rs0, 3;                                        // @B12
    tcgen05.commit.cta_group::2.mbarrier::arrive::one.shared::cluster.multicast::cluster.b64 [%r13], %rs0;

    // ---- all: epilogue -----------------------------------------------------------------
EPILOGUE:
D_WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p10, [%r13], 0;
    @!%p10 bra      D_WAIT;
    tcgen05.fence::after_thread_sync;
    // (early hand-back slot)                                          // @EARLY
    shl.b32         %r30, %r1, 21;                  // (32 * warp) << 16: TMEM lane field
    add.u32         %r31, %r9, %r30;
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r40, %r41, %r42, %r43, %r44, %r45, %r46, %r47, %r48, %r49, %r50, %r51, %r52, %r53, %r54, %r55}, [%r31];
    tcgen05.wait::ld.sync.aligned;                  // @WAITLD
    ld.param.u64    %rd20, [d_ptr];
    cvta.to.global.u64 %rd21, %rd20;
    shl.b32         %r32, %r2, 7;
    add.u32         %r33, %r32, %r0;                // row = 128 * rank + tid
    mul.wide.u32    %rd22, %r33, 64;
    add.u64         %rd23, %rd21, %rd22;
    st.global.b32   [%rd23+0], %r40;
    st.global.b32   [%rd23+4], %r41;
    st.global.b32   [%rd23+8], %r42;
    st.global.b32   [%rd23+12], %r43;
    st.global.b32   [%rd23+16], %r44;
    st.global.b32   [%rd23+20], %r45;
    st.global.b32   [%rd23+24], %r46;
    st.global.b32   [%rd23+28], %r47;
    st.global.b32   [%rd23+32], %r48;
    st.global.b32   [%rd23+36], %r49;
    st.global.b32   [%rd23+40], %r50;
    st.global.b32   [%rd23+44], %r51;
    st.global.b32   [%rd23+48], %r52;
    st.global.b32   [%rd23+52], %r53;
    st.global.b32   [%rd23+56], %r54;
    st.global.b32   [%rd23+60], %r55;
    // ---- hand-back: round 1's reads are done in this CTA -------------------------------
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    add.u32         %r34, %r3, 24;                  // empty (this CTA's address)
    mapa.shared::cluster.u32 %r35, %r34, 0;         // rank 0's empty
    @%p1 bra        R2_WAIT_ALL;
    setp.eq.u32     %p12, %r2, 0;
    @%p12 bra       R2_LOCAL;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r35];     // @HANDBACK
    bra             R2_WAIT_ALL;
R2_LOCAL:
    mbarrier.arrive.shared::cta.b64 _, [%r34];
E_WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p13, [%r34], 0;  // @EWAIT
    @!%p13 bra      E_WAIT;
    tcgen05.fence::after_thread_sync;
    add.u32         %r36, %r3, 16;                  // done2
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd5, %rd7, %r26, %p7;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd8, %rd9, %r26, %p8;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd10, %rd11, %r26, %p8;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], %rd12, %rd13, %r26, %p8;
    tcgen05.commit.cta_group::2.mbarrier::arrive::one.shared::cluster.multicast::cluster.b64 [%r36], %rs0;
R2_WAIT_ALL:
    add.u32         %r37, %r3, 16;                  // done2
D2_WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p14, [%r37], 0;
    @!%p14 bra      D2_WAIT;
    tcgen05.fence::after_thread_sync;
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r40, %r41, %r42, %r43, %r44, %r45, %r46, %r47, %r48, %r49, %r50, %r51, %r52, %r53, %r54, %r55}, [%r31];
    tcgen05.wait::ld.sync.aligned;
    st.global.b32   [%rd23+0], %r40;
    st.global.b32   [%rd23+4], %r41;
    st.global.b32   [%rd23+8], %r42;
    st.global.b32   [%rd23+12], %r43;
    st.global.b32   [%rd23+16], %r44;
    st.global.b32   [%rd23+20], %r45;
    st.global.b32   [%rd23+24], %r46;
    st.global.b32   [%rd23+28], %r47;
    st.global.b32   [%rd23+32], %r48;
    st.global.b32   [%rd23+36], %r49;
    st.global.b32   [%rd23+40], %r50;
    st.global.b32   [%rd23+44], %r51;
    st.global.b32   [%rd23+48], %r52;
    st.global.b32   [%rd23+52], %r53;
    st.global.b32   [%rd23+56], %r54;
    st.global.b32   [%rd23+60], %r55;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    // The pair's TMEM must stay allocated until both CTAs are done reading it.
    barrier.cluster.arrive.aligned;
    barrier.cluster.wait.aligned;
    setp.ne.u32     %p11, %r1, 0;
    @%p11 bra       FINAL;
    tcgen05.fence::after_thread_sync;
    tcgen05.dealloc.cta_group::2.sync.aligned.b32 %r9, 32;
FINAL:
    ret;
}
