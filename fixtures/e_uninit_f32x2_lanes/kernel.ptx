//
// S-INIT per lane of a PTX f32x2 register: every thread loads a, and b only under a
// predicate threads 16..31 fail; `mov.b64 %rd, {a, b}` packs a defined and an undefined lane
// into one 64-bit register, add.rn.f32x2 doubles both, and the lanes are unpacked. Lane 0 is
// stored: clean. Before, a PTX virtual register was defined or undefined as a whole, so the
// undefined lane poisoned the defined one (CuTeDSL FlashAttentionBackwardPreprocess, PTX
// front: mul.f32x2 / add.f32x2 over values of two rows, one row out of range).
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry uninit_f32x2_lanes(
	.param .u64 in_ptr,
	.param .u64 out_ptr
)
.reqntid 32
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<10>;

	ld.param.u64 %rd1, [in_ptr];
	ld.param.u64 %rd2, [out_ptr];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p1, %r1, 16;
	mul.wide.u32 %rd3, %r1, 8;
	add.s64 %rd4, %rd1, %rd3;
	ld.global.b32 %r2, [%rd4];
	@%p1 ld.global.b32 %r3, [%rd4+4];
	mov.b64 %rd5, {%r2, %r3};
	add.rn.f32x2 %rd6, %rd5, %rd5;
	mov.b64 {%r4, %r5}, %rd6;
	mul.wide.u32 %rd7, %r1, 4;
	add.s64 %rd8, %rd2, %rd7;
	st.global.b32 [%rd8], %r4; // @STORE
	ret;
}
