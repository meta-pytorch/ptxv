// fixtures/c_num_branch_f32 (N-NUM-TRACK): control flow decided by a rounded value. Thread t
// (32 threads) reads x, y, z, u, v [t] and writes out[32 k + t]; p = rn(x*y) >= 1 and
// q = rn(u*v) > 1. In even lanes x*y lies just below 1 and rounds to 1 (p true, false in exact
// arithmetic), u*v just above 1 and rounds to 1 (q false, true in exact arithmetic):
//   k = 0: p ? 1 : -1               (a branch)
//   k = 1: p ? y + z : x + z        (a branch to tracked adds)
//   k = 2: 1 if q (a store under the guard q), else the initial 0
// `ptxv num` follows this run's path; the exact computation takes the other one.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry c_num_branch_f32(
	.param .u64 px,
	.param .u64 py,
	.param .u64 pz,
	.param .u64 pu,
	.param .u64 pv,
	.param .u64 pout
)
{
	.reg .pred %p<4>;
	.reg .b32 %r<4>;
	.reg .f32 %f<16>;
	.reg .b64 %rd<16>;

	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [py];
	ld.param.u64 %rd3, [pz];
	ld.param.u64 %rd4, [pu];
	ld.param.u64 %rd5, [pv];
	ld.param.u64 %rd6, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	cvta.to.global.u64 %rd4, %rd4;
	cvta.to.global.u64 %rd5, %rd5;
	cvta.to.global.u64 %rd6, %rd6;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd7, %r1, 4;
	add.s64 %rd8, %rd1, %rd7;
	ld.global.f32 %f1, [%rd8];
	add.s64 %rd8, %rd2, %rd7;
	ld.global.f32 %f2, [%rd8];
	add.s64 %rd8, %rd3, %rd7;
	ld.global.f32 %f3, [%rd8];
	add.s64 %rd8, %rd4, %rd7;
	ld.global.f32 %f4, [%rd8];
	add.s64 %rd8, %rd5, %rd7;
	ld.global.f32 %f5, [%rd8];
	add.s64 %rd9, %rd6, %rd7;
	mul.rn.f32 %f6, %f1, %f2;
	setp.ge.f32 %p1, %f6, 0f3F800000;
	@%p1 bra $L_t;
	mov.f32 %f7, 0fBF800000;
	add.rn.f32 %f8, %f1, %f3;
	bra.uni $L_j;
$L_t:
	mov.f32 %f7, 0f3F800000;
	add.rn.f32 %f8, %f2, %f3;
$L_j:
	st.global.f32 [%rd9], %f7;
	st.global.f32 [%rd9+128], %f8;
	mul.rn.f32 %f9, %f4, %f5;
	setp.gt.f32 %p2, %f9, 0f3F800000;
	@%p2 st.global.f32 [%rd9+256], 0f3F800000;
	ret;
}
