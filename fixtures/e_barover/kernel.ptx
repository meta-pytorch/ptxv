// E-BAR-OVER fixture: a named barrier used by more threads than its count. 128 threads.
// Warp 0 (producer) writes buf[lane] = lane + 1 in shared memory, then `bar.sync 1, 64`.
// Warp 1 (consumer) runs `bar.sync 1, 64`, then copies buf[lane] to out[lane]. Warps 2 and 3
// meet on `bar.sync 2, 64`.
//   good: as above
//   BO1 : warps 2 and 3 use barrier 1 too. Barrier 1 now sees 128 arrivals of count 64: two
//         generations, and which warps share one depends on arrival order. Only when warps 0
//         and 1 share a generation is the consumer's load ordered after the producer's store;
//         e.g. warps 1 and 2 first, then 0 and 3, is a race.
//   BO2 : warp 3 skips the barrier, warp 2 arrives at barrier 1 twice. Warps 0 and 1 first:
//         warp 2 is then alone in the second generation (deadlock); any other order races.
//   BO3 : warp 3 skips the barrier, the consumer arrives at barrier 1 again after its copy.
//         Warps 0 and 1 first: clean; 1 and 2 first: race; 0 and 2 first: the consumer is
//         alone in the second generation (deadlock).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_barover(.param .u64 out_p)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 buf[32];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;                // lane
    shr.u32 %r8, %r1, 5;                 // warp
    mov.u32 %r3, buf;
    shl.b32 %r4, %r2, 2;
    add.u32 %r5, %r3, %r4;               // &buf[lane]
    setp.ge.u32 %p1, %r8, 2;
    @%p1 bra OTHER;
    setp.eq.u32 %p2, %r8, 1;
    @%p2 bra CONSUMER;
    add.u32 %r6, %r2, 1;
    st.shared.u32 [%r5], %r6;
    bar.sync 1, 64;
    bra DONE;
CONSUMER:
    bar.sync 1, 64;
    ld.shared.u32 %r7, [%r5];
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r7;
    bra DONE;                            // @CDONE
OTHER:
    bar.sync 2, 64;                      // @OTHER
DONE:
    ret;
}
