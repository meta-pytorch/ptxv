// E-ELECT: the elected lane's id is the output. GB300 elects the lowest active lane
// (probes/elect): out[0] = 0. The PTX ISA fixes no lane, so the PTX front runs the lowest and
// the highest leader: two outcomes (nondeterministic); the SASS front must give GB300's.
// (Partial membermasks are refused by both fronts, so only the full warp is checked.)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_elect_lane(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    elect.sync _|%p1, 0xffffffff;
    @%p1 st.global.u32 [%rd1], %r1;
DONE:
    ret;
}
