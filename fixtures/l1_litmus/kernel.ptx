// E-HW-L1 litmus (docs/deepep-repro.md): message passing from a producer CTA to a consumer
// CTA on another SM, in the shapes of docs/poll-acq-litmus.md.
//
//   producer (CTA 0, thread 0): weak store payload = 1; fence.acq_rel.sys; relaxed sys atomic
//       add on the flag (DeepEP barrier_block's signal: MEMBAR.ALL.SYS; CCTL.IVALL; ATOM).
//   consumer (CTA 1): every thread runs the entry slot, then bar.sync. Thread 0 polls the flag
//       with ld.volatile until it is 1 (no fence: barrier_block's wait); thread 32 runs the
//       stress slot meanwhile. Then bar.sync, and thread 0 reads the payload with a weak load.
//
// Slots (case.toml variants): entry = barrier_block's entry fence (pr0); pre = a weak payload
// load before the poll (pr2); reload = a weak payload load in every poll iteration (pr3);
// post = an acquire fence after the poll (negative control); stress = another warp of the SM
// loads the payload during the barrier (payld).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry l1lit(
    .param .u64 pay,
    .param .u64 flag,
    .param .u64 out
)
.maxntid 64, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    mov.u32         %r0, %ctaid.x;
    mov.u32         %r1, %tid.x;
    ld.param.u64    %rd0, [pay];
    cvta.to.global.u64 %rd1, %rd0;
    ld.param.u64    %rd2, [flag];
    cvta.to.global.u64 %rd3, %rd2;
    setp.ne.u32     %p0, %r0, 0;                                    // @ROLE
    @%p0 bra        CONSUMER;
    setp.ne.u32     %p1, %r1, 0;
    @%p1 bra        DONE;
    mov.u32         %r2, 1;
    st.global.u32   [%rd1], %r2;
    fence.acq_rel.sys;
    atom.relaxed.sys.global.add.u32 %r3, [%rd3], %r2;
    bra             DONE;
CONSUMER:
    // (entry slot)                                                 // @ENTRY
    bar.sync        0;
    mov.u32         %r9, 0;
    setp.ne.u32     %p3, %r1, 0;
    setp.eq.u32     %p2, %r1, 32;
    @%p2 bra        STRESS;
    @%p3 bra        JOIN;
    // (pre slot)                                                   // @PRE
POLL:
    ld.volatile.global.u32 %r5, [%rd3];
    // (reload slot)                                                // @RELOAD
    setp.lt.u32     %p4, %r5, 1;
    @%p4 bra        POLL;
    // (post slot)                                                  // @POST
    bra             JOIN;
STRESS:
    // (stress slot)                                                // @STRESS
JOIN:
    bar.sync        0;
    @%p3 bra        DONE;
    ld.global.u32   %r6, [%rd1];
    add.u32         %r6, %r6, %r9;
    ld.param.u64    %rd4, [out];
    cvta.to.global.u64 %rd5, %rd4;
    st.global.u32   [%rd5], %r6;
DONE:
    ret;
}
