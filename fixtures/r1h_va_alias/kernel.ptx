//
// Rung 1h, virtual aliases within one address space (S-VA-ALIAS): `a` and `b` are two
// mappings of the same buffer (two cuMemMap calls of one handle). Warp 0, thread 0:
//   - weak pair: st.global through a, fence.proxy.alias, ld.global through b;
//   - strong pair: st.release.sys through a, fence.proxy.alias, ld.acquire.sys through b;
//   - message passing to warp 1: data through a, fence.proxy.alias, flag st.release.sys
//     through a.
// Warp 1, thread 32: fence.proxy.alias, poll the flag with ld.acquire.sys through b, read
// the data through b. PTX ISA 8.2.2 (aliases), 8.6 (aliases act as distinct proxies), 8.7
// (moral strength needs the same proxy), 8.9.5 (an alias proxy fence on the base causality
// path); CUDA programming guide, virtual aliasing support.
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry va_alias(
    .param .u64 a,
    .param .u64 b,
    .param .u64 out
)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [out];
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 bra PRODUCER;
    setp.eq.u32 %p1, %r1, 32;
    @%p1 bra CONSUMER;
    bra DONE;
PRODUCER:
    st.global.u32 [%rd1], 7;
    fence.proxy.alias; // @WFENCE
    ld.global.u32 %r2, [%rd2];
    st.global.u32 [%rd3], %r2;
    st.release.sys.global.u32 [%rd1+64], 9;
    fence.proxy.alias; // @SFENCE
    ld.acquire.sys.global.u32 %r3, [%rd2+64];
    st.global.u32 [%rd3+4], %r3;
    st.global.u32 [%rd1+128], 11;
    fence.proxy.alias; // @PFENCE
    st.release.sys.global.u32 [%rd1+192], 1;
    bra DONE;
CONSUMER:
    fence.proxy.alias; // @CFENCE
POLL:
    ld.acquire.sys.global.u32 %r4, [%rd2+192];
    setp.lt.u32 %p2, %r4, 1;
    @%p2 bra POLL;
    ld.global.u32 %r5, [%rd2+128];
    st.global.u32 [%rd3+8], %r5;
DONE:
    ret;
}
