// E-CLOCK: a clock-derived store address (clock.rs `clock_effects`). Thread 0 stores 1 to
// out[0] or out[1], chosen by bit 2 of %clock; the model reads the clock as 0 and would always
// store out[0], while GB300 stores either. A control operand derived from the clock is not
// modeled: unmodeled on both fronts, never clean with one output.
//   good: bit 2 of %clock picks the word.
//   SELP: a select on a clock comparison picks the word.
//   CONST: the same store at a constant offset (no clock): clean.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_clock_addr(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u32 %r2, %clock;
    and.b32 %r3, %r2, 4;                 // @OFF
    cvt.u64.u32 %rd2, %r3;
    add.s64 %rd3, %rd1, %rd2;
    mov.u32 %r4, 1;
    st.global.u32 [%rd3], %r4;
DONE:
    ret;
}
