// E-CPASYNC, SASS cp.async scoreboard: lanes of one warp on two divergent paths, each with its
// own copy, commit and wait (ptxas: LDGSTS, LDGDEPBAR, DEPBAR.LE SB0 on each path). The even
// lanes spin on a flag the odd lanes set after their wait, so the odd path's DEPBAR retires
// the even lanes' copies too (the scoreboard counts the warp's commits). The even lanes'
// own DEPBAR then has nothing left to retire; it still orders their read after their copy.
//   good: each lane reads its own slot after its path's wait: clean.
//   NOWAIT: the even path has no wait: its read races with its copy.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cpasync_div_wait(.param .u64 out_p, .param .u64 in_p)
{
    .shared .align 16 .b8 slot[128];
    .shared .align 4 .u32 flag;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, slot;
    mov.u32 %r8, flag;
    shl.b32 %r3, %r1, 2;
    add.u32 %r4, %r2, %r3;
    cvt.u64.u32 %rd3, %r3;
    add.u64 %rd4, %rd2, %rd3;
    add.u64 %rd5, %rd1, %rd3;
    setp.ne.u32 %p3, %r1, 0;
    @%p3 bra INIT_DONE;
    st.volatile.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    and.b32 %r5, %r1, 1;
    setp.ne.u32 %p1, %r5, 0;
    @%p1 bra ODD;
    cp.async.ca.shared.global [%r4], [%rd4], 4;
    cp.async.commit_group;
SPIN:
    ld.volatile.shared.u32 %r9, [%r8];
    setp.eq.u32 %p2, %r9, 0;
    @%p2 bra SPIN;
    cp.async.wait_group 0;                         // @WAIT
    ld.shared.u32 %r6, [%r4];
    st.global.u32 [%rd5], %r6;
    bra DONE;
ODD:
    cp.async.ca.shared.global [%r4], [%rd4], 4;
    cp.async.commit_group;
    cp.async.wait_group 0;
    ld.shared.u32 %r7, [%r4];
    add.u32 %r7, %r7, 100;
    st.global.u32 [%rd5], %r7;
    st.volatile.shared.u32 [%r8], 1;
DONE:
    ret;
}
