// Generic f16x2 / bf16x2 atomic adds on a local-memory address (ptxas emits a non-atomic
// LD / integer add / ST fallback for the local window).
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pin, .param .u64 pout)
{
  .local .align 4 .b8 buf[16];
  .reg .b32 %r<16>; .reg .b64 %rd<8>;
  ld.param.u64 %rd1, [pin];
  ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1;
  cvta.to.global.u64 %rd2, %rd2;
  ld.global.u32 %r1, [%rd1];      // initial word
  ld.global.u32 %r2, [%rd1+4];    // addend
  mov.u64 %rd3, buf;
  st.local.u32 [%rd3], %r1;
  st.local.u32 [%rd3+4], %r1;
  cvta.local.u64 %rd4, %rd3;
  atom.add.noftz.f16x2 %r3, [%rd4], %r2;
  atom.add.noftz.bf16x2 %r4, [%rd4+4], %r2;
  ld.local.u32 %r5, [%rd3];
  ld.local.u32 %r6, [%rd3+4];
  st.global.u32 [%rd2], %r3;
  st.global.u32 [%rd2+4], %r5;
  st.global.u32 [%rd2+8], %r4;
  st.global.u32 [%rd2+12], %r6;
  ret;
}
