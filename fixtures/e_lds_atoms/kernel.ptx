// LDS vs ATOMS (S-SMEM-STRONG): warp 0's lane 0 folds 2 into a shared word with
// red.relaxed.shared::cta.or (SASS ATOMS.OR), warp 1's lane 0 reads the word with a plain
// ld.shared (SASS LDS) and writes it out. The word starts at 1 (set before a bar.sync).
//   good: a bar.sync 1, 64 orders the fold before the read (clean, out = 3)
//   LA1 : no barrier (PTX: a data race; SASS: LDS and ATOMS are both strong at CTA scope, so
//         no race, only a schedule-dependent output: nondeterministic)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_lds_atoms(.param .u64 out_p)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 word;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, word;
    setp.ne.u32 %p0, %r1, 0;
    @%p0 bra INIT_DONE;
    mov.u32 %r3, 1;
    st.shared.u32 [%r2], %r3;
INIT_DONE:
    bar.sync 0;
    and.b32 %r4, %r1, 31;
    setp.ne.u32 %p1, %r4, 0;
    setp.ge.u32 %p2, %r1, 32;
    @%p2 bra READER;
    @%p1 bra FOLDED;
    mov.u32 %r5, 2;
    red.relaxed.cta.shared::cta.or.b32 [%r2], %r5;
FOLDED:
    bar.arrive 1, 64;                    // @ARRIVE
    bra DONE;
READER:
    bar.sync 1, 64;                      // @SYNC
    @%p1 bra DONE;
    ld.shared.u32 %r6, [%r2];
    st.global.u32 [%rd1], %r6;
DONE:
    ret;
}
