.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 flag, .param .u64 output) {
 .reg .b64 %p<2>;
 .reg .b32 %id, %v, %result;
 .reg .pred %producer, %pending, %retry;
 ld.param.u64 %p0, [flag];
 ld.param.u64 %p1, [output];
 mov.u32 %id, %ctaid.x;
 setp.eq.u32 %producer, %id, 0;
 @%producer bra PRODUCER;
 mov.b32 %result, 0;
LOOP:
 ld.acquire.gpu.global.u32 %v, [%p0];
 setp.eq.u32 %pending, %v, 2;
 @%pending mov.b32 %result, 0f40000000; // @RESULT
 setp.ne.u32 %retry, %v, 1;
 @%retry bra LOOP;
 st.global.b32 [%p1], %result;
 ret;
PRODUCER:
 st.release.gpu.global.u32 [%p0], 1;
 ret;
}
