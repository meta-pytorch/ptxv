// fixtures/e_clock_data (E-CLOCK): thread 0 stores selp(%clock64 - t0 > 1000, 1, 2) to out[0]
// with a load between the two clock reads. The stored value depends on timing through data
// only (a select, not explored both ways): the verdict must not claim one output for every
// timing, so it is incomplete with a "clock-dependent output" note.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_clock_data(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u64 %rd2, %clock64;
    ld.volatile.global.u32 %r2, [%rd1+4];
    mov.u64 %rd3, %clock64;
    sub.s64 %rd4, %rd3, %rd2;
    setp.gt.s64 %p2, %rd4, 1000;
    selp.u32 %r3, 1, 2, %p2;
    add.u32 %r3, %r3, %r2;
    st.global.u32 [%rd1], %r3;
DONE:
    ret;
}
