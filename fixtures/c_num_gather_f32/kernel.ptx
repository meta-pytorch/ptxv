// fixtures/c_num_gather_f32 (N-NUM-TRACK): addresses and a shuffle lane computed from a rounded
// value. Thread t (32 threads) reads x, y, z [t]; i = trunc(rn(x*y)). In even lanes x*y lies just
// below 1 and rounds to 1: i = 1, while the exact computation has i = 0.
//   out[t]           = z[(t + i) & 31]                 (a gather)
//   out[32 + t]      = shfl.idx(z, (t + i) & 31)       (a shuffle)
//   out[64 + t + 32 i] = x[t]                          (a scatter; the other slot keeps 0)
// `ptxv num` follows this run's addresses; the exact computation reads and writes others.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry c_num_gather_f32(
	.param .u64 px,
	.param .u64 py,
	.param .u64 pz,
	.param .u64 pout
)
{
	.reg .b32 %r<16>;
	.reg .f32 %f<16>;
	.reg .b64 %rd<16>;

	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [py];
	ld.param.u64 %rd3, [pz];
	ld.param.u64 %rd4, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	cvta.to.global.u64 %rd4, %rd4;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd6, %rd1, %rd5;
	ld.global.f32 %f1, [%rd6];
	add.s64 %rd6, %rd2, %rd5;
	ld.global.f32 %f2, [%rd6];
	add.s64 %rd6, %rd3, %rd5;
	ld.global.f32 %f3, [%rd6];
	add.s64 %rd7, %rd4, %rd5;
	mul.rn.f32 %f4, %f1, %f2;
	cvt.rzi.s32.f32 %r2, %f4;
	min.s32 %r2, %r2, 1;
	add.s32 %r3, %r1, %r2;
	and.b32 %r3, %r3, 31;
	mul.wide.u32 %rd8, %r3, 4;
	add.s64 %rd9, %rd3, %rd8;
	ld.global.f32 %f5, [%rd9];
	st.global.f32 [%rd7], %f5;
	shfl.sync.idx.b32 %f6, %f3, %r3, 31, -1;
	st.global.f32 [%rd7+128], %f6;
	mul.wide.s32 %rd10, %r2, 128;
	add.s64 %rd11, %rd7, %rd10;
	st.global.f32 [%rd11+256], %f1;
	ret;
}
