// E-CLOCK MISS 78 follow-up: a wrap-unsafe 32-bit deadline. deadline = %clock + 2^31 (u32),
// trap when %clock > deadline. hang_bound_holds samples starts {0, 2^33, 2^50}, whose low 32 bits
// are all 0, so the deadline never wraps in the proof and the guard is exempt. On hardware
// %clock's start is anywhere in [0, 2^32): for starts >= 2^31 the deadline wraps below the start
// and the first poll traps.
//   good: wrap-unsafe compare (deadline).
//   SAFE: wrap-safe compare (now - start > 2^31): really a >= 2^31 bound.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_clock_hang_wrap(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra READER;
    nanosleep.u32 200000;
    mov.u32 %r2, 7;
    st.global.u32 [%rd1+4], %r2;
    mov.u32 %r3, 1;
    st.release.gpu.global.u32 [%rd1+8], %r3;
    bra DONE;
READER:
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
    mov.u32 %r10, %clock;
    add.u32 %r11, %r10, 0x80000000;
POLL:
    ld.acquire.gpu.global.u32 %r4, [%rd1+8];
    setp.ne.u32 %p3, %r4, 0;
    @%p3 bra READ;
    mov.u32 %r12, %clock;
    setp.gt.u32 %p4, %r12, %r11;         // @CMP
    @%p4 bra TIMEOUT;
    bra POLL;
TIMEOUT:
    trap;
READ:
    ld.global.u32 %r5, [%rd1+4];
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
