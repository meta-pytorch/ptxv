// Register membermask shfl.sync: each half-warp shuffles within its own half.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pout)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<6>;
    .reg .pred %p<3>;
    ld.param.u64 %rd1, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r2, %r1, 7;
    add.u32 %r2, %r2, 100;
    setp.lt.u32 %p1, %r1, 16;
    selp.b32 %r5, 0x0000ffff, 0xffff0000, %p1;   // @MASK
    xor.b32 %r4, %r1, 1;                         // @SRC
    mov.u32 %r3, 0;
    setp.ge.u32 %p2, %r1, 30;                    // @EXIT
    @%p2 bra DONE;
    shfl.sync.idx.b32 %r3, %r2, %r4, 31, %r5;
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
DONE:
    ret;
}
