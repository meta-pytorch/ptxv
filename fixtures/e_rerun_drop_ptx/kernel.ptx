// Rerun-drop probe, PTX front (tc_fence_contract keeps only level-1 race signatures). Warps 0,
// 4 and 8 share TMEM lane quadrant 0. Warp X loads column 0, waits, and meets warp 8 at named
// barrier 1 with no tcgen05 thread-sync fences (a race, ordered once the fences are implied,
// E-TC-FENCE-NOP). Warp Y loads column 0, waits, and raises a relaxed flag that warp 8 polls
// (a race with or without the fences). Warp 8 then stores column 0. tmem_access reported one
// racer per access, the lowest actor (MISS 122); it reports every racer now.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_rerun_drop_ptx(
    .param .u64 dst_ptr
)
.maxntid 384, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .shared .align 16 .b32 slot;
    .shared .align 4 .b32 f1;

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;
    mov.u32         %r2, slot;
    mov.u32         %r11, f1;
    setp.ne.u32     %p0, %r1, 0;
    @%p0 bra        SKIP_ALLOC;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r2], 32;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
    st.shared.u32   [%r11], 0;
SKIP_ALLOC:
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    ld.shared.b32   %r3, [%r2];
    and.b32         %r4, %r1, 3;
    shl.b32         %r4, %r4, 21;
    add.u32         %r5, %r3, %r4;
    setp.lt.u32     %p1, %r1, 4;
    @!%p1 bra       NOINIT;
    add.u32         %r6, %r0, 100;
    tcgen05.st.sync.aligned.32x32b.x1.b32 [%r5], {%r6};
    tcgen05.wait::st.sync.aligned;
NOINIT:
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    mov.u32         %r12, 0;                        // @XW X warp
    mov.u32         %r13, 4;                        // @YW Y warp
    setp.eq.u32     %p2, %r1, %r12;
    @!%p2 bra       NOTX;
    tcgen05.ld.sync.aligned.32x32b.x1.b32 {%r7}, [%r5];
    tcgen05.wait::ld.sync.aligned;
    bar.sync        1, 64;
    bra             OUT;
NOTX:
    setp.eq.u32     %p3, %r1, %r13;
    @!%p3 bra       NOTY;
    tcgen05.ld.sync.aligned.32x32b.x1.b32 {%r7}, [%r5];
    tcgen05.wait::ld.sync.aligned;
    st.relaxed.cta.shared.u32 [%r11], 1;
    bra             OUT;
NOTY:
    setp.ne.u32     %p4, %r1, 8;
    @%p4 bra        DONE;
    bar.sync        1, 64;
POLL1:
    ld.relaxed.cta.shared.u32 %r15, [%r11];
    setp.ne.u32     %p6, %r15, 1;
    @%p6 bra        POLL1;
    add.u32         %r16, %r0, 200;
    tcgen05.st.sync.aligned.32x32b.x1.b32 [%r5], {%r16};
    tcgen05.wait::st.sync.aligned;
    mov.u32         %r7, %r16;
OUT:
    ld.param.u64    %rd0, [dst_ptr];
    cvta.to.global.u64 %rd1, %rd0;
    mul.wide.u32    %rd2, %r0, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.b32   [%rd3], %r7;
DONE:
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    @%p0 bra        FIN;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r3, 32;
FIN:
    ret;
}
