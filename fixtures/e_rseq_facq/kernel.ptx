// S-SCOPE, release sequences (MISS 112), the acquire side: the last operation of an acquire
// pattern (a fence) must be morally strong with the first operation of the release pattern
// (PTX ISA 9.5 section 8.9.4), not with the read-modify-write that continued it.
// CTA 0 t0: data = 7; st.release.gpu [f] = 1 (W).
// CTA 1 t32: spins ld.relaxed.gpu [f] until 1; atom.relaxed.gpu.add [f], 1 (Z).
// CTA 1 t0: spins ld.relaxed.gpu [f] until 2; fence.acq_rel.gpu (the acquire pattern's last
//   operation); reads data.
//   good: the .gpu fence includes CTA 0's t0: clean.
//   CTAFENCE: fence.acq_rel.cta does not include CTA 0's t0: no synchronization, a race (the
//             SASS front: ptxas emits no CCTL.IVALL for a .cta acquire, a race as well).
//   DIRECT: control, the .cta fence and no Z (R polls until 1): race.
//   CTAACQ: t32 signals t0 (st.release.cta) after Z; t0 waits for it, then reads f with
//           ld.acquire.cta and no fence, so it reads Z's value only: R and Z are morally strong
//           (CTA 1), but the acquire's .cta scope does not include CTA 0's t0: race.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry rseq_facq(.param .u64 out_p)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra CTA1;
    setp.ne.u32 %p3, %r1, 0;
    @%p3 bra DONE;
    mov.u32 %r3, 7;
    st.global.u32 [%rd1], %r3;
    mov.u32 %r4, 1;
    st.release.gpu.global.u32 [%rd1+4], %r4;
    bra DONE;
CTA1:
    setp.eq.u32 %p2, %r1, 32;
    @%p2 bra TZ;
    setp.ne.u32 %p5, %r1, 0;
    @%p5 bra DONE;
R:
    ld.relaxed.gpu.global.u32 %r5, [%rd1+4];      // @RLOAD
    setp.ne.u32 %p4, %r5, 2;                       // @RCHK
    @%p4 bra R;                                    // @RBRA
    fence.acq_rel.gpu;                             // @FENCE
    ld.global.u32 %r6, [%rd1];
    st.global.u32 [%rd1+12], %r6;
    bra DONE;
TZ:
    ld.relaxed.gpu.global.u32 %r9, [%rd1+4];
    setp.eq.u32 %p6, %r9, 0;
    @%p6 bra TZ;
    atom.relaxed.gpu.global.add.u32 %r8, [%rd1+4], 1;   // @Z
DONE:
    ret;
}
