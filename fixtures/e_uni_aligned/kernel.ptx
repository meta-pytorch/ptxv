// `.uni` and barrier.cluster `.aligned` contracts. A cluster of 2 CTAs of 64 threads.
//   good: `@%p1 bra.uni` with %p1 = (warp id == 0), uniform in each warp; every thread runs
//         barrier.cluster.arrive.release.aligned / wait.acquire.aligned together.
//   unidiv: %p1 = (tid < 16): lanes of warp 0 disagree on the bra.uni guard (contract).
//   aligndiv: lanes 0..15 of each warp run their own copy of the aligned arrive (two
//             UCGABAR_ARV for one warp after ptxas's WARPSYNC.ALL): violation.
//   alignguard: the aligned wait guarded off in lanes 0..15: violation.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 pout)
.reqnctapercluster 2, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    shr.u32         %r2, %r1, 5;                    // warp id
    and.b32         %r3, %r1, 31;                   // lane
    mov.u32         %r4, %ctaid.x;
    mad.lo.u32      %r5, %r4, 64, %r1;
    setp.eq.u32     %p1, %r2, 0;                    // @UNI
    setp.lt.u32     %p2, %r3, 16;
    setp.eq.u32     %p3, %r1, %r1;                  // @G3
    mov.u32         %r6, 1;
    @%p1 bra.uni    WARP0;
    mov.u32         %r6, 2;
WARP0:
    bra             ARRIVE;                         // @DIV
    @%p2 bra        LOW;
ARRIVE:
    barrier.cluster.arrive.release.aligned;
    bra             WAIT;
LOW:
    barrier.cluster.arrive.release.aligned;
WAIT:
    @%p3 barrier.cluster.wait.acquire.aligned;
    mul.wide.u32    %rd2, %r5, 4;
    add.s64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r6;
    ret;
}
