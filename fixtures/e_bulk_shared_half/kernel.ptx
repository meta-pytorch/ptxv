.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 input, .param .u64 output) {
    .shared .align 16 .b8 source[16];
    .shared .align 16 .b8 dest[16];
    .shared .align 8 .b64 barrier;
    .reg .b64 %p<2>;
    .reg .b32 %r<8>;
    .reg .f32 %f;
    .reg .pred %done;
    ld.param.u64 %p0, [input];
    ld.param.u64 %p1, [output];
    ld.volatile.global.f32 %f, [%p0];
    cvt.rn.bf16x2.f32 %r4, %f, %f;
    mov.u32 %r2, source;
    mov.u32 %r3, dest;
    mov.u32 %r6, barrier;
    st.shared.b32 [%r2], %r4; // @RESULT
    st.shared.b32 [%r2+4], 0;
    st.shared.b32 [%r2+8], 0;
    st.shared.b32 [%r2+12], 0;
    mbarrier.init.shared::cta.b64 [%r6], 1;
    fence.mbarrier_init.release.cluster;
    fence.proxy.async.shared::cta;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r6], 16;
    cp.async.bulk.shared::cluster.shared::cta.mbarrier::complete_tx::bytes [%r3], [%r2], 16, [%r6];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %done, [%r6], 0;
    @!%done bra WAIT;
    ld.shared.b32 %r4, [%r3];
    mov.b32 %r0, 0x3f803f80;
    mul.bf16x2 %r5, %r4, %r0;
    shl.b32 %r7, %r5, 16;
    st.global.b32 [%p1], %r7;
    ret;
}
