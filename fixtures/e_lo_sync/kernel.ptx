// Two lanes of one converged warp each store data[lane], then perform one acq_rel atom.add on
// one word (result dead), then lane 1 reads data[0], lane 0's store. Under the PTX model the
// lanes are threads: where lane 1's atomic precedes lane 0's in coherence order, lane 1 does
// not acquire lane 0's release, and its read races with lane 0's store. MISS 74's lane orders
// take a dead-result integer add as commuting (lane order only), so lane 1 always acquires
// lane 0's release. Variants: LIVE uses the atomic's result (every order explored); LANE0
// lets lane 0 read data[1] (the race in lane order, control).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_lo_sync(.param .u64 pdata, .param .u64 psem, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [psem];
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    add.u32 %r2, %r1, 100;
    mul.wide.u32 %rd4, %r1, 4;
    add.s64 %rd5, %rd1, %rd4;
    st.global.u32 [%rd5], %r2;
    atom.acq_rel.gpu.global.add.u32 %r3, [%rd2], 1;   // @ATOM
    mov.u32 %r6, 0;                                   // @USE
    setp.ne.u32 %p1, %r1, 1;                          // @WHO
    @%p1 bra DONE;
    sub.u32 %r5, 1, %r1;
    mul.wide.u32 %rd7, %r5, 4;
    add.s64 %rd8, %rd1, %rd7;
    ld.global.u32 %r4, [%rd8];
    add.u32 %r4, %r4, %r6;
    add.s64 %rd6, %rd3, %rd4;
    st.global.u32 [%rd6], %r4;
DONE:
    ret;
}
