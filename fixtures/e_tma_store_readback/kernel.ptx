// E-ASYNC-STEP / S-TMA: a thread reads back, through the generic proxy, a global element its
// own TMA store (cp.async.bulk.tensor ... bulk_group) wrote. 128 threads fill a 32x32 f32 tile;
// thread 0 stores it to D and then loads D[0][5] into out[0].
//   good: cp.async.bulk.wait_group 0 before the load (the store's writes are complete): out = 5.
//   READ: cp.async.bulk.wait_group.read 0: only the store's shared-memory reads are complete
//         (PTX ISA); its global writes may still be in flight, so the load races with them.
//   NOWAIT: no wait at all: the load races with the store's writes.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_tma_store_readback(
    .param .align 64 .b8 tmap[128],
    .param .u64 out_p,
    .param .u64 d_p
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<4>;
    .reg .f32   %f<2>;
    .shared .align 1024 .b8 tile[4096];

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, tile;
    mov.u32         %r2, %r0;
    mov.u32         %r5, 1024;
LOOP:
    cvt.rn.f32.u32  %f0, %r2;
    shl.b32         %r3, %r2, 2;
    add.u32         %r4, %r1, %r3;
    st.shared.f32   [%r4], %f0;
    add.u32         %r2, %r2, 128;
    setp.lt.u32     %p1, %r2, %r5;
    @%p1 bra        LOOP;
    fence.proxy.async.shared::cta;
    bar.sync        0;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        DONE;
    mov.b64         %rd0, tmap;
    cvta.param.u64  %rd1, %rd0;
    mov.u32         %r6, 0;
    cp.async.bulk.tensor.2d.global.shared::cta.bulk_group [%rd1, {%r6, %r6}], [%r1];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;                                 // @WAIT
    ld.param.u64    %rd2, [d_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.global.f32   %f1, [%rd2+20];
    ld.param.u64    %rd3, [out_p];
    cvta.to.global.u64 %rd3, %rd3;
    st.global.f32   [%rd3], %f1;
DONE:
    ret;
}
