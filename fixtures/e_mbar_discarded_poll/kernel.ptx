// RMK4 round 2, B1 (MISS 272): an mbarrier poll whose result is discarded (ptxas: SYNCS.PHASECHK.TRANS64 PT,
// which the SASS lifter turns into Op::Nop, sass/src/lib.rs, E-SPIN) on an object that is not
// live: never initialized (good), or invalidated after a uniform init, so its bytes hold no state
// word and MISS 266's revival cannot apply (INV). USED: the result is stored (control).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_mbar_discarded_poll(.param .u64 out_p)
.maxntid 32, 1, 1
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b8 a[8];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, a;
    setp.ne.u32 %p2, %r1, 0;
    // @PRE
    @%p2 bra DONE;
    mbarrier.test_wait.parity.shared::cta.b64 %p6, [%r2], 0;
    mov.u32 %r9, 1;                                             // @POLL
    st.global.u32 [%rd1], %r9;
DONE:
    ret;
}
