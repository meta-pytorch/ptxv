// S-SCOPE, complete overlap (PTX ISA 9.5 section 8.7: two memory operations are morally strong
// only if they overlap completely). Thread 0 writes data (plain) and releases a u32 flag
// (st.release.gpu); thread 32 polls the flag with an acquire load and then reads the data
// (plain).
//   good:  u32 acquire: the same location as the release, synchronized, clean.
//   MIXED: u8 acquire of the flag's first byte: the two overlap partially, so they are not
//          morally strong: the flag accesses are a mixed-size data race (8.7.2) and the acquire
//          does not synchronize (observation order runs along morally strong pairs, 8.9.2), so
//          the data read races too.
//   WIDE:  u64 acquire covering the flag and the next word: partial overlap the other way.
//   VEC:   v2.u32 relaxed load, then fence.acq_rel.gpu: a vector access is one operation per
//          element (8.2.4), and its first element is the flag's location: clean.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_scope_mixed(.param .u64 out_p)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra READER;
    mov.u32 %r2, 7;
    st.global.u32 [%rd1+4], %r2;
    mov.u32 %r3, 1;
    st.release.gpu.global.u32 [%rd1+8], %r3;
    bra DONE;
READER:
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
POLL:
    ld.acquire.gpu.global.u32 %r4, [%rd1+8];      // @LD
    setp.eq.u32 %p3, %r4, 0;
    @%p3 bra POLL;
    ld.global.u32 %r5, [%rd1+4];
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
