// Input coverage with the PTX predicate %p7 (coverage.rs): each thread loads an input word,
// stores it, and stores it again under `@%p7` where %p7 = (word != 0). The guard derives
// from the input, so the kernel is input-dependent. SASS's P7 is the constant PT, but the PTX
// front's %p7 is an ordinary register: until 2026-11-08 coverage treated it as constant and
// called the PTX kernel input-independent (SASS was right).
//   P4: the same with %p4
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cov_pt(.param .u64 out_p, .param .u64 in_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.u32 %r3, [%rd4];
    add.u64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r3;
    setp.ne.b32 %p7, %r3, 0;              // @SET
    @%p7 st.global.b32 [%rd5+128], %r3;   // @USE
    ret;
}
