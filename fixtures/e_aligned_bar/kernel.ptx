// E-ALIGNED for named barriers: warp 0 and warp 1 meet at named barrier 1 (64 threads).
// Warp 0 branches on lane < 16 first.
//   good: both halves of warp 0 rejoin and run one bar.sync (one pc): clean
//   AB1 : the halves run two different bar.sync 1, 64 instructions: a divergent aligned
//         barrier (violation; GB300 hangs)
//   AB2 : as AB1 with the non-aligned barrier.sync (legal in a divergent warp: clean on
//         GB300; SASS: ptxas's BRA.DIV + WARPSYNC.COLLECTIVE.ALL slow path)
//   AB3 : lanes 16-31 of warp 0 skip the joined bar.sync with a guard (violation)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_aligned_bar(.param .u64 out_p)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    mov.u32 %r3, 1;
    setp.ge.u32 %p1, %r1, 32;
    @%p1 bra OTHER;
    setp.lt.u32 %p2, %r2, 16;
    @%p2 bra LOW;
    mov.u32 %r3, 2;
    bra JOIN;                    // @HIGH
LOW:
    mov.u32 %r3, 3;
JOIN:
    bar.sync 1, 64;              // @JOIN
    bra DONE;
OTHER:
    bar.sync 1, 64;              // @OTHER
DONE:
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
