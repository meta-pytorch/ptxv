// E-ELECT (PTX contract): the leader of elect.sync is "deterministic" for a membermask, but
// the ISA does not say which lane. This kernel is correct when the leader is lane 0 or lane 31
// and racy for every other leader: an end-lane leader stores out[1] before bar.sync 0, a
// middle-lane leader after it, where thread 32's read of out[1] races with it.
//   good: as above (racy under the ISA for 30 of the 32 possible leaders): race on PTX.
//   ENDS: the late store removed: race-free for every leader, output leader-dependent.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_elect_mid(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    mov.u32 %r7, 7;
    setp.eq.u32 %p2, %r2, 0;
    setp.eq.u32 %p3, %r2, 31;
    or.pred %p4, %p2, %p3;
    setp.ne.u32 %p6, %r1, %r1;           // false outside warp 0
    setp.lt.u32 %p5, %r1, 32;
    @!%p5 bra BAR;
    elect.sync %r9|%p1, -1;
    and.pred %p6, %p1, %p4;
    @%p6 st.global.u32 [%rd1+4], %r7;    // end-lane leader: before the barrier
    not.pred %p4, %p4;
    and.pred %p6, %p1, %p4;
BAR:
    bar.sync 0;
    @%p6 st.global.u32 [%rd1+4], %r7;    // @LATE middle-lane leader: after the barrier
    setp.ne.u32 %p7, %r1, 32;
    @%p7 bra DONE;
    ld.global.u32 %r3, [%rd1+4];
    st.global.u32 [%rd1], %r3;
DONE:
    ret;
}
