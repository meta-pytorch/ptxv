.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_equiv_cas_ref_cas(.param .u64 px, .param .u64 py, .param .u64 pout, .param .u64 pz)
{
    .reg .pred %p<4>;
    .reg .b16 %rs<8>;
    .reg .b32 %r<32>;
    .reg .f32 %f<24>;
    .reg .b64 %rd<32>;
    .local .align 8 .b8 L[64];
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd7, [py];
    ld.param.u64 %rd2, [pout];
    ld.param.u64 %rd15, [pz];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd7, %rd7;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd15, %rd15;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd3, %r0, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd8, %rd7, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    add.s64 %rd16, %rd15, %rd3;
    ld.global.f32 %f4, [%rd4];
    st.global.u32 [%rd16], 0;
    cvt.rzi.u32.f32 %r1, %f4;
    atom.global.cas.b32 %r2, [%rd16], %r1, 1;
    ld.volatile.global.u32 %r3, [%rd16];
    add.u32 %r4, %r0, %r3;
    and.b32 %r4, %r4, 31;
    mul.wide.u32 %rd20, %r4, 4;
    add.s64 %rd21, %rd7, %rd20;
    ld.global.f32 %f7, [%rd21];
    add.rn.f32 %f6, %f4, %f7;
    st.global.f32 [%rd5], %f6;
    ret;
}
