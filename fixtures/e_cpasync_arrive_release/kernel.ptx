// E-CPASYNC-MBAR, what the arrive-on releases: PTX ISA 9.5 8.9.1.1, "The asynchronous mbarrier
// arrive-on operation performed by a cp.async.mbarrier.arrive instruction is ordered with respect
// to the memory operations performed by all prior cp.async operations initiated by the same
// thread, but not to those of any other instruction issued by the thread."
// Thread 0 stores 0x42 to a word, copies in[0..3] into a shared slot with cp.async and arrives
// on mb with .noinc; thread 32 waits on mb (try_wait, acquire.cta), then reads the word into
// out[0] and slot word 1 into out[1].
//   good:    mb counts 2; thread 0 also arrives with a plain mbarrier.arrive (release): clean.
//   WHOLE:   mb counts 1, only the arrive-on; the store precedes the cp.async.
//   BETWEEN: WHOLE with the store between the cp.async and cp.async.mbarrier.arrive.
//   NOCP:    no cp.async at all: the arrive-on tracks nothing of the thread.
//   GLOBAL:  WHOLE with the word in global memory (st.global / ld.global).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cpasync_arrive_release(.param .u64 out_p, .param .u64 in_p, .param .u64 g_p)
{
    .shared .align 16 .b8 slot[16];
    .shared .align 8 .b64 mb;
    .shared .align 4 .b32 xw;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd4, [g_p];
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, slot;
    mov.u32 %r5, mb;
    mov.u32 %r8, xw;
    setp.ne.u32 %p1, %r1, 32;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r5], 2;     // @COUNT
INIT_DONE:
    bar.sync 0;
    @%p2 bra WAITER;
    mov.u32 %r3, 0x42;
    st.shared.u32 [%r8], %r3;     // @ST1
    cp.async.cg.shared.global [%r2], [%rd2], 16;     // @CP
    // @ST2
    cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%r5];
    mbarrier.arrive.shared::cta.b64 %rd3, [%r5];     // @REL
    bra DONE;
WAITER:
    @%p1 bra DONE;
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r5], 0;
    @!%p3 bra WAIT;
    ld.shared.u32 %r6, [%r8];     // @LD1
    st.global.u32 [%rd1], %r6;
    ld.shared.u32 %r7, [%r2+4];     // @LD2
    st.global.u32 [%rd1+4], %r7;
DONE:
    ret;
}
