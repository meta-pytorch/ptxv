.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 px, .param .u64 py)
{
    .reg .b16 %h<2>;
    .reg .b32 %r<12>;
    .reg .f32 %f<4>;
    .reg .b64 %rd<8>;
    .reg .pred %p<2>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [py];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %tid.x;
    mad.lo.u32 %r3, %r1, 256, %r2;
    mul.wide.u32 %rd3, %r3, 2;
    add.s64 %rd4, %rd1, %rd3;
    mul.wide.u32 %rd5, %r3, 4;
    add.s64 %rd6, %rd2, %rd5;
    ld.global.b16 %h1, [%rd4];
    cvt.f32.bf16 %f1, %h1;
    mov.b32 %r4, %f1;
    add.s32 %r5, %r4, 1073741824;
    setp.eq.s32 %p1, %r4, -1073741824;
    selp.b32 %r6, -2147483648, %r5, %p1;
    mov.b32 %f2, %r6;
    st.global.f32 [%rd6], %f2;
    ret;
}
