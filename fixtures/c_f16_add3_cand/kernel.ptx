//
// out[i] = f16(sum of x, y, z), x, y, z f32 (docs/equiv-mma.md, 16-bit outputs).
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry add3(
	.param .u64 px,
	.param .u64 py,
	.param .u64 pz,
	.param .u64 pout
)
.reqntid 128, 1, 1
{
	.reg .b32 	%r<4>;
	.reg .f32 	%f<6>;
	.reg .b16 	%rs<2>;
	.reg .b64 	%rd<10>;

	ld.param.u64 	%rd1, [px];
	ld.param.u64 	%rd2, [py];
	ld.param.u64 	%rd3, [pz];
	ld.param.u64 	%rd4, [pout];
	mov.u32 	%r1, %tid.x;
	mov.u32 	%r2, %ctaid.x;
	mad.lo.s32 	%r3, %r2, 128, %r1;
	mul.wide.s32 	%rd5, %r3, 4;
	add.s64 	%rd6, %rd1, %rd5;
	ld.global.f32 	%f1, [%rd6];
	add.s64 	%rd7, %rd2, %rd5;
	ld.global.f32 	%f2, [%rd7];
	add.s64 	%rd8, %rd3, %rd5;
	ld.global.f32 	%f3, [%rd8];
	add.f32 %f4, %f2, %f3;
	add.f32 %f5, %f1, %f4;
	cvt.rn.f16.f32 	%rs1, %f5;
	mul.wide.s32 	%rd5, %r3, 2;
	add.s64 	%rd9, %rd4, %rd5;
	st.global.b16 	[%rd9], %rs1;
	ret;
}
