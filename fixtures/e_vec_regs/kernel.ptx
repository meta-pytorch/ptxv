//
// PTX vector operands are consecutive virtual registers, one per element. Every analysis that
// asks an instruction for the registers it writes or reads (`Op::dst_regs` / `src_regs`) must
// see all of them: before, `ld.global.v4.u32 {%r1, %r2, %r3, %r4}` reported %r1 four times,
// so %r4 kept its old provenance (the constant 0 below; input coverage and the input-data
// taint saw no input in it) and the constant-guard analysis folded the branch on it.
// Element 4 is compared, used in an address and in a branch; the vector store reads two
// elements; mma.sync writes four registers.
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry vec_regs(
	.param .u64 in_ptr,
	.param .u64 out_ptr
)
.reqntid 32
{
	.reg .pred %p<4>;
	.reg .b32 %r<40>;
	.reg .f32 %f<20>;
	.reg .b64 %rd<20>;

	ld.param.u64 %rd1, [in_ptr];
	ld.param.u64 %rd2, [out_ptr];
	mov.u32 %r0, %tid.x;
	mul.wide.u32 %rd3, %r0, 16;
	add.s64 %rd4, %rd1, %rd3;
	mov.u32 %r4, 0; // @CONST
	ld.global.v4.u32 {%r1, %r2, %r3, %r4}, [%rd4];
	setp.ne.u32 %p1, %r4, 0;
	shr.u32 %r5, %r4, 2;
	and.b32 %r5, %r5, 31;
	mul.wide.u32 %rd5, %r5, 8;
	add.s64 %rd6, %rd2, %rd5;
	st.global.v2.u32 [%rd6], {%r2, %r3};
	// @MMA
	@%p1 bra DONE;
	st.global.u32 [%rd6+4], %r1;
DONE:
	ret;
}
