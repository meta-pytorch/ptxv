// Rung 1e fixture: a pair of kernels with programmatic dependent launch (PDL).
//
//   produce (2 CTAs x 32): buf[i] = 3 * in[i] + 1. The "mainloop" reads in[i]; then the CTA
//     triggers the dependent launch (griddepcontrol.launch_dependents, where CUTLASS calls
//     launch_dependent_grids: after the mainloop, before the epilogue); the epilogue stores
//     buf[i].
//   consume (2 CTAs x 32, launched with programmatic stream serialization): its prologue runs
//     concurrently with produce's epilogue. After griddepcontrol.wait it resets in[i] for the
//     next step (in is produce's input) and computes out[i] = 2 * buf[i] + 100.
//
// Mutants (case.toml): B18 consume has no griddepcontrol.wait; B55 consume resets in[] before
// the wait (a write-after-read hazard across the two kernels).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry produce(.param .u64 in_ptr, .param .u64 buf_ptr)
.maxntid 32, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, %ctaid.x;
    shl.b32         %r2, %r1, 5;
    add.u32         %r3, %r2, %r0;                  // i
    mul.wide.u32    %rd0, %r3, 4;
    ld.param.u64    %rd1, [in_ptr];
    cvta.to.global.u64 %rd2, %rd1;
    add.u64         %rd3, %rd2, %rd0;
    ld.global.u32   %r4, [%rd3];                    // mainloop
    mul.lo.u32      %r5, %r4, 3;
    add.u32         %r5, %r5, 1;
    griddepcontrol.launch_dependents;
    ld.param.u64    %rd4, [buf_ptr];                // epilogue
    cvta.to.global.u64 %rd5, %rd4;
    add.u64         %rd6, %rd5, %rd0;
    st.global.u32   [%rd6], %r5;
    ret;
}

.visible .entry consume(.param .u64 in_ptr, .param .u64 buf_ptr, .param .u64 out_ptr)
.maxntid 32, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;

    mov.u32         %r0, %tid.x;                    // prologue (overlaps produce's epilogue)
    mov.u32         %r1, %ctaid.x;
    shl.b32         %r2, %r1, 5;
    add.u32         %r3, %r2, %r0;                  // i
    mul.wide.u32    %rd0, %r3, 4;
    ld.param.u64    %rd1, [in_ptr];
    cvta.to.global.u64 %rd2, %rd1;
    add.u64         %rd3, %rd2, %rd0;
    ld.param.u64    %rd4, [buf_ptr];
    cvta.to.global.u64 %rd5, %rd4;
    add.u64         %rd6, %rd5, %rd0;
    mov.u32         %r4, 0;
    griddepcontrol.wait;                                            // @B18
    st.global.u32   [%rd3], %r4;                    // reset in[i] for the next step
    ld.global.u32   %r5, [%rd6];
    shl.b32         %r6, %r5, 1;
    add.u32         %r6, %r6, 100;
    ld.param.u64    %rd7, [out_ptr];
    cvta.to.global.u64 %rd8, %rd7;
    add.u64         %rd9, %rd8, %rd0;
    st.global.u32   [%rd9], %r6;
    ret;
}
