// The high half-warp runs a loop, then the whole warp exchanges through one shfl.sync (fixtures/e_warpcoll_split).
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pout, .param .u32 n)
{
    .reg .b32 %r<12>;
    .reg .b64 %rd<6>;
    .reg .pred %p<3>;
    ld.param.u64 %rd1, [pout];
    ld.param.u32 %r6, [n];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r2, %r1, 7;
    add.u32 %r2, %r2, 100;
    xor.b32 %r4, %r1, 16;
    setp.lt.u32 %p1, %r1, 16;
    @%p1 bra J;
    mov.u32 %r7, 0;
LOOP:
    mul.lo.u32 %r2, %r2, 3;
    add.u32 %r2, %r2, 1;
    add.u32 %r7, %r7, 1;
    setp.lt.u32 %p2, %r7, %r6;
    @%p2 bra LOOP;
J:
    shfl.sync.idx.b32 %r3, %r2, %r4, 31, -1;
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
