// E-BAR-CUT fixture: a counted named barrier whose other users can reach it only through an
// all-thread barrier. 128 threads, two rounds. In round r the active pair is warps 2r and
// 2r+1: the even warp writes buf[lane] = (lane + r + 1) * 0x01010101 in shared memory and runs
// `bar.sync 2, 64`; the odd warp runs `bar.sync 2, 64`, then copies buf[lane] to
// out[32r + lane]. Every warp then meets the others at `bar.sync 1` (all threads). The round
// counter decides the roles, so every warp can reach barrier 2 from anywhere in the loop: 128
// threads for a count of 64. Only through `bar.sync 1`, though, which cannot complete while
// the active pair is parked in barrier 2.
//   good: as above
//   BC1 : the inactive pair skips `bar.sync 1` in its round (a path to barrier 2 around the
//         all-thread barrier): warps 2 and 3 can meet warps 0 and 1 at barrier 2, and a
//         generation of a producer with the wrong consumer races.
//   BC2 : `bar.sync 1` guarded off for the upper half-warp of the inactive pair (the
//         non-aligned `barrier.sync`): those lanes reach barrier 2 around it.
//   BC3 : the active pair arrives at barrier 1 with `bar.arrive` before its work and does
//         not wait there: the inactive pair is released while the active pair is still in
//         barrier 2, and meets it there.
//   BC4 : the all-thread barrier uses id 2, the counted barrier's id.
//   BC5 : lanes 16-31 of the producer warp skip barrier 2 (`barrier.sync`) and wait at the
//         all-thread barrier while lanes 0-15 wait at barrier 2: one warp split between the
//         two. Under thread counting the all-thread barrier cannot complete (a deadlock, as
//         barrier 2 lacks 16 threads); the cut must not rely on it (premise (a)).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_barcut(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 4 .b32 buf[32];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;                // lane
    shr.u32 %r8, %r1, 5;                 // warp
    mov.u32 %r3, buf;
    shl.b32 %r4, %r2, 2;
    add.u32 %r5, %r3, %r4;               // &buf[lane]
    mov.u32 %r9, 0;                      // round
LOOP:
    shl.b32 %r10, %r9, 1;                // first warp of the active pair
    sub.u32 %r11, %r8, %r10;
    setp.gt.u32 %p2, %r11, 1;            // not in the active pair (unsigned)
    @%p2 bra JOIN;                       // @SKIP
    setp.eq.u32 %p3, %r11, 1;            // @ACTIVE
    @%p3 bra CONSUMER;
    add.u32 %r6, %r2, %r9;
    add.u32 %r6, %r6, 1;
    mul.lo.u32 %r6, %r6, 16843009;       // in every byte (0x01010101)
    st.shared.u32 [%r5], %r6;
    bar.sync 2, 64;                      // @PBAR
    bra JOIN;                            // @PDONE
CONSUMER:
    bar.sync 2, 64;
    ld.shared.u32 %r7, [%r5];
    shl.b32 %r12, %r9, 5;
    add.u32 %r12, %r12, %r2;
    mul.wide.u32 %rd2, %r12, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r7;
    bra JOIN;                            // @CDONE
JOIN:
    bar.sync 1;                          // @ALLTHREAD
NEXT:
    add.u32 %r9, %r9, 1;
    setp.lt.u32 %p4, %r9, 2;
    @%p4 bra LOOP;
    ret;
}
