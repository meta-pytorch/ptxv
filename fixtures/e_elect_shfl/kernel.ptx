// E-ELECT (MISS 79): the leader's identity through shfl.sync.idx of elect's predicate from a fixed
// source lane. Every lane of warp 0 shuffles (leader ? 1 : 0) from lane 5: the result is 1 in
// every lane exactly when lane 5 leads. The leader stores out[1] before bar.sync 0 when the
// result is 0 (leaders 0 and 31, the two end-lane policies), after it when lane 5 leads,
// where thread 32's read races with it. shfl.idx from a warp-uniform lane is not
// lane-varying in the leader-sensitivity taint, so no gate fired (a collective of a
// leader-dependent pattern is lane-varying now).
//   good: racy for leader 5 only.
//   LANE0: shuffle from lane 0: racy unless lane 0 leads (the highest-lane policy shows it).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_elect_shfl(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r7, 7;
    shr.u32 %r2, %r1, 5;
    setp.ne.u32 %p5, %r2, 0;
    setp.ne.u32 %p6, %r2, %r2;           // false
    @%p5 bra BAR;
    elect.sync _|%p1, -1;
    selp.u32 %r10, 1, 0, %p1;
    shfl.sync.idx.b32 %r9, %r10, 5, 31, -1;   // @SRC
    setp.eq.u32 %p4, %r9, 0;
    and.pred %p6, %p1, %p4;
    @%p6 st.global.u32 [%rd1+4], %r7;    // leader 0 or 31: before the barrier
    not.pred %p4, %p4;
    and.pred %p6, %p1, %p4;
BAR:
    bar.sync 0;
    @%p6 st.global.u32 [%rd1+4], %r7;    // leader 5: after the barrier
    setp.ne.u32 %p7, %r1, 32;
    @%p7 bra DONE;
    ld.global.u32 %r5, [%rd1+4];
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
