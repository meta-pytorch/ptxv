// Fixture for E-RACE-DEAD (race_dead.rs): every thread of two warps loads a global word and
// thread 0 then stores the word plus one (Triton's `tl.load` of a scalar by every thread,
// `tl.store` masked to one lane: local_stats_partial_reduction's numel update). The other
// threads' loads race with the store; warp 1 never uses its value.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_race_dead(.param .u64 cnt_p, .param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [cnt_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [out_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    ld.global.u32 %r5, [%rd1];
    add.u32 %r6, %r5, 1;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra NOT0;
    st.global.u32 [%rd1], %r6;
NOT0:
    shr.u32 %r2, %r1, 5;
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra DONE;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd2, %rd3;
    st.global.u32 [%rd4], %r1;           // @USE
DONE:
    ret;
}
