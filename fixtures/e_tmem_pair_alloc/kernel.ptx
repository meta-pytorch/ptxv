// E-PAIR, the paired tensor-memory allocation: PTX ISA 9.5 9.7.18.5, tcgen05.alloc.cta_group::2,
// "one warp from each of the peer CTAs must collectively perform the allocation", and the first
// warp "could block until the second warp in the Peer CTA also performs the operation".
// A cluster of two CTAs of one warp each. Each warp allocates 32 columns with
// tcgen05.alloc.cta_group::2, both meet at a cluster barrier, thread 0 of each CTA stores the
// address it got to out[rank], and each warp deallocates.
//   good:     clean; both CTAs get column 0. (SASS: a scoreboard contract at every level, the
//             gb300 profile's too; see case.toml.)
//   ONESIDED: rank 1 neither allocates nor deallocates: rank 0's warp waits for it in the
//             alloc forever and rank 1 waits at the cluster barrier, a deadlock. SASS: ptxas has
//             the even CTA allocate in both CTAs without waiting (UTCATOMSWS.2CTA), and CTA 1
//             exits with the columns allocated (a TMEM leak, a violation).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_tmem_pair_alloc(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .shared .align 4 .b32 slot;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    mov.u32 %r2, %cluster_ctarank;
    mov.u32 %r4, slot;
    setp.eq.u32 %p1, %r2, 1;
    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r4], 32;     // @ALLOC
    barrier.cluster.arrive.aligned;
    barrier.cluster.wait.aligned;
    ld.shared.b32 %r9, [%r4];
    setp.ne.u32 %p2, %r0, 0;
    @%p2 bra DEALLOC;
    mul.wide.u32 %rd2, %r2, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r9;
DEALLOC:
    tcgen05.dealloc.cta_group::2.sync.aligned.b32 %r9, 32;     // @DEALLOC
    ret;
}
