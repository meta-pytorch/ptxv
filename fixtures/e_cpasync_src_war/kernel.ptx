// E-CPASYNC, the copy's global load: PTX ISA 9.5 8.9.1.1, "the loads and stores performed as
// part of a cp.async are ordered with respect to each other, but not to those of any other
// cp.async instructions initiated by the same thread, nor any other instruction subsequently
// issued by the thread with the exception of cp.async.commit_group or
// cp.async.mbarrier.arrive"; 9.7.10.28.1: "Once an asynchronous copy operation is initiated,
// modifying the source memory location ... before the asynchronous operation completes,
// exhibits undefined behavior". The load may happen at any point up to the copy's completion,
// so a store to the source ordered only after an instruction the issuer runs after the copy (a
// barrier, its own store) races with it. Thread 0 copies src[0..3] (16 bytes) into a shared
// slot with cp.async.cg and commits, then:
//   good: waits (wait_group 0), bar.sync; thread 32 then stores 99 to src[1]: clean.
//   BAR:  bar.sync first (thread 32 stores 99 to src[1] after it), then waits: a race.
//   OWN:  thread 0 itself stores 99 to src[1] after the cp.async, then waits: a race.
// Thread 0 then writes slot word 1 to out[0].
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cpasync_src_war(.param .u64 out_p, .param .u64 src_p)
{
    .shared .align 16 .b8 slot[16];
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [src_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, slot;
    mov.u32 %r3, 99;
    setp.ne.u32 %p1, %r1, 32;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra ISSUED;
    cp.async.cg.shared.global [%r2], [%rd2], 16;
    cp.async.commit_group;
    // @OWN
    cp.async.wait_group 0;     // @WAIT1
ISSUED:
    bar.sync 0;
    @%p1 bra NOT32;
    st.global.u32 [%rd2+4], %r3;     // @ST32
NOT32:
    @%p2 bra DONE;
    // @WAIT2
    ld.shared.u32 %r7, [%r2+4];
    st.global.u32 [%rd1], %r7;
DONE:
    ret;
}
