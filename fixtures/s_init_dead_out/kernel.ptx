// S-INIT-DEAD: a declared dead workspace (init = "undef", scratch = true, not an output).
//
// One thread. ws[0] = 3 * in[0]; out[0] = ws[0] (a workspace round trip). It also copies the
// unwritten ws[1] (undefined) into ws[2]:
//   good:  the undefined value stays in the dead workspace: a dead-undef-exit note, clean.
//   LEAK:  the undefined value is stored to out[1] instead: undefined data leaves the kernel
//          in an output, a violation.
//   READ:  the kernel branches on the unwritten ws[1]: a read of the workspace before any
//          write is still caught (S-INIT), a violation.
// fixtures/s_init_dead_out runs the same kernel with ws also declared an output: the note
// does not apply and good is a violation.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry init_dead(.param .u64 in_ptr, .param .u64 ws_ptr, .param .u64 out_ptr)
.maxntid 32, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;

    mov.u32         %r0, %tid.x;
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        $L_done;
    ld.param.u64    %rd1, [in_ptr];
    cvta.to.global.u64 %rd2, %rd1;
    ld.param.u64    %rd3, [ws_ptr];
    cvta.to.global.u64 %rd4, %rd3;
    ld.param.u64    %rd5, [out_ptr];
    cvta.to.global.u64 %rd6, %rd5;
    ld.global.u32   %r1, [%rd2];
    mul.lo.u32      %r1, %r1, 3;
    st.global.u32   [%rd4], %r1;
    ld.global.u32   %r2, [%rd4+4];
    setp.eq.u32     %p2, %r0, 7;                                    // @R
    @%p2 bra        $L_done;
    st.global.u32   [%rd4+8], %r2;                                  // @L
    ld.global.u32   %r3, [%rd4];
    st.global.u32   [%rd6], %r3;
$L_done:
    ret;
}
