// DPOR drain repro, race-free. Rank 0's thread 0 completes rank 1's mbarrier with st.async
// (a remote operation its cluster-scope release at the end drains), then tests its own
// mbarrier once (no loop) and writes the result. Rank 1's thread 0 waits for the st.async and
// arrives remotely on rank 0's mbarrier. Whether the single test sees that arrival depends on
// timing: out = 0 or 1 (nondeterministic output), with no data race.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_dpor_drain_rf(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<6>;
    .shared .align 8 .b64 mbar;
    .shared .align 4 .b32 flag;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r5, mbar;
    mov.u32 %r6, flag;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
    @%p0 bra INIT_DONE;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r5], 4;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    @%p1 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r8, %r6, 1;
    mapa.shared::cluster.u32 %r9, %r5, 1;
    mov.u32 %r10, 42;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r8], %r10, [%r9];
    mbarrier.test_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r5], 0;
    selp.u32 %r11, 1, 0, %p4;
    st.global.u32 [%rd1], %r11;
    @%p4 bra END;
DRAIN_WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra DRAIN_WAIT;
    bra END;
RANK1:
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p3, [%r5], 0;
    @!%p3 bra WAIT;
    mapa.shared::cluster.u32 %r12, %r5, 0;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r12];
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
