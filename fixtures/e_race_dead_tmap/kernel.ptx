// Fixture (E-RACE-DEAD, tensormap proxy fence): warp 0 is probes/tmap_device (thread 0 builds a
// tensor map in shared memory, warp 0 publishes it to global memory with
// tensormap.cp_fenceproxy, acquires it with fence.proxy.tensormap::generic and TMA-loads a box
// with it). Warp 1 runs the same acquire fence on the map with no ordering against the
// publication and never uses the map (as the epilogue warps 1..3 of a CuTe grouped GEMM that
// all run fence_tensormap_update while only warp 0 issues the TMA stores). The fence's read
// of the map races with the publication; its snapshot is used by no TMA op (good: race-dead).
// TF1: thread 32 also TMA-loads with the map after its fence (positive control). TF2: warp 1
// waits for flag[0] (relaxed: no happens-before) before its fence, so the fence reads the
// published map in every interleaving but is still unordered with the publication; thread 32
// then acquires flag[1] and TMA-loads relying on its own snapshot. The race must stay a race.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tmap_device(.param .u64 pin, .param .u64 pout, .param .u64 pmap, .param .u64 pflag)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<16>;
    .reg .pred %p<4>;
    .shared .align 128 .b8 tm[128];
    .shared .align 128 .b8 tile[2048];
    .shared .align 8 .b64 mbar;
    .shared .align 128 .b8 tile2[2048];
    .shared .align 8 .b64 mbar2;
    ld.param.u64 %rd1, [pin];
    ld.param.u64 %rd2, [pout];
    ld.param.u64 %rd3, [pmap];
    ld.param.u64 %rd9, [pflag];
    cvta.to.global.u64 %rd9, %rd9;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    shr.u32 %r20, %r0, 5;
    setp.ne.u32 %p0, %r20, 0;
    @%p0 bra W1;
    mov.u32 %r5, tm;
    mov.u32 %r6, tile;
    mov.u32 %r7, mbar;
    shl.b32 %r1, %r0, 2;
    add.u32 %r2, %r5, %r1;
    st.shared.u32 [%r2], 0;
    setp.ne.u32 %p1, %r0, 0;
    @%p1 bra SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r7], 1;
SKIP_INIT:
    bar.sync 1, 32;
    @%p1 bra SKIP_REPLACE;
    tensormap.replace.tile.global_address.shared::cta.b1024.b64 [%r5], %rd1;
    tensormap.replace.tile.rank.shared::cta.b1024.b32 [%r5], 1;
    tensormap.replace.tile.box_dim.shared::cta.b1024.b32 [%r5], 0, 32;
    tensormap.replace.tile.box_dim.shared::cta.b1024.b32 [%r5], 1, 16;
    tensormap.replace.tile.global_dim.shared::cta.b1024.b32 [%r5], 0, 64;
    tensormap.replace.tile.global_dim.shared::cta.b1024.b32 [%r5], 1, 32;
    tensormap.replace.tile.global_stride.shared::cta.b1024.b64 [%r5], 0, 256;
    tensormap.replace.tile.element_stride.shared::cta.b1024.b32 [%r5], 0, 1;
    tensormap.replace.tile.element_stride.shared::cta.b1024.b32 [%r5], 1, 1;
    tensormap.replace.tile.elemtype.shared::cta.b1024.b32 [%r5], 7;
    tensormap.replace.tile.interleave_layout.shared::cta.b1024.b32 [%r5], 0;
    tensormap.replace.tile.swizzle_mode.shared::cta.b1024.b32 [%r5], 0;
    tensormap.replace.tile.fill_mode.shared::cta.b1024.b32 [%r5], 0;
SKIP_REPLACE:
    bar.sync 1, 32;
    tensormap.cp_fenceproxy.global.shared::cta.tensormap::generic.release.gpu.sync.aligned [%rd3], [%r5], 128;
    // the map is published: thread 0 raises flag[0] (relaxed) and flag[1] (release), read only
    // by TF2's thread 32, before warp 0's own acquire fence
    bar.sync 1, 32;
    @%p1 bra NOFLAG;
    st.relaxed.gpu.global.u32 [%rd9], 1;
    st.release.gpu.global.u32 [%rd9+4], 1;
NOFLAG:
    fence.proxy.tensormap::generic.acquire.gpu [%rd3], 128;
    @%p1 bra WAIT;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r7], 2048;
    mov.u32 %r10, 16;
    mov.u32 %r11, 8;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes [%r6], [%rd3, {%r10, %r11}], [%r7];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [%r7], 0;
    @!%p2 bra WAIT;
    // 32 threads: thread t copies tile words t, t + 32, ...
    mov.u32 %r12, 0;
COPY:
    shl.b32 %r13, %r12, 5;
    add.u32 %r13, %r13, %r0;
    shl.b32 %r14, %r13, 2;
    add.u32 %r15, %r6, %r14;
    ld.shared.u32 %r16, [%r15];
    mul.wide.u32 %rd4, %r13, 4;
    add.u64 %rd5, %rd2, %rd4;
    st.global.u32 [%rd5], %r16;
    add.u32 %r12, %r12, 1;
    setp.lt.u32 %p3, %r12, 16;
    @%p3 bra COPY;
    // the map as left in global memory
    mul.wide.u32 %rd6, %r0, 4;
    add.u64 %rd7, %rd3, %rd6;
    ld.global.u32 %r17, [%rd7];
    // words 0 / 1 hold the global address of `in`: store them relative to it (0)
    mov.b64 {%r18, %r19}, %rd1;
    setp.eq.u32 %p2, %r0, 0;
    @%p2 sub.u32 %r17, %r17, %r18;
    setp.eq.u32 %p2, %r0, 1;
    @%p2 sub.u32 %r17, %r17, %r19;
    add.u64 %rd8, %rd2, %rd6;
    st.global.u32 [%rd8+2048], %r17;
    ret;
W1:
    fence.proxy.tensormap::generic.acquire.gpu [%rd3], 128; // @W1FENCE
    ret; // @W1END
}
