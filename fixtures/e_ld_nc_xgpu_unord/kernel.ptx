// E-LAUNCH-ORDER and S-NC across GPUs (the launch structure of a two-GPU combine and its
// reduce):
//   GPU 1 writer: data[t] = 100 + t (peer stores into GPU 0 memory); bar.sync; thread 0:
//     st.release.sys flag = 1.
//   GPU 0 waiter: thread 0 spins ld.acquire.sys flag until 1; bar.sync.
//   GPU 0 reader, after the waiter on its stream (no PDL): out[t] = ld.global.nc data[t].
// The writes happen before the waiter's acquire, and the waiter completes before the reader
// starts. The launch-clock exemption applies only when the reader's stream predecessor is
// recorded (REC: clean), never to an unknown-order list (good, as older captures are: a
// violation) or to UNORD (a race and a violation).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry waiter(.param .u64 pflag)
.reqntid 32
{
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [pflag];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra $L_done;
$L_spin:
    ld.acquire.sys.global.u32 %r2, [%rd1];
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra $L_spin;
$L_done:
    bar.sync 0;
    ret;
}

.visible .entry writer(.param .u64 pdata, .param .u64 pflag)
.reqntid 32
{
    .reg .pred %p<4>;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [pflag];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.u32 %r2, %r1, 100;
    st.global.u32 [%rd4], %r2;
    bar.sync 0;
    setp.ne.u32 %p1, %r1, 0;
    mov.u32 %r3, 1;
    @!%p1 st.release.sys.global.u32 [%rd2], %r3;    // @SIG
    ret;
}

.visible .entry reader(.param .u64 pdata, .param .u64 pout)
.reqntid 32
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    ld.global.nc.u32 %r2, [%rd4];                     // @LD
    st.global.u32 [%rd5], %r2;
    ret;
}
