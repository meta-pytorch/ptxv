// RMK4 A7: two threads of different warps initialize the same mbarrier `a`, unordered.
// INITA / INITB: per-thread address (ptxas: STS.64 of the state word) or uniform (SYNCS.EXCH.64).
// PREINV: optionally t0 first initializes `a` uniformly, bar.sync, invalidates it, bar.sync.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_mbar_double_sts_init(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b8 a[8];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, a;
    and.b32 %r20, %r1, 31;
    shl.b32 %r21, %r20, 3;
    add.u32 %r22, %r2, %r21;                           // a + 8*lane: a for lane 0
    setp.ne.u32 %p2, %r1, 0;
    // @PRE
NOPRE:
    and.b32 %r23, %r1, 31;
    setp.ne.u32 %p3, %r23, 0;
    @%p3 bra NOINIT;
    mbarrier.init.shared::cta.b64 [%r22], 1;           // @INIT (lane 0 of each warp, per-thread address)
NOINIT:
    bar.sync 0;
    @%p2 bra DONE;
    mov.u32 %r9, 1;
    st.global.u32 [%rd1], %r9;
DONE:
    ret;
}
