// E-LAUNCH-ORDER and the hardware runner (case.toml). writer: p[t] = t + 100 (L0 writes dummy,
// L1 data); reader: out[t] = ld.global data[t] (L2, ordered after L0 only).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry writer(.param .u64 pdata)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pdata];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 4;
    add.s64         %rd3, %rd1, %rd2;
    add.u32         %r2, %r1, 100;
    st.global.u32   [%rd3], %r2;
    ret;
}

.visible .entry reader(.param .u64 pdata, .param .u64 pout)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pdata];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 4;
    add.s64         %rd4, %rd1, %rd3;
    add.s64         %rd5, %rd2, %rd3;
    ld.global.u32   %r2, [%rd4];
    st.global.u32   [%rd5], %r2;
    ret;
}
