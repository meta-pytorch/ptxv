// E-HW-WEAK-FLAG: message passing with a weak flag store after a sys fence (msl DeepEP
// nvlink_barrier_wo_local_sync, index L5; probes/weak_flag). Two CTAs of one warp: CTA 1's
// thread 0 stores data (weak), fence.sc.sys, then stores the flag with a weak st.global; CTA
// 0's thread 0 polls the flag with ld.volatile until it is 1, fence.sc.sys, reads data into
// out. Strict PTX model: the weak flag store races with the poll (and so the data read with
// the data store). GB300 hardware model (two-level): the weak store after the sys fence acts
// as a relaxed sys store and publishes the fence's clock, so the races are latent.
//   nofence: the writer's fence removed: the data race stays observable at level 2
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_weak_flag(.param .u64 out_p, .param .u64 data_p, .param .u64 flag_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [data_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [flag_p];
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u32 %r2, %ctaid.x;
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra READER;
    st.global.u32 [%rd2], 42;
    fence.sc.sys;                          // @FENCE
    st.global.u32 [%rd3], 1;
    bra DONE;
READER:
SPIN:
    ld.volatile.global.u32 %r5, [%rd3];
    setp.ne.u32 %p3, %r5, 1;
    @%p3 bra SPIN;
    fence.sc.sys;
    ld.global.u32 %r6, [%rd2];
    st.global.u32 [%rd1], %r6;
DONE:
    ret;
}
