.version 9.0
.target sm_103a
.address_size 64

.global .align 4 .u32 out[2] = {0, 0};

.visible .entry strict_memory_scalar()
{
    .reg .b32 %r<1>;
    .reg .b64 %rd<2>;

    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd0, %r0, 4; // @stride
    mov.u64 %rd1, out;
    add.u64 %rd0, %rd1, %rd0;
    st.global.u32 [%rd0], 7;
    ret;
}
