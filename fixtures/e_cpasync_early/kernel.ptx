// E-CPASYNC: a cp.async writes shared memory when wait_group retires its group, not at issue.
// Thread 32 fills a shared slot with 0x55; thread 0 copies in[0..3] = 0..3 over it; thread 32
// reads word 1 after a bar.sync.
//   good: thread 0 waits (cp.async.wait_group 0) before the barrier: clean (out = in).
//   LATEWAIT: thread 0 waits only after the barrier: the copy may land after thread 32's read
//             (the barrier orders the issue, not the write): must not be clean.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cpasync_early(.param .u64 out_p, .param .u64 in_p)
{
    .shared .align 16 .b8 slot[16];
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, slot;
    mov.u32 %r3, 0x55;
    setp.ne.u32 %p1, %r1, 32;
    @%p1 bra INIT_DONE;
    st.shared.v4.u32 [%r2], {%r3, %r3, %r3, %r3};
INIT_DONE:
    bar.sync 1;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra ISSUED;
    cp.async.cg.shared.global [%r2], [%rd2], 16;
    cp.async.commit_group;
    cp.async.wait_group 0;               // @EARLY
ISSUED:
    bar.sync 0;
    @%p2 bra READ;
    // @LATE
    bra DONE;
READ:
    @%p1 bra DONE;
    ld.shared.u32 %r4, [%r2+4];
    st.global.u32 [%rd1], %r4;
DONE:
    ret;
}
