// E-ELECT (MISS 49): the leader's lane number (elect.sync's first output) decides the leader's
// work through a function equal at the two end lanes: f(l) = min(l, (l + 1) & 31) is 0 for
// leaders 0 and 31 and nonzero for every other leader. An end-lane leader stores out[1] before
// bar.sync 0, a middle-lane leader after it, where thread 32's read races with it.
//   good: racy for middle-lane leaders only.
//   OUT: a middle-lane leader stores f(l) to out[2] instead of out[1]: race-free, thread 32
//        reads 0 and out[2] is nonzero for middle-lane leaders only.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_elect_lane_number(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r7, 7;
    shr.u32 %r2, %r1, 5;
    setp.ne.u32 %p5, %r2, 0;
    setp.ne.u32 %p6, %r2, %r2;           // false
    @%p5 bra BAR;
    elect.sync %r9|%p1, -1;
    add.u32 %r3, %r9, 1;
    and.b32 %r3, %r3, 31;
    min.u32 %r4, %r9, %r3;               // 0 for leaders 0 and 31
    setp.eq.u32 %p4, %r4, 0;
    and.pred %p6, %p1, %p4;
    @%p6 st.global.u32 [%rd1+4], %r7;    // end-lane leader: before the barrier
    not.pred %p4, %p4;
    and.pred %p6, %p1, %p4;
BAR:
    bar.sync 0;
    @%p6 st.global.u32 [%rd1+4], %r7;    // @LATE middle-lane leader: after the barrier
    setp.ne.u32 %p7, %r1, 32;
    @%p7 bra DONE;
    ld.global.u32 %r5, [%rd1+4];
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
