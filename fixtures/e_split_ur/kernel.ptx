// E-HW-SPLIT-UR at the strict level: even and odd lanes on separate paths, each adding its
// value to its own shared word with an atomic, then `bar.warp.sync` with its pair (3 << (lane &
// 30)) and reading the partner's word. ptxas 13.0 compiles each path's warp sync to the fast
// path `MATCH.ANY; REDUX.OR UR5; VOTEU.ANY UR8; ...; ATOMS.ADD; LOP3 P0, .., UR8, ..; @!P0
// BRA.DIV UR5`: the split's lane mask lives in UR8 across the atomic. out[t] = the partner's
// word: (t ^ 1) + 1 times 3 for an odd partner, times 2 for an even one.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry ur_window_split(.param .u64 pout)
.maxntid 32, 1, 1
{
    .reg .b32   %r<32>;
    .reg .b64   %rd<8>;
    .reg .pred  %p<4>;
    .shared .align 4 .b32 s[32];

    ld.param.u64 %rd1, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    and.b32 %r3, %r2, 30;
    mov.u32 %r4, 3;
    shl.b32 %r5, %r4, %r3;
    mov.u32 %r6, s;
    shl.b32 %r7, %r1, 2;
    add.u32 %r8, %r6, %r7;
    xor.b32 %r9, %r7, 4;
    add.u32 %r10, %r6, %r9;
    add.u32 %r11, %r1, 1;
    mov.u32 %r16, 0;
    st.shared.u32 [%r8], %r16;
    bar.warp.sync -1;
    and.b32 %r12, %r2, 1;
    setp.ne.u32 %p1, %r12, 0;
    @%p1 bra ODD;
    mul.lo.u32 %r13, %r11, 2;
    atom.shared.add.u32 %r15, [%r8], %r13;
    bar.warp.sync %r5;
    ld.shared.u32 %r14, [%r10];
    bra JOIN;
ODD:
    mul.lo.u32 %r13, %r11, 3;
    atom.shared.add.u32 %r15, [%r8], %r13;
    bar.warp.sync %r5;
    ld.shared.u32 %r14, [%r10];
JOIN:
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r14;
    ret;
}
