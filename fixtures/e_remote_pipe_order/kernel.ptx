// S-REMOTE-INFLIGHT pipe order (MISS 154). Rank 0 warp 0: lane 1 issues st.async B (x of rank
// 1, mbarrier m), then releases a flag; lane 0 acquires the flag, then issues st.async A (y,
// m). One warp's remote operations on one mbarrier land in issue order, so B lands first and
// completes phase 0; rank 1 waits on phase 0 and reads x.
//   good: ordered by B's release: clean. The pipe used to be ordered by (actor, clock), which
//         put lane 0's A ahead of B: a false race on x.
//   REV: the first-issued store writes y, the second x: phase 0 completes before x lands:
//         race, nondeterministic, and the unwritten word read (S-INIT) (negative control).
//   DRN: a cluster fence of lane 0 alone after A, with B pending: the drain lands B (the pipe's
//         head, another lane's) before A: clean (MISS 184).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_remote_pipe_order(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m;
    .shared .align 4 .b32 x;
    .shared .align 4 .b32 y;
    .shared .align 4 .b32 flag;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r4, m;
    mov.u32 %r5, x;
    mov.u32 %r6, y;
    mov.u32 %r7, flag;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mov.u32 %r20, 0;
    st.shared.u32 [%r7], %r20;
    @%p0 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    fence.mbarrier_init.release.cluster;
    mbarrier.arrive.expect_tx.relaxed.cluster.shared::cta.b64 _, [%r4], 4;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.gt.u32 %p3, %r1, 1;
    @%p3 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r5, 1;
    mapa.shared::cluster.u32 %r11, %r6, 1;
    mov.u32 %r14, 42;
    mov.u32 %r16, 1;
    @%p1 bra LANE1;
SPIN0:
    ld.acquire.cta.shared.u32 %r17, [%r7];
    setp.ne.u32 %p6, %r17, 1;
    @%p6 bra SPIN0;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r11], %r14, [%r9];   // @SECOND
    bra END;
LANE1:
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r10], %r14, [%r9];   // @FIRST
    st.release.cta.shared.u32 [%r7], %r16;
    bra END;
RANK1:
    @%p1 bra END;
WAIT0:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r4], 0;
    @!%p4 bra WAIT0;
    ld.shared.u32 %r18, [%r5];
    st.global.u32 [%rd1], %r18;
    mbarrier.arrive.expect_tx.relaxed.cluster.shared::cta.b64 _, [%r4], 4;
WAIT1:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r4], 1;
    @!%p5 bra WAIT1;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
