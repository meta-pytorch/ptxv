// st.async of every width (SASS STAS / STAS.64 / STAS.128): rank 1 of a 2-CTA cluster stores
// 40 bytes into rank 0's shared memory with .b64, .b32, .v4.b32 and .v2.b32 st.async, each
// completing its bytes on rank 0's mbarrier; rank 0 expects 40 bytes, waits, and copies the
// 10 words out.
//   good: as above (clean)
//   SW1 : rank 0 expects 48 bytes (deadlock)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_stasync_wide(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    .shared .align 8 .b8 bar[8];
    .shared .align 16 .b8 buf[64];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %cluster_ctarank;
    mov.u32 %r2, bar;
    mov.u32 %r3, buf;
    setp.ne.u32 %p0, %r0, 0;
    setp.ne.u32 %p1, %r1, 0;
    @%p0 bra SYNC;
    @%p1 bra SYNC;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    fence.mbarrier_init.release.cluster;
SYNC:
    barrier.cluster.arrive.relaxed.aligned;
    barrier.cluster.wait.aligned;
    @%p0 bra DONE;
    @%p1 bra SENDER;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r2], 40;   // @EXPECT
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p2, [%r2], 0;
    @!%p2 bra WAIT;
    ld.shared.v4.u32 {%r4, %r5, %r6, %r7}, [%r3];
    st.global.v4.u32 [%rd1], {%r4, %r5, %r6, %r7};
    ld.shared.v4.u32 {%r4, %r5, %r6, %r7}, [%r3+16];
    st.global.v4.u32 [%rd1+16], {%r4, %r5, %r6, %r7};
    ld.shared.v2.u32 {%r4, %r5}, [%r3+32];
    st.global.v2.u32 [%rd1+32], {%r4, %r5};
    bra DONE;
SENDER:
    mapa.shared::cluster.u32 %r8, %r3, 0;
    mapa.shared::cluster.u32 %r9, %r2, 0;
    mov.u32 %r10, 0x11;
    mov.u32 %r11, 0x22;
    mov.u32 %r12, 0x33;
    mov.u32 %r13, 0x44;
    mov.u32 %r14, 0x55;
    mov.b64 %rd2, {%r11, %r12};
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b64 [%r8], %rd2, [%r9];
    add.u32 %r15, %r8, 8;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r15], %r10, [%r9];
    add.u32 %r19, %r8, 12;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r19], %r14, [%r9];
    add.u32 %r16, %r8, 16;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.v4.b32 [%r16], {%r10, %r11, %r12, %r13}, [%r9];
    add.u32 %r18, %r8, 32;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.v2.b32 [%r18], {%r13, %r14}, [%r9];
DONE:
    ret;
}
