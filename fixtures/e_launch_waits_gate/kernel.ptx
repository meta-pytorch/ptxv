// E-LAUNCH-ORDER, `waits` as a launch gate: three kernels on two streams of one GPU,
// 1 CTA x 32 each.
//   ka (stream 0): a[t] = t + 1.
//   kb (stream 1, waits for nothing): thread 0 spins (ld.acquire.gpu) until flag is set, then
//     writes b[0] = 5.
//   kc (stream 0, after ka; stream 0 waited for an event recorded after kb: waits = [1]):
//     thread 0 sets flag (st.release.gpu).
// good: kc cannot start before kb completes, and kb cannot complete before kc sets the flag:
//   a deadlock (a grid in `waits` gates the launch, not only the join of its done clocks).
// NOWAIT: no event wait (waits = []): kc starts after ka, sets the flag, kb completes: clean.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry ka(.param .u64 pa)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pa];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 4;
    add.s64         %rd3, %rd1, %rd2;
    add.u32         %r2, %r1, 1;
    st.global.u32   [%rd3], %r2;
    ret;
}

.visible .entry kb(.param .u64 pflag, .param .u64 pb)
.reqntid 32
{
    .reg .pred  %p<4>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    mov.u32         %r1, %tid.x;
    setp.ne.u32     %p1, %r1, 0;
    @%p1 bra        $L_done;
    ld.param.u64    %rd1, [pflag];
    cvta.to.global.u64 %rd1, %rd1;
$L_spin:
    ld.acquire.gpu.global.u32 %r2, [%rd1];
    setp.eq.u32     %p2, %r2, 0;
    @%p2 bra        $L_spin;
    ld.param.u64    %rd2, [pb];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r3, 5;
    st.global.u32   [%rd2], %r3;
$L_done:
    ret;
}

.visible .entry kc(.param .u64 pflag)
.reqntid 32
{
    .reg .pred  %p<4>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    mov.u32         %r1, %tid.x;
    setp.ne.u32     %p1, %r1, 0;
    @%p1 bra        $L_done;
    ld.param.u64    %rd1, [pflag];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r2, 1;
    st.release.gpu.global.u32 [%rd1], %r2;
$L_done:
    ret;
}
