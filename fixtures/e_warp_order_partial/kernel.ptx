// E-WARP-ORDER with a partial bar.warp.sync: the lower and upper half-warps take the two sides
// of a branch and each syncs its half (bar.warp.sync 0x0000ffff / 0xffff0000). Lane 0 then
// stores the flag word twice with st.volatile and lane 1 loads it twice on the next
// instructions (as e_warp_order_div CONV), all inside the lower half's side, no bar.warp.sync
// between them. Under the PTX model the lanes are threads: lane 1 may see any coherent pair.
//   good: half-warp branch, partial syncs, then the strong pairs.
//   NODIV: the same strong pairs with no branch before them (the warp never diverged).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_warp_order_partial(.param .u64 out_p)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 4 .b32 x;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, x;
    mov.u32 %r3, 0;
    st.shared.u32 [%r2], %r3;
    bar.warp.sync -1;
    setp.eq.u32 %p1, %r1, 0;
    setp.eq.u32 %p2, %r1, 1;
    setp.ge.u32 %p3, %r1, 16;
    mov.u32 %r10, 1;
    mov.u32 %r11, 2;
    mov.u32 %r12, 0;
    mov.u32 %r13, 0;
    @%p3 bra UPPER;                      // @DIV
    bar.warp.sync 0x0000ffff;           // @HALF
    @%p1 st.volatile.shared.u32 [%r2], %r10;
    @%p2 ld.volatile.shared.u32 %r12, [%r2];
    @%p1 st.volatile.shared.u32 [%r2], %r11;
    @%p2 ld.volatile.shared.u32 %r13, [%r2];
    bra JOIN;
UPPER:
    bar.warp.sync 0xffff0000;
JOIN:
    bar.warp.sync -1;
    @!%p2 bra DONE;
    st.global.u32 [%rd1], %r12;
    st.global.u32 [%rd1+4], %r13;
DONE:
    ret;
}
