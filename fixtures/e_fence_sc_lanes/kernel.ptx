// S-FENCE-SC with the lanes of one converged atom step (forum post 74 review).
// Thread 32 (warp 1): data = 42; fence.sc.gpu (F1); st.relaxed.gpu flag = 1.
// Warp 0: lane 0 spins on ld.acquire.gpu flag (F1 happens before it); the other lanes skip;
// vote.sync.all (convergence, no memory ordering); every lane: t = atom.add(sem, 1) (A0 by
// lane 0, B1 by lane 1); fence.sc.gpu (F2); lane 1 (chosen by lane id) reads data.
// PTX: lanes are threads; in executions where B1 precedes A0 in coherence order, F2 before F1
// is a valid Fence-SC order and lane 1's read races with thread 32's store. Lane 0 has no
// release fence between its acquire and A0, so no acquire-release edge exists either way. The
// model runs the lanes of one step in lane order only (A0 first), so a Fence-SC edge read off
// that order (F1 -> F2) is not forced. SASS: ptxas aggregates the atomic and E-LOCKSTEP orders
// the lanes, so clean.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pdata, .param .u64 pflag, .param .u64 psem, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [pflag];
    ld.param.u64 %rd3, [psem];
    ld.param.u64 %rd4, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32 %r1, %tid.x;
    setp.lt.u32 %p1, %r1, 32;
    @%p1 bra WARP0;
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
    mov.u32 %r2, 42;
    st.global.u32 [%rd1], %r2;
    fence.sc.gpu;                                // F1
    mov.u32 %r3, 1;
    st.relaxed.gpu.global.u32 [%rd2], %r3;
    bra DONE;
WARP0:
    setp.ne.u32 %p3, %r1, 0;
    @%p3 bra CONV;
SPIN:
    ld.acquire.gpu.global.u32 %r4, [%rd2];
    setp.eq.u32 %p4, %r4, 0;
    @%p4 bra SPIN;
CONV:
    vote.sync.all.pred %p5, %p1, 0xffffffff;     // @CONV
    atom.global.add.u32 %r5, [%rd3], 1;          // @ATOM
    fence.sc.gpu;                                // @F2
    setp.ne.u32 %p6, %r1, 1;                     // @WHO
    @%p6 bra DONE;
    ld.global.u32 %r6, [%rd1];
    st.global.u32 [%rd4], %r6;
DONE:
    ret;
}
