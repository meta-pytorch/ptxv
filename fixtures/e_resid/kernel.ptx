// Fixture for E-RESIDENCY (limited residency): 4 CTAs of one warp; thread 0 of each CTA runs
// one cross-CTA protocol, picked by the @MODE line (case.toml variants):
//
//   0 good     grid spin barrier: atom.add the arrival counter, poll it until all 4 arrived,
//              then out[cta] = cta + 1. Needs every CTA co-resident: with fewer slots the
//              resident CTAs spin forever and the others never start.
//   1 chain    CTA i waits for flag[i-1] (ld.acquire), writes out[i] = i + 1 and sets
//              flag[i] (st.release). CTAs become resident in any order, so the resident ones
//              may all wait on CTAs that are not: needs all 4.
//   2 ticket   the same chain over dynamic tile ids: t = atom.add(ticket, 1) at start; wait
//              for flag[t-1], out[t] = t + 1, set flag[t]. A CTA only waits on one that took
//              an earlier ticket, so it is resident or done: deadlock-free with 1 slot (the
//              single-pass-scan idiom).
//   3 last     out[cta] = cta + 1, then atom.acq_rel.add of the counter; the CTA that sees 3
//              (the last one) sums out[0..4] into total. No CTA waits: any residency.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_resid(
    .param .u64 out_p,
    .param .u64 cnt_p,
    .param .u64 flag_p,
    .param .u64 ticket_p,
    .param .u64 total_p
)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<32>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [cnt_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [flag_p];
    cvta.to.global.u64 %rd3, %rd3;
    ld.param.u64 %rd4, [ticket_p];
    cvta.to.global.u64 %rd4, %rd4;
    ld.param.u64 %rd5, [total_p];
    cvta.to.global.u64 %rd5, %rd5;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %nctaid.x;
    mov.u32 %r20, 0;                        // @MODE
    setp.eq.u32 %p1, %r20, 1;
    @%p1 bra CHAIN;
    setp.eq.u32 %p1, %r20, 2;
    @%p1 bra TICKET;
    setp.eq.u32 %p1, %r20, 3;
    @%p1 bra LAST;

    // ---- grid spin barrier
    atom.release.gpu.global.add.u32 %r4, [%rd2], 1;
SPIN:
    ld.acquire.gpu.global.u32 %r5, [%rd2];
    setp.lt.u32 %p2, %r5, %r3;
    @%p2 bra SPIN;
    add.u32 %r6, %r2, 1;
    mul.wide.u32 %rd6, %r2, 4;
    add.u64 %rd7, %rd1, %rd6;
    st.global.u32 [%rd7], %r6;
    bra DONE;

    // ---- chain by ctaid (%r7 = position in the chain)
CHAIN:
    mov.u32 %r7, %r2;
    bra LINK;
    // ---- chain by dynamic ticket
TICKET:
    atom.relaxed.gpu.global.add.u32 %r7, [%rd4], 1;
LINK:
    setp.eq.u32 %p3, %r7, 0;
    @%p3 bra WRITE;
    add.u32 %r8, %r7, -1;
    mul.wide.u32 %rd8, %r8, 4;
    add.u64 %rd9, %rd3, %rd8;
WAITF:
    ld.acquire.gpu.global.u32 %r9, [%rd9];
    setp.eq.u32 %p4, %r9, 0;
    @%p4 bra WAITF;
WRITE:
    add.u32 %r10, %r7, 1;
    mul.wide.u32 %rd10, %r7, 4;
    add.u64 %rd11, %rd1, %rd10;
    st.global.u32 [%rd11], %r10;
    add.u64 %rd12, %rd3, %rd10;
    st.release.gpu.global.u32 [%rd12], 1;
    bra DONE;

    // ---- last block sums
LAST:
    add.u32 %r11, %r2, 1;
    mul.wide.u32 %rd13, %r2, 4;
    add.u64 %rd14, %rd1, %rd13;
    st.global.u32 [%rd14], %r11;
    atom.acq_rel.gpu.global.add.u32 %r12, [%rd2], 1;
    add.u32 %r13, %r3, -1;
    setp.ne.u32 %p5, %r12, %r13;
    @%p5 bra DONE;
    ld.global.u32 %r14, [%rd1];
    ld.global.u32 %r15, [%rd1+4];
    ld.global.u32 %r16, [%rd1+8];
    ld.global.u32 %r17, [%rd1+12];
    add.u32 %r18, %r14, %r15;
    add.u32 %r18, %r18, %r16;
    add.u32 %r18, %r18, %r17;
    st.global.u32 [%rd5], %r18;
DONE:
    ret;
}
