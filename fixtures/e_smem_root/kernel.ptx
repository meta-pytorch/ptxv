//
// Two warps, no barrier between a shared store by warp 1 and a shared load by warp 0; the
// loaded value is the output. In SASS (LDS / STS strong, S-SMEM-STRONG) this is not a race
// but the output depends on the order: `check --certify` lists the pair as an `unordered`
// root-cause finding next to the nondeterministic verdict.
//
.version 9.0
.target sm_103a
.address_size 64

.shared .align 4 .b32 flag;

.visible .entry smem_root(
	.param .u64 out_ptr
)
.reqntid 64
{
	.reg .pred %p<4>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<4>;

	ld.param.u64 %rd1, [out_ptr];
	mov.u32 %r1, %tid.x;
	setp.ne.u32 %p1, %r1, 0;
	@%p1 bra INIT_DONE;
	mov.u32 %r2, 0;
	st.shared.u32 [flag], %r2;
INIT_DONE:
	bar.sync 0;
	setp.ne.u32 %p2, %r1, 32;
	@%p2 bra NO_STORE;
	mov.u32 %r3, 1;
	st.shared.u32 [flag], %r3;
NO_STORE:
	@%p1 bra DONE;
	ld.shared.u32 %r4, [flag];
	st.global.u32 [%rd1], %r4;
DONE:
	ret;
}
