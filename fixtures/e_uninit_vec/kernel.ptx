//
// S-INIT per byte for vector stores: every thread loads four words, the fourth under a
// predicate that threads 16..31 fail, and stores the four as one vector to shared memory and
// to a global scratch buffer (lane 3 undefined for threads 16..31). After a barrier each
// thread loads lanes 0..2 of its neighbour's (tid ^ 16) shared vector and stores their sum;
// the threads that skipped the load overwrite their scratch lane 3 with 0. Only lane 3's
// bytes are undefined, so both are clean (HistogramSelect: an STS.128 with one undefined
// register poisoned all 16 bytes).
//
.version 9.0
.target sm_103a
.address_size 64

.shared .align 16 .b8 buf[512];

.visible .entry uninit_vec(
	.param .u64 in_ptr,
	.param .u64 out_ptr,
	.param .u64 scratch_ptr
)
.reqntid 32
{
	.reg .pred %p<2>;
	.reg .b32 %r<24>;
	.reg .b64 %rd<12>;

	ld.param.u64 %rd1, [in_ptr];
	ld.param.u64 %rd2, [out_ptr];
	ld.param.u64 %rd3, [scratch_ptr];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p1, %r1, 16;
	mul.wide.u32 %rd4, %r1, 16;
	add.s64 %rd5, %rd1, %rd4;
	ld.global.u32 %r2, [%rd5];
	ld.global.u32 %r3, [%rd5+4];
	ld.global.u32 %r4, [%rd5+8];
	@%p1 ld.global.u32 %r5, [%rd5+12];
	mov.u32 %r6, buf;
	shl.b32 %r7, %r1, 4;
	add.s32 %r8, %r6, %r7;
	st.shared.v4.u32 [%r8], {%r2, %r3, %r4, %r5};
	add.s64 %rd6, %rd3, %rd4;
	st.global.v4.u32 [%rd6], {%r2, %r3, %r4, %r5};
	@!%p1 st.global.u32 [%rd6+12], 0; // @FIX
	bar.sync 0;
	xor.b32 %r9, %r7, 256;
	add.s32 %r9, %r6, %r9;
	ld.shared.u32 %r10, [%r9];
	ld.shared.u32 %r11, [%r9+4];
	ld.shared.u32 %r12, [%r9+8]; // @READ
	add.s32 %r13, %r10, %r11;
	add.s32 %r13, %r13, %r12;
	mul.wide.u32 %rd7, %r1, 4;
	add.s64 %rd8, %rd2, %rd7;
	st.global.u32 [%rd8], %r13;
	ret;
}
