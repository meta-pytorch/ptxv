// S-INIT through a compare-and-swap loop. Each thread adds into its own shared word with a
// reduction that ptxas lowers to a load, the add and an `ATOMS.CAST.SPIN P, [a], Rc, Rc+1`
// loop (`.64` with Rc+2 for the u64 form) that branches back on !P. P is the compare of the
// word's old bytes with the loaded value; when the word was never written both are undefined,
// so P is too, and the loop's branch reads it (S-INIT-PRED). Nothing else reads an undefined
// value: the add's result stays in registers the CAS stores, and the word is never read. The
// PTX front (one read-modify-write, result discarded) is clean either way.
//   f32:  red.shared.add.f32 into a never-written word (ATOMS.CAST.SPIN).
//   u64:  red.shared.add.u64 into a never-written word (ATOMS.CAST.SPIN.64).
//   init: f32 after each thread stores 0 to its word: clean on both fronts.
// out[t] = t in every variant.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry s_init_cas_spin(.param .u64 out)
.maxntid 64, 1, 1
{
    .reg .b32   %r<8>;
    .reg .f32   %f<4>;
    .reg .b64   %rd<8>;
    .shared .align 8 .b8 sh[512];

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, sh;
    shl.b32         %r2, %r0, 3;
    add.u32         %r3, %r1, %r2;              // word[t]
    mov.b64         %rd0, 0;
    cvt.u64.u32     %rd1, %r0;
    cvt.rn.f32.u32  %f1, %r0;
    // @INIT
    red.shared.add.f32 [%r3], %f1;              // @RED
    ld.param.u64    %rd2, [out];
    cvta.to.global.u64 %rd2, %rd2;
    mul.wide.u32    %rd3, %r0, 4;
    add.u64         %rd2, %rd2, %rd3;
    st.global.u32   [%rd2], %r0;
    ret;
}
