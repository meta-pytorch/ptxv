// E-WARP-ORDER reconvergence: a warp that diverged once (lane 0 branches around an init store),
// then meets at bar.sync (or a shfl.sync / elect.sync), then issues the converged strong pair
// of e_warp_order_div CONV.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_warp_order_reconv(.param .u64 out_p)
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 4 .b32 x;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, x;
    setp.eq.u32 %p1, %r1, 0;
    setp.eq.u32 %p2, %r1, 1;
    @!%p1 bra SKIP;                      // @DIV
    mov.u32 %r3, 0;
    st.shared.u32 [%r2], %r3;            // @INIT
SKIP:
    bar.sync 0;                          // @BAR
    mov.u32 %r10, 1;
    mov.u32 %r11, 2;
    mov.u32 %r12, 0;
    mov.u32 %r13, 0;
    @%p1 st.volatile.shared.u32 [%r2], %r10;    // @ST1
    @%p2 ld.volatile.shared.u32 %r12, [%r2];
    @%p1 st.volatile.shared.u32 [%r2], %r11;    // @ST2
    @%p2 ld.volatile.shared.u32 %r13, [%r2];
    bar.warp.sync -1;
    @!%p2 bra DONE;
    st.global.u32 [%rd1], %r12;
    st.global.u32 [%rd1+4], %r13;
DONE:
    ret;
}
