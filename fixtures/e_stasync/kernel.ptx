// st.async fixture: rank 1 of a 2-CTA cluster stores one word into rank 0's shared memory with
// st.async ... mbarrier::complete_tx::bytes; rank 0 arms its mbarrier with expect_tx(4), waits
// for the transaction bytes, then reads the word and writes it out.
//   good: as above (clean)
//   SA1 : rank 0 expects 8 bytes: the barrier never completes (deadlock)
//   SA2 : rank 0 reads the word without waiting (race)
//   SA3 : rank 0 neither waits nor reads: it can exit while the st.async is in flight
//         (violation, S-REMOTE-INFLIGHT)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_stasync(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    .shared .align 8 .b8 bar[8];
    .shared .align 4 .b32 buf;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %cluster_ctarank;
    mov.u32 %r2, bar;
    mov.u32 %r3, buf;
    setp.ne.u32 %p0, %r0, 0;
    setp.ne.u32 %p1, %r1, 0;
    @%p0 bra SYNC;
    @%p1 bra SYNC;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    fence.mbarrier_init.release.cluster;
SYNC:
    barrier.cluster.arrive.relaxed.aligned;
    barrier.cluster.wait.aligned;
    @%p0 bra DONE;
    @%p1 bra SENDER;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r2], 4;   // @EXPECT
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p2, [%r2], 0;   // @POLL
    @!%p2 bra WAIT;                                                           // @LOOP
    ld.shared.u32 %r5, [%r3];                                                 // @READ
    st.global.u32 [%rd1], %r5;                                                // @READ
    bra DONE;
SENDER:
    mapa.shared::cluster.u32 %r6, %r3, 0;
    mapa.shared::cluster.u32 %r7, %r2, 0;
    mov.u32 %r8, 0x1234;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r6], %r8, [%r7];
DONE:
    ret;
}
