//
// S-INIT through shared memory: threads 16..31 skip a predicated load, every thread stores
// its register to shared memory, a barrier, then every thread loads it back; a store under
// the load's predicate discards the undefined values (the shape of cute
// FusedRMSNormCombineFwdParallelTOPKStream's reduction buffer).
//
.version 9.0
.target sm_103a
.address_size 64

.shared .align 4 .b8 buf[128];

.visible .entry uninit_smem(
	.param .u64 in_ptr,
	.param .u64 out_ptr
)
.reqntid 32
{
	.reg .pred %p<2>;
	.reg .b32 %r<8>;
	.reg .b64 %rd<8>;

	ld.param.u64 %rd1, [in_ptr];
	ld.param.u64 %rd2, [out_ptr];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p1, %r1, 16;
	mul.wide.u32 %rd3, %r1, 4;
	add.s64 %rd4, %rd1, %rd3;
	@%p1 ld.global.u32 %r2, [%rd4];
	mov.u32 %r3, buf;
	shl.b32 %r4, %r1, 2;
	add.s32 %r5, %r3, %r4;
	st.shared.u32 [%r5], %r2;
	bar.sync 0;
	xor.b32 %r6, %r4, 4;
	add.s32 %r6, %r3, %r6;
	ld.shared.u32 %r7, [%r6];
	add.s64 %rd5, %rd2, %rd3;
	@%p1 st.global.u32 [%rd5], %r7; // @STORE
	ret;
}
