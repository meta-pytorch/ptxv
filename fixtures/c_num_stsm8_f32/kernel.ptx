.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_stsm8_f32(.param .u64 pout)
{
	.reg .pred %p<4>;
	.reg .b32 %r<24>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<8>;
	.shared .align 16 .b8 smem[256];
	ld.param.u64 %rd1, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	mov.u32 %r1, %tid.x;
	cvt.rn.f32.u32 %f1, %r1;
	add.rn.f32 %f2, %f1, 0f3DCCCCCD;
	mov.b32 %r10, %f2;
	mov.u32 %r2, smem;
	shl.b32 %r3, %r1, 2;
	add.u32 %r4, %r2, %r3;
	st.shared.f32 [%r4], 0f00000000;
	st.shared.f32 [%r4+128], %f2;
	bar.sync 0;
	and.b32 %r5, %r1, 7;
	shl.b32 %r6, %r5, 4;
	add.u32 %r7, %r2, %r6;
	stmatrix.sync.aligned.m16n8.x1.trans.shared.b8 [%r7], {%r10};
	shl.b32 %r11, %r1, 2;
	mul.lo.u32 %r12, %r11, 0x01010101;
	add.u32 %r13, %r12, 0x03020100;
	add.u32 %r14, %r7, 128;
	stmatrix.sync.aligned.m16n8.x1.trans.shared.b8 [%r14], {%r13};
	bar.sync 0;
	ld.shared.f32 %f3, [%r4];
	ld.shared.f32 %f4, [%r4+128];
	mul.wide.u32 %rd2, %r1, 4;
	add.s64 %rd3, %rd1, %rd2;
	st.global.f32 [%rd3], %f3;
	st.global.f32 [%rd3+128], %f4;
	ret;
}
