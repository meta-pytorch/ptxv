// MISS 140: C-TICKET's warp check with lane 0's claim ordered before lane 1's only by an
// S-FENCE-SC edge whose coherence pair is on a second counter, shared with another warp.
// Lane 0: data = 7; c0 = atom.add(W); F1 = fence.sc.gpu; A = atom.add(W2) (result stored).
// Thread 32: B = atom.add(W2) (result stored); st.release.gpu flag = 1.
// Lane 1: spin ld.acquire.gpu flag; F2 = fence.sc.gpu; c1 = atom.add(W); reads data.
// With A before B: F1 -> F2, so data -> read and c0 -> c1. With B before A: no edge, a race.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pdata, .param .u64 pflag, .param .u64 pw, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [pflag];
    ld.param.u64 %rd3, [pw];
    ld.param.u64 %rd4, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 bra L0;
    setp.eq.u32 %p1, %r1, 1;
    @%p1 bra L1;
    setp.eq.u32 %p1, %r1, 32;
    @%p1 bra LX;
    bra DONE;
L0:
    mov.u32 %r2, 7;
    st.global.u32 [%rd1], %r2;
    atom.global.add.u32 %r3, [%rd3], 1;
    st.global.u32 [%rd4], %r3;
    fence.sc.gpu;
    atom.global.add.u32 %r6, [%rd3+4], 1;
    st.global.u32 [%rd4+16], %r6;
    bra DONE;
LX:
    atom.global.add.u32 %r6, [%rd3+4], 1;
    st.global.u32 [%rd4+20], %r6;
    mov.u32 %r2, 1;
    st.release.gpu.global.u32 [%rd2], %r2;
    bra DONE;
L1:
    ld.acquire.gpu.global.u32 %r4, [%rd2];
    setp.eq.u32 %p2, %r4, 0;
    @%p2 bra L1;
    fence.sc.gpu;
    atom.global.add.u32 %r3, [%rd3], 1;
    st.global.u32 [%rd4+8], %r3;
    ld.global.u32 %r5, [%rd1];
    st.global.u32 [%rd4+12], %r5;
DONE:
    ret;
}
