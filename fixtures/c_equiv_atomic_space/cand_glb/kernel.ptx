.version 8.8
.target sm_103a
.address_size 64

.visible .entry cand_glb(.param .u64 px, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<4>;
    .reg .b64 %rd<8>;
    mov.u32 %r1, %tid.x;
    ld.param.u64 %rd1, [px];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [pout];
    cvta.to.global.u64 %rd2, %rd2;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.f32 %f1, [%rd4];
    add.u64 %rd5, %rd2, %rd3;
    mov.f32 %f2, 0f00000000;
    st.global.f32 [%rd5], %f2;
    red.global.add.f32 [%rd5], %f1;
    ret;
}
