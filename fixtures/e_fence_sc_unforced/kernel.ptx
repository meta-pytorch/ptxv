// S-FENCE-SC: SC fences without a forcing pair of atomics give no edge. Lanes 0 and 1 of one
// converged warp store data[lane], run fence.sc.gpu, and lane 1 loads data[0]. No atomic, so
// no Fence-SC order is forced: a race in every PTX execution (lane 1's fence before lane 0's is
// a valid Fence-SC order). The model runs the fence step in lane order only, so a rule that
// orders SC fences as executed reports clean (srcmut sc-drop-forcing). SASS: E-LOCKSTEP.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pdata, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    add.u32 %r2, %r1, 100;
    mul.wide.u32 %rd4, %r1, 4;
    add.s64 %rd5, %rd1, %rd4;
    st.global.u32 [%rd5], %r2;
    fence.sc.gpu;
    setp.ne.u32 %p1, %r1, 1;
    @%p1 bra DONE;
    ld.global.u32 %r4, [%rd1];
    st.global.u32 [%rd3], %r4;
DONE:
    ret;
}
