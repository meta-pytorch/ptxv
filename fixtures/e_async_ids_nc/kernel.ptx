// S-NC with async actor ids (MISS 68). k0 (1 CTA x 32): thread 31 (the last thread of grid 0)
// reads src[0..4) with ld.global.nc, then issues N bulk stores (cp.async.bulk.global.shared::cta,
// 16 bytes, each waited for) into dummy, then one more 16-byte bulk store into src[0..4): a write
// of bytes an .nc load of the same kernel read (S-NC: violation). With N = 4096 the last store is
// the thread's 4097th async op (serial 4096); with a fixed stride of 4096 ids per thread its id
// was grid 1 thread 32's first. k1 (stream-ordered after k0, 1 CTA x 32): nothing visible.
// fence.proxy.async orders the generic-proxy .nc read before the async-proxy store (S-GPROXY).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k0(.param .u64 psrc, .param .u64 pdummy, .param .u64 pout, .param .u32 pn)
.reqntid 32
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;
    .shared .align 128 .b32 tile[4];

    ld.param.u64    %rd1, [psrc];
    ld.param.u64    %rd2, [pdummy];
    ld.param.u64    %rd3, [pout];
    ld.param.u32    %r9, [pn];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32         %r1, %tid.x;
    setp.ne.u32     %p1, %r1, 31;
    @%p1 bra        $L_end;
    ld.global.nc.u32 %r2, [%rd1];                   // @SRC
    mov.u32         %r10, tile;
    mov.u32         %r11, 5;
    st.shared.v4.u32 [%r10], {%r11, %r11, %r11, %r11};
    fence.proxy.async.shared::cta;
    mov.u32         %r12, 0;
$L_loop:
    setp.ge.u32     %p2, %r12, %r9;
    @%p2 bra        $L_last;
    cp.async.bulk.global.shared::cta.bulk_group [%rd2], [%r10], 16;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
    add.u32         %r12, %r12, 1;
    bra.uni         $L_loop;
$L_last:
    fence.proxy.async;                              // generic-proxy .nc read before the async-proxy write (S-GPROXY)
    cp.async.bulk.global.shared::cta.bulk_group [%rd1], [%r10], 16;   // @LAST
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
    st.global.u32   [%rd3], %r2;
$L_end:
    ret;
}

.visible .entry k1(.param .u64 pout2)
.reqntid 32
{
    .reg .b32   %r<4>;
    .reg .b64   %rd<4>;
    ld.param.u64    %rd1, [pout2];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 4;
    add.s64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r1;
    ret;
}
