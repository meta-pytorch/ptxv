// S-DSMEM: a shared address is (cluster rank << 24) | offset, and in a cluster launch a
// shared::cta access must name the CTA's own rank (GB300 traps with an illegal instruction
// otherwise, probes/reserved_smem). Each CTA of a 2-CTA cluster stores to its own shared word
// and reads it back.
//   good: the CTA's own address (rank byte = its rank): clean.
//   PEER: the rank byte flipped (the peer CTA's address) in a shared::cta store: fault.
//   CLUSTER: the same flipped address through st.shared::cluster: a DSMEM store into the peer,
//            which may have exited (no cluster barrier), and the own word is never written.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_dsmem_rank(.param .u64 out_p)
.reqnctapercluster 2, 1, 1
{
    .shared .align 4 .b32 w;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, w;
    mov.u32 %r3, 0;                      // @FLIP
    xor.b32 %r4, %r2, %r3;
    add.u32 %r5, %r1, 7;
    st.shared.u32 [%r4], %r5;            // @SPACE
    bar.sync 0;
    ld.shared.u32 %r6, [%r2];
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r6;
    ret;
}
