// Async actor ids with --slices (MISS 68). One grid, 2 CTAs x 32. CTA 0 thread 31 issues N bulk
// stores into dummy (each waited for), then one 16-byte bulk store into src[0..4). CTA 1 thread 0
// reads src[0] with ld.global.nc (no synchronization: also a race). With N = 4096 the store is
// thread 31's 4097th async op; with a fixed stride of 4096 ids per thread its id decoded as
// thread 32 (CTA 1), and --slices' footprint attributed the write to cluster 1.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 psrc, .param .u64 pdummy, .param .u64 pout, .param .u32 pn)
.reqntid 32
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;
    .shared .align 128 .b32 tile[4];

    ld.param.u64    %rd1, [psrc];
    ld.param.u64    %rd2, [pdummy];
    ld.param.u64    %rd3, [pout];
    ld.param.u32    %r9, [pn];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    setp.ne.u32     %p3, %r2, 0;
    @%p3 bra        $L_reader;
    setp.ne.u32     %p1, %r1, 31;
    @%p1 bra        $L_end;
    mov.u32         %r10, tile;
    mov.u32         %r11, 5;
    st.shared.v4.u32 [%r10], {%r11, %r11, %r11, %r11};
    fence.proxy.async.shared::cta;                  // @N
    mov.u32         %r12, 0;
$L_loop:
    setp.ge.u32     %p2, %r12, %r9;
    @%p2 bra        $L_last;
    cp.async.bulk.global.shared::cta.bulk_group [%rd2], [%r10], 16;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
    add.u32         %r12, %r12, 1;
    bra.uni         $L_loop;
$L_last:
    cp.async.bulk.global.shared::cta.bulk_group [%rd1], [%r10], 16;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
    bra.uni         $L_end;
$L_reader:
    setp.ne.u32     %p1, %r1, 0;
    @%p1 bra        $L_end;
    ld.global.nc.u32 %r3, [%rd1];
    st.global.u32   [%rd3], %r3;
$L_end:
    ret;
}
