// E-REMOTE-FIFO (remote_fifo = true) with S-REMOTE-INFLIGHT's pipe order. Rank 0 warp 0: lane 1
// stores g into rank 1 (st.shared::cluster, `@ST`), then arrives .release.cta on rank 1's M1
// (X); lane 0 arrives on M1 (Y), then on M2 (Z). X and Y share one remote pipe (warp 0, CTA 1,
// M1). Lane 1's code comes first, so the explored schedule issues X before Y. Z's landing
// delivers Y first (E-REMOTE-FIFO: Y's issue happens-before Z's) but not X as drained (lane 1,
// unordered with Z): X, the pipe's head, lands first as its own step would (MISS 154's FIFO),
// so no op behind a pending head is consumed (`deliver_fifo_before`). Until then Y landed
// behind the pending X: DPOR's non-head backtrack (dpor::NONHEAD_BACKTRACKS) was taken here (SASS).
// Rank 1 waits on M1 (count 2) and M2 (count 1), then reads g (`@RD`).
//   good: with lane 1's store: race on g (.release.cta orders nothing for rank 1).
//   NOST: without it: rank 1 reads g unwritten (S-INIT violation).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_remote_fifo_nonhead(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 4 .b32 g;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, g;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    or.pred %p2, %p0, %p1;
    @%p2 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 2;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.gt.u32 %p3, %r1, 1;
    @%p3 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r5, 1;
    mapa.shared::cluster.u32 %r13, %r8, 1;
    mov.u32 %r14, 42;
    @!%p1 bra LANE0;
    st.shared::cluster.u32 [%r13], %r14;   // @ST
    mbarrier.arrive.release.cta.shared::cluster.b64 _, [%r9];
    bra END;
LANE0:
    mbarrier.arrive.release.cta.shared::cluster.b64 _, [%r9];
    mbarrier.arrive.release.cta.shared::cluster.b64 _, [%r10];
    bra END;
RANK1:
    @%p1 bra END;
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r4], 0;
    @!%p4 bra WAIT;
WAIT2:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra WAIT2;
    ld.shared.u32 %r15, [%r8];   // @RD
    st.global.u32 [%rd1], %r15;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
