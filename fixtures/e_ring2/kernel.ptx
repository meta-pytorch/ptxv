// Fixture for C-RING (E-WELLSYNC): the ring of e_ring across two GPUs, laid out as DeepEP
// lays out its channels: the ring's slots and both counters live in the consumer's memory
// (GPU 1). The producer (GPU 0) writes payload and tail through peer pointers and polls the
// head remotely; every counter access is at .sys scope.
//
//   Producer: for each chunk of CH = 2 items, wait until the ring has room
//   (head >= tail + CH - CAP, ld.acquire.sys), write the items into their slots (plain
//   stores), then publish the new tail with st.release.sys.
//   Consumer: poll the tail until it moves (ld.acquire.sys), copy every published item i in
//   [head, tail) to out[i] = 3 * slot + i + 1, then publish the new head with st.release.sys,
//   until N = 6 items are consumed (CAP = 4: slots 0 and 1 are reused).
//
// Mutants (case.toml): R1 publish before the payload write; R2 the consumer reads one slot
// past the tail it observed; R3 slot reuse without waiting for the head; R4 a threshold
// branch on the observed batch size; R5 the tail released at .gpu scope (it must reach the
// other GPU); R6 a relaxed tail store; R7 the consumer counts its batches.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_ring2(
    .param .u32 role_p,
    .param .u64 src_p,
    .param .u64 buf_p,
    .param .u64 head_p,
    .param .u64 tail_p,
    .param .u64 out_p
)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<32>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [src_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [buf_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [head_p];
    cvta.to.global.u64 %rd3, %rd3;
    ld.param.u64 %rd4, [tail_p];
    cvta.to.global.u64 %rd4, %rd4;
    ld.param.u64 %rd5, [out_p];
    cvta.to.global.u64 %rd5, %rd5;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    ld.param.u32 %r2, [role_p];
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra CONSUMER;

    // ---- producer: %r3 = tail (items published)
    mov.u32 %r3, 0;
CHUNK:
    add.u32 %r4, %r3, -2;                   // tail + CH - CAP
WAITH:
    ld.acquire.sys.global.u32 %r5, [%rd3];  // @WAITH
    setp.gt.s32 %p2, %r4, %r5;
    @%p2 bra WAITH;
    // (head wait slot)
    mov.u32 %r6, 0;                         // j
ITEM:
    add.u32 %r7, %r3, %r6;                  // item index
    mul.wide.u32 %rd6, %r7, 4;
    add.u64 %rd7, %rd1, %rd6;
    ld.global.u32 %r8, [%rd7];              // src[item]
    and.b32 %r9, %r7, 3;                    // slot = item mod CAP
    mul.wide.u32 %rd8, %r9, 4;
    add.u64 %rd9, %rd2, %rd8;
    st.global.u32 [%rd9], %r8;              // @PAYLOAD
    add.u32 %r6, %r6, 1;
    setp.lt.u32 %p3, %r6, 2;
    @%p3 bra ITEM;
    add.u32 %r3, %r3, 2;
    st.release.sys.global.u32 [%rd4], %r3;  // @PUBLISH
    setp.lt.u32 %p3, %r3, 6;
    @%p3 bra CHUNK;
    bra DONE;

    // ---- consumer: %r10 = head (items consumed), %r11 = observed tail
CONSUMER:
    mov.u32 %r10, 0;
    mov.u32 %r20, 0;                        // batches (R7)
BATCH:
POLL:
    ld.acquire.sys.global.u32 %r11, [%rd4]; // @POLL
    setp.eq.u32 %p4, %r11, %r10;
    @%p4 bra POLL;
    add.u32 %r20, %r20, 1;
    mov.u32 %r12, %r10;                     // i
COPY:
    and.b32 %r13, %r12, 3;
    mul.wide.u32 %rd10, %r13, 4;
    add.u64 %rd11, %rd2, %rd10;
    ld.global.u32 %r14, [%rd11];            // slot
    mul.lo.u32 %r15, %r14, 3;
    add.u32 %r15, %r15, %r12;
    add.u32 %r15, %r15, 1;                  // @VALUE
    mul.wide.u32 %rd12, %r12, 4;
    add.u64 %rd13, %rd5, %rd12;
    st.global.u32 [%rd13], %r15;
    add.u32 %r12, %r12, 1;
    setp.lt.u32 %p5, %r12, %r11;            // @BOUND
    @%p5 bra COPY;
    mov.u32 %r10, %r11;
    st.release.sys.global.u32 [%rd3], %r10; // @HEAD
    setp.lt.u32 %p6, %r10, 6;
    @%p6 bra BATCH;
    // (batch count slot)                   // @COUNT
DONE:
    ret;
}
