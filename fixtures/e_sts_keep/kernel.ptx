// The lanes of one shared store write their tid to one word; every lane then reads the word
// and traps if lane 0's value remains (GB300 keeps the lowest lane's bytes, E-HW-STS-LOWEST).
// A strict SASS level that keeps lane order (lane 31's value) never traps. Variants: HIGH
// traps on lane 31's value instead; OUT stores the word to out[tid] (no trap).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry sts_keep(.param .u64 out_p)
.maxntid 32, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 w;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, w;
    st.volatile.shared.u32 [%r2], %r1;
    bar.warp.sync -1;
    ld.volatile.shared.u32 %r3, [%r2];
    setp.eq.u32 %p1, %r3, 0;   // @CMP
    @%p1 trap;                 // @TRAP
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
