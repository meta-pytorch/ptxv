// E-CPASYNC: each cp.async.mbarrier.arrive lands the copies it tracks as a fresh async actor,
// from the thread's async actor ids (shared with its TMA and bulk operations; the last is its
// wait actor), past which one would alias another actor's. One thread copies 4 bytes, tracks
// the copy with cp.async.mbarrier.arrive.noinc and waits for the phase, N times.
//   good: N = 4000: clean.
//   MANY: N = 4100: clean (a lone thread has 2^30 ids); with the ids cut to 4096
//   (async_actor_ids_fail_closed), an unmodeled fault at the 4096th arrive.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_async_actor_cap(.param .u64 out_p, .param .u64 in_p)
{
    .shared .align 16 .b8 slot[16];
    .shared .align 8 .b64 mb;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r2, slot;
    mov.u32 %r5, mb;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    mov.u32 %r9, 0;
    mov.u32 %r8, 4000;                             // @N
LOOP:
    cp.async.ca.shared.global [%r2], [%rd2], 4;
    cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%r5];
    and.b32 %r10, %r9, 1;
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [%r5], %r10;
    @!%p2 bra WAIT;
    add.u32 %r9, %r9, 1;
    setp.lt.u32 %p1, %r9, %r8;
    @%p1 bra LOOP;
    ld.shared.u32 %r4, [%r2];
    st.global.u32 [%rd1], %r4;
    ret;
}
