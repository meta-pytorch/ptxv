// fixtures/clock_pace (E-CLOCK, PTXV_CLOCK_STEP): store pacing. Thread 0 stores out[0], waits
// until %clock64 has advanced by 1000 cycles, then stores out[1]. With the clock reading 0
// (default) the wait never ends; with a clock step it ends after 1000 / step reads.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry clock_pace(
    .param .u64 out
)
.maxntid 32, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;

    mov.u32         %r0, %tid.x;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        DONE;
    ld.param.u64    %rd4, [out];
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32         %r1, 1;
    st.global.u32   [%rd4], %r1;
    mov.u64         %rd1, %clock64;
WAIT:
    mov.u64         %rd2, %clock64;
    sub.u64         %rd3, %rd2, %rd1;
    setp.lt.u64     %p1, %rd3, 1000;
    @%p1 bra        WAIT;
    mov.u32         %r2, 2;
    st.global.u32   [%rd4+4], %r2;
DONE:
    ret;
}
