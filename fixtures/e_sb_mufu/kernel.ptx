// L-OPCLASS: MUFU is a variable-latency unit; its register result needs a write scoreboard
// that the consumer waits on. Each thread loads x, computes ex2.approx.f32(x) (MUFU.EX2) and
// stores it.
//   good: as compiled: clean.
//   NOWAIT: the store's wait mask cleared (case.toml patch): the store may read the register
//           before MUFU writes it: the scoreboard check must flag it.
// Binary-only: kernel.cubin is kernel.ptx through ptxas 13.0 (-arch=sm_103a).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_sb_mufu(.param .u64 out_p, .param .u64 in_p)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.u64 %rd4, %rd2, %rd3;
    ld.global.f32 %f1, [%rd4];
    ex2.approx.ftz.f32 %f2, %f1;
    add.u64 %rd5, %rd1, %rd3;
    st.global.f32 [%rd5], %f2;
    ret;
}
