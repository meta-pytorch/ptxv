.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_equiv_local_ref_local16(.param .u64 px, .param .u64 py, .param .u64 pout, .param .u64 pz)
{
    .reg .pred %p<4>;
    .reg .b16 %rs<8>;
    .reg .b32 %r<32>;
    .reg .f32 %f<24>;
    .reg .b64 %rd<32>;
    .local .align 8 .b8 L[64];
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd7, [py];
    ld.param.u64 %rd2, [pout];
    ld.param.u64 %rd15, [pz];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd7, %rd7;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd15, %rd15;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd3, %r0, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd8, %rd7, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    add.s64 %rd16, %rd15, %rd3;
    ld.global.f32 %f4, [%rd4];
    st.global.u32 [%rd16], 0;
    mov.u64 %rd6, L;
    ld.volatile.global.u32 %r30, [%rd16];
    cvt.u64.u32 %rd17, %r30;
    add.s64 %rd18, %rd6, %rd17;
    mov.b32 %r8, %f4;
    mov.b32 {%rs1, %rs2}, %r8;
    st.local.b16 [%rd6+16], %rs2;
    ld.local.b16 %rs3, [%rd18+16];
    setp.gt.u16 %p1, %rs3, 16320;
    @%p1 bra BIG;
    ld.global.f32 %f7, [%rd8];
    mul.rn.f32 %f6, %f4, %f7;
    bra.uni JOIN;
BIG:
    ld.global.f32 %f7, [%rd8];
    add.rn.f32 %f6, %f4, %f7;
JOIN:
    st.global.f32 [%rd5], %f6;
    ret;
}
