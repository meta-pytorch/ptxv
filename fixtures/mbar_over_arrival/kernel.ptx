// fixtures/mbar_over_arrival: plain mbarrier arrivals, more than the barrier expects, whose
// order matters. The barrier expects 3 arrivals. Warp 0 lane 0 writes data then arrives; warp 2
// lane 0 and warps 4 and 5 lane 0 arrive (variant `lanes`: warp 2 lanes 0..2 arrive in one
// warp step, warps 4 and 5 exit); warp 3 lane 0 waits for phase 0 and reads data. If the other
// three arrivals come first they complete phase 0 without warp 0's: the consumer may read data
// before warp 0 writes it (a race). Warp 1 and the other lanes exit at once.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mbar_over_arrival(.param .u64 out)
{
    .reg .pred %p<8>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .shared .align 8 .b64 bar;
    .shared .align 4 .b32 data;
    mov.u32 %r0, %tid.x;
    and.b32 %r1, %r0, 31;
    shr.u32 %r2, %r0, 5;
    mov.u32 %r3, bar;
    mov.u32 %r4, data;
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r3], 3;
    st.shared.u32 [%r4], 0;
SKIP_INIT:
    bar.sync 0;
    setp.eq.u32 %p2, %r2, 2;
    @%p2 bra W2;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra PRODUCER;
    setp.eq.u32 %p2, %r2, 3;
    @%p2 bra WAIT;
    setp.eq.u32 %p2, %r2, 1;
    @%p2 bra DONE;
    mbarrier.arrive.shared::cta.b64 _, [%r3]; // @SINGLE
    bra DONE;
W2:
    setp.gt.u32 %p4, %r1, 0; // @LANES
    @%p4 bra DONE;
    mbarrier.arrive.shared::cta.b64 _, [%r3];
    bra DONE;
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r3], 0;
    @!%p3 bra WAIT;
    ld.shared.u32 %r5, [%r4];
    ld.param.u64 %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    st.global.u32 [%rd1], %r5;
    bra DONE;
PRODUCER:
    st.shared.u32 [%r4], 42;
    mbarrier.arrive.shared::cta.b64 _, [%r3];
DONE:
    ret;
}
