// fixtures/smid_slot (E-SMID): thread 0 of each CTA stores its %ctaid.x to out[%smid % 4],
// and CTA 0 stores %nsmid to out[4]. Distinct slots when the two CTAs sit on different SMs
// (mod 4); a write-write race when they share one (placement `same`).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry smid_slot(
    .param .u64 out
)
.maxntid 32, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<16>;

    mov.u32         %r0, %tid.x;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        DONE;
    mov.u32         %r1, %smid;
    and.b32         %r2, %r1, 3;
    mov.u32         %r4, %ctaid.x;
    ld.param.u64    %rd4, [out];
    cvta.to.global.u64 %rd4, %rd4;
    mul.wide.u32    %rd5, %r2, 4;
    add.u64         %rd6, %rd4, %rd5;
    st.global.u32   [%rd6], %r4;
    setp.ne.u32     %p1, %r4, 0;
    @%p1 bra        DONE;
    mov.u32         %r3, %nsmid;
    st.global.u32   [%rd4+16], %r3;
DONE:
    ret;
}
