// Two halves of a warp execute different shfl.sync instructions with a full mask.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pout)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<6>;
    .reg .pred %p<3>;
    ld.param.u64 %rd1, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r2, %r1, 7;
    add.u32 %r2, %r2, 100;
    xor.b32 %r4, %r1, 16;
    setp.lt.u32 %p1, %r1, 16;
    @%p1 bra LO;
    add.u32 %r5, %r2, 1000;
    shfl.sync.idx.b32 %r3, %r5, %r4, 31, -1;
    bra.uni J;
LO:
    shfl.sync.idx.b32 %r3, %r2, %r4, 31, -1; // @M
J:
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
