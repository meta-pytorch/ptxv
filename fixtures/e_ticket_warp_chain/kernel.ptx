// MISS 140: C-TICKET's warp check with claims interleaved across warps and an order-created
// chain lane 0 -> thread 32 -> lane 1.
// Lane 0: data = 7; fence.acq_rel.gpu; c0 = atom.add(W) (relaxed).
// Thread 32: cx = atom.add(W); fence.acq_rel.gpu (acquires c0's release when c0 precedes cx);
//   st.relaxed flag = 1.
// Lane 1: spin ld.relaxed flag; fence.acq_rel.gpu; c1 = atom.add(W); reads data.
// Race-free only in claim orders with c0 before cx: in the run c0, cx, c1 the per-warp pair
// (c0, c1) is ordered by an edge the claim order created. With cx first, lane 1's read races
// with lane 0's store. Every claim result is stored (steers outputs).
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pdata, .param .u64 pflag, .param .u64 pw, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [pdata];
    ld.param.u64 %rd2, [pflag];
    ld.param.u64 %rd3, [pw];
    ld.param.u64 %rd4, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 bra L0;
    setp.eq.u32 %p1, %r1, 1;
    @%p1 bra L1;
    setp.eq.u32 %p1, %r1, 32;
    @%p1 bra LX;
    bra DONE;
L0:
    mov.u32 %r2, 7;
    st.global.u32 [%rd1], %r2;
    fence.acq_rel.gpu;
    atom.global.add.u32 %r3, [%rd3], 1;
    st.global.u32 [%rd4], %r3;
    bra DONE;
LX:
    atom.global.add.u32 %r3, [%rd3], 1;
    fence.acq_rel.gpu;                           // @XFENCE
    mov.u32 %r2, 1;
    st.relaxed.gpu.global.u32 [%rd2], %r2;
    st.global.u32 [%rd4+4], %r3;
    bra DONE;
L1:
    ld.relaxed.gpu.global.u32 %r4, [%rd2];
    setp.eq.u32 %p2, %r4, 0;
    @%p2 bra L1;
    fence.acq_rel.gpu;
    atom.global.add.u32 %r3, [%rd3], 1;
    st.global.u32 [%rd4+8], %r3;
    ld.global.u32 %r5, [%rd1];                   // @READ
    st.global.u32 [%rd4+12], %r5;
DONE:
    ret;
}
