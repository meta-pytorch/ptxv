// An input word indexes a by-value table parameter; a branch tests the entry read.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_cov_ldconst(.param .u64 out_p, .param .u64 in_p, .param .align 4 .b8 tbl[16])
.reqntid 32
{
    .reg .b32 %r<20>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd2, %rd3;
    ld.global.u32 %r2, [%rd4];
    and.b32 %r3, %r2, 3;
    mul.wide.u32 %rd5, %r3, 4;
    mov.u64 %rd6, tbl;
    add.s64 %rd7, %rd6, %rd5;
    ld.param.u32 %r5, [%rd7];
    mov.u32 %r6, 1;
    setp.lt.u32 %p1, %r5, 4;
    @!%p1 bra SKIP;
    mov.u32 %r6, 2;
SKIP:
    mul.wide.u32 %rd9, %r5, 4;                     // the store's index is the table entry
    add.s64 %rd8, %rd1, %rd9;
    st.global.u32 [%rd8], %r6;
    ret;
}
