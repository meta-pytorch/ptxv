// fixtures/e_cas_retry: an integer add by compare-and-swap retry loop, as ptxas emits for a
// 16-bit atomic (plain seed load of the word, then add, CAS, compare refreshed from the value
// the CAS returned). Thread t (2 CTAs x 2 threads) adds t + 1 to w[0]; every thread also adds
// 1 to w[1] with red.global.add (the word the `seedaddr` variant seeds from).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry e_cas_retry(
    .param .u64 pw,
    .param .u64 pout
)
.maxntid 2, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;
    .reg .pred  %p<4>;

    ld.param.u64    %rd1, [pw];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    mad.lo.u32      %r3, %r2, 2, %r1;
    add.u32         %r4, %r3, 1;
    mul.wide.u32    %rd3, %r3, 4;
    add.s64         %rd4, %rd2, %rd3;
    red.global.add.u32 [%rd1+4], 1;
    ld.global.u32   %r5, [%rd1];              // @seed
    mov.u32         %r10, 0;                  // @use
$L_retry:
    add.u32         %r6, %r5, %r4;
    atom.global.cas.b32 %r7, [%rd1], %r5, %r6;
    setp.ne.u32     %p1, %r7, %r5;            // @exit
    mov.u32         %r5, %r7;                 // @refresh
    @%p1 bra        $L_retry;
    st.global.u32   [%rd4], %r10;
    ret;
}
