// S-MBAR-SCOPE: a 2-CTA hand-off. Rank 0 stores a tile id into rank 1's shared memory and
// arrives on rank 1's mbarrier; rank 1 waits on it, reads the id and writes it out. The arrive
// and the wait are in different CTAs, so they synchronize only when both are at cluster scope
// (PTX ISA 8.7 morally strong, 8.9.4 release / acquire patterns).
//   good : weak st.shared::cluster, mbarrier.arrive.release.cluster, try_wait.acquire.cluster
//   PFC  : weak st.shared::cluster, fence.proxy.async.shared::cluster, a .release.cta arrive,
//          an .acquire.cta wait: no synchronization, the read races with the store (a stale
//          read of this protocol was reported on GB200)
//   PFCW : as PFC with the wait at .acquire.cluster (one side only): race
//   PFCA : .release.cluster arrive, .acquire.cta wait (one side only): race
//   FEN  : fence.acq_rel.cluster before a .release.cta arrive, .acquire.cta wait: the
//          .cta arrive is not morally strong with the peer's wait, so no release pattern
//          forms: race on the PTX front
//   FRC  : fence.acq_rel.cluster before a .relaxed.cta arrive, .acquire.cluster wait: race (PTX)
//   STA  : arrive.expect_tx.relaxed.cluster (4 bytes) and st.async with complete_tx, wait at
//          .acquire.cluster: the complete-tx is a cluster-scope release: clean
//   STAC : as STA with an .acquire.cta wait: the complete-tx is the issuing thread's (rank
//          0), so the wait does not pair with it (contract: the PTX ISA does not say which
//          thread performs an async unit's complete-tx)
//   NOF  : weak st.shared::cluster, a .release.cta arrive, an .acquire.cta wait, no fence:
//          race (GB300 read stale words, probes/mbar_scope v=1)
//   PCTA : as NOF with fence.proxy.async.shared::cta (SASS MEMBAR.ALL.CTA) before the
//          arrive: race (GB300 read stale words, probes/mbar_scope v=2)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_mbar_scope(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    .shared .align 8 .b8 bar[8];
    .shared .align 4 .b32 slot;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r0, %tid.x;
    mov.u32 %r1, %cluster_ctarank;
    mov.u32 %r2, bar;
    mov.u32 %r3, slot;
    setp.ne.u32 %p0, %r0, 0;
    setp.ne.u32 %p1, %r1, 0;
    @%p0 bra SYNC;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    mov.u32 %r4, 0;
    st.shared.u32 [%r3], %r4;
    fence.mbarrier_init.release.cluster;
SYNC:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    @%p0 bra END;
    @%p1 bra PEER;
    mapa.shared::cluster.u32 %r6, %r3, 1;
    mapa.shared::cluster.u32 %r7, %r2, 1;
    mov.u32 %r8, 42;
    st.shared::cluster.u32 [%r6], %r8;                                   // @STORE
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r7];        // @ARRIVE
    bra END;
PEER:
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p2, [%r2], 0;   // @WAIT
    @!%p2 bra WAIT;
    ld.shared.u32 %r5, [%r3];
    st.global.u32 [%rd1], %r5;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
