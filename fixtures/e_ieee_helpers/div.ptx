.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 input, .param .u64 output) {
 .reg .b64 %p<3>;
 .reg .u32 %t;
 .reg .f32 %f<3>;
 ld.param.u64 %p0, [input];
 ld.param.u64 %p1, [output];
 mov.u32 %t, %tid.x;
 mul.wide.u32 %p2, %t, 8;
 add.u64 %p0, %p0, %p2;
 ld.global.f32 %f0, [%p0];
 ld.global.f32 %f1, [%p0+4];
 div.rn.f32 %f2, %f0, %f1;
 bar.sync 0;
 st.global.f32 [%p1], %f2;
 ret;
}
