// Fixture for MISS 194 (S-SCOPE, complete overlap with the NIC's accesses): states that differ
// only in NicState::acc, which the machine's state hash must include. CTA 0 t0 (A) takes a
// clock branch (E-CLOCK: both sides explored) and posts one signaled RDMA write of src[0..16) to
// dst[0..16) with two data segments (ds 4), split 8+8 (side X: S-NIC-WORD chunks [0,8) and
// [8,16)) or 4+12 (side Y: chunks [0,4), [4,8), [8,16); each segment is chunked from its own
// start). Both sides read and write the same bytes with the same NIC actor; after its CQ poll and
// fence.acquire.sys, A zeroes the WQE and the CQE and its registers, then sets done with
// st.relaxed.sys. CTA 1 t32 (C) polls done with ld.relaxed.sys (no acquire: unordered with the
// NIC write) and reads dst+4 with ld.relaxed.sys.u32: a partial overlap of X's 8-byte chunk
// (mixed-size race), one location with Y's 4-byte chunk (no race). @SIDEF / @SIDET pick the
// shape each side posts.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry conv2(
    .param .u64 src,
    .param .u64 sq,
    .param .u64 cq,
    .param .u64 uar,
    .param .u64 dst,
    .param .u64 done,
    .param .u64 out
)
.maxntid 64, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<48>;

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, %ctaid.x;
    ld.param.u64    %rd1, [src];
    ld.param.u64    %rd2, [sq];
    ld.param.u64    %rd3, [cq];
    ld.param.u64    %rd4, [uar];
    ld.param.u64    %rd5, [dst];
    ld.param.u64    %rd6, [done];
    ld.param.u64    %rd7, [out];
    setp.eq.u32     %p0, %r0, 0;
    setp.eq.u32     %p1, %r1, 0;
    and.pred        %p2, %p0, %p1;
    @%p2 bra        SENDER;
    setp.eq.u32     %p0, %r0, 32;
    setp.eq.u32     %p1, %r1, 1;
    and.pred        %p2, %p0, %p1;
    @%p2 bra        READER;
    bra             DONE;

SENDER:
    mov.u32         %r2, 256;
    st.global.u32   [%rd1], %r2;
    mov.u32         %r2, 257;
    st.global.u32   [%rd1+4], %r2;
    mov.u32         %r2, 258;
    st.global.u32   [%rd1+8], %r2;
    mov.u32         %r2, 259;
    st.global.u32   [%rd1+12], %r2;
    mov.u64         %rd8, %clock64;
    setp.lt.u64     %p3, %rd8, 1000;
    @%p3 bra        SIDE_T;
    bra             SHAPE_X;                                        // @SIDEF
SIDE_T:
    bra             SHAPE_Y;                                        // @SIDET
SHAPE_X:
    mov.u64         %rd9, 8;
    bra             POST;
SHAPE_Y:
    mov.u64         %rd9, 4;
POST:
    // segment 1: %rd9 bytes from src; segment 2: 16 - %rd9 bytes from src + %rd9
    add.u64         %rd10, %rd1, %rd9;
    sub.u64         %rd11, 16, %rd9;
    cvt.u32.u64     %r3, %rd9;
    prmt.b32        %r4, %r3, 0, 0x0123;                            // BE(bc1)
    mov.u32         %r5, 0x00010000;                                // BE(lkey 0x100)
    mov.b64         %rd12, {%r4, %r5};
    cvt.u32.u64     %r3, %rd11;
    prmt.b32        %r4, %r3, 0, 0x0123;                            // BE(bc2)
    mov.b64         %rd13, {%r4, %r5};
    mov.b64         {%r6, %r7}, %rd1;
    prmt.b32        %r8, %r6, 0, 0x0123;
    prmt.b32        %r9, %r7, 0, 0x0123;
    mov.b64         %rd14, {%r9, %r8};                              // BE(src)
    mov.b64         {%r6, %r7}, %rd10;
    prmt.b32        %r8, %r6, 0, 0x0123;
    prmt.b32        %r9, %r7, 0, 0x0123;
    mov.b64         %rd15, {%r9, %r8};                              // BE(src + bc1)
    mov.b64         {%r6, %r7}, %rd5;
    prmt.b32        %r8, %r6, 0, 0x0123;
    prmt.b32        %r9, %r7, 0, 0x0123;
    mov.b64         %rd16, {%r9, %r8};                              // BE(dst)
    mov.u64         %rd20, 0x0442000008000000;                      // WQE 0, RDMA write, qpn 0x42, ds 4
    mov.u64         %rd21, 0x0000000008000000;                      // CQ update
    st.global.v2.b64 [%rd2], {%rd20, %rd21};
    mov.u64         %rd22, 0x0000000000020000;                      // rkey 0x200
    st.global.v2.b64 [%rd2+16], {%rd16, %rd22};
    st.global.v2.b64 [%rd2+32], {%rd12, %rd14};
    st.global.v2.b64 [%rd2+48], {%rd13, %rd15};
    fence.release.gpu;
    mov.u64         %rd23, 0x0042000000010000;
    st.mmio.relaxed.sys.global.b64 [%rd4], %rd23;
CQPOLL:
    ld.relaxed.sys.global.u8 %r10, [%rd3+63];
    and.b32         %r11, %r10, 1;
    setp.ne.u32     %p4, %r11, 0;
    @%p4 bra        CQPOLL;
    fence.acquire.sys;
    // converge: zero what the shapes left differently (the WQE), the CQE and the registers
    mov.u64         %rd24, 0;
    st.global.v2.b64 [%rd2], {%rd24, %rd24};
    st.global.v2.b64 [%rd2+16], {%rd24, %rd24};
    st.global.v2.b64 [%rd2+32], {%rd24, %rd24};
    st.global.v2.b64 [%rd2+48], {%rd24, %rd24};
    st.global.v2.b64 [%rd3], {%rd24, %rd24};
    st.global.v2.b64 [%rd3+16], {%rd24, %rd24};
    st.global.v2.b64 [%rd3+32], {%rd24, %rd24};
    st.global.v2.b64 [%rd3+48], {%rd24, %rd24};
    mov.u64         %rd9, 0;
    mov.u64         %rd10, 0;
    mov.u64         %rd11, 0;
    mov.u64         %rd12, 0;
    mov.u64         %rd13, 0;
    mov.u64         %rd15, 0;
    mov.u32         %r3, 0;
    mov.u32         %r4, 0;
    mov.u32         %r6, 0;
    mov.u32         %r7, 0;
    mov.u32         %r8, 0;
    mov.u32         %r9, 0;
    mov.u32         %r10, 0;
    mov.u32         %r11, 0;
    setp.eq.u32     %p3, %r0, 99;
    setp.eq.u32     %p4, %r0, 99;
    mov.u32         %r2, 1;
    st.relaxed.sys.global.u32 [%rd6], %r2;
    bra             DONE;

READER:
RPOLL:
    ld.relaxed.sys.global.u32 %r12, [%rd6];
    setp.ne.u32     %p5, %r12, 1;
    @%p5 bra        RPOLL;
    ld.relaxed.sys.global.u32 %r13, [%rd5+4];
    setp.eq.u32     %p6, %r13, 12345;
    @%p6 st.global.u32 [%rd7], %r13;
DONE:
    ret;
}
