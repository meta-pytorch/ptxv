// 4096 threads: the last thread (CTA 31, tid 127) copies 16 bytes global -> shared with a
// bulk copy, waits on its mbarrier and stores them. Probes Machine::access's cta_of for an
// async actor (every decoder goes through `async_base` / `actor_thread_of`).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_actor_base(
    .param .u64 src_ptr,
    .param .u64 dst_ptr
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;
    .shared .align 8 .b8 bar[8];
    .shared .align 16 .b8 buf[16];

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, %ctaid.x;
    setp.ne.u32     %p0, %r0, 127;
    setp.ne.or.u32  %p0, %r1, 31, %p0;
    @%p0 bra        DONE;
    mov.u32         %r2, bar;
    mov.u32         %r3, buf;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    fence.mbarrier_init.release.cluster;
    fence.proxy.async.shared::cta;
    ld.param.u64    %rd0, [src_ptr];
    cvta.to.global.u64 %rd1, %rd0;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r2], 16;
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r3], [%rd1], 16, [%r2];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r2], 0;
    @!%p1 bra       WAIT;
    ld.shared.v4.u32 {%r4, %r5, %r6, %r7}, [%r3];
    ld.param.u64    %rd2, [dst_ptr];
    cvta.to.global.u64 %rd3, %rd2;
    st.global.v4.u32 [%rd3], {%r4, %r5, %r6, %r7};
DONE:
    ret;
}
