//
// A race that needs depth: lane 0 of each of 4 warps adds to one shared counter 16 times
// (atom.shared.add: every interleaving of the adds is a distinct state), then lane 0 of
// warps 0 and 1 write one global word with no order between them. A bounded search that goes breadth-first spends its
// budget on the interleavings of the first rounds and never reaches the race; it must then
// say `inconclusive`, never `clean`.
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry deep_race(
	.param .u64 out_ptr
)
.reqntid 1024
{
	.reg .pred %p<4>;
	.reg .b32 %r<12>;
	.reg .b64 %rd<4>;
	.shared .align 4 .b32 buf[1024];

	ld.param.u64 %rd1, [out_ptr];
	mov.u32 %r1, %tid.x;
	shr.u32 %r2, %r1, 5;
	mov.u32 %r3, buf;
	shl.b32 %r4, %r1, 2;
	add.u32 %r5, %r3, %r4;
	mov.u32 %r6, 0;
	st.shared.u32 [%r5], %r6;
	bar.sync 0;
	and.b32 %r7, %r1, 31;
	setp.ne.u32 %p1, %r7, 0;
	@%p1 bra AFTER;
LOOP:
	atom.shared.add.u32 %r8, [%r3], 1;
	add.u32 %r6, %r6, 1;
	setp.lt.u32 %p1, %r6, 16;
	@%p1 bra LOOP;
AFTER:
	setp.ne.u32 %p2, %r7, 0;
	setp.gt.u32 %p3, %r2, 1;
	or.pred %p2, %p2, %p3;
	@%p2 bra DONE;
	st.global.u32 [%rd1], %r8; // @RACE
DONE:
	ret;
}
