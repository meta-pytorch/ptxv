// fixtures/c_num_ctl_addr_f32 (N-NUM-TRACK; the independent review's probe rd_addr_tid): load
// addresses floor(rn(f32(t) * 0.7f)) (an FMUL, no node) and floor(rn(f32(t) - 2^-25)) (an FADD, a
// node). This run reads other elements than the exact computation in 34 of 64 outputs.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_ctl_addr_f32(
	.param .u64 px, .param .u64 py, .param .u64 pz, .param .u64 pout,
	.param .f32 ps, .param .f32 pb
)
{
	.reg .pred %p<8>;
	.reg .b32 %r<16>;
	.reg .f32 %f<32>;
	.reg .b64 %rd<24>;
	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd4, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd4, %rd4;
	ld.param.f32 %f10, [ps];
	ld.param.f32 %f11, [pb];
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd9, %rd4, %rd5;
	cvt.rn.f32.u32 %f12, %r1;
	mul.rn.f32 %f13, %f12, %f10;
	cvt.rmi.u32.f32 %r2, %f13;
	mul.wide.u32 %rd10, %r2, 4;
	add.s64 %rd10, %rd1, %rd10;
	ld.global.f32 %f14, [%rd10];
	st.global.f32 [%rd9], %f14;
	add.rn.f32 %f15, %f12, %f11;
	cvt.rmi.u32.f32 %r3, %f15;
	mul.wide.u32 %rd11, %r3, 4;
	add.s64 %rd11, %rd1, %rd11;
	ld.global.f32 %f16, [%rd11];
	st.global.f32 [%rd9+128], %f16;
	ret;
}
