// dp2a.{lo,hi}.{u32,s32}.{u32,s32} (SASS IDP.2A.{LO,HI}.{U16,S16}.{U8,S8}) against GB300
// bitwise on every pair of the s_alu2 operands: thread i, x = v[i]; for each j,
// out[(i*128 + j)*8 + k] = dp2a form k (x, v[j], v[(i+j)%128]).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry s_dp2a(.param .u64 sp, .param .u64 rnd, .param .u64 out)
{
    .reg .pred %p<3>;
    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    .shared .align 4 .b32 v[128];
    ld.param.u64 %rd1, [sp];
    ld.param.u64 %rd2, [rnd];
    ld.param.u64 %rd3, [out];
    mov.u32 %r1, %tid.x;
    setp.lt.u32 %p1, %r1, 64;
    and.b32 %r2, %r1, 63;
    mul.wide.u32 %rd4, %r2, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    selp.b64 %rd7, %rd5, %rd6, %p1;
    ld.global.b32 %r3, [%rd7];
    mov.u32 %r4, v;
    shl.b32 %r5, %r1, 2;
    add.u32 %r6, %r4, %r5;
    st.shared.b32 [%r6], %r3;
    bar.sync 0;
    shl.b32 %r7, %r1, 10;
    mul.wide.u32 %rd8, %r7, 4;
    add.s64 %rd9, %rd3, %rd8;
    mov.u32 %r8, 0;
LOOP:
    shl.b32 %r9, %r8, 2;
    add.u32 %r10, %r4, %r9;
    ld.shared.b32 %r11, [%r10];
    add.u32 %r13, %r8, %r1;
    and.b32 %r13, %r13, 127;
    shl.b32 %r14, %r13, 2;
    add.u32 %r15, %r4, %r14;
    ld.shared.b32 %r12, [%r15];
    shl.b32 %r16, %r8, 3;
    mul.wide.u32 %rd10, %r16, 4;
    add.s64 %rd11, %rd9, %rd10;
    dp2a.lo.u32.u32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+0], %r20;
    dp2a.lo.u32.s32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+4], %r20;
    dp2a.lo.s32.u32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+8], %r20;
    dp2a.lo.s32.s32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+12], %r20;
    dp2a.hi.u32.u32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+16], %r20;
    dp2a.hi.u32.s32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+20], %r20;
    dp2a.hi.s32.u32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+24], %r20;
    dp2a.hi.s32.s32 %r20, %r3, %r11, %r12;
    st.global.b32 [%rd11+28], %r20;
    add.u32 %r8, %r8, 1;
    setp.lt.u32 %p2, %r8, 128;
    @%p2 bra LOOP;
    ret;
}
