// E-ELECT repro: ldmatrix from one row address gives lane l word l % 4; warp 0's leader
// writes out[that word]; thread 32 reads out[1] unsynchronized. A race only when the leader's
// lane % 4 == 1 (lanes 1, 5, ..., 29): neither end lane.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry e_elect_ldmatrix(.param .u64 out)
{
    .reg .b32 %r<32>; .reg .b64 %rd<8>; .reg .pred %p<16>;
    .shared .align 16 .b32 sm[4];
    ld.param.u64 %rd1, [out]; cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x; mov.u32 %r4, sm;
    setp.lt.u32 %p2, %r1, 4; @!%p2 bra INIT;
    shl.b32 %r5, %r1, 2; add.u32 %r6, %r4, %r5; st.shared.u32 [%r6], %r1;
INIT:
    bar.sync 0;
    shr.u32 %r3, %r1, 5; setp.ne.u32 %p3, %r3, 0; @%p3 bra READER;   // warp 1 (warp-uniform)
    ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%r7}, [%r4];
    elect.sync %r8|%p1, -1;
    mul.wide.u32 %rd2, %r7, 4; add.u64 %rd3, %rd1, %rd2;
    mov.u32 %r9, 1;
    @%p1 st.global.u32 [%rd3], %r9;
    bra DONE;
READER:
    setp.ne.u32 %p4, %r1, 32; @%p4 bra DONE;
    ld.global.u32 %r10, [%rd1+4]; st.global.u32 [%rd1+16], %r10;
DONE:
    ret;
}
