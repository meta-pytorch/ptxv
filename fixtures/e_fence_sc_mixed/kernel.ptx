// S-FENCE-SC with mixed-size atomics: e_fence_sc_publish, but CTA 0's thread 0 claims the
// semaphore with a 64-bit atom and CTA 1's with a 32-bit one. The two partially overlap, so
// they are not morally strong (PTX ISA 9.5 section 8.7) and coherence does not order them: no
// Fence-SC order is forced and the consumer's loads race. On SASS the instruction width is
// all the model sees of the access size, so the rule requires equal widths.

.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pstage, .param .u64 psem, .param .u64 pout)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<6>;
    .shared .align 4 .u32 last;
    ld.param.u64 %rd1, [pstage];
    ld.param.u64 %rd2, [psem];
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %nctaid.x;
    mad.lo.u32 %r4, %r2, 64, %r1;
    add.u32 %r5, %r4, 100;
    mul.wide.u32 %rd4, %r4, 4;
    add.s64 %rd5, %rd1, %rd4;
    st.global.u32 [%rd5], %r5;
    membar.gl;                                   // @PFENCE
    bar.sync 0;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra JOIN;
    setp.eq.u32 %p5, %r2, 0;
    @%p5 atom.global.add.u64 %rd10, [%rd2], 1;   // @ATOM64
    @%p5 cvt.u32.u64 %r6, %rd10;                 // @CVT
    @!%p5 atom.global.add.u32 %r6, [%rd2], 1;    // @ATOM
    add.u32 %r7, %r3, -1;
    setp.eq.u32 %p2, %r6, %r7;
    selp.u32 %r8, 1, 0, %p2;
    st.shared.u32 [last], %r8;
JOIN:
    bar.sync 0;
    ld.shared.u32 %r9, [last];
    setp.eq.u32 %p3, %r9, 0;
    @%p3 bra DONE;
    membar.gl;                                   // @CFENCE
    mov.u32 %r10, 0;
    mov.u32 %r11, 0;
LOOP:
    mad.lo.u32 %r12, %r11, 64, %r1;
    mul.wide.u32 %rd6, %r12, 4;
    add.s64 %rd7, %rd1, %rd6;
    ld.global.u32 %r13, [%rd7];
    add.u32 %r10, %r10, %r13;
    add.u32 %r11, %r11, 1;
    setp.lt.u32 %p4, %r11, %r3;
    @%p4 bra LOOP;
    mul.wide.u32 %rd8, %r1, 4;
    add.s64 %rd9, %rd3, %rd8;
    st.global.u32 [%rd9], %r10;
DONE:
    ret;
}
