// E-HW-L1 predictive check, filler after the read in the explored order. Cluster of 2 CTAs,
// 2 warps each. CTA 0 thread 0 (writer): weak store W of word 0 of line L, then a release
// store of the flag at cluster scope. CTA 1 warp 0 (reader): acquire poll of the flag at
// cluster scope (no L1 invalidation in the PTX model), then a weak load R of word 0. CTA 1
// warp 1 (co-reader): a weak load F of word 1 of L, unordered with W and R. In schedules with
// F before W lands, R hits F's line and reads word 0 stale. Until 2026-11-10 the check looked
// only at fills before the read: DPOR and the certificate, whose schedules run F after R,
// were clean.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry l1late(.param .u64 buf, .param .u64 flag, .param .u64 out)
.explicitcluster
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [buf];
    ld.param.u64 %rd2, [flag];
    ld.param.u64 %rd3, [out];
    mov.u32 %r1, %cluster_ctarank;
    mov.u32 %r2, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra CTA1;
    setp.ne.u32 %p2, %r2, 0;
    @%p2 bra DONE;
    st.global.u32 [%rd1], 7; // @W
    st.release.cluster.global.u32 [%rd2], 1; // @REL
    bra DONE;
CTA1:
    setp.eq.u32 %p2, %r2, 0;
    @%p2 bra READER;
    setp.ne.u32 %p3, %r2, 32;
    @%p3 bra DONE;
    ld.global.u32 %r5, [%rd1+4]; // @F
    st.global.u32 [%rd3+4], %r5;
    bra DONE;
READER:
    ld.acquire.cluster.global.u32 %r3, [%rd2]; // @POLL
    setp.eq.u32 %p2, %r3, 0;
    @%p2 bra READER;
    ld.global.u32 %r4, [%rd1];
    st.global.u32 [%rd3], %r4;
DONE:
    ret;
}
