.version 9.0
.target sm_100a
.address_size 64
.visible .entry k() {
  .reg .pred %p, %q;
  .shared .align 8 .b64 bar;
  mbarrier.try_wait.parity.shared::cta.b64 %p, [bar], 0;
  @%p bra END;
WAIT:
  mbarrier.try_wait.parity.shared::cta.b64 %q, [bar], 0;
  @!%q bra WAIT;
END:
  ret;
}
