// E-BSYNC exit order: lane 0 of each warp stores 7 and exits inside the BSSY B0 region
// (`@P0 EXIT` before `BSYNC.RECONVERGENT B0`); lanes 1-31 run an n-iteration loop, store
// tid*n, converge at the BSYNC, meet at bar.sync 0 and store tid*n+1. In some orders lane 0
// exits before the others arrive at the BSYNC, in others after: the exit then releases them.
// Either way the same lanes go on with the same clocks (no lane 0 history), so the
// certificate need not order the exit before the arrivals.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 out_p, .param .u32 n_p)
{
  .reg .pred %p<4>;
  .reg .b32 %r<12>;
  .reg .b64 %rd<6>;
  ld.param.u64 %rd1, [out_p];
  ld.param.u32 %r9, [n_p];
  cvta.to.global.u64 %rd1, %rd1;
  mov.u32 %r1, %tid.x;
  and.b32 %r2, %r1, 31;
  mul.wide.u32 %rd2, %r1, 4;
  add.s64 %rd3, %rd1, %rd2;
  mov.u32 %r3, 0;
  setp.eq.u32 %p1, %r2, 0;
  @%p1 bra LANE0;
  mov.u32 %r4, 0;
LOOP:
  add.u32 %r3, %r3, %r1;
  add.u32 %r4, %r4, 1;
  setp.lt.u32 %p2, %r4, %r9;
  @%p2 bra LOOP;
  st.global.u32 [%rd3], %r3;
  bra.uni JOIN;
LANE0:
  st.global.u32 [%rd3], 7;
  setp.ne.u32 %p3, %r9, 0;
  @%p3 ret;
JOIN:
  bar.sync 0;
  add.u32 %r6, %r3, 1;
  st.global.u32 [%rd3+512], %r6;
  ret;
}
