.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_st16_f32(.param .u64 px, .param .u64 pout, .param .u64 ptmp)
{
	.reg .b16 %h<4>;
	.reg .b32 %r<16>;
	.reg .f32 %f<12>;
	.reg .b64 %rd<12>;
	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [pout];
	ld.param.u64 %rd3, [ptmp];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd6, %rd3, %rd5;
	add.s64 %rd7, %rd2, %rd5;
	add.s64 %rd8, %rd1, %rd5;
	cvt.rn.f32.u32 %f1, %r1;
	add.rn.f32 %f2, %f1, 0f3DCCCCCD;
	st.volatile.global.f32 [%rd6], %f2;
	mov.b16 %h1, 0x3F80;
	st.volatile.global.b16 [%rd6+2], %h1;
	st.volatile.global.f32 [%rd6+128], 0f00000000;
	mov.b32 %r2, %f2;
	cvt.u16.u32 %h2, %r2;
	st.volatile.global.b16 [%rd6+128], %h2;
	ld.volatile.global.f32 %f3, [%rd6];
	st.global.f32 [%rd7], %f3;
	ld.volatile.global.f32 %f4, [%rd6+128];
	st.global.f32 [%rd7+128], %f4;
	ld.global.f32 %f5, [%rd8];
	add.rn.f32 %f6, %f3, %f5;
	st.global.f32 [%rd7+256], %f6;
	ret;
}
