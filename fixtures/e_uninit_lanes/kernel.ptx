//
// S-INIT lane precision for narrow packs (SASS F2FP.E4M3.F32.PACK_AB, F2FP.F16.E4M3.UNPACK_B,
// HADD2.F32 of one half): the high e4m3 lane comes from a register only threads 0..15 load;
// every thread stores the f32 widening of the low lane only (the shape of triton's
// _nvfp4x2_k_quant_kernel).
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry uninit_lanes(
	.param .u64 in_ptr,
	.param .u64 out_ptr
)
.reqntid 32
{
	.reg .pred %p<2>;
	.reg .b16 %h<4>;
	.reg .b32 %r<10>;
	.reg .f32 %f<4>;
	.reg .b64 %rd<8>;

	ld.param.u64 %rd1, [in_ptr];
	ld.param.u64 %rd2, [out_ptr];
	mov.u32 %r1, %tid.x;
	setp.lt.u32 %p1, %r1, 16;
	mul.wide.u32 %rd3, %r1, 4;
	add.s64 %rd4, %rd1, %rd3;
	ld.global.f32 %f1, [%rd4];
	@%p1 ld.global.f32 %f2, [%rd4+128];
	cvt.rn.satfinite.e4m3x2.f32 %h1, %f2, %f1;
	cvt.rn.f16x2.e4m3x2 %r2, %h1;
	mov.b32 {%h2, %h3}, %r2;
	cvt.f32.f16 %f3, %h2; // @LANE
	add.s64 %rd5, %rd2, %rd3;
	st.global.f32 [%rd5], %f3;
	ret;
}
