.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_atom_cas_f32(.param .u64 px, .param .u64 pout, .param .u64 polds, .param .u64 pacc)
{
	.reg .pred %p<4>;
	.reg .b32 %r<16>;
	.reg .f32 %f<16>;
	.reg .b64 %rd<16>;
	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [pout];
	ld.param.u64 %rd3, [polds];
	ld.param.u64 %rd4, [pacc];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	cvta.to.global.u64 %rd4, %rd4;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd6, %rd3, %rd5;
	setp.ne.u32 %p1, %r1, 0;
	@%p1 bra INIT;
	st.global.f32 [%rd4], 0f00000000;
	st.global.b32 [%rd4+4], 0;
	ld.global.f32 %f1, [%rd1];
	st.global.f32 [%rd4+12], %f1;
INIT:
	bar.sync 0;
	atom.global.add.f32 %f2, [%rd4], 0f3DCCCCCD;
	st.global.f32 [%rd6], %f2;
	mov.b32 %r2, 0x3DCD3DCD;
	atom.global.add.noftz.bf16x2 %r3, [%rd4+4], %r2;
	st.global.b32 [%rd6+128], %r3;
	bar.sync 0;
	@%p1 bra DONE;
	atom.global.cas.b32 %r4, [%rd4], 0x404CCCCD, 0x3F800000;
	ld.global.f32 %f3, [%rd4];
	st.global.f32 [%rd2], %f3;
	st.global.b32 [%rd2+4], %r4;
	ld.global.f32 %f4, [%rd1+4];
	add.rn.f32 %f5, %f3, %f4;
	st.global.f32 [%rd2+8], %f5;
	ld.global.b32 %r5, [%rd4+4];
	shl.b32 %r6, %r5, 16;
	mov.b32 %f6, %r6;
	st.global.f32 [%rd2+12], %f6;
	ld.global.f32 %f7, [%rd1+8];
	add.rn.f32 %f8, %f6, %f7;
	st.global.f32 [%rd2+16], %f8;
	ld.global.f32 %f9, [%rd1];
	add.rn.f32 %f10, %f9, 0f30800000;
	mov.b32 %r7, %f10;
	mov.b32 %r8, 0x40000000;
	mov.b64 %rd7, {%r8, %r7};
	atom.global.exch.b64 %rd8, [%rd4+8], %rd7;
	ld.global.f32 %f11, [%rd4+12];
	st.global.f32 [%rd2+20], %f11;
DONE:
	ret;
}
