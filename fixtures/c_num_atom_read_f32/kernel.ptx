.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_atom_read_f32(.param .u64 px, .param .u64 pout, .param .u64 polds, .param .u64 pacc)
{
	.reg .pred %p<4>;
	.reg .b32 %r<16>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<12>;
	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [pout];
	ld.param.u64 %rd3, [polds];
	ld.param.u64 %rd4, [pacc];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	cvta.to.global.u64 %rd4, %rd4;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd6, %rd3, %rd5;
	setp.ne.u32 %p2, %r1, 0;
	@!%p2 st.global.f32 [%rd4], 0f00000000;
	bar.sync 0;
	atom.global.add.f32 %f1, [%rd4], 0f3DCCCCCD;
	st.global.f32 [%rd6], %f1;
	bar.sync 0;
	setp.ne.u32 %p1, %r1, 0;
	@%p1 bra DONE;
	ld.global.f32 %f2, [%rd1];
	atom.global.or.b32 %r2, [%rd4], 0;
	atom.global.add.u32 %r3, [%rd4], 0;
	atom.global.max.u32 %r6, [%rd4], 0;
	atom.global.cas.b32 %r7, [%rd4], 1, 2;
	atom.global.exch.b32 %r8, [%rd4], 0;
	st.global.b32 [%rd2], %r2;
	st.global.b32 [%rd2+4], %r3;
	st.global.b32 [%rd2+8], %r3;
	st.global.b32 [%rd2+12], %r3;
	st.global.b32 [%rd2+16], %r6;
	st.global.b32 [%rd2+20], %r7;
	st.global.b32 [%rd2+24], %r8;
	mov.b32 %f3, %r8;
	add.rn.f32 %f4, %f3, %f2;
	st.global.f32 [%rd2+28], %f4;
DONE:
	ret;
}
