.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_cas_after_or_f32(.param .u64 px, .param .u64 pout, .param .u64 pacc)
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pout];
    ld.param.u64 %rd4, [pacc];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd4, %rd4;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @!%p1 st.global.f32 [%rd4], 0f00000000;
    bar.sync 0;
    red.global.add.f32 [%rd4], 0f3DCCCCCD;
    bar.sync 0;
    @%p1 bra DONE;
    ld.global.f32 %f1, [%rd1];
    atom.global.or.b32 %r2, [%rd4], 0;
    atom.global.cas.b32 %r3, [%rd4], 0x404cccc9, 0x3f800000;
    ld.global.f32 %f2, [%rd4];
    st.global.f32 [%rd2], %f2;
    add.rn.f32 %f3, %f2, %f1;
    st.global.f32 [%rd2+4], %f3;
DONE:
    ret;
}
