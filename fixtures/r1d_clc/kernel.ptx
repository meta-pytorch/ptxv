// Rung 1d fixture: a persistent kernel driven by cluster launch control (CLC).
//
//   Grid of 4 one-warp CTAs over 4 tiles: out[32 * tile + lane] = 1000 * tile + lane.
//   A CTA starts with tile = ctaid.x. After each tile, thread 0 asks to cancel a CTA that has
//   not launched yet (clusterlaunchcontrol.try_cancel -> 16-byte response + complete_tx on an
//   mbarrier). On success the CTA takes over the cancelled CTA's tile; on failure it exits.
//   Every tile is done exactly once, by its own CTA or by the CTA that cancelled it.
//
// Mutants (case.toml): B17 the response is used without waiting for its mbarrier; B53 the wait
// parity is not flipped for the second request; B54 a CTA exits after a successful cancel
// without doing the stolen tile.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry r1d_clc(.param .u64 out)
.maxntid 32, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<24>;
    .reg .b64   %rd<8>;
    .reg .b128  %q<2>;
    .shared .align 16 .b8 resp[16];
    .shared .align 8 .b8 bar[8];
    .shared .align 4 .b32 next_tile;

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, resp;
    mov.u32         %r2, bar;
    mov.u32         %r3, next_tile;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r2], 1;
INIT_DONE:
    bar.sync        0;
    ld.param.u64    %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    mov.u32         %r4, %ctaid.x;                  // tile
    mov.u32         %r5, 0;                         // wait parity
TILE:
    mul.lo.u32      %r6, %r4, 1000;
    add.u32         %r6, %r6, %r0;
    shl.b32         %r7, %r4, 5;
    add.u32         %r7, %r7, %r0;
    mul.wide.u32    %rd2, %r7, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r6;
    bar.sync        0;                              // everyone has read next_tile
    @%p0 bra        NEXT;
    // ---- thread 0: request the next tile ------------------------------------------------
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r2], 16;
    clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%r1], [%r2];
W:
    mbarrier.try_wait.parity.shared::cta.b64 %p1, [%r2], %r5;      // @B17
    @!%p1 bra       W;                                              // @B17
    ld.shared.b128  %q0, [%r1];                                     // load after the wait  // @V2PACK
    clusterlaunchcontrol.query_cancel.is_canceled.pred.b128 %p2, %q0;
    mov.u32         %r8, 0xffffffff;
    @%p2 clusterlaunchcontrol.query_cancel.get_first_ctaid::x.b32.b128 %r8, %q0;
    // (B54 drops the stolen tile here)                             // @B54
    st.shared.u32   [%r3], %r8;
NEXT:
    bar.sync        0;
    ld.shared.u32   %r4, [%r3];
    xor.b32         %r5, %r5, 1;                                    // @B53
    setp.ne.u32     %p3, %r4, 0xffffffff;
    @%p3 bra        TILE;
    ret;
}
