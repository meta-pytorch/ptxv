// fixtures/c_num_ctl_guard_f32 (N-NUM-TRACK; the independent review's probe rd_guard_tid): a store
// guard rn(f32(t) * 0.7f) >= 7: lane 10 stores here, not in exact arithmetic (10 * 0.7f < 7).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_num_ctl_guard_f32(
	.param .u64 px, .param .u64 py, .param .u64 pz, .param .u64 pout,
	.param .f32 ps
)
{
	.reg .pred %p<8>;
	.reg .b32 %r<16>;
	.reg .f32 %f<32>;
	.reg .b64 %rd<24>;
	ld.param.u64 %rd1, [px];
	ld.param.u64 %rd2, [py];
	ld.param.u64 %rd3, [pz];
	ld.param.u64 %rd4, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	cvta.to.global.u64 %rd4, %rd4;
	mov.u32 %r1, %tid.x;
	mul.wide.u32 %rd5, %r1, 4;
	add.s64 %rd6, %rd1, %rd5;
	add.s64 %rd7, %rd2, %rd5;
	add.s64 %rd8, %rd3, %rd5;
	add.s64 %rd9, %rd4, %rd5;
	ld.global.f32 %f1, [%rd6];
	ld.global.f32 %f2, [%rd7];
	ld.global.f32 %f3, [%rd8];
	add.rn.f32 %f4, %f1, %f2;
	add.rn.f32 %f5, %f1, %f3;
	ld.param.f32 %f10, [ps];
	cvt.rn.f32.u32 %f12, %r1;
	mul.rn.f32 %f13, %f12, %f10;
	setp.ge.f32 %p1, %f13, 0f40E00000;
	@%p1 st.global.f32 [%rd9], %f1;
	ret;
}
