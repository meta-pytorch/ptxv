// E-CLOCK hang guard whose start read is skipped on some path. Thread 32 polls a flag that
// thread 0 sets after a 200 us sleep, with a 2^32 timeout against the start %rd10. The start
// is read only when x == 0 (x loaded from memory, 1000): with x != 0 the timeout compares
// against an undefined register.
//   good: the start read is skipped (x != 0): the start's only definition does not reach the
//         compare on every path, no slice decides the bound: a clock choice.
//   DEF:  the start read on every path: a 2^32 bound, exempt.
//   DL:   the start read on every path, the deadline (start + 2^40) computed only when x == 0;
//         with x != 0 the compare reads an undefined deadline: a clock choice.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_clock_hang_undef(.param .u64 out_p, .param .u64 in_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra READER;
    nanosleep.u32 200000;
    mov.u32 %r2, 7;
    st.global.u32 [%rd1+4], %r2;
    mov.u32 %r3, 1;
    st.release.gpu.global.u32 [%rd1+8], %r3;
    bra DONE;
READER:
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
    ld.global.u32 %r6, [%rd2];
    setp.ne.u32 %p7, %r6, 0;
    @%p7 bra POLL;                           // @SKIP
    mov.u64 %rd10, %clock64;                 // @START
POLL:
    ld.acquire.gpu.global.u32 %r4, [%rd1+8];
    setp.ne.u32 %p3, %r4, 0;
    @%p3 bra READ;
    mov.u64 %rd12, %clock64;
    sub.u64 %rd13, %rd12, %rd10;             // @SUB
    setp.gt.u64 %p4, %rd13, 0x100000000;     // @CMP
    @%p4 bra TIMEOUT;
    bra POLL;
TIMEOUT:
    trap;
READ:
    ld.global.u32 %r5, [%rd1+4];
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
