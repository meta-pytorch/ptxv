.version 9.0
.target sm_103a
.address_size 64

// errdist: outputs whose exact value is not determined because an instruction slice has no
// identified real function (MISS 88). Each thread i forms a = RN(x[i] w[i]) and
// a' = RN(3 a) where x[0] >= 0 (a predicated FMUL), else a. The captured x is 0 and the
// identification probes perturb it by N(0, 1): they take both outcomes of the guard, so no one
// function fits the slice of a'.
//   unident:     y[i] = RN(a' + v[i]). Every output is finite and none has an exact value:
//                the out-of-domain cause is the unidentified slice, not NaN / Inf.
//   unident_max: y[i] = max(a', v[i]). The slice's value (NaN in the exact arithmetic) must
//                not let the maximum pass on v[i] as the exact value: until 2026-11-11 it did,
//                and errdist compared max(a', v) against RN(v).
//   unident_one: y[i] = RN(a' + v[i]) with the guarded FMUL on thread 0 only (a branch on the
//                thread index): output 0 has no exact value, outputs 1-63 do (y = RN(RN(x w) + v),
//                which differs from RN(x w + v) often). The share left out, 1 / 64 per input,
//                widens P(differ)'s interval and is within 10% of P (MISS 66).

.visible .entry unident(.param .u64 px, .param .u64 pw, .param .u64 pv, .param .u64 py)
{
    .reg .f32 %f<12>;
    .reg .b64 %rd<16>;
    .reg .b32 %r<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pw];
    ld.param.u64 %rd3, [pv];
    ld.param.u64 %rd4, [py];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd6, %r1, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd9, %rd3, %rd6;
    add.s64 %rd10, %rd4, %rd6;
    ld.global.f32 %f1, [%rd7];
    ld.global.f32 %f2, [%rd8];
    ld.global.f32 %f3, [%rd9];
    ld.global.f32 %f9, [%rd1];
    mul.rn.f32 %f4, %f1, %f2;
    setp.ge.f32 %p1, %f9, 0f00000000;
    @%p1 mul.rn.f32 %f4, %f4, 0f40400000;
    add.rn.f32 %f5, %f4, %f3;
    st.global.f32 [%rd10], %f5;
    ret;
}

.visible .entry unident_max(.param .u64 px, .param .u64 pw, .param .u64 pv, .param .u64 py)
{
    .reg .f32 %f<12>;
    .reg .b64 %rd<16>;
    .reg .b32 %r<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pw];
    ld.param.u64 %rd3, [pv];
    ld.param.u64 %rd4, [py];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd6, %r1, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd9, %rd3, %rd6;
    add.s64 %rd10, %rd4, %rd6;
    ld.global.f32 %f1, [%rd7];
    ld.global.f32 %f2, [%rd8];
    ld.global.f32 %f3, [%rd9];
    ld.global.f32 %f9, [%rd1];
    mul.rn.f32 %f4, %f1, %f2;
    setp.ge.f32 %p1, %f9, 0f00000000;
    @%p1 mul.rn.f32 %f4, %f4, 0f40400000;
    max.f32 %f5, %f4, %f3;
    st.global.f32 [%rd10], %f5;
    ret;
}

.visible .entry unident_one(.param .u64 px, .param .u64 pw, .param .u64 pv, .param .u64 py)
{
    .reg .f32 %f<12>;
    .reg .b64 %rd<16>;
    .reg .b32 %r<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pw];
    ld.param.u64 %rd3, [pv];
    ld.param.u64 %rd4, [py];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd6, %r1, 4;
    add.s64 %rd7, %rd1, %rd6;
    add.s64 %rd8, %rd2, %rd6;
    add.s64 %rd9, %rd3, %rd6;
    add.s64 %rd10, %rd4, %rd6;
    ld.global.f32 %f1, [%rd7];
    ld.global.f32 %f2, [%rd8];
    ld.global.f32 %f3, [%rd9];
    ld.global.f32 %f9, [%rd1];
    mul.rn.f32 %f4, %f1, %f2;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra $L_add;
    setp.ge.f32 %p1, %f9, 0f00000000;
    @%p1 mul.rn.f32 %f4, %f4, 0f40400000;
$L_add:
    add.rn.f32 %f5, %f4, %f3;
    st.global.f32 [%rd10], %f5;
    ret;
}
