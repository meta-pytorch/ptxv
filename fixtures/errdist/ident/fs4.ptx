.version 9.0
.target sm_103a
.address_size 64

// The third review's controls for MISS 138: a crossed rounding step that the probes cannot see
// (D1's remaining assumption, N-ERRDIST-IDENT), and a smooth control. Captured x = 2560,
// v = 2^40; the probes keep |v| >= about 2^36 (ulp >= 2^13), so any |addend| < 2^12 is
// absorbed: y = v on every probe.
//   rE_fs4: s = RN(RM(|x| * 2^-10 + C) - C) = floor(|x| / 1024) (C = 1.5 * 2^23, exact for
//           |x| / 1024 < 2^22); the probes cross its steps (s takes 0..30); y = RN(s + v).
//   rE_sm1: no step: y = RN(x * 2^-10 + v), one correct rounding (x * 2^-10 exact).
.visible .entry rE_fs4(.param .u64 px, .param .u64 pv, .param .u64 py)
{
    .reg .f32 %f<12>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pv];
    ld.param.u64 %rd3, [py];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd4, %r1, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    abs.f32 %f6, %f1;
    mul.rn.f32 %f3, %f6, 0f3A800000;
    add.rm.f32 %f4, %f3, 0f4B400000;
    sub.rn.f32 %f7, %f4, 0f4B400000;
    add.rn.f32 %f5, %f7, %f2;
    st.global.f32 [%rd7], %f5;
    ret;
}

.visible .entry rE_sm1(.param .u64 px, .param .u64 pv, .param .u64 py)
{
    .reg .f32 %f<12>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pv];
    ld.param.u64 %rd3, [py];
    mov.u32 %r1, %tid.x;
    mul.wide.u32 %rd4, %r1, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5];
    ld.global.f32 %f2, [%rd6];
    mul.rn.f32 %f3, %f1, 0f3A800000;
    add.rn.f32 %f5, %f3, %f2;
    st.global.f32 [%rd7], %f5;
    ret;
}
