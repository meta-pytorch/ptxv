// E-ELECT fixture: one warp. A leader publishes a value in shared memory and lane 0 reads it
// back with no synchronization. Correct only if the leader IS lane 0.
//   good: the leader is chosen with %laneid == 0 (same thread writes and reads)
//   B46 : the leader is chosen with elect.sync, assuming it is lane 0. GB300 does pick
//         lane 0 (probes/elect), but the PTX ISA only promises "one active thread".
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_elect(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 slot;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, slot;
    setp.eq.u32 %p1, %r1, 0;             // @B46
    @!%p1 bra SKIP;
    mov.u32 %r3, 42;
    st.shared.u32 [%r2], %r3;
SKIP:
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra DONE;
    ld.shared.u32 %r4, [%r2];
    st.global.u32 [%rd1], %r4;
DONE:
    ret;
}
