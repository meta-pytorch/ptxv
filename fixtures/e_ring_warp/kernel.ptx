// Fixture for C-RING (E-WELLSYNC) with DeepEP's consumer shape: e_ring's ring (N = 6 items,
// CAP = 4 slots, chunks of CH = 2), consumed by a CTA of two warps.
//
//   Producer (CTA 0, thread 0): as in e_ring (head polled with ld.acquire, payload by plain
//   stores, tail published with st.release).
//   Consumer (CTA 1, 64 threads): warp 0 polls the tail in a warp-level loop (lane 0 loads
//   with ld.acquire and broadcasts it, E-SPIN warp-level poll loops), lane 0 relays the tail
//   it saw through shared memory, bar.sync, then lane 0 of warp w copies slots
//   head + w, head + w + 2, ... below the tail (out[i] = 3 * slot + i + 1), bar.sync, and
//   thread 0 publishes the new head with st.release. Which warp copies which slot depends on
//   the tails seen (DeepEP dispatch's receivers distribute a chunk over warps the same way).
//
// Mutants (case.toml): R1 publish before the payload write; R2 the copy reads one slot past
// the tail; R4 a threshold branch on the batch size; R7 the consumer counts its batches;
// W1 both warps copy every slot (unordered writes of one output word; both warps store the
// same value, S-SAME-VALUE).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_ring_warp(
    .param .u64 src_p,
    .param .u64 buf_p,
    .param .u64 head_p,
    .param .u64 tail_p,
    .param .u64 out_p
)
{
    .reg .b32 %r<40>;
    .reg .b64 %rd<32>;
    .reg .pred %p<12>;
    .shared .align 4 .b32 s_tail;
    ld.param.u64 %rd1, [src_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [buf_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [head_p];
    cvta.to.global.u64 %rd3, %rd3;
    ld.param.u64 %rd4, [tail_p];
    cvta.to.global.u64 %rd4, %rd4;
    ld.param.u64 %rd5, [out_p];
    cvta.to.global.u64 %rd5, %rd5;
    mov.u32 %r1, %tid.x;
    and.b32 %r30, %r1, 31;                  // lane
    shr.u32 %r31, %r1, 5;                   // warp
    mov.u32 %r32, s_tail;
    mov.u32 %r2, %ctaid.x;
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra CONSUMER;

    // ---- producer: thread 0, %r3 = tail
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u32 %r3, 0;
CHUNK:
    add.u32 %r4, %r3, -2;                   // tail + CH - CAP
WAITH:
    ld.acquire.gpu.global.u32 %r5, [%rd3];
    setp.gt.s32 %p2, %r4, %r5;
    @%p2 bra WAITH;
    // (head wait slot)
    mov.u32 %r6, 0;
ITEM:
    add.u32 %r7, %r3, %r6;
    mul.wide.u32 %rd6, %r7, 4;
    add.u64 %rd7, %rd1, %rd6;
    ld.global.u32 %r8, [%rd7];
    and.b32 %r9, %r7, 3;
    mul.wide.u32 %rd8, %r9, 4;
    add.u64 %rd9, %rd2, %rd8;
    st.global.u32 [%rd9], %r8;
    add.u32 %r6, %r6, 1;
    setp.lt.u32 %p3, %r6, 2;
    @%p3 bra ITEM;
    add.u32 %r3, %r3, 2;
    st.release.gpu.global.u32 [%rd4], %r3;
    setp.lt.u32 %p3, %r3, 6;
    @%p3 bra CHUNK;
    bra DONE;

    // ---- consumer: %r10 = head, %r11 = tail seen
CONSUMER:
    mov.u32 %r10, 0;
    mov.u32 %r20, 0;                        // batches (R7)
    setp.ne.u32 %p8, %r30, 0;               // not lane 0
BATCH:
    setp.ne.u32 %p9, %r31, 0;
    @%p9 bra WAITBAR;
POLL:
    mov.u32 %r11, %r10;
    @%p8 bra SKIP;
    ld.acquire.gpu.global.u32 %r11, [%rd4];
SKIP:
    shfl.sync.idx.b32 %r11, %r11, 0, 31, 0xffffffff;
    setp.eq.u32 %p4, %r11, %r10;
    @%p4 bra POLL;
    @%p8 bra WAITBAR;
    st.shared.u32 [%r32], %r11;
WAITBAR:
    bar.sync 0;
    ld.shared.u32 %r11, [%r32];
    add.u32 %r20, %r20, 1;
    @%p8 bra COPYDONE;
    add.u32 %r12, %r10, %r31;               // @START i = head + warp
COPY:
    setp.ge.u32 %p5, %r12, %r11;            // @BOUND
    @%p5 bra COPYDONE;
    and.b32 %r13, %r12, 3;
    mul.wide.u32 %rd10, %r13, 4;
    add.u64 %rd11, %rd2, %rd10;
    ld.global.u32 %r14, [%rd11];
    mul.lo.u32 %r15, %r14, 3;
    add.u32 %r15, %r15, %r12;
    add.u32 %r15, %r15, 1;                  // @VALUE
    mul.wide.u32 %rd12, %r12, 4;
    add.u64 %rd13, %rd5, %rd12;
    st.global.u32 [%rd13], %r15;
    add.u32 %r12, %r12, 2;                  // @STRIDE
    bra COPY;
COPYDONE:
    bar.sync 0;
    mov.u32 %r10, %r11;
    setp.ne.u32 %p6, %r1, 0;
    @%p6 bra NEXT;
    st.release.gpu.global.u32 [%rd3], %r10;
NEXT:
    setp.lt.u32 %p7, %r10, 6;
    @%p7 bra BATCH;
    // (batch count slot)                   // @COUNT
DONE:
    ret;
}
