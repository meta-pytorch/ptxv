// PTX front-end forms seen in CuTeDSL output, against GB300 bitwise (both front-ends):
// cp.async.{ca,cg}.shared.global (4 / 8 / 16 bytes, src-size 0 zero fill, ignore-src
// predicate), commit_group / wait_group / wait_all, cp.async.mbarrier.arrive[.noinc],
// non-tensor cp.async.bulk (global -> shared::cluster with complete_tx, shared::cta -> global
// bulk_group), mad.lo.s64, vote.sync.{any,all,uni}.pred / ballot.b32, bar.warp.sync,
// div.rn.f32, cvt.rn.bf16.f32, cvt.rzi.{u32,s32}.f32, mov.b32 {h0, h1} unpack / pack.
// 64 threads; out[32 t ..] per thread, out[2048 ..] the bulk store, out[2112 ..] a fused
// bf16 pack.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry s_ptx_cute_ops(
    .param .u64 src_p,
    .param .u64 sp_p,
    .param .u64 rnd_p,
    .param .u64 out_p
)
.maxntid 64, 1, 1
{
    .reg .pred  %p<16>;
    .reg .b16   %h<8>;
    .reg .b32   %r<96>;
    .reg .b64   %rd<32>;
    .shared .align 128 .b8 sm[3608];

    ld.param.u64    %rd0, [src_p];
    cvta.to.global.u64 %rd1, %rd0;
    ld.param.u64    %rd2, [sp_p];
    cvta.to.global.u64 %rd3, %rd2;
    ld.param.u64    %rd4, [rnd_p];
    cvta.to.global.u64 %rd5, %rd4;
    ld.param.u64    %rd6, [out_p];
    cvta.to.global.u64 %rd7, %rd6;
    mov.u32         %r0, %tid.x;
    mov.u32         %r1, sm;
    shl.b32         %r2, %r0, 2;                // 4 t
    shl.b32         %r3, %r0, 3;                // 8 t
    shl.b32         %r4, %r0, 4;                // 16 t
    cvt.u64.u32     %rd8, %r2;
    cvt.u64.u32     %rd9, %r3;
    cvt.u64.u32     %rd10, %r4;
    add.u64         %rd11, %rd1, %rd8;          // &src[t]
    mul.wide.u32    %rd12, %r0, 128;
    add.u64         %rd13, %rd7, %rd12;         // &out[32 t]
    and.b32         %r5, %r0, 1;
    setp.eq.u32     %p0, %r5, 1;                // odd thread
    // ---- ALU forms
    add.u64         %rd22, %rd5, %rd8;
    ld.global.u32   %r42, [%rd22];              // rnd[t]
    ld.global.u32   %r43, [%rd22+256];          // rnd[t + 64]
    add.u64         %rd23, %rd3, %rd8;
    ld.global.u32   %r44, [%rd23];              // sp[t]
    mov.u32         %r45, 63;
    sub.u32         %r45, %r45, %r0;
    mul.wide.u32    %rd24, %r45, 4;
    add.u64         %rd24, %rd3, %rd24;
    ld.global.u32   %r46, [%rd24];              // sp[63 - t]
    // mad.lo.s64
    mov.b64         %rd25, {%r42, %r43};
    mov.b64         %rd26, {%r44, %r46};
    cvt.s64.s32     %rd27, %r43;
    mad.lo.s64      %rd27, %rd25, %rd26, %rd27; // d aliases c
    st.global.u64   [%rd13], %rd27;
    mad.lo.u64      %rd28, %rd26, 12345, %rd25;
    st.global.u64   [%rd13+120], %rd28;
    // votes
    setp.lt.u32     %p5, %r42, 0x40000000;
    vote.sync.any.pred %p6, %p5, 0xffffffff;
    vote.sync.all.pred %p7, %p5, 0xffffffff;
    vote.sync.uni.pred %p8, %p5, 0xffffffff;
    setp.lt.u32     %p9, %r0, 70;
    vote.sync.uni.pred %p10, %p9, 0xffffffff;   // uniformly true
    vote.sync.any.pred %p11, !%p9, 0xffffffff;  // false
    vote.sync.ballot.b32 %r47, %p5, 0xffffffff;
    selp.u32        %r48, 1, 0, %p6;
    selp.u32        %r49, 2, 0, %p7;
    or.b32          %r48, %r48, %r49;
    selp.u32        %r49, 4, 0, %p8;
    or.b32          %r48, %r48, %r49;
    selp.u32        %r49, 8, 0, %p10;
    or.b32          %r48, %r48, %r49;
    selp.u32        %r49, 16, 0, %p11;
    or.b32          %r48, %r48, %r49;
    bar.warp.sync   -1;
    st.global.u32   [%rd13+8], %r48;
    st.global.u32   [%rd13+12], %r47;
    // div.rn.f32
    div.rn.f32      %r50, %r44, %r46;
    div.rn.f32      %r51, %r44, %r42;
    div.rn.f32      %r52, %r42, %r44;
    div.rn.f32      %r53, %r42, %r43;
    st.global.v4.u32 [%rd13+16], {%r50, %r51, %r52, %r53};
    // cvt.rn.bf16.f32
    cvt.rn.bf16.f32 %h0, %r44;
    cvt.rn.bf16.f32 %h1, %r42;
    cvt.u32.u16     %r54, %h0;
    cvt.u32.u16     %r55, %h1;
    st.global.v2.u32 [%rd13+32], {%r54, %r55};
    // cvt.rzi
    cvt.rzi.u32.f32 %r56, %r44;
    cvt.rzi.u32.f32 %r57, %r42;
    cvt.rzi.s32.f32 %r58, %r44;
    cvt.rzi.ftz.s32.f32 %r59, %r42;
    st.global.v2.u32 [%rd13+40], {%r56, %r57};
    st.global.v2.u32 [%rd13+48], {%r58, %r59};
    // mov.b32 unpack / pack: swap the halves of rnd[t]; repack {h0 of rnd[t+64], _}
    mov.b32         {%h2, %h3}, %r42;
    mov.b32         %r60, {%h3, %h2};
    st.global.u32   [%rd13+56], %r60;
    mov.b32         {%h4, _}, %r43;
    mov.b32         {_, %h5}, %r44;
    mov.b32         %r61, {%h5, %h4};
    st.global.u32   [%rd13+60], %r61;
    // two cvt.rn.bf16.f32 packed by mov.b32 (ptxas: one F2FP.BF16.F32.PACK_AB) -> out[2112 + t]
    cvt.rn.bf16.f32 %h6, %r44;
    cvt.rn.bf16.f32 %h7, %r46;
    mov.b32         %r62, {%h6, %h7};
    add.u64         %rd29, %rd7, %rd8;
    st.global.u32   [%rd29+8448], %r62;
    add.u32         %r6, %r1, 3584;             // mbarrier M1 (noinc)
    add.u32         %r7, %r1, 3592;             // M2 (arrive + async tx unit)
    add.u32         %r8, %r1, 3600;             // M3 (bulk copy)
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r6], 64;
    mbarrier.init.shared::cta.b64 [%r7], 64;
    mbarrier.init.shared::cta.b64 [%r8], 1;
    fence.mbarrier_init.release.cluster;
INIT_DONE:
    bar.sync        0;

    // ---- cp.async batch 1: wait_group
    add.u32         %r10, %r1, %r2;             // A + 4t
    cp.async.ca.shared.global [%r10], [%rd11], 4;
    add.u32         %r11, %r1, 256;
    add.u32         %r11, %r11, %r3;            // B + 8t
    add.u64         %rd14, %rd1, 256;
    add.u64         %rd14, %rd14, %rd9;
    cp.async.ca.shared.global.L2::128B [%r11], [%rd14], 8;
    add.u32         %r12, %r1, 768;
    add.u32         %r12, %r12, %r4;            // C + 16t
    add.u64         %rd15, %rd1, 768;
    add.u64         %rd15, %rd15, %rd10;
    cp.async.cg.shared.global [%r12], [%rd15], 16;
    add.u32         %r13, %r1, 1792;
    add.u32         %r13, %r13, %r2;            // D + 4t: src-size 0, zero fill
    st.shared.u32   [%r13], %r0;
    cp.async.ca.shared.global [%r13], [%rd11], 4, 0;
    add.u32         %r14, %r1, 2048;
    add.u32         %r14, %r14, %r2;            // E + 4t: ignore-src on odd threads
    add.u64         %rd16, %rd11, 1792;
    cp.async.ca.shared.global [%r14], [%rd16], 4, %p0;
    cp.async.commit_group;
    cp.async.wait_group 0;
    // ---- batch 2: wait_all (no commit)
    add.u32         %r15, %r1, 2304;
    add.u32         %r15, %r15, %r2;            // W + 4t
    add.u64         %rd17, %rd11, 2048;
    cp.async.ca.shared.global [%r15], [%rd17], 4;
    cp.async.wait_all;
    // ---- batch 3: cp.async.mbarrier.arrive.noinc on M1
    add.u32         %r16, %r1, 2560;
    add.u32         %r16, %r16, %r2;
    add.u64         %rd18, %rd11, 2304;
    cp.async.ca.shared.global [%r16], [%rd18], 4;
    cp.async.mbarrier.arrive.noinc.shared::cta.b64 [%r6];
    // ---- batch 4: cp.async.mbarrier.arrive (pending count + 1) and an arrive on M2
    add.u32         %r17, %r1, 2816;
    add.u32         %r17, %r17, %r2;
    add.u64         %rd19, %rd11, 2560;
    cp.async.ca.shared.global [%r17], [%rd19], 4;
    cp.async.mbarrier.arrive.shared.b64 [%r7];
    mbarrier.arrive.shared::cta.b64 _, [%r7];
    // ---- bulk copy: 256 bytes src[704..768) -> F, complete_tx on M3
    @%p1 bra        BULK_ISSUED;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r8], 256;
    add.u32         %r18, %r1, 3072;
    add.u64         %rd20, %rd1, 2816;
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r18], [%rd20], 256, [%r8];
BULK_ISSUED:
WAIT1:
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [%r6], 0;
    @!%p2 bra       WAIT1;
WAIT2:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r7], 0;
    @!%p3 bra       WAIT2;
WAIT3:
    mbarrier.try_wait.parity.shared::cta.b64 %p4, [%r8], 0;
    @!%p4 bra       WAIT3;
    bar.sync        0;
    // neighbours' words: (t + 1) % 64
    add.u32         %r19, %r0, 1;
    and.b32         %r19, %r19, 63;
    shl.b32         %r20, %r19, 2;
    add.u32         %r21, %r1, %r20;
    ld.shared.u32   %r22, [%r21];               // A
    st.global.u32   [%rd13+64], %r22;
    shl.b32         %r23, %r19, 3;
    add.u32         %r24, %r1, %r23;
    ld.shared.v2.u32 {%r25, %r26}, [%r24+256];  // B
    st.global.v2.u32 [%rd13+72], {%r25, %r26};
    shl.b32         %r27, %r19, 4;
    add.u32         %r28, %r1, %r27;
    ld.shared.v4.u32 {%r29, %r30, %r31, %r32}, [%r28+768];  // C
    st.global.v4.u32 [%rd13+80], {%r29, %r30, %r31, %r32};
    ld.shared.u32   %r33, [%r21+1792];          // D
    st.global.u32   [%rd13+96], %r33;
    ld.shared.u32   %r34, [%r21+2048];          // E
    st.global.u32   [%rd13+100], %r34;
    ld.shared.u32   %r35, [%r21+2304];          // W
    st.global.u32   [%rd13+104], %r35;
    ld.shared.u32   %r36, [%r21+2560];          // M1 batch
    st.global.u32   [%rd13+108], %r36;
    ld.shared.u32   %r37, [%r21+2816];          // M2 batch
    st.global.u32   [%rd13+112], %r37;
    ld.shared.u32   %r38, [%r21+3072];          // F (bulk)
    st.global.u32   [%rd13+116], %r38;
    // ---- bulk store: G[t] = 3 t + 1, then out[2048 + t]
    mad.lo.u32      %r39, %r0, 3, 1;
    add.u32         %r40, %r1, 3328;
    add.u32         %r41, %r40, %r2;
    st.shared.u32   [%r41], %r39;
    fence.proxy.async.shared::cta;
    bar.sync        0;
    @%p1 bra        STORE_DONE;
    add.u64         %rd21, %rd7, 8192;
    cp.async.bulk.global.shared::cta.bulk_group [%rd21], [%r40], 256;
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
STORE_DONE:

    ret;
}
