// fixtures/e_clock_mem (E-CLOCK): a clock value crosses threads through memory. Thread 0 stores
// %clock64 to out[2..3] and releases a flag; thread 32 acquires it, loads the timestamp, and
// stores 1 to out[0] if it is above 1000, else 2. With the clock read as 0 the timestamp is 0
// and only 2 is reached; on hardware the clock is far above 1000. The branch is on a loaded
// clock-derived value: explored both ways (outputs 1 and 2).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_clock_mem(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<16>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra READER;
    mov.u64 %rd2, %clock64;
    st.global.u64 [%rd1+8], %rd2;
    mov.u32 %r3, 1;
    st.release.gpu.global.u32 [%rd1+4], %r3;
    bra DONE;
READER:
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
POLL:
    ld.acquire.gpu.global.u32 %r4, [%rd1+4];
    setp.eq.u32 %p3, %r4, 0;
    @%p3 bra POLL;
    ld.global.u64 %rd3, [%rd1+8];
    mov.u32 %r5, 2;
    setp.gt.u64 %p4, %rd3, 1000;
    @!%p4 bra STORE;
    mov.u32 %r5, 1;
STORE:
    st.global.u32 [%rd1], %r5;
DONE:
    ret;
}
