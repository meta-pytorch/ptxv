.version 9.0
.target sm_103a
.address_size 64

.visible .entry c_equiv_atom_words_ref_cas64fail(
    .param .u64 px, .param .u64 pw, .param .u64 pout, .param .u64 pz)
{
    .reg .b16 %rs<8>;
    .reg .b32 %r<16>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<24>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd7, [pw];
    ld.param.u64 %rd2, [pout];
    ld.param.u64 %rd15, [pz];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd7, %rd7;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd15, %rd15;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd3, %r0, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd8, %rd7, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    mul.wide.u32 %rd9, %r0, 8;
    add.s64 %rd10, %rd15, %rd9;
    ld.global.f32 %f4, [%rd4];
    ld.global.f32 %f5, [%rd8];
    mov.u32 %r5, 0;
    st.global.u32 [%rd10], %r5;
    st.global.f32 [%rd10+4], %f4;
    mov.b32 %r1, %f4;
    mov.u32 %r6, 1;
    mov.b64 %rd11, {%r6, %r1};
    mov.u64 %rd12, 0;
    atom.global.cas.b64 %rd13, [%rd10], %rd11, %rd12;
    ld.global.f32 %f9, [%rd10+4];
    st.global.f32 [%rd5], %f9;
    ret;
}
