.version 9.0
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 input, .param .u64 output) {
 .shared .align 16 .b8 response[16];
 .shared .align 8 .b64 bar;
 .reg .b64 %p<2>;
 .reg .b32 %r<2>;
 .reg .f32 %f<3>;
 .reg .pred %q;
 ld.param.u64 %p0, [input];
 ld.param.u64 %p1, [output];
 ld.volatile.global.f32 %f0, [%p0];
 mov.u32 %r0, response;
 mov.u32 %r1, bar;
 st.shared.b32 [%r0], 0;
 st.shared.f32 [%r0+4], %f0;
 st.shared.b32 [%r0+8], 0;
 st.shared.b32 [%r0+12], 0;
 mbarrier.init.shared::cta.b64 [%r1], 1;
 fence.mbarrier_init.release.cluster;
 fence.proxy.async.shared::cta;
 mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 16;
 clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%r0], [%r1];
WAIT:
 mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %q, [%r1], 0;
 @!%q bra WAIT;
 ld.shared.f32 %f1, [%r0+4];
 mov.f32 %f2, %f1; // @RESULT
 st.global.f32 [%p1], %f2;
 ret;
}
