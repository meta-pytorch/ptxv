//
// Rung 1h, virtual aliases (S-VA-ALIAS): accesses before a write through another mapping.
// `a` and `b` are two mappings of one buffer (a second cuMemMap of the same handle).
// Thread 0:
//   - weak read through b, fence.proxy.alias, weak write of the same word through a;
//   - strong read through b, fence.proxy.alias, weak write through a;
//   - 17 strong writes of distinct words through a, fence.proxy.alias, a strong read of the
//     first word through b (the fence must cover every earlier strong access);
//   - weak read through b, fence.proxy.alias, flag release through a.
// Thread 32: acquires the flag through a, then writes the word thread 0 read through b.
// PTX ISA 8.6 (aliases act as distinct proxies), 8.7.1 (conflicting accesses not in
// causality order are a data race), 8.9.5 (proxy-preserved base causality order needs an
// alias proxy fence on the path from X to Y, whichever of X and Y is the write).
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry va_war(
    .param .u64 a,
    .param .u64 b,
    .param .u64 out
)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;

    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd2, [b];
    ld.param.u64 %rd3, [out];
    mov.u32 %r1, %tid.x;
    setp.eq.u32 %p1, %r1, 0;
    @%p1 bra T0;
    setp.eq.u32 %p1, %r1, 32;
    @%p1 bra T32;
    bra DONE;
T0:
    ld.global.u32 %r2, [%rd2];
    fence.proxy.alias; // @WAR1
    st.global.u32 [%rd1], 5;
    st.global.u32 [%rd3], %r2;
    ld.relaxed.sys.global.u32 %r3, [%rd2+4];
    fence.proxy.alias; // @WAR2
    st.global.u32 [%rd1+4], 6;
    st.global.u32 [%rd3+4], %r3;
    mov.u32 %r4, 0; // @RAR
    st.global.u32 [%rd3+8], %r4;
    st.relaxed.sys.global.u32 [%rd1+256], 1;
    st.relaxed.sys.global.u32 [%rd1+264], 1;
    st.relaxed.sys.global.u32 [%rd1+272], 1;
    st.relaxed.sys.global.u32 [%rd1+280], 1;
    st.relaxed.sys.global.u32 [%rd1+288], 1;
    st.relaxed.sys.global.u32 [%rd1+296], 1;
    st.relaxed.sys.global.u32 [%rd1+304], 1;
    st.relaxed.sys.global.u32 [%rd1+312], 1;
    st.relaxed.sys.global.u32 [%rd1+320], 1;
    st.relaxed.sys.global.u32 [%rd1+328], 1;
    st.relaxed.sys.global.u32 [%rd1+336], 1;
    st.relaxed.sys.global.u32 [%rd1+344], 1;
    st.relaxed.sys.global.u32 [%rd1+352], 1;
    st.relaxed.sys.global.u32 [%rd1+360], 1;
    st.relaxed.sys.global.u32 [%rd1+368], 1;
    st.relaxed.sys.global.u32 [%rd1+376], 1;
    st.relaxed.sys.global.u32 [%rd1+384], 1;
    fence.proxy.alias; // @OVF
    ld.relaxed.sys.global.u32 %r5, [%rd2+256]; // @FIRST
    ld.relaxed.sys.global.u32 %r8, [%rd2+384]; // @LAST
    add.u32 %r5, %r5, %r8;
    st.global.u32 [%rd3+12], %r5;
    ld.global.u32 %r6, [%rd2+64];
    fence.proxy.alias; // @WAR3
    st.global.u32 [%rd3+16], %r6;
    st.release.gpu.global.u32 [%rd1+128], 1;
    bra DONE;
T32:
POLL:
    ld.acquire.gpu.global.u32 %r7, [%rd1+128];
    setp.lt.u32 %p2, %r7, 1;
    @%p2 bra POLL;
    st.global.u32 [%rd1+64], 9;
DONE:
    ret;
}
