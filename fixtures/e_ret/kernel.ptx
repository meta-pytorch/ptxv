// E-RET: a non-inlined device function (SASS `CALL.REL.NOINC` / `RET.REL.NODEC`) called from
// two sites, the second after a bar.sync. Every return lands right after one of its calls.
//   good: thread 0 stores out[1] through the function's result, bar.sync, thread 32 reads it.
//   NOBAR: the BAR.SYNC NOPed (case.toml patch): the read races with the store.
// The PTX front has no `call`; kernel.cubin is `ptxas -arch=sm_103a kernel.ptx` (CUDA 13.0).
.version 9.0
.target sm_103a
.address_size 64

.func (.reg .b32 %ret) mix(.reg .b32 %a)
{
    .reg .b32 %t<4>;
    mul.lo.u32 %t1, %a, 2654435761;
    shr.u32 %t2, %t1, 7;
    xor.b32 %ret, %t1, %t2;
    ret;
}

.visible .entry e_ret(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    call (%r2), mix, (%r1);
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra SKIP;
    st.global.u32 [%rd1+4], %r2;
SKIP:
    bar.sync 0;
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
    ld.global.u32 %r3, [%rd1+4];
    call (%r4), mix, (%r3);
    st.global.u32 [%rd1], %r4;
DONE:
    ret;
}
