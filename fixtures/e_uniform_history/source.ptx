.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 input, .param .u64 output) {
 .shared .align 4 .b8 slot[8];
 .reg .b64 %p<2>;
 .reg .b32 %r<5>;
 .reg .pred %q<2>;
 ld.param.u64 %p0, [input];
 ld.param.u64 %p1, [output];
 mov.u32 %r0, %tid.x;
 mov.u32 %r1, slot;
 mad.lo.u32 %r4, %r0, 4, %r1;
 ld.volatile.global.u32 %r2, [%p0];
 st.volatile.shared.u32 [%r4], %r2;
 bar.warp.sync 3;
 setp.eq.u32 %q0, %r0, 0;
 @%q0 st.volatile.shared.u32 [%r1], 0;
 bar.warp.sync 3;
 setp.eq.u32 %q1, %r0, 1;
 @%q1 ld.volatile.shared.u32 %r3, [%r1];
 @%q1 st.global.u32 [%p1], %r3;
 ret;
}
