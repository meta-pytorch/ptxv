// RMK4 A4: the store is ordered after the invalidating thread's release, but the release is
// before the inval (INVAFTER, the default) or after it (control REL_AFTER_INV). Thread 0 inits
// `a`, bar.sync; t0: st.release flag; mbarrier.inval a. t32: spin ld.acquire flag; store zero
// over a. The store can land before the inval: violation.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry e_mbar_reuse_ordered(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b8 a[8];
    .shared .align 4 .b32 f[2];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, a;
    mov.u32 %r3, f;
    mov.u32 %r4, 1;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra AFTER_INIT;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    st.shared.u32 [%r3], 0;
    // @CL
AFTER_INIT:
    bar.sync 0;
    @%p2 bra NOINV;
    st.release.cta.shared.u32 [%r3], %r4;              // @REL
    mbarrier.inval.shared::cta.b64 [%r2];              // @INV
NOINV:
    setp.eq.u32 %p4, %r1, 32;
    @!%p4 bra NOST;
SPIN:
    ld.acquire.cta.shared.u32 %r5, [%r3];
    setp.ne.u32 %p5, %r5, 1;
    @%p5 bra SPIN;
    mov.b64 %rd5, 0;
    st.shared.u64 [%r2], %rd5;                         // @STORE
NOST:
    bar.sync 0;
    @%p2 bra DONE;
    st.global.u32 [%rd1], %r4;
DONE:
    ret;
}
