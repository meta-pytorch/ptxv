.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pa, .param .u64 pb, .param .u64 pout)
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<16>;
    ld.param.u64 %rd1, [pa];
    ld.param.u64 %rd2, [pb];
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %tid.x;
    shl.b32 %r7, %r2, 2;
    mad.lo.u32 %r3, %r1, 256, %r7;
    mul.wide.u32 %rd4, %r3, 4;
    add.s64 %rd5, %rd1, %rd4;
    add.s64 %rd6, %rd2, %rd4;
    add.s64 %rd7, %rd3, %rd4;
    ld.global.f32 %f1, [%rd5+0];
    ld.global.f32 %f2, [%rd5+4];
    ld.global.f32 %f3, [%rd5+8];
    ld.global.f32 %f4, [%rd5+12];
    red.global.add.f32 [%rd7+0], %f1;
    red.global.add.f32 [%rd7+4], %f2;
    red.global.add.f32 [%rd7+8], %f3;
    red.global.add.f32 [%rd7+12], %f4;
    ld.global.f32 %f5, [%rd6+0];
    ld.global.f32 %f6, [%rd6+4];
    ld.global.f32 %f7, [%rd6+8];
    ld.global.f32 %f8, [%rd6+12];
    red.global.add.f32 [%rd7+0], %f5;
    red.global.add.f32 [%rd7+4], %f6;
    red.global.add.f32 [%rd7+8], %f7;
    red.global.add.f32 [%rd7+12], %f8;
    ret;
}
