// S-NC across launches (E-PDL). Three kernels on one stream, 1 CTA x 32 each.
//   k0: a[t] = t + 7.
//   k1 (launched after k0 completed): x = ld.global.nc a[t] (k0 completed before k1 started:
//     exact); y = ld.global.nc src[t]; griddepcontrol.launch_dependents; b[t] = x + y.
//   k2 (PDL: may start once k1 triggered): griddepcontrol.wait; z = ld.global b[t];
//     out[t] = z; src[t] = 0 (after the wait, so after k1 completed and its .nc reads of src).
//   good: clean.
//   PDLNC: k2 reads b with ld.global.nc. The wait orders coherent loads only; ptxas moves the
//     .nc load above it (probes/nc_pdl hoist: GB300 reads the old word 200/200): reported.
//   EARLY: k2 overwrites src[t] before its wait, while k1 may still run: a race with k1's
//     read of src[t], and an .nc read of a byte written while its kernel runs.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k0(.param .u64 pa)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pa];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 4;
    add.s64         %rd3, %rd1, %rd2;
    add.u32         %r2, %r1, 7;
    st.global.u32   [%rd3], %r2;
    ret;
}

.visible .entry k1(.param .u64 pa, .param .u64 psrc, .param .u64 pb)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [pa];
    ld.param.u64    %rd2, [psrc];
    ld.param.u64    %rd3, [pb];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd4, %r1, 4;
    add.s64         %rd5, %rd1, %rd4;
    add.s64         %rd6, %rd2, %rd4;
    add.s64         %rd7, %rd3, %rd4;
    ld.global.nc.u32 %r2, [%rd5];                   // @K1A
    ld.global.nc.u32 %r3, [%rd6];
    griddepcontrol.launch_dependents;
    add.u32         %r4, %r2, %r3;
    st.global.u32   [%rd7], %r4;
    ret;
}

.visible .entry k2(.param .u64 pb, .param .u64 psrc, .param .u64 pout)
.reqntid 32
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [pb];
    ld.param.u64    %rd2, [psrc];
    ld.param.u64    %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd4, %r1, 4;
    add.s64         %rd5, %rd1, %rd4;
    add.s64         %rd6, %rd2, %rd4;
    add.s64         %rd7, %rd3, %rd4;
    mov.u32         %r5, 0;
    // (early slot) // @EARLY
    griddepcontrol.wait;
    ld.global.u32   %r2, [%rd5];                    // @READ
    st.global.u32   [%rd7], %r2;
    st.global.u32   [%rd6], %r5;                    // @LATE
    ret;
}
