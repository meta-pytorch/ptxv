//
// Exhaustive concolic expansion (cert.rs): input-dependent decisions that every thread makes
// the same way (n = cfg[0], m = cfg[1], x = xs[0]), each thread writing only its own word.
// good: four feasible paths (n > 100, x < 0.5), all clean: certified.
// Mutants (variants), each clean on the captured input (n = 7, m = 3, x = 0.25) with a race on
// out[0] reachable only on a side the captured input does not take:
//   race_eq     n == 0x12345                one 32-bit equality
//   race_nan    x is NaN                    a float compare (unordered)
//   race_combo  n > 100 and m == 77         a combination of two decisions
//   race_loop   a loop of m & 7 trips stores out[0] on trip 5
//   race_fmul   x * x > 2^23                float arithmetic (uninterpreted in the encoding)
//   race_hash   n * 0x9e3779b1 == 5         a multiplicative hash (modular inverse)
//   fault_oob   m == 4242: thread 0 stores out of bounds
//   addr        out[(t + n) & 63]: an input-dependent address (clean for every n, but not
//               fixed on the path: blocked, never certified)
//
.version 9.0
.target sm_103a
.address_size 64

.visible .entry exh(
	.param .u64 pcfg,
	.param .u64 pxs,
	.param .u64 pout
)
.reqntid 64
{
	.reg .pred %p<16>;
	.reg .b32 %r<40>;
	.reg .f32 %f<8>;
	.reg .b64 %rd<20>;

	ld.param.u64 %rd1, [pcfg];
	ld.param.u64 %rd2, [pxs];
	ld.param.u64 %rd3, [pout];
	cvta.to.global.u64 %rd1, %rd1;
	cvta.to.global.u64 %rd2, %rd2;
	cvta.to.global.u64 %rd3, %rd3;
	mov.u32 %r1, %tid.x;
	ld.global.u32 %r2, [%rd1];
	ld.global.u32 %r3, [%rd1+4];
	ld.global.f32 %f1, [%rd2];
	mul.wide.u32 %rd4, %r1, 4;
	add.s64 %rd5, %rd3, %rd4;
	// d1
	setp.gt.u32 %p1, %r2, 100;
	selp.u32 %r4, 1, 2, %p1;
	@%p1 bra BIG;
	st.global.u32 [%rd5], %r4;
	bra.uni D2;
BIG:
	add.u32 %r5, %r4, 10;
	st.global.u32 [%rd5], %r5;
D2:
	// d2
	setp.lt.f32 %p2, %f1, 0f3F000000;
	@%p2 st.global.u32 [%rd5], 3;
	mov.u32 %r30, 0; // @MUT
	ret;
}
