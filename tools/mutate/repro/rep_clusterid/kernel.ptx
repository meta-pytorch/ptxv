// E-CTA-REP: control and address from %clusterid.x (= %ctaid.x for 1-CTA clusters).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %clusterid.x;          // @SRC
    mov.u32 %r9, %ctaid.x;
    mad.lo.u32 %r3, %r9, 32, %r1;
    setp.eq.u32 %p1, %r2, 7;
    @%p1 add.u32 %r3, %r3, 4096;        // @OFF CTA 7 stores far past the end
    mul.wide.u32 %rd2, %r3, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r9;
    ret;
}
