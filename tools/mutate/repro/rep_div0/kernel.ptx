.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 out_p, .param .u64 in_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [in_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    shl.b32 %r3, %r2, 5;
    add.u32 %r4, %r3, %r1;
    mul.wide.u32 %rd3, %r4, 4;
    add.s64 %rd4, %rd2, %rd3;
    ld.global.u32 %r5, [%rd4];
    sub.s32 %r6, %r5, 96;
    div.s32 %r7, 1000, %r6;
    add.s64 %rd5, %rd1, %rd3;
    st.global.u32 [%rd5], %r7;
    ret;
}
