// C-POLL-ATOM base: the poller's own add is HB-before its poll but comes after another
// CTA's concurrent add in the run.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 out_p, .param .u64 data_p, .param .u64 cnt_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [data_p];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [cnt_p];
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra DONE;
    mov.u32 %r2, %ctaid.x;
    add.u32 %r3, %r2, 1;
    mul.wide.u32 %rd4, %r2, 4;
    add.u64 %rd5, %rd2, %rd4;
    setp.eq.u32 %p2, %r2, 1;          // @SLOW
    st.global.u32 [%rd5], %r3;
    red.release.gpu.global.add.u32 [%rd3], 1;
    setp.ne.u32 %p2, %r2, 2;
    @%p2 bra DONE;
SPIN:
    ld.acquire.gpu.global.u32 %r5, [%rd3];
    setp.lt.u32 %p3, %r5, 2;              // @COND
    @%p3 bra SPIN;
    ld.global.u32 %r8, [%rd2];
    ld.global.u32 %r9, [%rd2+4];
    add.u32 %r8, %r8, %r9;
    st.global.u32 [%rd1], %r8;
DONE:
    ret;
}
