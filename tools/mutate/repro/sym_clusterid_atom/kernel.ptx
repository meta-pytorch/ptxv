// E-CTA-INDEP symmetry: cluster 3 (by %clusterid.x) hands out shared-memory tickets; the
// output depends on the schedule only there.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry k(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<12>;
    .reg .pred %p<4>;
    .shared .align 4 .b32 s[1];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %clusterid.x;          // @SRC
    mov.u32 %r9, %ctaid.x;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra SKIPW;
    st.shared.u32 [s], 0;
SKIPW:
    bar.sync 0;
    mov.u32 %r5, %r1;
    setp.ne.u32 %p1, %r2, 3;
    @%p1 bra STORE;
    atom.shared.add.u32 %r5, [s], 1;
STORE:
    mad.lo.u32 %r3, %r9, 64, %r1;
    mul.wide.u32 %rd2, %r3, 4;
    add.u64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r5;
    ret;
}
