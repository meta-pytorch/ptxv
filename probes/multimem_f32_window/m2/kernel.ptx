// MISS 225 repro: thread i reduces lane i of each test through the multicast object mc and
// stores the result to out: f32 (multimem.ld_reduce.relaxed.sys.global.add.f32, n0 lanes from
// word 0), f32w (multimem.ld_reduce.weak.global.add.f32, n1 lanes from word b1) and f32x4
// (multimem.ld_reduce.relaxed.sys.global.add.v4.f32, n2 16-byte groups from word b2), the
// instructions of probes/multimem/mm.cu `ldr` (data/m<N>.in<d>.bin: the sections in that order).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mm32(
    .param .u64 mc,
    .param .u64 out,
    .param .u32 n0, .param .u32 n1, .param .u32 n2,
    .param .u32 b1, .param .u32 b2
)
{
    .reg .pred %p<3>;
    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [mc];
    ld.param.u64 %rd2, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r1, %r2, %r3, %r1;
    // f32
    ld.param.u32 %r7, [n0];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T1;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.f32 %r10, [%rd4];
    st.global.b32 [%rd5], %r10;
T1:
    // f32w
    ld.param.u32 %r7, [n1];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T2;
    ld.param.u32 %r8, [b1];
    add.u32 %r9, %r1, %r8;
    mul.wide.u32 %rd3, %r9, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.weak.global.add.f32 %r10, [%rd4];
    st.global.b32 [%rd5], %r10;
T2:
    // f32x4
    ld.param.u32 %r7, [n2];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T3;
    ld.param.u32 %r8, [b2];
    shl.b32 %r9, %r1, 2;
    add.u32 %r9, %r9, %r8;
    mul.wide.u32 %rd3, %r9, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.v4.f32 {%r10, %r11, %r12, %r13}, [%rd4];
    st.global.v4.b32 [%rd5], {%r10, %r11, %r12, %r13};
T3:
    ret;
}
