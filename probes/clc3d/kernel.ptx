// Probe for the CLC response encoding on a 3-D grid (16 x 4 x 128 one-warp CTAs): thread 0 of
// each CTA issues one try_cancel and writes out[8c..8c+7] = {1 (ran), is_canceled, raw0..raw3,
// get_first_ctaid::y, ::z}, c = x + 16 (y + 4 z). check.py: a cancelled CTA never ran and is (raw0, raw1 & 0xffff, raw1 >> 16).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_clc3d(.param .u64 out)
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .b128 %q<2>;
    .shared .align 16 .b8 resp[16];
    .shared .align 8 .b8 bar[8];
    mov.u32         %r9, %tid.x;
    setp.ne.u32     %p3, %r9, 0;
    @%p3 bra        DONE;
    mov.u32         %r0, resp;
    mov.u32         %r1, bar;
    mbarrier.init.shared::cta.b64 [%r1], 1;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 16;
    clusterlaunchcontrol.try_cancel.async.shared::cta.mbarrier::complete_tx::bytes.b128 [%r0], [%r1];
W:
    mbarrier.try_wait.parity.shared::cta.b64 %p0, [%r1], 0;
    @!%p0 bra       W;
    ld.shared.b128  %q0, [%r0];
    ld.shared.v4.b32 {%r4, %r5, %r6, %r7}, [%r0];
    clusterlaunchcontrol.query_cancel.is_canceled.pred.b128 %p1, %q0;
    selp.u32        %r3, 1, 0, %p1;
    mov.u32         %r2, 0;
    mov.u32         %r11, 0;
    @%p1 clusterlaunchcontrol.query_cancel.get_first_ctaid::y.b32.b128 %r2, %q0;
    @%p1 clusterlaunchcontrol.query_cancel.get_first_ctaid::z.b32.b128 %r11, %q0;
    mov.u32         %r8, %ctaid.x;
    mov.u32         %r12, %ctaid.y;
    mov.u32         %r13, %ctaid.z;
    shl.b32         %r13, %r13, 2;
    add.u32         %r12, %r12, %r13;
    shl.b32         %r12, %r12, 4;
    add.u32         %r8, %r8, %r12;
    ld.param.u64    %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    mul.wide.u32    %rd2, %r8, 32;
    add.u64         %rd3, %rd1, %rd2;
    mov.u32         %r10, 1;
    st.global.v4.b32 [%rd3], {%r10, %r3, %r4, %r5};
    st.global.v4.b32 [%rd3+16], {%r6, %r7, %r2, %r11};
DONE:
    ret;
}
