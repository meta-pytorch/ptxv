// MISS 224 repro, the payload alone (probes/README.md): thread 0 writes out[i] = x[i] + y[i]
// (one rounding) with plain stores: the bits loop/'s RDMA write carries, run on GB300.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry arith(
    .param .u64 out,
    .param .u64 x,
    .param .u64 y
)
.maxntid 32, 1, 1
{
    .reg .pred  %p<2>;
    .reg .b32   %r<4>;
    .reg .b64   %rd<16>;
    .reg .f32   %f<8>;
    mov.u32         %r0, %tid.x;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        DONE;
    ld.param.u64    %rd9, [x];
    ld.param.u64    %rd14, [y];
    ld.param.u64    %rd3, [out];
    ld.global.v4.f32 {%f0, %f1, %f2, %f3}, [%rd9];
    ld.global.v4.f32 {%f4, %f5, %f6, %f7}, [%rd14];
    add.rn.f32      %f0, %f0, %f4;
    add.rn.f32      %f1, %f1, %f5;
    add.rn.f32      %f2, %f2, %f6;
    add.rn.f32      %f3, %f3, %f7;
    st.global.v4.f32 [%rd3], {%f0, %f1, %f2, %f3};
DONE:
    ret;
}
