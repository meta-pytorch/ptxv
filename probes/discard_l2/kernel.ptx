// probes/discard_l2: discard.global.L2 [a], 128 makes the line's contents indeterminate
// (S-INIT). 32 threads; buf[0..32) (one 128-byte line) is written by the warp (buf[t] =
// 0x1000 + t), discarded by lane 0, rewritten (buf[t] = 0x2000 + t) and read back into
// buf[32 + t]. Variant read_after (@RA): the rewrite is skipped, so the read sees the
// discarded (indeterminate) line.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry discard_l2(
    .param .u64 pbuf
)
.maxntid 32, 1, 1
{
    .reg .b32   %r<8>;
    .reg .b64   %rd<8>;
    .reg .pred  %p<4>;

    ld.param.u64    %rd1, [pbuf];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd2, %r1, 4;
    add.s64         %rd3, %rd1, %rd2;
    add.u32         %r2, %r1, 0x1000;
    st.global.u32   [%rd3], %r2;
    bar.sync        0;
    setp.eq.u32     %p1, %r1, 0;
    @%p1 discard.global.L2 [%rd1], 128;
    bar.sync        0;
    mov.pred        %p2, 0; // @RA
    @%p2 bra        SKIP;
    add.u32         %r3, %r1, 0x2000;
    st.global.u32   [%rd3], %r3;
SKIP:
    bar.sync        0;
    ld.global.u32   %r4, [%rd3];
    st.global.u32   [%rd3+128], %r4;
    ret;
}
