// N-CVT-LP s2f6 probe (generated by gen.py; do not edit): the MXINT8 dequant
// cvt.rn[.relu][.satfinite].scaled::n2::ue8m0.bf16x2.s2f6x2 (SASS F2FP[.SATFINITE][.RELU].BF16
// .S2_6.UNPACK_B Rd, Ra[.H1], Rb.H0). Thread i: x = four s2f6 codes, y = four ue8m0 scales;
// op j converts (x.lo16, y.lo16) into out[8 i + 2 j] and (x.hi16, y.hi16) into
// out[8 i + 2 j + 1].
.version 9.1
.target sm_103a
.address_size 64

.visible .entry cvt_s2f6(.param .u64 x_p, .param .u64 y_p, .param .u64 out_p)
{
    .reg .b32 %x, %y, %o, %t<4>;
    .reg .b16 %xl, %xh, %yl, %yh;
    .reg .b64 %rd<8>;
    mov.u32 %t0, %ctaid.x;
    mov.u32 %t1, %ntid.x;
    mov.u32 %t2, %tid.x;
    mad.lo.u32 %t3, %t0, %t1, %t2;
    mul.wide.u32 %rd1, %t3, 4;
    ld.param.u64 %rd2, [x_p];
    add.u64 %rd3, %rd2, %rd1;
    ld.global.u32 %x, [%rd3];
    ld.param.u64 %rd2, [y_p];
    add.u64 %rd3, %rd2, %rd1;
    ld.global.u32 %y, [%rd3];
    mov.b32 {%xl, %xh}, %x;
    mov.b32 {%yl, %yh}, %y;
    mul.wide.u32 %rd4, %t3, 32;
    ld.param.u64 %rd5, [out_p];
    add.u64 %rd6, %rd5, %rd4;
    // 0: rn.satfinite
    cvt.rn.satfinite.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xl, %yl;
    st.global.u32 [%rd6+0], %o;
    cvt.rn.satfinite.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xh, %yh;
    st.global.u32 [%rd6+4], %o;
    // 1: rn
    cvt.rn.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xl, %yl;
    st.global.u32 [%rd6+8], %o;
    cvt.rn.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xh, %yh;
    st.global.u32 [%rd6+12], %o;
    // 2: rn.relu
    cvt.rn.relu.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xl, %yl;
    st.global.u32 [%rd6+16], %o;
    cvt.rn.relu.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xh, %yh;
    st.global.u32 [%rd6+20], %o;
    // 3: rn.relu.satfinite
    cvt.rn.relu.satfinite.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xl, %yl;
    st.global.u32 [%rd6+24], %o;
    cvt.rn.relu.satfinite.scaled::n2::ue8m0.bf16x2.s2f6x2 %o, %xh, %yh;
    st.global.u32 [%rd6+28], %o;
    ret;
}
