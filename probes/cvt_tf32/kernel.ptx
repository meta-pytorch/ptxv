// probes/cvt_tf32: cvt.rna.tf32.f32 (round to 19 bits, ties away from zero; ptxas adds 0x1000
// to a finite operand and masks with 0xffffe000, Inf / NaN only masked). 256 threads x 4
// words: in = random words, ties (low 13 bits 0x1000), near-overflow values, NaN payloads,
// Inf, subnormals (gen.py); out[i] = cvt.rna.tf32.f32(in[i]).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry cvt_tf32(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 16;
    add.s64         %rd4, %rd1, %rd3;
    add.s64         %rd5, %rd2, %rd3;
    ld.global.v4.b32 {%r2, %r3, %r4, %r5}, [%rd4];
    cvt.rna.tf32.f32 %r6, %r2;
    cvt.rna.tf32.f32 %r7, %r3;
    cvt.rna.tf32.f32 %r8, %r4;
    cvt.rna.tf32.f32 %r9, %r5;
    st.global.v4.b32 [%rd5], {%r6, %r7, %r8, %r9};
    ret;
}
