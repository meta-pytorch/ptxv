// probes/cvt_ftz: cvt.ftz.sat.f32.f32 and cvt.ftz.f32.f32 (ptxas: FADD.FTZ.SAT d, RZ, a and
// FADD.FTZ d, a, -RZ). 64 threads; x = in[t] (gen.py: signed zeros, subnormals, NaN payloads,
// infinities, values around 0 and 1); out[2 t] = cvt.ftz.sat, out[2 t + 1] = cvt.ftz.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry cvt_ftz(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 64, 1, 1
{
    .reg .b32   %r<4>;
    .reg .f32   %f<4>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 4;
    add.s64         %rd4, %rd1, %rd3;
    mul.wide.u32    %rd5, %r1, 8;
    add.s64         %rd6, %rd2, %rd5;
    ld.global.f32   %f1, [%rd4];
    cvt.ftz.sat.f32.f32 %f2, %f1;
    cvt.ftz.f32.f32 %f3, %f1;
    st.global.v2.f32 [%rd6], {%f2, %f3};
    ret;
}
