// Probe for bar.red.{popc.u32, and.pred, or.pred} over the CTA (256 threads): per thread,
// predicates from the input word (bits 0..2), a negated source, and a named barrier with a
// thread count (64: warps 0-1 only). Thread i writes words 8i..8i+7.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry bar_red(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<20>; .reg .pred %p<12>;
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mul.wide.u32 %rd3, %r1, 4; add.s64 %rd4, %rd1, %rd3;
  mul.wide.u32 %rd5, %r1, 32; add.s64 %rd6, %rd2, %rd5;
  ld.global.u32 %r2, [%rd4];
  and.b32 %r3, %r2, 1; setp.ne.u32 %p1, %r3, 0;
  and.b32 %r4, %r2, 2; setp.ne.u32 %p2, %r4, 0;
  and.b32 %r5, %r2, 4; setp.ne.u32 %p3, %r5, 0;
  bar.red.popc.u32 %r6, 0, %p1;
  bar.red.popc.u32 %r7, 1, !%p2;
  bar.red.and.pred %p4, 0, %p3;
  bar.red.or.pred %p5, 2, %p2;
  bar.red.and.pred %p6, 0, !%p1;
  bar.red.or.pred %p7, 1, !%p3;
  selp.u32 %r8, 1, 0, %p4; selp.u32 %r9, 1, 0, %p5;
  selp.u32 %r10, 1, 0, %p6; selp.u32 %r11, 1, 0, %p7;
  mov.u32 %r12, 0; mov.u32 %r13, 0;
  setp.lt.u32 %p8, %r1, 64;
  @!%p8 bra $L_skip;
  bar.red.popc.u32 %r12, 3, 64, %p1;
  bar.red.or.pred %p9, 4, 64, %p3;
  selp.u32 %r13, 1, 0, %p9;
$L_skip:
  st.global.v4.u32 [%rd6], {%r6, %r7, %r8, %r9};
  st.global.v4.u32 [%rd6+16], {%r10, %r11, %r12, %r13};
  ret; }
