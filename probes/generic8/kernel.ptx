// probes/generic8: generic byte accesses and CTA-scope global atomics (SASS LD.E.U8, LD.E.S8,
// ST.E.U8, ATOMG / REDG .E.ADD.STRONG.SM). 128 threads; thread t: a = in8[t] (ld.u8), b =
// in8[128 + t] (ld.s8, sign-extended), out8[t] = a + b (st.u8, generic); outw[64 + t] = b
// (sign-extended); old = atom.global.cta.add(cnt[0], t + 1) with outw[192 + t] = old - old
// (the value depends on the order: only zero is stored), red.global.cta.add(cnt[1], t); the
// counters are outw[320] and outw[321].
.version 8.8
.target sm_103a
.address_size 64

.visible .entry generic8(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 128, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b16   %rs<8>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    mov.u32         %r1, %tid.x;
    add.s64         %rd8, %rd2, 1280;              // counters: outw[320], outw[321]
    cvt.u64.u32     %rd3, %r1;
    add.s64         %rd4, %rd1, %rd3;
    add.s64         %rd5, %rd2, %rd3;
    ld.u8           %rs1, [%rd4];
    ld.s8           %rs2, [%rd4+128];
    add.s16         %rs3, %rs1, %rs2;
    st.u8           [%rd5], %rs3;
    cvt.s32.s16     %r2, %rs2;
    mul.wide.u32    %rd6, %r1, 4;
    add.s64         %rd7, %rd2, %rd6;
    st.u32          [%rd7+256], %r2;
    add.u32         %r4, %r1, 1;
    atom.global.cta.add.u32 %r3, [%rd8], %r4;
    sub.u32         %r5, %r3, %r3;
    st.u32          [%rd7+768], %r5;
    red.global.cta.add.u32 [%rd8+4], %r1;
    ret;
}
