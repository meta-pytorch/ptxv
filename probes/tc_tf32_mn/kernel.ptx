// probes/tc_tf32_mn: tcgen05.mma.kind::tf32 with MN-major operands (idesc bits 15 / 16), which
// GB300 reads only through smem descriptor layout 1 (SWIZZLE_128B_BASE32B; the other layouts
// give zeros). The CTA copies a host-built 18,432-byte shared-memory image (gen.py), then
// thread 0 issues MMA 1 (A MN-major at 0, B K-major at 16384) into TMEM columns 0..15 and
// MMA 2 (A K-major at 8192, B MN-major at 12288) into columns 16..31, D[128x16] = A[128x8]
// B[16x8]^T each; thread t writes its lane's 32 columns to out[32 t ..].
.version 9.0
.target sm_103a
.address_size 64

.visible .entry tc_tf32_mn(
    .param .u64 img,
    .param .u64 out
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<100>;
    .reg .b64   %rd<40>;
    .shared .align 16 .b32 tmem_slot;
    .shared .align 8 .b64 done_bar;
    .shared .align 1024 .b8 sm[18432];

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;
    mov.u32         %r3, tmem_slot;
    mov.u32         %r4, done_bar;
    mov.u32         %r5, sm;
    setp.ne.u32     %p0, %r1, 0;
    @%p0 bra        SKIP_ALLOC;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
SKIP_ALLOC:
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    fence.mbarrier_init.release.cluster;
SKIP_INIT:
    ld.param.u64    %rd1, [img];
    cvta.to.global.u64 %rd1, %rd1;
    shl.b32         %r6, %r0, 4;
    mov.u32         %r7, 0;
COPY:
    add.u32         %r8, %r6, %r7;
    cvt.u64.u32     %rd2, %r8;
    add.u64         %rd3, %rd1, %rd2;
    ld.global.v4.b32 {%r20, %r21, %r22, %r23}, [%rd3];
    add.u32         %r9, %r5, %r8;
    st.shared.v4.b32 [%r9], {%r20, %r21, %r22, %r23};
    add.u32         %r7, %r7, 2048;
    setp.lt.u32     %p2, %r7, 18432;
    @%p2 bra        COPY;
    fence.proxy.async.shared::cta;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    ld.shared.b32   %r16, [%r3];
    @%p1 bra        WAIT;
    // B (for MMA 1): K-major, no swizzle, at sm + 16384: SBO 128, LBO 256
    add.u32         %r30, %r5, 16384;
    shr.u32         %r30, %r30, 4;
    cvt.u64.u32     %rd10, %r30;
    or.b64          %rd11, %rd10, 0x0000400800100000;
    // MMA 1: A MN-major, SWIZZLE_128B_BASE32B (layout 1) at sm + 0: LBO 1024 (32-row M atoms),
    // SBO 4096 (K rows 4..7); idesc f32 D, tf32 A / B, A MN-major, N 16, M 128
    mov.u32         %r31, 0x8048910;
    shr.u32         %r32, %r5, 4;
    cvt.u64.u32     %rd12, %r32;
    or.b64          %rd13, %rd12, 0x2000410000400000;
    tcgen05.mma.cta_group::1.kind::tf32 [%r16], %rd13, %rd11, %r31, 0;
    // MMA 2: A K-major, no swizzle, at sm + 8192 (SBO 128, LBO 2048); B MN-major,
    // SWIZZLE_128B_BASE32B at sm + 12288 (LBO 1024, SBO 1024); idesc B MN-major
    mov.u32         %r33, 0x8050910;
    add.u32         %r34, %r5, 8192;
    shr.u32         %r34, %r34, 4;
    cvt.u64.u32     %rd14, %r34;
    or.b64          %rd15, %rd14, 0x0000400800800000;
    add.u32         %r35, %r5, 12288;
    shr.u32         %r35, %r35, 4;
    cvt.u64.u32     %rd16, %r35;
    or.b64          %rd17, %rd16, 0x2000404000400000;
    add.u32         %r40, %r16, 16;
    tcgen05.mma.cta_group::1.kind::tf32 [%r40], %rd15, %rd17, %r33, 0;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%r4];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r4], 0;
    @!%p3 bra       WAIT;
    tcgen05.fence::after_thread_sync;
    ld.param.u64    %rd20, [out];
    cvta.to.global.u64 %rd20, %rd20;
    mul.wide.u32    %rd21, %r0, 128;
    add.u64         %rd22, %rd20, %rd21;
    shl.b32         %r17, %r1, 21;
    add.u32         %r18, %r16, %r17;
    mov.u32         %r60, 0;
DUMP:
    add.u32         %r61, %r18, %r60;
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r70, %r71, %r72, %r73, %r74, %r75, %r76, %r77, %r78, %r79, %r80, %r81, %r82, %r83, %r84, %r85}, [%r61];
    tcgen05.wait::ld.sync.aligned;
    st.global.v4.b32 [%rd22+0], {%r70, %r71, %r72, %r73};
    st.global.v4.b32 [%rd22+16], {%r74, %r75, %r76, %r77};
    st.global.v4.b32 [%rd22+32], {%r78, %r79, %r80, %r81};
    st.global.v4.b32 [%rd22+48], {%r82, %r83, %r84, %r85};
    add.u64         %rd22, %rd22, 64;
    add.u32         %r60, %r60, 16;
    setp.lt.u32     %p4, %r60, 32;
    @%p4 bra        DUMP;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    @%p0 bra        DONE;
    tcgen05.fence::after_thread_sync;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r16, 32;
DONE:
    ret;
}
