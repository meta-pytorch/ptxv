// Stateful-explorer repro (MISS 232): the issue order of two lanes into one remote pipe under
// the synchronization reduction. Rank 0 warp 0, lanes diverged. Lane 0 arrives on rank 1's M1
// (X), then runs a one-trip loop of volatile loads (it keeps the warp diverged on SASS: without
// it ptxas if-converts the two paths and the converged warp always issues X first, as in
// probes/dpor_pipe_issue_order). Lane 1 arrives on rank 1's M1 (Y), runs fence.acq_rel.cluster (drains its own remote
// ops: lands the pipe prefix up to Y) and arrives .release.cluster on rank 1's M2. X and Y
// share one pipe (warp 0, CTA 1, M1).
//   issue order X,Y: lane 1's drain lands X (the head) then Y, so M1's phase 0 (count 2) has
//                    completed when rank 1 has acquired M2: test_wait is always true.
//   issue order Y,X: the drain lands Y only; X can still be in flight when rank 1 tests M1:
//                    test_wait can be false. out = 1 or 0 (nondeterministic).
// Rank 1 then waits on M1 for real (both arrivals delivered before it exits).
// The two issues conflict only in the remote pipe they enter, so a reduction whose footprints
// leave the pipe out schedules one issue order (the stateful synchronization reduction on
// SASS until MISS 232; DPOR until MISS 222).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry sync_pipe_issue_order(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 4 .b32 g;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, g;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    or.pred %p2, %p0, %p1;
    @%p2 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 2;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
INIT_DONE:
    @%p1 bra G1;
    st.shared.u32 [%r8], 0;
G1:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.gt.u32 %p3, %r1, 1;
    @%p3 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r5, 1;
    @%p1 bra LANE0;
    mbarrier.arrive.relaxed.cluster.shared::cluster.b64 _, [%r9];
    mov.u32 %r17, 0;
SPINX:
    ld.volatile.shared.u32 %r16, [%r8];
    add.u32 %r17, %r17, 1;
    setp.lt.u32 %p7, %r17, %r16;
    @%p7 bra SPINX;
    bra END;
LANE0:
    mbarrier.arrive.relaxed.cluster.shared::cluster.b64 _, [%r9];
    fence.acq_rel.cluster;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r10];
    bra END;
RANK1:
    @%p1 bra END;
WAIT2:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra WAIT2;
    mbarrier.test_wait.parity.acquire.cluster.shared::cta.b64 %p6, [%r4], 0;
    selp.u32 %r15, 1, 0, %p6;
    st.global.u32 [%rd1], %r15;
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r4], 0;
    @!%p4 bra WAIT;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
