// Probe for ASSUMPTIONS.md S-RESERVED: the initial contents of the system-reserved shared
// memory 0x0..0x3ff, which ptxas's tcgen05 code uses for hidden bookkeeping (0x40..0x5f:
// alloc bitmaps, relinquish flag, and for cta_group::2 a hidden mbarrier at 0x48 with a phase
// bit at 0x50). Thread i of each CTA writes word i: out[cta*256 + i] = smem[4i], read before
// anything else touches shared memory.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_reserved_smem(.param .u64 out)
.reqnctapercluster 2, 1, 1                                          // @NOCLUSTER
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    .reg .pred %p<2>;
    .shared .align 4 .b32 slot;
    mov.u32         %r0, %tid.x;
    mov.u32         %r1, %ctaid.x;
    shl.b32         %r2, %r0, 2;
    mov.u32         %r6, %cluster_ctarank;
    shl.b32         %r6, %r6, 24;
    or.b32          %r2, %r2, %r6;                  // own window: rank << 24 | offset   // @UNTAGGED
    ld.volatile.shared.b32 %r3, [%r2];
    ld.param.u64    %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    shl.b32         %r4, %r1, 8;
    add.u32         %r5, %r4, %r0;
    mul.wide.u32    %rd2, %r5, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r3;
    // A paired TMEM allocation after the dump, so the cubin is a cta_group::2 kernel.
    bar.sync        0;
    shr.u32         %r7, %r0, 5;
    setp.ne.u32     %p0, %r7, 0;
    @%p0 bra        DONE;
    mov.u32         %r1, slot;
    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r1], 32;   // @NOPAIR
    tcgen05.relinquish_alloc_permit.cta_group::2.sync.aligned;          // @NOPAIR
    ld.volatile.shared.b32 %r3, [%r1];
    tcgen05.dealloc.cta_group::2.sync.aligned.b32 %r3, 32;              // @NOPAIR
DONE:
    ret;
}
