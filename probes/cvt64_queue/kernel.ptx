// Probe (MISS 130): same-base conversions of different widths (F2I.S64 / F2I, I2F.S64 / I2F.U32) as one queue?
.version 9.0
.target sm_103a
.address_size 64
.visible .entry cvt64q(.param .u64 out_p, .param .u64 seed)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<16>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [seed];
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd3, %r1;
    mul.lo.u64 %rd4, %rd3, %rd2;
    cvt.u32.u64 %r2, %rd4;
    cvt.rn.f32.u32 %f3, %r1;
    mul.f32 %f4, %f3, 0f4B12D687;
    mul.f32 %f5, %f3, 0f3FC00000;
    cvt.rzi.s64.f32 %rd5, %f4;     // F2I.S64
    cvt.rzi.s32.f32 %r3, %f5;      // F2I
    cvt.rm.f32.s64 %f1, %rd4;      // I2F.S64.RM
    cvt.rm.f32.u32 %f2, %r2;       // I2F.U32.RM
    mul.wide.u32 %rd6, %r1, 32;
    add.s64 %rd7, %rd1, %rd6;
    st.global.u64 [%rd7], %rd5;
    st.global.u32 [%rd7+8], %r3;
    st.global.v2.f32 [%rd7+16], {%f1, %f2};
    ret;
}
