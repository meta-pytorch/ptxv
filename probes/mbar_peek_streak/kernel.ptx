// RMK277 F1: warp 0 peeks an mbarrier that warp 1 initializes later (mbar-uninit, Flow::Stay);
// DetSched keeps warp 0 for DET_STREAK=4096 steps, then moves to warp 1, which initializes the
// mbarrier and writes out[0]; warp 0 then passes the peek and writes out[0] too: a write-write
// race that only a run past the 64-step FaultLoop stop reaches.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mbar_peek_streak(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b8 a[8];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, a;
    setp.eq.u32 %p1, %r1, 0;
    setp.eq.u32 %p2, %r1, 32;
    @%p1 bra W0;
    @%p2 bra W1;
    bra DONE;
W0:
    mbarrier.test_wait.parity.shared::cta.b64 %p6, [%r2], 0;
    selp.u32 %r9, 1, 2, %p6;
    st.global.u32 [%rd1], %r9;
    bra DONE;
W1:
    mov.u32 %r3, 1;
    mbarrier.init.shared::cta.b64 [%r2], %r3;
    mov.u32 %r4, 7;
    st.global.u32 [%rd1], %r4;
DONE:
    ret;
}
