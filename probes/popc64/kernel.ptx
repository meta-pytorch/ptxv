// probes/popc64: popc.b64 (ptxas: POPC of each half, IADD3). 256 threads; out[t] =
// popc(in[t]) (gen.py: 0, all ones, single bits, alternating patterns, random).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry popc64(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<4>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 8;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.b64   %rd5, [%rd4];
    popc.b64        %r2, %rd5;
    mul.wide.u32    %rd6, %r1, 4;
    add.s64         %rd7, %rd2, %rd6;
    st.global.b32   [%rd7], %r2;
    ret;
}
