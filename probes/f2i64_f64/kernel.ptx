// Probe (measured by the RVS2 review): F2I.S64.F64 and F2I.F64 (32-bit result), same base opcode, both with an f64 operand.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry f2i64f64(.param .u64 out_p, .param .u64 seed)
{
    .reg .b32 %r<16>;
    .reg .f64 %fd<16>;
    .reg .b64 %rd<16>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [seed];
    mov.u32 %r1, %tid.x;
    cvt.u64.u32 %rd3, %r1;
    mul.lo.u64 %rd4, %rd3, %rd2;
    cvt.rn.f64.u64 %fd1, %rd4;
    cvt.rn.f64.u32 %fd2, %r1;
    mul.f64 %fd3, %fd2, 0d3FF8000000000000;
    cvt.rzi.s64.f64 %rd5, %fd1;     // F2I.S64.F64
    cvt.rzi.s32.f64 %r3, %fd3;      // F2I.F64
    mul.wide.u32 %rd6, %r1, 16;
    add.s64 %rd7, %rd1, %rd6;
    st.global.u64 [%rd7], %rd5;
    st.global.u32 [%rd7+8], %r3;
    ret;
}
