// probes/f32x2_repack: plain mul.f32x2 products unpacked and repacked (PTX-FMAD). 256 threads;
// per thread 16 words: x, y, u, w, c, e (f32x2 each), k, then pad (gen.py: c, e near minus the
// product lanes they meet, so a contraction changes the result). p = x * y, q = u * w.
//   out[8 t + 0, 1] = {q.hi, p.hi} + ({q.lo, p.lo} + c)   (CuTe FA backward preprocess:
//                     each pack mixes a half in its own lane with one of the other product)
//   out[8 t + 2, 3] = {p.lo, k} + e                        (own lane next to a loaded word)
//   out[8 t + 4]    = low word of (p >> 7) ^ p            (integer reads of the bits)
//   out[8 t + 5]    = cvt.u32.u64 p
// With k replaced by p.hi (marker @K: {p.lo, p.hi}) ptxas contracts into FFMA2; the PTX front
// refuses it.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry f32x2_repack(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<32>;
    .reg .b64   %rd<40>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 64;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.v2.b64 {%rd5, %rd6}, [%rd4];
    ld.global.v2.b64 {%rd7, %rd8}, [%rd4+16];
    ld.global.v2.b64 {%rd9, %rd10}, [%rd4+32];
    ld.global.u32   %r2, [%rd4+48];
    mul.wide.u32    %rd11, %r1, 32;
    add.s64         %rd12, %rd2, %rd11;

    mul.f32x2       %rd13, %rd5, %rd6;
    mul.f32x2       %rd14, %rd7, %rd8;
    mov.b64         {%r10, %r11}, %rd14;
    mov.b64         {%r12, %r13}, %rd13;
    mov.b64         %rd15, {%r11, %r13};
    mov.b64         %rd16, {%r10, %r12};
    add.f32x2       %rd17, %rd16, %rd9;
    add.f32x2       %rd18, %rd15, %rd17;
    st.global.b64   [%rd12], %rd18;

    mul.f32x2       %rd20, %rd5, %rd6;
    mov.b64         {%r14, %r15}, %rd20;
    mov.b64         %rd21, {%r14, %r2}; // @K
    add.f32x2       %rd22, %rd21, %rd10;
    st.global.b64   [%rd12+8], %rd22;

    mul.f32x2       %rd23, %rd7, %rd6;
    shr.u64         %rd24, %rd23, 7;
    xor.b64         %rd25, %rd24, %rd23;
    cvt.u32.u64     %r20, %rd25;
    cvt.u32.u64     %r21, %rd23;
    st.global.v2.b32 [%rd12+16], {%r20, %r21};
    ret;
}
