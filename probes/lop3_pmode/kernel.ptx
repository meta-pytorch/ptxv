// Probe (L-LOP3-P): base kernel for patch.py. out[i] = (a & ~b != 0) + 2 (c < 0) over the
// (a, b, c) triples in `in`; ptxas emits `ISETP.GE.AND P1, PT, c, RZ, PT` then
// `LOP3.LUT P0, RZ, a, b, RZ, 0x30, !PT`, whose predicate operand patch.py rewrites.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry lop3_pmode(.param .u64 in_p, .param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [in_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [out_p];
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r1, %tid.x;
    mov.u32 %r13, %ctaid.x;
    shl.b32 %r14, %r13, 8;
    add.u32 %r1, %r1, %r14;
    mul.wide.u32 %rd3, %r1, 12;
    add.u64 %rd4, %rd1, %rd3;
    ld.global.u32 %r4, [%rd4+8];
    setp.lt.s32 %p2, %r4, 0;
    selp.u32 %r8, 2, 0, %p2;
    ld.global.volatile.u32 %r2, [%rd4];
    ld.global.volatile.u32 %r3, [%rd4+4];
    not.b32 %r5, %r3;
    and.b32 %r6, %r2, %r5;
    setp.ne.u32 %p1, %r6, 0;
    selp.u32 %r7, 1, 0, %p1;
    add.u32 %r9, %r7, %r8;
    mul.wide.u32 %rd5, %r1, 4;
    add.u64 %rd6, %rd2, %rd5;
    st.global.u32 [%rd6], %r9;
    ret;
}
