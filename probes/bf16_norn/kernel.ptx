// Probe for bf16 add / sub / mul with no rounding modifier where ptxas cannot contract:
// sub / add .bf16x2 and .bf16 of loaded values, mul.bf16x2 whose only use is a store, and
// two mul.bf16 packed (mov.b32 {lo, hi}) then stored. Thread i: a, b = words 2i, 2i+1 of in;
// writes words 8i..8i+4.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry bf16_norn(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<12>; .reg .b16 %rs<12>;
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mul.wide.u32 %rd3, %r1, 8; add.s64 %rd4, %rd1, %rd3;
  mul.wide.u32 %rd5, %r1, 32; add.s64 %rd6, %rd2, %rd5;
  ld.global.u32 %r2, [%rd4]; ld.global.u32 %r3, [%rd4+4];
  sub.bf16x2 %r4, %r2, %r3;
  add.bf16x2 %r5, %r2, %r3;
  mul.bf16x2 %r6, %r2, %r3;
  mov.b32 {%rs1, %rs2}, %r2; mov.b32 {%rs3, %rs4}, %r3;
  sub.bf16 %rs5, %rs1, %rs3;
  add.bf16 %rs6, %rs4, %rs2;
  st.global.v2.u32 [%rd6], {%r4, %r5};
  st.global.u32 [%rd6+8], %r6;
  st.global.b16 [%rd6+12], %rs5;
  st.global.b16 [%rd6+14], %rs6;
  mul.bf16 %rs7, %rs1, %rs3;
  mul.bf16 %rs8, %rs2, %rs4;
  mov.b32 %r7, {%rs7, %rs8};
  st.global.u32 [%rd6+16], %r7;
  ret; }
