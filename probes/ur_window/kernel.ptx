// probes/ur_window (E-SPLIT-UR): do a warp's splits switch inside a uniform-register window?
// Even and odd lanes of every warp run separate paths. Each path chases n dependent uncached
// pointers, then four more whose last value it stores, then bar.warp.sync on its own lanes
// (0x55555555 / 0xaaaaaaaa in a register). ptxas 13.0 computes REDUX.OR UR5 of the mask before
// the last loads and reads it at BRA.DIV UR5 after the store, which waits for them: a window
// with a long stall inside, and no YIELD or blocking instruction in either path (each path's
// mask is its own lanes: the fast path). Per warp: out[4w..4w+3] = t0, t1 of the even path,
// t0, t1 of the odd path (%globaltimer, lanes 0 and 1); a strict overlap of the two intervals
// is a switch between the splits inside a stretch without a switch point.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 pout, .param .u64 pchain, .param .u64 psink, .param .u32 n,
                  .param .u32 mask)
{
    .reg .b32 %r<30>;
    .reg .b64 %rd<30>;
    .reg .pred %p<6>;
    ld.param.u64 %rd1, [pout];
    ld.param.u64 %rd2, [pchain];
    ld.param.u64 %rd3, [psink];
    ld.param.u32 %r10, [n];
    ld.param.u32 %r13, [mask];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r1, %tid.x;
    and.b32 %r20, %r1, 31;
    mov.u32 %r21, %ctaid.x;
    mov.u32 %r22, %ntid.x;
    mad.lo.u32 %r23, %r21, %r22, %r1;
    shr.u32 %r24, %r23, 5;            // global warp id
    mul.wide.u32 %rd20, %r24, 32;
    add.s64 %rd21, %rd1, %rd20;       // this warp's 4 slots
    mul.wide.u32 %rd22, %r23, 8;
    add.s64 %rd23, %rd3, %rd22;       // this thread's sink word
    and.b32 %r25, %r20, 1;
    shl.b32 %r26, %r25, 4;            // 0 / 16: the path's slots
    cvt.u64.u32 %rd24, %r26;
    add.s64 %rd21, %rd21, %rd24;
    and.b32 %r27, %r24, %r13;
    mul.wide.u32 %rd25, %r27, 4096;
    setp.ne.u32 %p1, %r25, 0;
    @%p1 bra ODD;
    mov.u64 %rd10, %globaltimer;
    mov.u64 %rd5, %rd25;
    mov.u32 %r2, 0;
CE:
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.u32 %r2, %r2, 1;
    setp.lt.u32 %p2, %r2, %r10;
    @%p2 bra CE;
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    st.global.u64 [%rd23], %rd5;
    mov.b32 %r3, 0x55555555;
    bar.warp.sync %r3;
    mov.u64 %rd11, %globaltimer;
    bra.uni J;
ODD:
    mov.u64 %rd10, %globaltimer;
    mov.u64 %rd5, %rd25;
    mov.u32 %r2, 0;
CO:
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.u32 %r2, %r2, 1;
    setp.lt.u32 %p2, %r2, %r10;
    @%p2 bra CO;
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    add.s64 %rd6, %rd2, %rd5;
    ld.global.cv.u64 %rd5, [%rd6];
    st.global.u64 [%rd23], %rd5;
    mov.b32 %r3, 0xaaaaaaaa;
    bar.warp.sync %r3;
    mov.u64 %rd11, %globaltimer;
J:
    setp.lt.u32 %p3, %r20, 2;
    @%p3 st.global.v2.u64 [%rd21], {%rd10, %rd11};
    bar.warp.sync -1;
    ret;
}
