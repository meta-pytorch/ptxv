// probes/syncwarp_fast: ptxas's fast path of `__syncwarp()` (bar.warp.sync -1) merged with the
// following elect.sync: `BRA.DIV 0xffffffff, slow` falls through with no WARPSYNC when the warp
// is converged, the slow path being WARPSYNC.COLLECTIVE (DeepEP hybrid dispatch's
// `tma_store_wait(); __syncwarp(); if (elect_one_sync()) tma_load(...)`). 32 threads, 3
// iterations i: lane 1 stages 100 + i in shared memory and bulk-stores it to buf[4 i .. 4 i +
// 3] (cp.async.bulk.global.shared, buf[30] + 1 times); every lane waits for the reads
// (wait_group.read 0) and syncs; the elected lane bulk-loads buf[16 .. 19] into the same
// shared bytes (mbarrier), then writes the first word to buf[20 + i]. GB300: buf[0..11] = 100
// + i, buf[20..22] = buf[16].
.version 8.8
.target sm_103a
.address_size 64
.visible .entry syncwarp_fast(.param .u64 p)
{
 .reg .b32 %r<16>; .reg .b64 %rd<8>; .reg .pred %p<8>;
 .shared .align 16 .b8 sbuf[16];
 .shared .align 8 .b64 mbar;
 ld.param.u64 %rd1,[p]; cvta.to.global.u64 %rd1,%rd1;
 mov.u32 %r1,%tid.x;
 setp.eq.u32 %p1,%r1,1;
 setp.eq.u32 %p2,%r1,0;
 mov.u32 %r10, sbuf;
 mov.u32 %r11, mbar;
 @%p2 mbarrier.init.shared.b64 [%r11], 1;
 fence.mbarrier_init.release.cluster;
 bar.sync 0;
 mov.u32 %r5,0;
 mov.u32 %r12,0;
LOOP:
 @!%p1 bra ST;
 add.u32 %r6,%r5,100;
 st.shared.v4.u32 [%r10],{%r6,%r6,%r6,%r6};
 fence.proxy.async.shared::cta;
 mul.wide.u32 %rd3,%r5,16;
 add.s64 %rd4,%rd1,%rd3;
 ld.global.u32 %r13,[%rd1+120];
 add.u32 %r13,%r13,1;
ISS:
 cp.async.bulk.global.shared::cta.bulk_group [%rd4], [%r10], 16;
 cp.async.bulk.commit_group;
 sub.u32 %r13,%r13,1;
 setp.ne.u32 %p7,%r13,0;
 @%p7 bra ISS;
ST:
 cp.async.bulk.wait_group.read 0;
 bar.warp.sync -1;
 elect.sync %r9|%p5, -1;
 @!%p5 bra NEXT;
 add.s64 %rd5,%rd1,64;
 mbarrier.arrive.expect_tx.shared.b64 _, [%r11], 16;
 cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r10], [%rd5], 16, [%r11];
WAIT:
 mbarrier.try_wait.parity.shared.b64 %p6, [%r11], %r12;
 @!%p6 bra WAIT;
 ld.shared.u32 %r14, [%r10];
 mul.wide.u32 %rd6, %r5, 4;
 add.s64 %rd7, %rd1, %rd6;
 st.global.u32 [%rd7+80], %r14;
NEXT:
 xor.b32 %r12,%r12,1;
 bar.warp.sync -1;
 add.u32 %r5,%r5,1;
 setp.lt.u32 %p4,%r5,3;
 @%p4 bra LOOP;
 ret;
}
