// probes/brx_idx: brx.idx (PTX indirect branch through a .branchtargets list; Triton's
// warp-specialized kernels dispatch on the warp's role this way). 128 threads; thread t loads
// x = in[t] (gen.py), branches on i = (t + t / 32) % 5 (lanes of a warp diverge to all five
// targets) and stores out[2 t] = target i's function of x, out[2 t + 1] = i; then, converged,
// a second brx.idx.uni on the warp index (t / 32 % 4) adds a per-warp constant.
// Variant `oob` (@OOB): the index is i + 1 (5 for some lanes: outside the list).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry brx_idx(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 128, 1, 1
{
    .reg .b32   %r<32>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 4;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.u32   %r4, [%rd4];
    mul.wide.u32    %rd5, %r1, 8;
    add.s64         %rd6, %rd2, %rd5;
    shr.u32         %r2, %r1, 5;
    add.u32         %r3, %r1, %r2;
    rem.u32         %r5, %r3, 5;
    add.u32         %r5, %r5, 0; // @OOB
$L_brx_0: .branchtargets
        T0,
        T1,
        T2,
        T3,
        T4;
    brx.idx         %r5, $L_brx_0;
T0:
    add.u32         %r10, %r4, 1;
    bra.uni         J;
T1:
    xor.b32         %r10, %r4, 0xff;
    bra.uni         J;
T2:
    shl.b32         %r10, %r4, 3;
    bra.uni         J;
T3:
    mul.lo.u32      %r10, %r4, 7;
    bra.uni         J;
T4:
    not.b32         %r10, %r4;
J:
    and.b32         %r6, %r2, 3;
$L_brx_1: .branchtargets
        W0, W1, W2, W3;
    brx.idx.uni     %r6, $L_brx_1;
W0:
    add.u32         %r10, %r10, 100;
    bra.uni         K;
W1:
    add.u32         %r10, %r10, 200;
    bra.uni         K;
W2:
    add.u32         %r10, %r10, 300;
    bra.uni         K;
W3:
    add.u32         %r10, %r10, 400;
K:
    st.global.u32   [%rd6], %r10;
    st.global.u32   [%rd6+4], %r5;
    ret;
}
