// Probe: an mbarrier initialized by the elected lane on a divergent path, waited on by the
// other lanes of the same warp at the join with no warp synchronization (the shape of a Triton
// warp-specialized attention kernel: `@!P0 BRA` past `SYNCS.EXCH.64` (mbarrier.init), then
// `SYNCS.PHASECHK.TRANS64.TRYWAIT` by every lane). Each slot first holds a planted stale word
// (`stale` parameter; bit 63 set = phase parity 1, which a parity-0 wait accepts at once).
// Per round r of each warp: the elected lane inits slot r (count 1), stores data[r] = r + 1,
// arrives (release); every lane then try_waits parity 0 on slot r and reads data[r].
// out[t] = rounds in which thread t passed the wait and read a data word other than r + 1
// (a wait satisfied by the stale word before the init).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry mbar_init_diverge(.param .u64 out_p, .param .u64 stale_p, .param .u32 rounds_p)
{
    .reg .pred %p<8>;
    .reg .b32 %r<40>;
    .reg .b64 %rd<16>;
    .shared .align 8 .b64 slots[1024];
    .shared .align 4 .b32 data[1024];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [stale_p];
    ld.param.u32 %r30, [rounds_p];
    mov.u32 %r1, %tid.x;
    shr.u32 %r9, %r1, 5;
    // The warp index made warp-uniform as Triton does (shfl of lane 0).
    shfl.sync.idx.b32 %r2, %r9, 0, 31, -1;
    mov.u32 %r3, slots;
    mov.u32 %r4, data;
    // Plant the stale words and zero the data, then a CTA barrier.
    mov.u32 %r5, %r1;
PLANT:
    shl.b32 %r6, %r5, 3;
    add.u32 %r7, %r3, %r6;
    st.shared.u64 [%r7], %rd2;
    shl.b32 %r6, %r5, 2;
    add.u32 %r7, %r4, %r6;
    mov.u32 %r8, 0;
    st.shared.u32 [%r7], %r8;
    add.u32 %r5, %r5, 128;
    setp.lt.u32 %p1, %r5, 1024;
    @%p1 bra PLANT;
    bar.sync 0;
    mov.u32 %r10, 0;
    mov.u32 %r11, 0;
LOOP:
    shl.b32 %r12, %r2, 8;
    add.u32 %r12, %r12, %r10;
    shl.b32 %r13, %r12, 3;
    add.u32 %r14, %r3, %r13;
    shl.b32 %r13, %r12, 2;
    add.u32 %r15, %r4, %r13;
    add.u32 %r16, %r10, 1;
    elect.sync %r17|%p2, -1;
    @!%p2 bra JOIN;
    // Delay loop (0 cycles here; the `late` control spins): keeps the path a real branch.
    mov.u32 %r22, %clock;
DELAY:
    mov.u32 %r23, %clock;
    sub.u32 %r24, %r23, %r22;
    // @SLEEP
    setp.lt.u32 %p6, %r24, 0;            // @DELAY
    @%p6 bra DELAY;
    mbarrier.init.shared::cta.b64 [%r14], 1;                 // @INIT
    st.shared.u32 [%r15], %r16;                              // @DATA
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r14];   // @ARRIVE
JOIN:
    // @SYNC
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p3, [%r14], 0;
    @!%p3 bra WAIT;
    ld.shared.u32 %r18, [%r15];
    setp.ne.u32 %p4, %r18, %r16;
    selp.u32 %r19, 1, 0, %p4;
    add.u32 %r11, %r11, %r19;
    add.u32 %r10, %r10, 1;
    setp.lt.u32 %p5, %r10, %r30;
    @%p5 bra LOOP;
    mov.u32 %r20, %ctaid.x;
    mad.lo.u32 %r21, %r20, 128, %r1;
    mul.wide.u32 %rd3, %r21, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.u32 [%rd4], %r11;
    ret;
}
