// DPOR repro (MISS 275): a non-completing arrival against a test. M has count 2. Warp 0 lane 0
// arrives (A). Warp 1 lane 0 arrives (B), then test_waits phase 0 and stores the result, then waits
// for phase 0 for real. A before B: B completes the phase, the test is true (out = 1). B before A:
// the test can run before A lands, false (out = 0). out = 1 or 0 (nondeterministic).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry dpor_peek_arrival(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 2;
INIT_DONE:
    bar.sync 0;
    setp.eq.u32 %p2, %r1, 0;
    @%p2 bra WARP0;
    setp.ne.u32 %p3, %r1, 32;
    @%p3 bra END;
    mbarrier.arrive.release.cta.shared::cta.b64 %rd2, [%r4];
    mbarrier.test_wait.parity.acquire.cta.shared::cta.b64 %p4, [%r4], 0;
    selp.u32 %r5, 1, 0, %p4;
    st.global.u32 [%rd1], %r5;
WAIT:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra WAIT;
    bra END;
WARP0:
    mbarrier.arrive.release.cta.shared::cta.b64 %rd3, [%r4];
END:
    ret;
}
