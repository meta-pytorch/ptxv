// DPOR repro (MISS 231): a remote expect_tx (a tx increment that lands as a remote operation)
// against a local copy's complete_tx into the same phase. Cluster of 2, M on rank 1 (count 1).
// Rank 1 thread 0 arrives with expect_tx 16 and copies in[0..4) into its ta. Rank 0 thread 0
// runs expect_tx 16 on rank 1's M (no arrival; in flight until it lands) and copies in[4..8)
// into rank 1's tb, completing on rank 1's M. Rank 1 thread 32 waits for phase 0 and reads tb.
// If rank 1's copy lands before rank 0's expect_tx, phase 0 completes with tb still in flight:
// out = 0 or in[4], a race. PTX: the model does not take expect_tx on another CTA's mbarrier
// (S-MBAR, an error); SASS (`SYNCS.ARRIVE.TRANS64.RED.A0TR` on the remote address) does.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry dpor_tx_commute_remote(.param .u64 in_p, .param .u64 out_p)
.maxntid 64, 1, 1
.reqnctapercluster 2, 1, 1
{
    .shared .align 16 .b8 ta[16];
    .shared .align 16 .b8 tb[16];
    .shared .align 8 .b64 m1;
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [in_p];
    ld.param.u64 %rd2, [out_p];
    cvta.to.global.u64 %rd2, %rd2;
    add.u64 %rd3, %rd1, 16;
    mov.u32 %r1, %tid.x;
    mov.u32 %r6, %cluster_ctarank;
    mov.u32 %r2, ta;
    mov.u32 %r3, tb;
    mov.u32 %r4, m1;
    setp.ne.u32 %p1, %r1, 0;
    setp.ne.u32 %p0, %r6, 1;
    or.pred %p6, %p0, %p1;
    @%p6 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    st.shared.u32 [%r3], 0;
    fence.mbarrier_init.release.cluster;
    fence.proxy.async.shared::cta;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    @!%p0 bra RANK1;
    // rank 0, thread 0: remote producer
    @%p1 bra END;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r3, 1;
    mbarrier.expect_tx.relaxed.cluster.shared::cluster.b64 [%r9], 16;
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r10], [%rd3], 16, [%r9];
    bra END;
RANK1:
    setp.eq.u32 %p2, %r1, 32;
    @%p2 bra W;
    @%p1 bra END;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r4], 16;
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r2], [%rd1], 16, [%r4];
    bra END;
W:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra W;
    ld.shared.u32 %r15, [%r3];
    st.global.u32 [%rd2], %r15;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
