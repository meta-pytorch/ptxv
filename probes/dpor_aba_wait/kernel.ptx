// DPOR repro (MISS 230, from a review repro): a blocking wait under parity ABA. Thread 0 writes
// x, then completes phases 0 and 1 of M (count 1). Thread 32 first does an unrelated global
// store (an independent transition DPOR's first schedule can postpone), then spins on
// try_wait.parity M, 1 and reads x. Parity 1 passes at init (the "preceding phase" convention)
// and again after phase 1 completes. Passing at init leaves x unordered: a race (PTX; on SASS
// LDS/STS are relaxed strong accesses, S-SMEM-STRONG, so out = 0 or 1, nondeterministic).
// A blocking wait is not enabled just before the completion it acquires (phase 1), but it is
// enabled before the arrivals that precede it (at init): the race check may skip the releasing
// transition only, not everything that happens before it.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry dpor_aba_wait(.param .u64 out_p)
.maxntid 64, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 4 .b32 x;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r8, x;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    st.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    setp.eq.u32 %p2, %r1, 32;
    @%p2 bra C;
    @%p1 bra END;
    // thread 0: producer
    mov.u32 %r9, 1;
    st.shared.u32 [%r8], %r9;
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    bra END;
C:
    st.global.u32 [%rd1+4], 5;  // @DL
W:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 1;  // @TW
    @!%p5 bra W;
    ld.shared.u32 %r15, [%r8];
    st.global.u32 [%rd1], %r15;
END:
    ret;
}
