// S-SAME-VALUE probe: every warp of every CTA stores the same 32-bit value (the parameter v,
// or v + warp in the `differ` variant) to one shared-memory word and to one global word, with
// no synchronization between the stores; after bar.sync thread 0 copies the shared word to
// out[1 + ctaid]. out[0] is the global word.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry k(.param .u64 out_p, .param .u32 v)
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<4>;
    .reg .pred %p<2>;
    .shared .align 16 .b32 word[4];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u32 %r1, [v];
    mov.u32 %r2, %tid.x;
    and.b32 %r3, %r2, 31;
    setp.ne.u32 %p1, %r3, 0;
    shr.u32 %r4, %r2, 5;
    add.u32 %r1, %r1, 0;                       // @DIFFER
    @%p1 bra SKIP;
    st.shared.u32 [word], %r1;
    st.global.u32 [%rd1], %r1;
SKIP:
    bar.sync 0;
    setp.ne.u32 %p1, %r2, 0;
    @%p1 bra DONE;
    ld.shared.u32 %r5, [word];
    mov.u32 %r6, %ctaid.x;
    add.u32 %r6, %r6, 1;
    mul.wide.u32 %rd2, %r6, 4;
    add.u64 %rd2, %rd1, %rd2;
    st.global.u32 [%rd2], %r5;
DONE:
    ret;
}
