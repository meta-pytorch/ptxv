// probes/mma_scale_d: tcgen05.mma.kind::f16 (bf16 A / B, f32 D) and kind::tf32 with
// scale-input-d: D = A B + D * 2^-s (SASS `UTCHMMA ..., UPT, s`). TMEM is loaded from `C`
// (128 lanes x 256 columns of f32 patterns, gen.py), then 14 MMAs (M = 128, N = 16) each
// accumulate into their own 16 columns with s = 0, 1, 2, 3, 4, 7, 8, 9, 12, 15 (columns 0..159),
// enable-input-d = 0 with s = 8 (160..175), s = 8 twice (176..191) and kind::tf32 with s = 5
// (192..207); columns 208..255 keep C. The output is the whole TMEM; expected/D.bin is GB300's.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mma_one(
    .param .u64 a,
    .param .u64 b,
    .param .u64 out,
    .param .u32 idesc,
    .param .u64 cin
)
.maxntid 128, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b16   %rs<4>;
    .reg .b32   %r<100>;
    .reg .b64   %rd<32>;
    .shared .align 16 .b32 tmem_slot;
    .shared .align 8 .b64 done_bar;
    .shared .align 1024 .b8 smA[4096];
    .shared .align 1024 .b8 smB[8192];

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;
    mov.u32         %r2, 0;
    mov.u32         %r3, tmem_slot;
    mov.u32         %r4, done_bar;
    mov.u32         %r5, smA;
    mov.u32         %r6, smB;
    setp.ne.u32     %p0, %r1, 0;
    @%p0 bra        SKIP_ALLOC;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 256;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
SKIP_ALLOC:
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    fence.mbarrier_init.release.cluster;
SKIP_INIT:
    // core-matrix offset of row t: (t/8)*128 + (t%8)*16
    shr.u32         %r9, %r0, 3;
    shl.b32         %r9, %r9, 7;
    and.b32         %r10, %r0, 7;
    shl.b32         %r10, %r10, 4;
    add.u32         %r11, %r9, %r10;
    // A row t of A[rank] (rank * 128 + t): 32 bytes -> smA + off (+2048 for k 8..15)
    ld.param.u64    %rd1, [a];
    cvta.to.global.u64 %rd1, %rd1;
    shl.b32         %r7, %r2, 7;
    add.u32         %r8, %r7, %r0;
    mul.wide.u32    %rd2, %r8, 32;
    add.u64         %rd3, %rd1, %rd2;
    ld.global.v4.b32 {%r20, %r21, %r22, %r23}, [%rd3];
    ld.global.v4.b32 {%r24, %r25, %r26, %r27}, [%rd3+16];
    add.u32         %r12, %r5, %r11;
    st.shared.v4.b32 [%r12], {%r20, %r21, %r22, %r23};
    st.shared.v4.b32 [%r12+2048], {%r24, %r25, %r26, %r27};
    // B rows t and t + 128 of B[rank] (rank * 256 + t): smB + off (+2048 for row + 128; +4096 for k 8..15)
    ld.param.u64    %rd4, [b];
    cvta.to.global.u64 %rd4, %rd4;
    shl.b32         %r13, %r2, 8;
    add.u32         %r14, %r13, %r0;
    mul.wide.u32    %rd5, %r14, 32;
    add.u64         %rd6, %rd4, %rd5;
    ld.global.v4.b32 {%r20, %r21, %r22, %r23}, [%rd6];
    ld.global.v4.b32 {%r24, %r25, %r26, %r27}, [%rd6+16];
    ld.global.v4.b32 {%r28, %r29, %r30, %r31}, [%rd6+4096];
    ld.global.v4.b32 {%r32, %r33, %r34, %r35}, [%rd6+4112];
    add.u32         %r15, %r6, %r11;
    st.shared.v4.b32 [%r15], {%r20, %r21, %r22, %r23};
    st.shared.v4.b32 [%r15+4096], {%r24, %r25, %r26, %r27};
    st.shared.v4.b32 [%r15+2048], {%r28, %r29, %r30, %r31};
    st.shared.v4.b32 [%r15+6144], {%r32, %r33, %r34, %r35};
    fence.proxy.async.shared::cta;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    ld.shared.b32   %r16, [%r3];
    // this warp's lanes, column 0
    shl.b32         %r17, %r1, 21;
    add.u32         %r18, %r16, %r17;
    ld.param.u64    %rd20, [cin];
    cvta.to.global.u64 %rd20, %rd20;
    mul.wide.u32    %rd21, %r0, 1024;
    add.u64         %rd22, %rd20, %rd21;
    mov.u32         %r60, 0;
FILL_LOOP:
    ld.global.v4.b32 {%r70, %r71, %r72, %r73}, [%rd22];
    ld.global.v4.b32 {%r74, %r75, %r76, %r77}, [%rd22+16];
    ld.global.v4.b32 {%r78, %r79, %r80, %r81}, [%rd22+32];
    ld.global.v4.b32 {%r82, %r83, %r84, %r85}, [%rd22+48];
    add.u32         %r61, %r18, %r60;
    tcgen05.st.sync.aligned.32x32b.x16.b32 [%r61], {%r70, %r71, %r72, %r73, %r74, %r75, %r76, %r77, %r78, %r79, %r80, %r81, %r82, %r83, %r84, %r85};
    add.u64         %rd22, %rd22, 64;
    add.u32         %r60, %r60, 16;
    setp.lt.u32     %p7, %r60, 256;
    @%p7 bra        FILL_LOOP;
    tcgen05.wait::st.sync.aligned;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    setp.ne.u32     %p3, %r2, 0;
    or.pred         %p4, %p1, %p3;
    @%p4 bra        WAIT;
    shr.u32         %r40, %r5, 4;
    cvt.u64.u32     %rd12, %r40;
    or.b64          %rd13, %rd12, 0x0000400800800000;   // A: LBO 2048, SBO 128
    shr.u32         %r41, %r6, 4;
    cvt.u64.u32     %rd14, %r41;
    or.b64          %rd15, %rd14, 0x0000400801000000;   // B: LBO 4096, SBO 128
    ld.param.u32    %r42, [idesc];                  // @SHAPE
    mov.u32         %r43, 0x8040910;                // tf32 idesc: A / B format 2, D f32, N 16, M 128
    // Each MMA accumulates into its own 16 columns (header comment).
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 0], %rd13, %rd15, %r42, 1, 0;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 16], %rd13, %rd15, %r42, 1, 1;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 32], %rd13, %rd15, %r42, 1, 2;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 48], %rd13, %rd15, %r42, 1, 3;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 64], %rd13, %rd15, %r42, 1, 4;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 80], %rd13, %rd15, %r42, 1, 7;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 96], %rd13, %rd15, %r42, 1, 8;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 112], %rd13, %rd15, %r42, 1, 9;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 128], %rd13, %rd15, %r42, 1, 12;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 144], %rd13, %rd15, %r42, 1, 15;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 160], %rd13, %rd15, %r42, 0, 8;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 176], %rd13, %rd15, %r42, 1, 8;
    tcgen05.mma.cta_group::1.kind::f16 [%r16 + 176], %rd13, %rd15, %r42, 1, 8;
    tcgen05.mma.cta_group::1.kind::tf32 [%r16 + 192], %rd13, %rd15, %r43, 1, 5;
    tcgen05.commit.cta_group::1.mbarrier::arrive::one.shared::cluster.b64 [%r4];
WAIT:
    mbarrier.try_wait.parity.shared::cta.b64 %p6, [%r4], 0;
    @!%p6 bra       WAIT;                           // @B05
    tcgen05.fence::after_thread_sync;
    ld.param.u64    %rd16, [out];
    cvta.to.global.u64 %rd16, %rd16;
    shl.b32         %r43, %r2, 7;
    add.u32         %r43, %r43, %r0;
    mul.wide.u32    %rd17, %r43, 1024;              // row rank * 128 + t: 256 words
    add.u64         %rd18, %rd16, %rd17;
    mov.u32         %r60, 0;
DUMP_LOOP:
    add.u32         %r61, %r18, %r60;
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r70, %r71, %r72, %r73, %r74, %r75, %r76, %r77, %r78, %r79, %r80, %r81, %r82, %r83, %r84, %r85}, [%r61];
    tcgen05.wait::ld.sync.aligned;
    st.global.v4.b32 [%rd18+0], {%r70, %r71, %r72, %r73};
    st.global.v4.b32 [%rd18+16], {%r74, %r75, %r76, %r77};
    st.global.v4.b32 [%rd18+32], {%r78, %r79, %r80, %r81};
    st.global.v4.b32 [%rd18+48], {%r82, %r83, %r84, %r85};
    add.u64         %rd18, %rd18, 64;
    add.u32         %r60, %r60, 16;
    setp.lt.u32     %p7, %r60, 256;
    @%p7 bra        DUMP_LOOP;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    @%p0 bra        DONE;
    tcgen05.fence::after_thread_sync;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r16, 256;
DONE:
    ret;
}

