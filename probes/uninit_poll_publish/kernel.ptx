// Repro (MISS 279, RDP2 finding H): warp 0 lane 0 polls mbarrier m2 before warp 3 initializes it
// (a poll before init: a violation, and the thread stays until the init). Warp 1 lane 32 and
// warp 2 lane 64 publish x through mbarrier m1 (count 2) in either order; warp 3 lane 96 waits
// for m1 phase 0, reads x (written by both: last writer wins, two outputs, a race), then inits
// m2 and arrives on it. SASS: the default explorer and DPOR gave [violation] with 0 outputs
// against the unreduced [nondeterministic, race, violation] with 2: the failing poll recorded no
// footprint, so the reductions ran it before the init only.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry uninit_poll_publish(.param .u64 out_p)
.maxntid 128, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 4 .b32 x;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, x;
    shr.u32 %r2, %r1, 5;
    and.b32 %r3, %r1, 31;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 2;
    st.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra END;
    setp.eq.u32 %p3, %r2, 1;
    @%p3 bra W1;
    setp.eq.u32 %p3, %r2, 2;
    @%p3 bra W2;
    setp.eq.u32 %p3, %r2, 3;
    @%p3 bra W3;
SPIN:
    mbarrier.try_wait.parity.shared::cta.b64 %p5, [%r5], 0;   // @SPIN
    @!%p5 bra SPIN;
    bra END;
W1:
    mov.u32 %r9, 1;
    st.shared.u32 [%r8], %r9;   // @S1
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    bra END;
W2:
    mov.u32 %r9, 2;
    st.shared.u32 [%r8], %r9;
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    bra END;
W3:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p6, [%r4], 0;
    @!%p6 bra W3;
    ld.shared.u32 %r15, [%r8];
    st.global.u32 [%rd1], %r15;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r5];
END:
    ret;
}
