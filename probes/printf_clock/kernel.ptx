// probes/printf_clock: DeepEP's timeout shape on the PTX front. Each thread reads %clock64
// and %globaltimer, spins once on a flag loaded from memory (already set), and calls vprintf
// with a stack-built argument buffer (cvta.local of %SPL) only if more than 2^40 cycles or
// ns passed (never). out[t] = 1 + the flag (2), out[64 + t] = (clock64 delta < 2^40).
.version 8.8
.target sm_103a
.address_size 64

.extern .func  (.param .b32 func_retval0) vprintf
(
    .param .b64 vprintf_param_0,
    .param .b64 vprintf_param_1
)
;

.visible .entry printf_clock(
    .param .u64 pflag,
    .param .u64 pout
)
.maxntid 64, 1, 1
{
    .local .align 8 .b8 __local_depot0[8];
    .reg .b64   %SP;
    .reg .b64   %SPL;
    .reg .pred  %p<4>;
    .reg .b32   %r<12>;
    .reg .b64   %rd<20>;

    mov.u64         %SPL, __local_depot0;
    cvta.local.u64  %SP, %SPL;
    ld.param.u64    %rd1, [pflag];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd3, %rd1;
    cvta.to.global.u64 %rd4, %rd2;
    mov.u32         %r1, %tid.x;
    mov.u64         %rd5, %clock64;
    mov.u64         %rd6, %globaltimer;
WAIT:
    ld.volatile.global.u32 %r2, [%rd3];
    mov.u64         %rd7, %clock64;
    sub.s64         %rd8, %rd7, %rd5;
    mov.u64         %rd9, %globaltimer;
    sub.s64         %rd10, %rd9, %rd6;
    setp.gt.s64     %p1, %rd8, 1099511627776;
    setp.gt.s64     %p2, %rd10, 1099511627776;
    or.pred         %p3, %p1, %p2;
    @!%p3 bra       NOPRINT;
    add.u64         %rd11, %SP, 0;
    add.u64         %rd12, %SPL, 0;
    st.local.v2.u32 [%rd12], {%r1, %r2};
    { // callseq 0, 0
    .param .b64 param0;
    st.param.b64    [param0], %rd1;
    .param .b64 param1;
    st.param.b64    [param1], %rd11;
    .param .b32 retval0;
    call.uni (retval0), vprintf, (param0, param1);
    ld.param.b32    %r3, [retval0];
    } // callseq 0
    trap;
NOPRINT:
    setp.eq.u32     %p1, %r2, 0;
    @%p1 bra        WAIT;
    add.u32         %r4, %r2, 1;
    mul.wide.u32    %rd13, %r1, 4;
    add.s64         %rd14, %rd4, %rd13;
    st.global.u32   [%rd14], %r4;
    setp.lt.s64     %p1, %rd8, 1099511627776;
    selp.u32        %r5, 1, 0, %p1;
    st.global.u32   [%rd14+256], %r5;
    ret;
}
