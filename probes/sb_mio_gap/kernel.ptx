    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    bar.sync 0;
    ld.shared.u32 %r50, [%r4];
    ld.shared.u32 %r51, [%r4+1024];
    ld.shared.u32 %r52, [%r4+2048];
    ld.shared.v4.u32 {%r54, %r55, %r56, %r57}, [%r9];
    // Values defined after the window: their registers are free for patch.py inside it.
    ld.global.u32 %r7, [%rd3+4];
    // (Addresses offset by that load's value, 0: ptxas cannot compute them before the window.)
    and.b32 %r58, %r61, 255;
    shl.b32 %r58, %r58, 4;
    add.u32 %r58, %r58, %r7;
    cvt.u64.u32 %rd11, %r58;
    add.u64 %rd11, %rd1, %rd11;
    ld.global.v4.u32 {%r20, %r21, %r22, %r23}, [%rd11];
    ld.global.v4.u32 {%r24, %r25, %r26, %r27}, [%rd11+4096];
    ld.global.v4.u32 {%r28, %r29, %r30, %r31}, [%rd11+8192];
    ld.global.u32 %r68, [%rd10];
    xor.b32 %r53, %r6, %r7;
    xor.b32 %r53, %r53, %r20;
    xor.b32 %r53, %r53, %r21;
    xor.b32 %r53, %r53, %r22;
    xor.b32 %r53, %r53, %r23;
    xor.b32 %r53, %r53, %r24;
    xor.b32 %r53, %r53, %r25;
    xor.b32 %r53, %r53, %r26;
    xor.b32 %r53, %r53, %r27;
    xor.b32 %r53, %r53, %r28;
    xor.b32 %r53, %r53, %r29;
    xor.b32 %r53, %r53, %r30;
    xor.b32 %r53, %r53, %r31;
    xor.b32 %r53, %r53, %r68;
    ld.param.u64 %rd4, [out_p];
    cvta.to.global.u64 %rd4, %rd4;
    add.u32 %r59, %r61, %r7;
    mul.wide.u32 %rd5, %r59, 32;
    add.u64 %rd6, %rd4, %rd5;
    st.global.v4.u32 [%rd6], {%r50, %r51, %r52, %r53};
    st.global.v4.u32 [%rd6+16], {%r54, %r55, %r56, %r57};
    ret;
