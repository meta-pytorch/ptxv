// Skeleton for the long-gap memory-queue windows (see patch.py, case.toml). 256 threads per
// CTA, at most 32 registers and 18 KB of shared memory (8 CTAs, 64 warps per SM). Shared
// memory: thread t's slots region 0 = [4t], region 1 = [0x400 + 4t], region 2 = [0x800 + 4t]
// (never written); its 16-byte W slot [0xc00 + 16t] (the wide stores' target) and Z row
// [0x1c00 + 16t] (never written: the wide loads' source); 0x2c00.. scratch; the 160 placeholder
// `st.volatile.shared` to [0x3000 + 4t] (volatile: ptxas keeps every one) that patch.py
// overwrites with the window; 0x3800.. the
// saturating stores' rows. Before the window, `nsat` rounds of eight 32-way bank-conflicted
// st.shared.v4 of zeros (lane l: 0x3800 + 128 l + 16 i) fill the memory pipe (nsat = 0: none).
// Global `aux[gid]` is zeroed before the window (an STG the window may overwrite) and read
// back after it. Output per thread: {region 0, 1, 2, x, W[0..3]}, x = the xor of the global
// loads after the window (0 with zero inputs) and aux[gid].
.version 9.0
.target sm_103a
.address_size 64
.extern .shared .align 16 .b8 sm[];

.visible .entry sb_mio_gap(.param .u64 out_p, .param .u64 in_p, .param .u32 bogus, .param .u32 nsat, .param .u64 aux_p)
.maxnreg 32
{
    .reg .b32 %r<80>;
    .reg .b64 %rd<12>;
    .reg .pred %p<3>;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, sm;
    shl.b32 %r3, %r1, 2;
    add.u32 %r4, %r2, %r3;
    shl.b32 %r9, %r1, 4;
    add.u32 %r9, %r9, %r2;
    add.u32 %r9, %r9, 3072;
    ld.param.u64 %rd1, [in_p];
    cvta.to.global.u64 %rd1, %rd1;
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd1, %rd2;
    ld.global.u32 %r6, [%rd3];
    add.u32 %r5, %r1, 1510000000;
    add.u32 %r5, %r5, %r6;
    mov.u32 %r60, %ctaid.x;
    shl.b32 %r61, %r60, 8;
    add.u32 %r61, %r61, %r1;
    ld.param.u64 %rd8, [aux_p];
    cvta.to.global.u64 %rd8, %rd8;
    mul.wide.u32 %rd9, %r61, 4;
    add.u64 %rd10, %rd8, %rd9;
    st.global.u32 [%rd10], 0;
    // Zero the CTA's 18 KB of shared memory first (4608 words, 18 per thread).
    mov.u32 %r70, 0;
ZERO:
    shl.b32 %r71, %r70, 10;
    add.u32 %r71, %r71, %r4;
    st.shared.u32 [%r71], 0;
    add.u32 %r70, %r70, 1;
    setp.lt.u32 %p1, %r70, 18;
    @%p1 bra ZERO;
    bar.sync 0;
    // Saturate the memory pipe: lane l stores 16 B at 0x3800 + 128 l (+16 i): one bank group.
    and.b32 %r72, %r1, 31;
    shl.b32 %r72, %r72, 7;
    add.u32 %r72, %r72, %r2;
    ld.param.u32 %r73, [nsat];
    mov.u32 %r74, 0;
    setp.eq.u32 %p2, %r73, 0;
    @%p2 bra WINDOW;
SAT:
    st.shared.v4.u32 [%r72+14336], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14352], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14368], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14384], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14400], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14416], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14432], {0, 0, 0, 0};
    st.shared.v4.u32 [%r72+14448], {0, 0, 0, 0};
    add.u32 %r74, %r74, 1;
    setp.lt.u32 %p1, %r74, %r73;
    @%p1 bra SAT;
WINDOW:
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
    st.volatile.shared.u32 [%r4+12288], %r5;
