    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r3], 256;
    tcgen05.relinquish_alloc_permit.cta_group::2.sync.aligned;
SKIP_ALLOC:
    @%p1 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
    // This CTA's B image.
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r4], 8192;
    ld.param.u64    %rd0, [bimg];
    cvta.to.global.u64 %rd0, %rd0;
    mul.wide.u32    %rd1, %r2, 8192;
    add.u64         %rd2, %rd0, %rd1;
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r7], [%rd2], 8192, [%r4];
WAIT_TMA:
    mbarrier.try_wait.parity.shared::cta.b64 %p2, [%r4], 0;
    @!%p2 bra       WAIT_TMA;
SKIP_INIT:
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    ld.shared.b32   %r6, [%r3];                     // TMEM base address (lane 0, column c0)
    shl.b32         %r41, %r1, 21;                  // (32 * warp) << 16
    add.u32         %r42, %r6, %r41;                // this warp's lanes, column 0
    shl.b32         %r8, %r2, 7;
    add.u32         %r8, %r8, %r0;                  // row 128 rank + t
