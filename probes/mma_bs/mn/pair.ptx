    ld.param.u64    %rd20, [sfb];
    cvta.to.global.u64 %rd20, %rd20;
    add.u64         %rd22, %rd20, %rd21;
    ld.global.v4.b32 {%r50, %r51, %r52, %r53}, [%rd22];
    ld.global.v4.b32 {%r54, %r55, %r56, %r57}, [%rd22+16];
    ld.global.v4.b32 {%r58, %r59, %r60, %r61}, [%rd22+32];
    ld.global.v4.b32 {%r62, %r63, %r64, %r65}, [%rd22+48];
    add.u32         %r47, %r42, 160;
    tcgen05.st.sync.aligned.32x32b.x16.b32 [%r47], {%r50, %r51, %r52, %r53, %r54, %r55, %r56, %r57, %r58, %r59, %r60, %r61, %r62, %r63, %r64, %r65};
    // A row 128 rank + t (128 bytes) -> columns 192..223, byte k at column 192 + k/4.
    ld.param.u64    %rd20, [a];
    cvta.to.global.u64 %rd20, %rd20;
    mul.wide.u32    %rd21, %r8, 128;
    add.u64         %rd22, %rd20, %rd21;
    ld.global.v4.b32 {%r50, %r51, %r52, %r53}, [%rd22];
    ld.global.v4.b32 {%r54, %r55, %r56, %r57}, [%rd22+16];
    ld.global.v4.b32 {%r58, %r59, %r60, %r61}, [%rd22+32];
    ld.global.v4.b32 {%r62, %r63, %r64, %r65}, [%rd22+48];
    add.u32         %r47, %r42, 192;
    tcgen05.st.sync.aligned.32x32b.x16.b32 [%r47], {%r50, %r51, %r52, %r53, %r54, %r55, %r56, %r57, %r58, %r59, %r60, %r61, %r62, %r63, %r64, %r65};
    ld.global.v4.b32 {%r50, %r51, %r52, %r53}, [%rd22+64];
    ld.global.v4.b32 {%r54, %r55, %r56, %r57}, [%rd22+80];
    ld.global.v4.b32 {%r58, %r59, %r60, %r61}, [%rd22+96];
    ld.global.v4.b32 {%r62, %r63, %r64, %r65}, [%rd22+112];
    add.u32         %r47, %r42, 208;
    tcgen05.st.sync.aligned.32x32b.x16.b32 [%r47], {%r50, %r51, %r52, %r53, %r54, %r55, %r56, %r57, %r58, %r59, %r60, %r61, %r62, %r63, %r64, %r65};
    tcgen05.wait::st.sync.aligned;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    tcgen05.fence::after_thread_sync;
    setp.ne.u32     %p3, %r2, 0;
    or.pred         %p4, %p1, %p3;
    @%p4 bra        WAIT_MMA;
    // ---- rank 0 thread 0: MMAs ---------------------------------------------------
    ld.param.u64    %rd2, [desc];
    cvta.to.global.u64 %rd2, %rd2;
    ld.global.v2.b64 {%rd14, %rd15}, [%rd2+32];     // B, K slices 0 and 1
    ld.global.v2.b64 {%rd16, %rd17}, [%rd2+48];     // B, K slices 2 and 3
    shr.u32         %r10, %r7, 4;
    cvt.u64.u32     %rd5, %r10;
    add.u64         %rd14, %rd14, %rd5;
    add.u64         %rd15, %rd15, %rd5;
    add.u64         %rd16, %rd16, %rd5;
    add.u64         %rd17, %rd17, %rd5;
    ld.param.u32    %r11, [idesc];
    setp.ne.u32     %p5, %r0, %r0;                  // false: overwrite D
    setp.eq.u32     %p6, %r0, %r0;                  // true: accumulate into D
    add.u32         %r48, %r6, 128;
    add.u32         %r49, %r6, 160;
    add.u32         %r66, %r6, 192;
    tcgen05.mma.cta_group::2.kind::mxf8f6f4.block_scale.scale_vec::1X [%r6], [%r66], %rd14, %r11, [%r48], [%r49], %p5;
    add.u32         %r48, %r6, 132;
    add.u32         %r49, %r6, 164;
    add.u32         %r66, %r6, 200;
    tcgen05.mma.cta_group::2.kind::mxf8f6f4.block_scale.scale_vec::1X [%r6], [%r66], %rd15, %r11, [%r48], [%r49], %p6;
    add.u32         %r48, %r6, 136;
    add.u32         %r49, %r6, 168;
    add.u32         %r66, %r6, 208;
    tcgen05.mma.cta_group::2.kind::mxf8f6f4.block_scale.scale_vec::1X [%r6], [%r66], %rd16, %r11, [%r48], [%r49], %p6;
    add.u32         %r48, %r6, 140;
    add.u32         %r49, %r6, 172;
    add.u32         %r66, %r6, 216;
    tcgen05.mma.cta_group::2.kind::mxf8f6f4.block_scale.scale_vec::1X [%r6], [%r66], %rd17, %r11, [%r48], [%r49], %p6;
    mov.b16         %rs0, 3;
    tcgen05.commit.cta_group::2.mbarrier::arrive::one.shared::cluster.multicast::cluster.b64 [%r5], %rs0;

    // ---- everyone: wait for the accumulator, read TMEM, store -------------------
WAIT_MMA:
    mbarrier.try_wait.parity.shared::cta.b64 %p7, [%r5], 0;
    @!%p7 bra       WAIT_MMA;
    tcgen05.fence::after_thread_sync;
    ld.param.u64    %rd24, [out];
    cvta.to.global.u64 %rd25, %rd24;
    mul.wide.u32    %rd26, %r8, 512;                // row 128 rank + t: 128 floats
    add.u64         %rd27, %rd25, %rd26;
    mov.u32         %r14, %r42;
    mov.u32         %r15, 0;
CHUNK:
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r16, %r17, %r18, %r19, %r20, %r21, %r22, %r23, %r24, %r25, %r26, %r27, %r28, %r29, %r30, %r31}, [%r14];
