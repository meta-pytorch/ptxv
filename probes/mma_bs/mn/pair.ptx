    st.global.v4.b32 [%rd27+16], {%r20, %r21, %r22, %r23};
    st.global.v4.b32 [%rd27+32], {%r24, %r25, %r26, %r27};
    st.global.v4.b32 [%rd27+48], {%r28, %r29, %r30, %r31};
