// N-MMA-BS / E-PAIR probe, MN-major operands across a CTA pair (probes/mma_bs/mn, gen.py):
// D[256x128] f32 = sum over 4 tcgen05.mma.cta_group::2.kind::mxf8f6f4.block_scale.scale_vec::1X
// (K = 32 each) of A[256xK] * B[128xK]^T, e4m3 x e4m3, ue8m0 scales; cluster 2 x 128 threads.
// CTA r bulk-copies its B image bimg[r] (B rows 64r.. in the case's layout) to smB and, in
// mma_mn_pair_ss, its A image aimg[r] (A rows 128r..) to smA; mma_mn_pair_ts instead writes A
// row 128r + t to TMEM lane t, columns 192..223 (byte k at column 192 + k/4). SFA[r][t][j] ->
// lane t, column 128 + j; SFB[r][t][j] -> column 160 + j. MMA s reads [sfa] = column 128 + 4s,
// [sfb] = 160 + 4s, A (ts) at column 192 + 8s, and descriptors desc[s] (A) / desc[4 + s] (B)
// with the smem base added to the start field. Rank 0 thread 0 issues; CTA r stores D rows
// 128r + lane. Every case's D must equal the K-major case's: the logical operands are the same.
.version 9.0
.target sm_100a
.address_size 64

.visible .entry mma_mn_pair_ts(
    .param .u64 a,
    .param .u64 bimg,
    .param .u64 desc,
    .param .u64 out,
    .param .u32 idesc,
    .param .u64 sfa,
    .param .u64 sfb
)
.maxntid 128, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b16   %rs<4>;
    .reg .b32   %r<80>;
    .reg .b64   %rd<40>;
    .shared .align 16 .b32 tmem_slot;
    .shared .align 8 .b64 tma_bar;
    .shared .align 8 .b64 mma_bar;
    .shared .align 1024 .b8 smB[8192];

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;                    // warp id
    mov.u32         %r2, %cluster_ctarank;
    mov.u32         %r3, tmem_slot;
    mov.u32         %r4, tma_bar;
    mov.u32         %r5, mma_bar;
    mov.u32         %r7, smB;
    setp.ne.u32     %p0, %r1, 0;                    // p0: not warp 0
