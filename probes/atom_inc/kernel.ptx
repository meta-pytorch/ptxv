// Probe (L-ROSETTA): atom.global.inc.u32 (SASS ATOMG.E.INC.STRONG.GPU). Thread t (256) owns
// word mem[t] (initial value from mem.bin) and bound b[t]: two increments, the old values to
// out[t] / out[256 + t]; mem[t] holds the final value. Edge pairs: old = b, old > b, b = 0,
// b = 0xffffffff, old = 0xffffffff, random.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry atom_inc(.param .u64 pmem, .param .u64 pb, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [pmem];
    ld.param.u64 %rd2, [pb];
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd4, %r0, 4;
    add.u64 %rd5, %rd1, %rd4;
    add.u64 %rd6, %rd2, %rd4;
    add.u64 %rd7, %rd3, %rd4;
    ld.global.u32 %r1, [%rd6];
    atom.global.inc.u32 %r2, [%rd5], %r1;
    atom.global.inc.u32 %r3, [%rd5], %r1;
    st.global.u32 [%rd7], %r2;
    st.global.u32 [%rd7+1024], %r3;
    ret;
}
