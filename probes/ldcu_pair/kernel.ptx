// Probe (MISS 181, the review repro): LDCU.64 defines a uniform pair; a read of only its high register (UR5).
.version 9.0
.target sm_103a
.address_size 64
.visible .entry ldcu_hi(.param .u64 out_p, .param .u64 v)
{
    .reg .b32 %r<10>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    ld.param.u64 %rd2, [v];
    mov.b64 {%r2, %r3}, %rd2;
    xor.b32 %r4, %r3, %r1;
    mul.wide.u32 %rd3, %r1, 4;
    add.s64 %rd4, %rd1, %rd3;
    st.global.u32 [%rd4], %r4;
    add.s32 %r5, %r2, %r1;
    st.global.u32 [%rd4+1024], %r5;
    ret;
}
