.version 9.0
.target sm_103a
.address_size 64

// MISS 258 repro: out = sqrt.approx.ftz.f32(x) (probes/mufu_nan_exact).

.visible .entry sqrt_negsub(.param .u64 px, .param .u64 pout)
{
    .reg .b32 %r<8>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd3, %r0, 4;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    ld.global.f32 %f4, [%rd4];
    sqrt.approx.ftz.f32 %f5, %f4;
    st.global.f32 [%rd5], %f5;
    ret;
}
