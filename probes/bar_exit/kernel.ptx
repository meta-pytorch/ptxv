// Probe for E-BAR-EXIT: does bar.sync wait for threads that have exited?
// 64 threads. Threads with tid >= EXIT_FROM exit immediately; the rest run bar.sync and
// thread 0 writes out[0] = 1 afterwards. A hang means exited threads are waited for.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_bar_exit(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ge.u32 %p1, %r1, 32;            // @EXIT
    @%p1 exit;
    bar.sync 0;                          // @BAR
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra DONE;
    mov.u32 %r2, 1;
    st.global.u32 [%rd1], %r2;
DONE:
    ret;
}
