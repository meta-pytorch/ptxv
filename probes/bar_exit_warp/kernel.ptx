// Probe for E-BAR-EXIT on partly exited warps: how does a counted named barrier (BAR.SYNC /
// BAR.ARV with a thread count) count a warp some of whose lanes have exited?
// Lane l of warp w exits first if l >= keep[w] (keep[w] = 32: the whole warp stays, 0: the
// whole warp exits). The survivors run `bar.sync 1, 64` (variants: other counts, bar.arrive)
// and each writes out[tid] = 1 after it. A hang means the barrier never completed.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_bar_exit_warp(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    shr.u32 %r3, %r1, 5;
    mov.u32 %r4, 0;                      // @KEEP2
    setp.eq.u32 %p1, %r3, 1;
    @%p1 mov.u32 %r4, 32;                // @KEEP1
    setp.eq.u32 %p1, %r3, 0;
    @%p1 mov.u32 %r4, 16;                // @KEEP0
    setp.ge.u32 %p2, %r2, %r4;
    @%p2 exit;
    setp.eq.u32 %p3, %r3, 0;
    @%p3 bra W0;
    bar.sync 1, 64;                      // @BARW1
    bra DONE;
W0:
    bar.sync 1, 64;                      // @BARW0
DONE:
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd1, %rd2;
    mov.u32 %r5, 1;
    st.global.u32 [%rd3], %r5;
    ret;
}
