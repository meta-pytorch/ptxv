// S-REMOTE-INFLIGHT, the lanes of one st.async instruction. Lanes 0 and 1 of rank 0 run one
// st.async (lane k writes word k of w in rank 1, complete_tx on rank 1's M1, expect_tx 8,
// .relaxed.cluster). One lane (`@DR`: lane 1, or lane 0) then runs fence.acq_rel.cluster and a
// remote .release.cluster arrive on M2. Rank 1 waits on M2, test_waits M1, stores the result
// plus the word it reads (`@READ`), then waits on M1. The draining lane's release orders its own
// word only; the other lane's word, and its share of M1's bytes, can still be in flight.
//   D1R0: lane 1 drains, rank 1 reads lane 0's x: race, x unwritten (S-INIT), test_wait either.
//   D1:   lane 1 drains, no read: test_wait either way (nondeterministic).
//   D1R1: lane 1 drains, reads its own y: ordered; test_wait either way.
//   D0R1: lane 0 (the operation's first lane) drains, reads lane 1's y: race, as D1R0.
//   D0:   lane 0 drains, no read: nondeterministic.
//   D0X:  lane 0 drains; rank 1 waits on M2 only and exits, with no final barrier.cluster
//         (`@TW*`, `@W1*`, `@EB*` deleted): lane 1's word can land after rank 1 exits, or land
//         with nothing ordering it before the exit (S-CLUSTER-LIFE violation). D0XW: the same,
//         but rank 1 waits on M1 before exiting: clean.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry e_stasync_lanes(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 16 .b32 w[4];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, w;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    or.pred %p2, %p0, %p1;
    @%p2 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
    mbarrier.arrive.expect_tx.relaxed.cluster.shared::cta.b64 _, [%r4], 8;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.ge.u32 %p3, %r1, 2;
    @%p3 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r5, 1;
    shl.b32 %r12, %r1, 2;
    add.u32 %r12, %r8, %r12;
    mapa.shared::cluster.u32 %r13, %r12, 1;
    add.u32 %r14, %r1, 40;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r13], %r14, [%r9];   // @STA
    setp.eq.u32 %p7, %r1, 1;   // @DR
    @%p7 bra D1;
    bra END;
D1:
    fence.acq_rel.cluster;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r10];
    bra END;
RANK1:
    @%p1 bra END;
WAIT2:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra WAIT2;
    mbarrier.test_wait.parity.acquire.cluster.shared::cta.b64 %p6, [%r4], 0;   // @TW1
    selp.u32 %r15, 1, 0, %p6;   // @TW2
    ld.shared.u32 %r16, [%r8+0];   // @READ
    add.u32 %r15, %r15, %r16;   // @SUM
    st.global.u32 [%rd1], %r15;
WAIT:   // @W1A
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r4], 0;   // @W1B
    @!%p4 bra WAIT;   // @W1C
END:
    barrier.cluster.arrive.release.aligned;   // @EB1
    barrier.cluster.wait.acquire.aligned;   // @EB2
    ret;
}
