// Probe for E-BAR-CUT premise (a): one warp's lanes waiting at two named barriers at once.
// 64 threads. Lanes 0-15 of warp 0 run `barrier.sync 1, 64` (B); lanes 16-31 of warp 0 run
// `barrier.sync 0` (A, all threads); warp 1 runs `barrier.sync 0`, then `barrier.sync 1, 64`.
// Each thread writes out[tid] = 1 after its last barrier. A counting threads: a hang; A
// counting warps: every word 1. GB300: an illegal instruction (case.toml).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_bar_cut_warp(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    and.b32 %r2, %r1, 31;
    shr.u32 %r3, %r1, 5;
    setp.eq.u32 %p1, %r3, 0;
    @%p1 bra W0;
    barrier.sync 0;                      // @W1A
    barrier.sync 1, 64;                  // @W1B
    bra DONE;
W0:
    setp.lt.u32 %p2, %r2, 16;            // @SPLIT
    @%p2 bra W0B;
    barrier.sync 0;                      // @W0HI
    bra DONE;
W0B:
    barrier.sync 1, 64;                  // @W0B
DONE:
    mul.wide.u32 %rd2, %r1, 4;
    add.u64 %rd3, %rd1, %rd2;
    mov.u32 %r5, 1;
    st.global.u32 [%rd3], %r5;
    ret;
}
