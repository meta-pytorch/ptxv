// probes/fmad_f16: PTX-FMAD for plain mul.f16 / add.f16 / sub.f16 (ptxas: HFMA2 where
// contracted, HMUL2 + HADD2 elsewhere). Per thread t, group k: a, b, c, d = in[20 t + 4 k ..]
// (f16; gen.py: c, d cancel a b to +- 1 ulp in 3 of 4 groups). Each group has its own operands
// so ptxas cannot merge the products. out[8 t + j] (f16 in the low half of a word):
//   0: mul + add (one reader)               1, 2: mul read by an add and a sub (both fused)
//   3, 4: mul read by an add and stored (neither fused: the store keeps HMUL2)
//   5, 6: mul read by an add and packed into an add.rn.f16x2 (neither fused; 6 is the f16x2 word)
//   7: mul + sub, product second
.version 8.8
.target sm_103a
.address_size 64

.visible .entry fmad_f16(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b16   %h<20>, %p<5>, %o<10>;
    .reg .b32   %r<60>, %w<12>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 40;
    add.s64         %rd4, %rd1, %rd3;
    mul.wide.u32    %rd3, %r1, 32;
    add.s64         %rd5, %rd2, %rd3;
    // 0: one reader
    ld.global.v4.b16 {%h0, %h1, %h2, %h3}, [%rd4+0];
    mul.f16 %p0, %h0, %h1;
    add.f16 %o0, %p0, %h2;
    // 1, 2: an add and a sub
    ld.global.v4.b16 {%h4, %h5, %h6, %h7}, [%rd4+8];
    mul.f16 %p1, %h4, %h5;
    add.f16 %o2, %h6, %p1;
    sub.f16 %o3, %p1, %h7;
    // 3, 4: an add and a store
    ld.global.v4.b16 {%h8, %h9, %h10, %h11}, [%rd4+16];
    mul.f16 %p2, %h9, %h8;
    add.f16 %o4, %p2, %h11;
    mov.b16 %o5, %p2;
    // 5, 6: an add and a pack into add.rn.f16x2
    ld.global.v4.b16 {%h12, %h13, %h14, %h15}, [%rd4+24];
    mul.f16 %p3, %h12, %h13;
    add.f16 %o6, %p3, %h14;
    mov.b32 %r40, {%p3, %h15};
    mov.b32 %r41, {%h14, %h14};
    add.rn.f16x2 %r42, %r40, %r41;
    // 7: sub, product second
    ld.global.v4.b16 {%h16, %h17, %h18, %h19}, [%rd4+32];
    mul.f16 %p4, %h17, %h16;
    sub.f16 %o8, %h19, %p4;
    cvt.u32.u16 %w0, %o0;
    cvt.u32.u16 %w1, %o2;
    cvt.u32.u16 %w2, %o3;
    cvt.u32.u16 %w3, %o4;
    cvt.u32.u16 %w4, %p2;
    cvt.u32.u16 %w5, %o6;
    cvt.u32.u16 %w8, %o8;
    st.global.v4.b32 [%rd5], {%w0, %w1, %w2, %w3};
    st.global.v4.b32 [%rd5+16], {%w4, %w5, %r42, %w8};
    ret;
}
