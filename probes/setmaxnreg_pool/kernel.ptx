// E-SETMAXNREG probe: the CTA's register pool. 256 threads with .maxnreg 64 (16,384 registers);
// warpgroup 0 gives 24 registers per thread back (setmaxnreg.dec 40: 3,072 registers), then
// warpgroup 1 asks for more (setmaxnreg.inc N). Every thread then writes tid + 1 to out[tid].
// Variants: N = 80 (2,048 requested), 88 (3,072, exactly what was released), 96 (4,096).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry setmaxnreg_pool(.param .u64 out_p)
.maxnreg 64
{
    .reg .pred %p<2>;
    .reg .b32 %r<4>;
    .reg .b64 %rd<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.lt.u32 %p1, %r1, 128;
    @%p1 bra WG0;
    setmaxnreg.inc.sync.aligned.u32 80;  // @INC
    bra.uni DONE;
WG0:
    setmaxnreg.dec.sync.aligned.u32 40;
DONE:
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    add.u32 %r2, %r1, 1;
    st.global.b32 [%rd3], %r2;
    ret;
}
