// Probe (S-TMA-2CTA-MCAST): which CTAs a multicast TMA load (cp.async.bulk.tensor ...
// .multicast::cluster[.cta_group::2], SASS UTMALDG.2D.MULTICAST[.2CTA]) writes and which
// mbarriers it completes. Cluster of 4 (two CTA pairs), 64 threads per CTA; run.py drives the
// parameters.
//
// Every CTA: thread 0 initializes an mbarrier `bar` (count 1) at the same offset, `buf`
//   (512 bytes) is zeroed, and thread 0 arrives on `bar` with expect_tx(128 x byte `rank` of
//   `exp`; a plain arrive for 0). After a cluster barrier, rank 0 thread 0 issues one
//   load of the whole 8 x 16 u32 tensor (512 bytes) with ctaMask `mask` to `buf` of rank
//   `dst_rank` (mapa), naming `bar` of rank `mbar_rank` (mapa); `pair` selects .cta_group::2.
//   Each CTA's thread 0 then polls its own `bar` (try_wait, nanosleep 500, at most 20000 times):
//   flag = 1 if phase 0 completed (2 if the CTA expected nothing: its plain arrive completed
//   it). After a cluster barrier, out[rank][0..128] = buf if flag != 0 else 0xdeadbeef,
//   out[rank][128] = flag. (A CTA that expected nothing reads its box after the CTA whose
//   mbarrier got the box's bytes has completed it.)
.version 9.0
.target sm_103a
.address_size 64

.visible .entry tma_2cta_mcast(
    .param .align 64 .b8 tmap[128],
    .param .u64 out,
    .param .u32 mask,
    .param .u32 mbar_rank,
    .param .u32 dst_rank,
    .param .u32 exp,
    .param .u32 pair
)
.maxntid 64, 1, 1
.reqnctapercluster 4, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b16   %rs<4>;
    .reg .b32   %r<40>;
    .reg .b64   %rd<16>;
    .shared .align 1024 .b8 buf[512];
    .shared .align 8 .b64 bar;
    .shared .align 4 .b32 flag;

    mov.u32         %r0, %tid.x;
    mov.u32         %r1, %cluster_ctarank;
    mov.u32         %r2, bar;
    mov.u32         %r3, buf;
    mov.u32         %r4, flag;
    mov.b64         %rd0, tmap;
    cvta.param.u64  %rd1, %rd0;
    setp.ne.u32     %p0, %r0, 0;
    // zero buf: thread t writes words t and t + 64
    shl.b32         %r5, %r0, 2;
    add.u32         %r6, %r3, %r5;
    mov.u32         %r7, 0;
    st.shared.u32   [%r6], %r7;
    st.shared.u32   [%r6+256], %r7;
    fence.proxy.async.shared::cta;
    @%p0 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r2], 1;
    fence.mbarrier_init.release.cluster;
    // expected bytes: byte `rank` of `exp`, times 128
    ld.param.u32    %r9, [exp];
    shl.b32         %r8, %r1, 3;
    shr.u32         %r9, %r9, %r8;
    and.b32         %r9, %r9, 255;
    shl.b32         %r11, %r9, 7;
    setp.eq.u32     %p2, %r11, 0;
    @%p2 bra        PLAIN;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r2], %r11;
    bra.uni         SKIP_INIT;
PLAIN:
    mbarrier.arrive.shared::cta.b64 _, [%r2];
SKIP_INIT:
    bar.sync        0;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.ne.u32     %p3, %r1, 0;
    or.pred         %p4, %p0, %p3;
    @%p4 bra        POLL;
    ld.param.u32    %r12, [mbar_rank];
    mapa.shared::cluster.u32 %r13, %r2, %r12;
    ld.param.u32    %r20, [dst_rank];
    mapa.shared::cluster.u32 %r21, %r3, %r20;
    ld.param.u32    %r22, [mask];
    cvt.u16.u32     %rs0, %r22;
    mov.u32         %r14, 0;
    ld.param.u32    %r23, [pair];
    setp.eq.u32     %p1, %r23, 0;
    @%p1 bra        ONE_CTA;
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes.multicast::cluster.cta_group::2 [%r21], [%rd1, {%r14, %r14}], [%r13], %rs0;
    bra.uni         POLL;
ONE_CTA:
    cp.async.bulk.tensor.2d.shared::cluster.global.tile.mbarrier::complete_tx::bytes.multicast::cluster [%r21], [%rd1, {%r14, %r14}], [%r13], %rs0;
POLL:
    @%p0 bra        POLLED;
    mov.u32         %r15, 0;
    mov.u32         %r16, 0;
POLL_LOOP:
    mbarrier.try_wait.parity.shared::cta.b64 %p5, [%r2], 0;
    @%p5 bra        DONE_OK;
    nanosleep.u32   500;
    add.u32         %r15, %r15, 1;
    setp.lt.u32     %p6, %r15, 20000;
    @%p6 bra        POLL_LOOP;
    bra.uni         STORE_FLAG;
DONE_OK:
    // 2: completed by the plain arrive alone (nothing expected; buf is not read)
    setp.eq.u32     %p6, %r11, 0;
    selp.u32        %r16, 2, 1, %p6;
STORE_FLAG:
    st.shared.u32   [%r4], %r16;
POLLED:
    // every CTA has polled: the boxes whose transactions completed some mbarrier have landed
    bar.sync        0;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ld.shared.u32   %r17, [%r4];
    ld.param.u64    %rd2, [out];
    cvta.to.global.u64 %rd2, %rd2;
    mul.wide.u32    %rd3, %r1, 516;                 // 129 words per rank
    add.u64         %rd4, %rd2, %rd3;
    mul.wide.u32    %rd5, %r0, 4;
    add.u64         %rd6, %rd4, %rd5;
    mov.u32         %r18, 0xdeadbeef;
    mov.u32         %r19, 0xdeadbeef;
    setp.eq.u32     %p7, %r17, 0;
    @%p7 bra        WRITE;
    ld.shared.u32   %r18, [%r6];
    ld.shared.u32   %r19, [%r6+256];
WRITE:
    st.global.u32   [%rd6], %r18;
    st.global.u32   [%rd6+256], %r19;
    @%p0 bra        END;
    st.global.u32   [%rd4+512], %r17;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
