// Probe: thread/register <-> (TMEM lane, column) mapping of tcgen05.ld.16x64b.x4, and which
// lanes a warp reads when the address's lane field is 0 / 16 (not its own quadrant).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_tmem_16x64b(.param .u64 out_p)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    .shared .align 16 .b32 taddr_s;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    shr.u32 %r2, %r1, 5;
    setp.ne.u32 %p1, %r2, 0;
    mov.u32 %r3, taddr_s;
    @%p1 bra SKIPALLOC;
    tcgen05.alloc.cta_group::1.sync.aligned.shared::cta.b32 [%r3], 32;
    tcgen05.relinquish_alloc_permit.cta_group::1.sync.aligned;
SKIPALLOC:
    tcgen05.fence::before_thread_sync;
    bar.sync 0;
    tcgen05.fence::after_thread_sync;
    ld.shared.u32 %r4, [%r3];
    shl.b32 %r5, %r1, 8;
    // Store with this warp's own lane quadrant in the address (32x32b), load with lane field
    // 0 / 16 regardless of the warp (as cuBLAS's epilogue does).
    shl.b32 %r7, %r2, 21;                // (32 * warp) << 16
    add.u32 %r8, %r4, %r7;
    add.u32 %r10, %r5, 0;
    add.u32 %r11, %r5, 1;
    add.u32 %r12, %r5, 2;
    add.u32 %r13, %r5, 3;
    add.u32 %r14, %r5, 4;
    add.u32 %r15, %r5, 5;
    add.u32 %r16, %r5, 6;
    add.u32 %r17, %r5, 7;
    tcgen05.st.sync.aligned.32x32b.x8.b32 [%r8], {%r10, %r11, %r12, %r13, %r14, %r15, %r16, %r17};
    tcgen05.wait::st.sync.aligned;
    tcgen05.ld.sync.aligned.16x64b.x4.b32 {%r20, %r21, %r22, %r23}, [%r4];
    add.u32 %r6, %r4, 0x100000;
    tcgen05.ld.sync.aligned.16x64b.x4.b32 {%r24, %r25, %r26, %r27}, [%r6];
    tcgen05.wait::ld.sync.aligned;
    mul.wide.u32 %rd2, %r1, 16;
    add.u64 %rd3, %rd1, %rd2;
    st.global.v4.u32 [%rd3], {%r20, %r21, %r22, %r23};
    st.global.v4.u32 [%rd3+2048], {%r24, %r25, %r26, %r27};
    tcgen05.fence::before_thread_sync;
    bar.sync 0;
    tcgen05.fence::after_thread_sync;
    @%p1 bra DONE;
    tcgen05.dealloc.cta_group::1.sync.aligned.b32 %r4, 32;
DONE:
    ret;
}
