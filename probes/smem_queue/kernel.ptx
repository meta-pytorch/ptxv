// Probe (L-OPCLASS, E-HW-SB-QUEUE): completion order across shared-memory opcodes. Each thread
// issues a bank-conflicted (slow) LDSM.16.M88.4 and LDS, conflict-free (fast) LDSM.16.M88.4,
// LDSM.16.MT88.4 and LDS, a SHFL.BFLY and a MUFU.EX2 (a control outside the shared-memory unit),
// and stores every result ^ seed (LOP3 readers) and the addresses. gen.py reorders the compiled
// instructions per variant (a slow op, a fast one, the slow op's readers) and sets their control
// bits.
.version 9.0
.target sm_103a
.address_size 64
.shared .align 16 .b32 sm[8192];
.visible .entry smem_queue(.param .u64 out_p, .param .u32 seed)
{
    .reg .b32 %r<64>;
    .reg .f32 %f<4>;
    .reg .b64 %rd<8>;
    .reg .pred %p<2>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u32 %r20, [seed];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, sm;
    // Fill: thread t writes words t, t+256, ..., t+7936 (value word index * 0x9e3779b1 ^ seed).
    mov.u32 %r3, 0;
FILL:
    shl.b32 %r4, %r3, 8;
    add.u32 %r4, %r4, %r1;
    mul.lo.u32 %r5, %r4, -1640531535;
    xor.b32 %r5, %r5, %r20;
    shl.b32 %r6, %r4, 2;
    add.u32 %r6, %r6, %r2;
    st.shared.u32 [%r6], %r5;
    add.u32 %r3, %r3, 1;
    setp.lt.u32 %p1, %r3, 32;
    @%p1 bra FILL;
    bar.sync 0;
    shr.u32 %r7, %r1, 5;              // warp
    and.b32 %r8, %r1, 31;             // lane
    // slow LDSM rows: lane l -> byte 128 l + 16 (w & 7): the 8 rows of each matrix in 4 banks
    and.b32 %r9, %r7, 7;
    shl.b32 %r9, %r9, 4;
    shl.b32 %r10, %r8, 7;
    add.u32 %r10, %r10, %r9;
    add.u32 %r10, %r10, %r2;
    // fast LDSM rows: lane l -> byte 4096 + 16 l (+ 512 w): consecutive rows
    shl.b32 %r11, %r8, 4;
    shl.b32 %r12, %r7, 9;
    add.u32 %r11, %r11, %r12;
    add.u32 %r11, %r11, %r2;
    // slow LDS: lane l -> word 32 l + w (one bank per warp); fast LDS: word 256 w + l + 4096
    shl.b32 %r13, %r8, 5;
    add.u32 %r13, %r13, %r7;
    shl.b32 %r13, %r13, 2;
    add.u32 %r13, %r13, %r2;
    shl.b32 %r14, %r7, 8;
    add.u32 %r14, %r14, %r8;
    shl.b32 %r14, %r14, 2;
    add.u32 %r14, %r14, %r2;
    add.u32 %r15, %r1, %r20;
    cvt.rn.f32.u32 %f1, %r8;
    mul.f32 %f1, %f1, 0f3D800000;     // lane / 16
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%r21, %r22, %r23, %r24}, [%r10];          // slow LDSM
    ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%r25, %r26, %r27, %r28}, [%r11+16384];    // fast LDSM
    ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%r29, %r30, %r31, %r32}, [%r11+16896]; // fast LDSM.MT88
    ld.shared.u32 %r33, [%r13];       // slow LDS
    ld.shared.u32 %r34, [%r14+16384]; // fast LDS
    shfl.sync.bfly.b32 %r35, %r15, 1, 31, -1;
    ex2.approx.ftz.f32 %f2, %f1;
    mov.b32 %r36, %f2;
    // ALU readers (operands read at issue): each result ^ seed
    xor.b32 %r41, %r21, %r20;
    xor.b32 %r42, %r22, %r20;
    xor.b32 %r43, %r23, %r20;
    xor.b32 %r44, %r24, %r20;
    xor.b32 %r45, %r25, %r20;
    xor.b32 %r46, %r26, %r20;
    xor.b32 %r47, %r27, %r20;
    xor.b32 %r48, %r28, %r20;
    xor.b32 %r49, %r29, %r20;
    xor.b32 %r50, %r30, %r20;
    xor.b32 %r51, %r31, %r20;
    xor.b32 %r52, %r32, %r20;
    xor.b32 %r53, %r33, %r20;
    xor.b32 %r54, %r34, %r20;
    xor.b32 %r55, %r35, %r20;
    xor.b32 %r56, %r36, %r20;
    mul.wide.u32 %rd2, %r1, 80;
    add.s64 %rd3, %rd1, %rd2;
    st.global.v4.u32 [%rd3], {%r41, %r42, %r43, %r44};
    st.global.v4.u32 [%rd3+16], {%r45, %r46, %r47, %r48};
    st.global.v4.u32 [%rd3+32], {%r49, %r50, %r51, %r52};
    st.global.v4.u32 [%rd3+48], {%r53, %r54, %r55, %r56};
    st.global.v4.u32 [%rd3+64], {%r10, %r11, %r13, %r14};   // the addresses (live to the end)
    ret;
}
