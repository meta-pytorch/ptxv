// Probe for the 2-CTA tensor-memory hand-off (S-MBAR-SCOPE, S-TCGEN05), the shape of the
// 2-CTA FlashAttention / GEMM pipelines: every round, both CTAs of a pair write the MMA's A
// operand into their own TMEM (tcgen05.st; wait::st), sync the CTA, and t0 of each arrives
// on the leader's `full` barrier (the peer remotely); the leader's t0 waits, issues one
// cta_group::2 MMA D = A * B^T (A from TMEM, B = 1 from shared memory, K = 16) and commits
// to `done` in both CTAs; every thread then reads its D row (tcgen05.ld; wait::ld) and
// counts the elements that differ from 16 * v(r), v(r) = (r mod 128) + 1. The next round's
// arrives hand both A (read by the MMA) and D (read by the threads) back to the leader.
//   good : the peer arrives with mbarrier.arrive.release.cluster.shared::cluster
//   RCTA : the peer arrives with .release.cta (PTX race; ptxas: a bare remote SYNCS.ARRIVE)
//   NOFULL (positive control): the leader tests `full` once and issues the MMA whether or
//          not the phase completed
//   EARLY (positive control): the peer arrives at the start of the round, before its st;
//          EARLYD also has the peer CTA sleep 5 us between that arrive and its st
//   NOWST: no tcgen05.wait::st before the hand-off (tcgen05.fence::before_thread_sync orders
//          the st in the PTX model; SASS STTM is scoreboarded): clean
// A stale A gives 16 * v(r-1); a D overwritten before it was read gives 16 * v(r+1).
// out[cta * 128 + tid]: the thread's count of wrong elements over all rounds.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry tc_handback(
    .param .u64 out_ptr,
    .param .u32 rounds
)
.maxntid 128, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .pred  %p<16>;
    .reg .b16   %rs<4>;
    .reg .b32   %r<80>;
    .reg .f32   %f<8>;
    .reg .b64   %rd<16>;
    .shared .align 16 .b32 tmem_slot;
    .shared .align 8 .b8 bars[16];
    .shared .align 1024 .b8 smB[1024];

    mov.u32         %r0, %tid.x;
    shr.u32         %r1, %r0, 5;                    // warp
    mov.u32         %r2, %cluster_ctarank;
    mov.u32         %r3, bars;                      // full +0 (rank 0, count 2), done +8
    add.u32         %r13, %r3, 8;
    mov.u32         %r4, tmem_slot;
    mov.u32         %r6, smB;
    ld.param.u32    %r60, [rounds];
    setp.ne.u32     %p0, %r1, 0;
    @%p0 bra        SKIP_ALLOC;
    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r4], 32;
    tcgen05.relinquish_alloc_permit.cta_group::2.sync.aligned;
SKIP_ALLOC:
    // B = 1.0 (bf16 0x3f80) in all of smB: 128 threads x 8 bytes.
    shl.b32         %r7, %r0, 3;
    add.u32         %r7, %r6, %r7;
    mov.b32         %r8, 0x3f803f80;
    st.shared.v2.b32 [%r7], {%r8, %r8};
    setp.ne.u32     %p1, %r0, 0;
    @%p1 bra        SKIP_INIT;
    mbarrier.init.shared::cta.b64 [%r3], 2;          // full (rank 0)
    mbarrier.init.shared::cta.b64 [%r13], 1;         // done
    fence.mbarrier_init.release.cluster;
SKIP_INIT:
    fence.proxy.async.shared::cta;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    tcgen05.fence::after_thread_sync;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ld.shared.b32   %r9, [%r4];                     // TMEM base: D columns 0..15, A 16..23
    shl.b32         %r30, %r1, 21;                  // (32 * warp) << 16: lane field
    add.u32         %r31, %r9, %r30;                // this warp's D
    add.u32         %r32, %r31, 16;                 // this warp's A
    mapa.shared::cluster.u32 %r10, %r3, 0;          // rank 0's full
    setp.eq.u32     %p2, %r2, 0;                    // leader CTA
    // MMA operands (leader t0)
    mov.u32         %r26, 0x10040490;               // idesc: f32 <- bf16 x bf16, N = 16, M = 256
    shr.u32         %r21, %r6, 4;
    cvt.u64.u32     %rd6, %r21;
    or.b64          %rd7, %rd6, 0x4000404000010000;
    add.u32         %r33, %r9, 16;                  // A (TMEM address, lane 0)
    setp.ne.u32     %p7, %r0, %r0;                  // false: overwrite D
    mov.u32         %r61, 0;                        // wrong elements
    mov.u32         %r62, 0;                        // round
    or.pred         %p8, %p1, %p2;
    not.pred        %p8, %p8;                       // the peer's t0
ROUND:
    // (early hand-off slot)                        // @EARLY
    // v = (r mod 128) + 1 as bf16, packed twice
    and.b32         %r63, %r62, 127;
    add.u32         %r63, %r63, 1;
    cvt.rn.f32.u32  %f0, %r63;
    cvt.rn.bf16.f32 %rs0, %f0;
    mov.b32         %r64, {%rs0, %rs0};
    tcgen05.st.sync.aligned.32x32b.x8.b32 [%r32], {%r64, %r64, %r64, %r64, %r64, %r64, %r64, %r64};
    tcgen05.wait::st.sync.aligned;                  // @WAITST
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    and.b32         %r65, %r62, 1;                  // parity
    @%p1 bra        WAIT_DONE;
    @%p2 bra        LEADER;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r10];     // @HANDOFF
    bra             WAIT_DONE;
LEADER:
    mbarrier.arrive.shared::cta.b64 _, [%r3];
FULL_WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p3, [%r3], %r65;
    @!%p3 bra       FULL_WAIT;                      // @FULLWAIT
    tcgen05.fence::after_thread_sync;
    tcgen05.mma.cta_group::2.kind::f16 [%r9], [%r33], %rd7, %r26, %p7;
    mov.b16         %rs1, 3;
    tcgen05.commit.cta_group::2.mbarrier::arrive::one.shared::cluster.multicast::cluster.b64 [%r13], %rs1;
WAIT_DONE:
    mbarrier.try_wait.parity.shared::cta.b64 %p4, [%r13], %r65;
    @!%p4 bra       WAIT_DONE;
    tcgen05.fence::after_thread_sync;
    tcgen05.ld.sync.aligned.32x32b.x16.b32 {%r40, %r41, %r42, %r43, %r44, %r45, %r46, %r47, %r48, %r49, %r50, %r51, %r52, %r53, %r54, %r55}, [%r31];
    tcgen05.wait::ld.sync.aligned;
    shl.b32         %r66, %r63, 4;                  // 16 * v
    cvt.rn.f32.u32  %f1, %r66;
    mov.b32         %r67, %f1;
    setp.ne.b32 %p5, %r40, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r41, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r42, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r43, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r44, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r45, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r46, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r47, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r48, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r49, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r50, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r51, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r52, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r53, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r54, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    setp.ne.b32 %p5, %r55, %r67;  selp.u32 %r68, 1, 0, %p5;  add.u32 %r61, %r61, %r68;
    // every thread of this CTA has read D before its t0 can hand it back early (EARLY)
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    add.u32         %r62, %r62, 1;
    setp.lt.u32     %p6, %r62, %r60;
    @%p6 bra        ROUND;
    // out[cta * 128 + tid] = wrong elements
    ld.param.u64    %rd0, [out_ptr];
    cvta.to.global.u64 %rd1, %rd0;
    mov.u32         %r70, %ctaid.x;
    shl.b32         %r71, %r70, 7;
    add.u32         %r71, %r71, %r0;
    mul.wide.u32    %rd2, %r71, 4;
    add.u64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r61;
    tcgen05.fence::before_thread_sync;
    bar.sync        0;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    @%p0 bra        FINAL;
    tcgen05.fence::after_thread_sync;
    tcgen05.dealloc.cta_group::2.sync.aligned.b32 %r9, 32;
FINAL:
    ret;
}
