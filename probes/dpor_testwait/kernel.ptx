// DPOR repro (MISS 221): a non-blocking mbarrier.test_wait that observed a phase completion
// must stay reorderable before that completion. Thread 0 spins on M2 (thread 64 arrives),
// then test_waits M1 (thread 32 arrives) and stores the result. Warps 1 and 2 arrive on
// different mbarriers (independent), so DPOR's first schedule may run warp 1 first: test_wait
// then observes M1's completion. If the poll's acquired-from edge is taken as an order
// ("a poll acquires the phase completion it observes"), the false outcome (warp 2 before
// warp 1) is never explored. No remote operations.
// good: out is 1 or 0 (nondeterministic). RACE: thread 32 writes g before its arrive and
// thread 0 reads g after test_wait: a race exactly when test_wait returned false.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry dpor_testwait(.param .u64 out_p)
.maxntid 96, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 4 .b32 g;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, g;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    st.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    setp.eq.u32 %p2, %r1, 32;
    @%p2 bra A1;
    setp.eq.u32 %p3, %r1, 64;
    @%p3 bra A2;
    @%p1 bra END;
W2:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra W2;
    mbarrier.test_wait.parity.acquire.cta.shared::cta.b64 %p6, [%r4], 0;
    selp.u32 %r15, 1, 0, %p6;
    // (read)   // @RD
    st.global.u32 [%rd1], %r15;
W1:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p4, [%r4], 0;
    @!%p4 bra W1;
    bra END;
A1:
    // (write)   // @WR
    mbarrier.arrive.shared::cta.b64 _, [%r4];
    bra END;
A2:
    mbarrier.arrive.shared::cta.b64 _, [%r5];
END:
    ret;
}
