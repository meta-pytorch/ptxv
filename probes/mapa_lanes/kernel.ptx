// probes/mapa_lanes: CuTe's per-lane peer address. Every lane of warp 0 computes
// mapa.shared::cluster(sm, %laneid) in a cluster of 2 CTAs, ranks 2..31 included; only lanes
// below the cluster size store through it (into the peer CTA's sm[rank of the storer]).
// After the cluster barrier each CTA writes its sm[0..1] to out[2 rank ..].
// Variant oob: lane 2 stores through its address too (rank 2 does not exist).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mapa_lanes(.param .u64 pout)
.explicitcluster
.reqnctapercluster 2, 1, 1
.maxntid 32, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;
    .shared .align 16 .b8 sm[64];

    mov.u32         %r0, sm;
    mov.u32         %r1, %laneid;
    mov.u32         %r2, %cluster_ctarank;
    mapa.shared::cluster.u32 %r3, %r0, %r1;
    shl.b32         %r4, %r2, 2;
    add.u32         %r5, %r3, %r4;
    add.u32         %r6, %r2, 100;
    barrier.cluster.arrive;
    barrier.cluster.wait;
    setp.lt.u32     %p1, %r1, 2;                                    // @OOB
    @%p1 st.shared::cluster.u32 [%r5], %r6;
    barrier.cluster.arrive;
    barrier.cluster.wait;
    setp.ge.u32     %p2, %r1, 2;
    @%p2 bra        DONE;
    shl.b32         %r7, %r1, 2;
    add.u32         %r8, %r0, %r7;
    ld.shared.u32   %r9, [%r8];
    ld.param.u64    %rd1, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    shl.b32         %r10, %r2, 1;
    add.u32         %r10, %r10, %r1;
    mul.wide.u32    %rd2, %r10, 4;
    add.s64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r9;
DONE:
    ret;
}
