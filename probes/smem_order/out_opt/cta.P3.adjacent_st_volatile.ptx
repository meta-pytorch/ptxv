.version 9.0
.target sm_103a
.address_size 64

.shared .align 16 .b32 smem[256];
.visible .entry k(.param .u64 p, .param .u64 q)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<16>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [p];
    mov.u32 %r2, %tid.x;
    
    mov.u32 %r3, smem;
    shl.b32 %r4, %r2, 2;
    add.u32 %r5, %r3, %r4;
    mov.u32 %r10, %r2;
    shl.b32 %r20, %r2, 4;
    add.u32 %r21, %r3, %r20;
    st.volatile.shared::cta.u32 [%r21], %r10;
    st.volatile.shared::cta.u32 [%r21+4], %r10;
    mov.u32 %r11, 0;
    st.global.u32 [%rd1], %r11;
    ret;
}
