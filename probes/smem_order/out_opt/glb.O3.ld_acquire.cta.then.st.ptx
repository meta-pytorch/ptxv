.version 9.0
.target sm_103a
.address_size 64

.shared .align 16 .b32 smem[256];
.visible .entry k(.param .u64 p, .param .u64 q)
{
    .reg .b32 %r<32>;
    .reg .b64 %rd<16>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [p];
    mov.u32 %r2, %tid.x;
    
    ld.param.u64 %rd2, [q];
    mul.wide.u32 %rd3, %r2, 4;
    add.u64 %rd4, %rd2, %rd3;
    mov.u32 %r10, %r2;
    ld.acquire.cta.global.u32 %r11, [%rd4];
    st.global.u32 [%rd4+4], %r10;
    st.global.u32 [%rd1], %r11;
    ret;
}
