// probes/redux_f32_paths: redux.sync.{min,max}[.abs][.NaN].f32 d, a, -1 reached by the lanes
// of a warp through different paths (an if / else on lane parity, joined before the redux:
// a full-mask redux.sync waits for every lane), over lanes holding NaNs, signed zeros,
// infinities, subnormals and random words. 16 warps; lane value a = in[t] (gen.py: per warp
// a different mix, e.g. all NaN, one NaN, only zeros of both signs). out[8 w + i]: form i
// (max, min, max.NaN, min.NaN, max.abs, min.abs, max.abs.NaN, min.abs.NaN) of warp w, written
// by lane 0.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry redux_f32_paths(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 512, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<32>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 4;
    add.s64         %rd4, %rd1, %rd3;
    and.b32         %r2, %r1, 1;
    setp.eq.u32     %p1, %r2, 0;
    @%p1 bra        EVEN;
    ld.global.u32   %r3, [%rd4];
    bra.uni         JOIN;
EVEN:
    ld.global.u32   %r4, [%rd4];
    mov.b32         %r3, %r4;
JOIN:
    redux.sync.max.f32 %r10, %r3, -1;
    redux.sync.min.f32 %r11, %r3, -1;
    redux.sync.max.NaN.f32 %r12, %r3, -1;
    redux.sync.min.NaN.f32 %r13, %r3, -1;
    redux.sync.max.abs.f32 %r14, %r3, -1;
    redux.sync.min.abs.f32 %r15, %r3, -1;
    redux.sync.max.abs.NaN.f32 %r16, %r3, -1;
    redux.sync.min.abs.NaN.f32 %r17, %r3, -1;
    and.b32         %r5, %r1, 31;
    setp.ne.u32     %p2, %r5, 0;
    @%p2 bra        DONE;
    shr.u32         %r6, %r1, 5;
    mul.wide.u32    %rd5, %r6, 32;
    add.s64         %rd6, %rd2, %rd5;
    st.global.v4.u32 [%rd6], {%r10, %r11, %r12, %r13};
    st.global.v4.u32 [%rd6+16], {%r14, %r15, %r16, %r17};
DONE:
    ret;
}
