// MISS 208 repro, 4 members: thread i reduces vector i of each test through the multicast
// object mc (one 16-byte multimem.ld_reduce per test: add.v4.bf16x2, add.acc::f32.v4.bf16x2, add.v4.f16x2, add.acc::f32.v4.f16x2)
// and stores the 8 lanes to out. Test k's vectors start at vector b_k of the member buffers and
// of out, n_k of them (data/m4.in<d>.bin: the per-test files, concatenated in that order).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry mm16(
    .param .u64 mc,
    .param .u64 out,
    .param .u32 n0, .param .u32 n1, .param .u32 n2, .param .u32 n3,
    .param .u32 b1, .param .u32 b2, .param .u32 b3
)
{
    .reg .pred %p<5>;
    .reg .b32 %r<24>;
    .reg .b64 %rd<12>;
    ld.param.u64 %rd1, [mc];
    ld.param.u64 %rd2, [out];
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, %ctaid.x;
    mov.u32 %r3, %ntid.x;
    mad.lo.u32 %r1, %r2, %r3, %r1;
    // bf16x8
    ld.param.u32 %r7, [n0];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T1;
    mov.u32 %r9, %r1;
    mul.wide.u32 %rd3, %r9, 16;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.v4.bf16x2 {%r10, %r11, %r12, %r13}, [%rd4];
    st.global.v4.b32 [%rd5], {%r10, %r11, %r12, %r13};
T1:
    // bf16x8a
    ld.param.u32 %r7, [n1];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T2;
    ld.param.u32 %r8, [b1];
    add.u32 %r9, %r1, %r8;
    mul.wide.u32 %rd3, %r9, 16;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.acc::f32.v4.bf16x2 {%r10, %r11, %r12, %r13}, [%rd4];
    st.global.v4.b32 [%rd5], {%r10, %r11, %r12, %r13};
T2:
    // f16x8
    ld.param.u32 %r7, [n2];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T3;
    ld.param.u32 %r8, [b2];
    add.u32 %r9, %r1, %r8;
    mul.wide.u32 %rd3, %r9, 16;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.v4.f16x2 {%r10, %r11, %r12, %r13}, [%rd4];
    st.global.v4.b32 [%rd5], {%r10, %r11, %r12, %r13};
T3:
    // f16x8a
    ld.param.u32 %r7, [n3];
    setp.ge.u32 %p1, %r1, %r7;
    @%p1 bra T4;
    ld.param.u32 %r8, [b3];
    add.u32 %r9, %r1, %r8;
    mul.wide.u32 %rd3, %r9, 16;
    add.s64 %rd4, %rd1, %rd3;
    add.s64 %rd5, %rd2, %rd3;
    multimem.ld_reduce.relaxed.sys.global.add.acc::f32.v4.f16x2 {%r10, %r11, %r12, %r13}, [%rd4];
    st.global.v4.b32 [%rd5], {%r10, %r11, %r12, %r13};
T4:
    ret;
}
