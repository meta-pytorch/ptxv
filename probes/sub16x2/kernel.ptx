// probes/sub16x2: sub.u16x2 / sub.s16x2 (two 16-bit lanes, each a - b modulo 2^16, no borrow
// between them; ptxas 13.3 accepts them, 13.0 does not: VIADD.16x2 d, a, -b). 24 CTAs x 256
// threads; i = 256 ctaid + tid; a, b = in[2 i], in[2 i + 1] (gen.py); out[4 i] = sub.u16x2(a, b),
// out[4 i + 1] = sub.s16x2(a, b), out[4 i + 2] = sub.u16x2(b, a), out[4 i + 3] =
// sub.s16x2(a, 0x00018000) (a moved constant; ptxas rejects an immediate operand).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry sub16x2(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r9, %ctaid.x;
    mov.u32         %r10, %tid.x;
    mad.lo.u32      %r1, %r9, 256, %r10;
    mul.wide.u32    %rd3, %r1, 8;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.v2.u32 {%r2, %r3}, [%rd4];
    mul.wide.u32    %rd5, %r1, 16;
    add.s64         %rd6, %rd2, %rd5;
    sub.u16x2       %r4, %r2, %r3;
    sub.s16x2       %r5, %r2, %r3;
    sub.u16x2       %r6, %r3, %r2;
    mov.b32         %r8, 0x00018000;
    sub.s16x2       %r7, %r2, %r8;
    st.global.v4.u32 [%rd6], {%r4, %r5, %r6, %r7};
    ret;
}
