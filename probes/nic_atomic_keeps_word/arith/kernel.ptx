.version 9.0
.target sm_103a
.address_size 64

// MISS 257 repro: the payload of cas_fail/, fa0/, fa1/.

.visible .entry r6n_arith(.param .u64 dst, .param .u64 out)
.maxntid 32, 1, 1
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<40>;
    mov.u32 %r0, %tid.x;
    setp.ne.u32 %p0, %r0, 0;
    @%p0 bra DONE;
    ld.param.u64 %rd1, [dst];
    ld.param.u64 %rd2, [out];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    add.rn.f32 %f0, 0f3DCCCCCD, 0f3E4CCCCD;
    add.rn.f32 %f1, 0f3F800000, 0f322BCC77;
    add.rn.f32 %f2, 0f40400000, 0f3DCCCCCD;
    add.rn.f32 %f3, 0f4CBEBC20, 0f3F800000;
    st.global.v4.f32 [%rd1], {%f0, %f1, %f2, %f3};
    ld.global.v4.u32 {%r10, %r11, %r12, %r13}, [%rd1];
    st.global.v4.u32 [%rd2], {%r10, %r11, %r12, %r13};
DONE:
    ret;
}
