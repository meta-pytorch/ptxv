// Probe for ASSUMPTIONS.md S-RESERVED: the hidden mbarrier at reserved smem 0x48 of a
// cta_group::2 kernel (driver-initialized to 0), under the operations the paired-alloc handshake
// applies to it. (Same steps as probes/mbar_zero, which zeroes an ordinary word instead.)
// ptxas's cta_group::2 allocation handshake waits on a hidden mbarrier in reserved shared
// memory (0x48) that nothing initializes (it starts as 0, probes/reserved_smem). One thread:
//   step 0: store 0 to the word;                  record try_wait parity 0 / 1 and the word
//   step 1: mbarrier.arrive.expect_tx 4;          record again
//   step 2: mbarrier.complete_tx 4;               record again
//   step 3: mbarrier.arrive.expect_tx 4;          record again   (the second handshake)
//   step 4: mbarrier.complete_tx 4;               record again
// out[4s + 0] = try_wait.parity 0, out[4s + 1] = parity 1, out[4s + 2/3] = word lo / hi.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_mbar_reserved(.param .u64 out)
.reqnctapercluster 2, 1, 1
{
    .reg .pred %p<4>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .shared .align 4 .b32 slot;
    mov.u32         %r0, %tid.x;
    setp.ne.u32     %p0, %r0, 0;
    @%p0 bra        DONE;
    // The reserved word at 0x48 of this CTA (rank-tagged address), as the driver left it.
    mov.u32         %r1, %cluster_ctarank;
    shl.b32         %r1, %r1, 24;
    or.b32          %r1, %r1, 0x48;
    ld.param.u64    %rd0, [out];
    cvta.to.global.u64 %rd1, %rd0;
    mov.u64         %rd2, %rd1;
    mov.u32         %r9, 9;                                         // @STEPS
    // step 0
    mbarrier.test_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    mbarrier.test_wait.parity.shared::cta.b64 %p2, [%r1], 1;
    selp.u32 %r3, 1, 0, %p1;  selp.u32 %r4, 1, 0, %p2;
    ld.volatile.shared.v2.b32 {%r5, %r6}, [%r1];
    st.global.v4.b32 [%rd2], {%r3, %r4, %r5, %r6};
    setp.eq.u32     %p3, %r9, 0;
    @%p3 bra        DONE;
    // step 1
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 4;
    mbarrier.test_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    mbarrier.test_wait.parity.shared::cta.b64 %p2, [%r1], 1;
    selp.u32 %r3, 1, 0, %p1;  selp.u32 %r4, 1, 0, %p2;
    ld.volatile.shared.v2.b32 {%r5, %r6}, [%r1];
    st.global.v4.b32 [%rd2+16], {%r3, %r4, %r5, %r6};
    setp.eq.u32     %p3, %r9, 1;
    @%p3 bra        DONE;
    // step 2
    mbarrier.complete_tx.shared::cta.b64 [%r1], 4;
    mbarrier.test_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    mbarrier.test_wait.parity.shared::cta.b64 %p2, [%r1], 1;
    selp.u32 %r3, 1, 0, %p1;  selp.u32 %r4, 1, 0, %p2;
    ld.volatile.shared.v2.b32 {%r5, %r6}, [%r1];
    st.global.v4.b32 [%rd2+32], {%r3, %r4, %r5, %r6};
    setp.eq.u32     %p3, %r9, 2;
    @%p3 bra        DONE;
    // step 3
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r1], 4;
    mbarrier.test_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    mbarrier.test_wait.parity.shared::cta.b64 %p2, [%r1], 1;
    selp.u32 %r3, 1, 0, %p1;  selp.u32 %r4, 1, 0, %p2;
    ld.volatile.shared.v2.b32 {%r5, %r6}, [%r1];
    st.global.v4.b32 [%rd2+48], {%r3, %r4, %r5, %r6};
    setp.eq.u32     %p3, %r9, 3;
    @%p3 bra        DONE;
    // step 4
    mbarrier.complete_tx.shared::cta.b64 [%r1], 4;
    mbarrier.test_wait.parity.shared::cta.b64 %p1, [%r1], 0;
    mbarrier.test_wait.parity.shared::cta.b64 %p2, [%r1], 1;
    selp.u32 %r3, 1, 0, %p1;  selp.u32 %r4, 1, 0, %p2;
    ld.volatile.shared.v2.b32 {%r5, %r6}, [%r1];
    st.global.v4.b32 [%rd2+64], {%r3, %r4, %r5, %r6};
    setp.eq.u32     %p3, %r9, 4;
    @%p3 bra        DONE;
DONE:
    // Never executed (tid 0 always returns above): makes this a cta_group::2 kernel, whose
    // reserved shared memory the driver initializes.
    setp.eq.u32     %p0, %r0, 1000;
    @!%p0 bra       OUT;
    mov.u32         %r10, slot;
    tcgen05.alloc.cta_group::2.sync.aligned.shared::cta.b32 [%r10], 32;
OUT:
    ret;
}
