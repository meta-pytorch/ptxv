// probes/imma_s8: mma.sync.aligned.m16n8k32.row.col.satfinite.s32.s8.s8.s32 (SASS
// IMMA.16832.S8.S8.SAT), one warp, four chained steps. Thread t reads in[32 t .. 32 t + 27]:
// C (4 words), then per step s A (4 words) at 4 + 6 s and B (2 words) at 8 + 6 s (gen.py);
// out[16 t + 4 s .. 16 t + 4 s + 3] = D after step s, D of step s = C of step s + 1.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry imma_s8(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 32, 1, 1
{
    .reg .b32   %r<96>;
    .reg .b64   %rd<16>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 128;
    add.s64         %rd4, %rd1, %rd3;
    mul.wide.u32    %rd5, %r1, 64;
    add.s64         %rd6, %rd2, %rd5;
    ld.global.v4.b32 {%r10, %r11, %r12, %r13}, [%rd4];
    ld.global.b32   %r20, [%rd4+16];
    ld.global.b32   %r21, [%rd4+20];
    ld.global.b32   %r22, [%rd4+24];
    ld.global.b32   %r23, [%rd4+28];
    ld.global.b32   %r24, [%rd4+32];
    ld.global.b32   %r25, [%rd4+36];
    mma.sync.aligned.m16n8k32.row.col.satfinite.s32.s8.s8.s32
        {%r60, %r61, %r62, %r63},
        {%r20, %r21, %r22, %r23},
        {%r24, %r25},
        {%r10, %r11, %r12, %r13};
    st.global.v4.b32 [%rd6+0], {%r60, %r61, %r62, %r63};
    ld.global.b32   %r28, [%rd4+40];
    ld.global.b32   %r29, [%rd4+44];
    ld.global.b32   %r30, [%rd4+48];
    ld.global.b32   %r31, [%rd4+52];
    ld.global.b32   %r32, [%rd4+56];
    ld.global.b32   %r33, [%rd4+60];
    mma.sync.aligned.m16n8k32.row.col.satfinite.s32.s8.s8.s32
        {%r64, %r65, %r66, %r67},
        {%r28, %r29, %r30, %r31},
        {%r32, %r33},
        {%r60, %r61, %r62, %r63};
    st.global.v4.b32 [%rd6+16], {%r64, %r65, %r66, %r67};
    ld.global.b32   %r36, [%rd4+64];
    ld.global.b32   %r37, [%rd4+68];
    ld.global.b32   %r38, [%rd4+72];
    ld.global.b32   %r39, [%rd4+76];
    ld.global.b32   %r40, [%rd4+80];
    ld.global.b32   %r41, [%rd4+84];
    mma.sync.aligned.m16n8k32.row.col.satfinite.s32.s8.s8.s32
        {%r68, %r69, %r70, %r71},
        {%r36, %r37, %r38, %r39},
        {%r40, %r41},
        {%r64, %r65, %r66, %r67};
    st.global.v4.b32 [%rd6+32], {%r68, %r69, %r70, %r71};
    ld.global.b32   %r44, [%rd4+88];
    ld.global.b32   %r45, [%rd4+92];
    ld.global.b32   %r46, [%rd4+96];
    ld.global.b32   %r47, [%rd4+100];
    ld.global.b32   %r48, [%rd4+104];
    ld.global.b32   %r49, [%rd4+108];
    mma.sync.aligned.m16n8k32.row.col.satfinite.s32.s8.s8.s32
        {%r72, %r73, %r74, %r75},
        {%r44, %r45, %r46, %r47},
        {%r48, %r49},
        {%r68, %r69, %r70, %r71};
    st.global.v4.b32 [%rd6+48], {%r72, %r73, %r74, %r75};
    ret;
}
