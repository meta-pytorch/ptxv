// Probe for the cp.async scoreboard scope: odd and even lanes issue their cp.async + commit on
// different paths (divergent), the warp reconverges, waits (wait_group N), bar.warp.sync, and
// each lane reads its neighbour's (lane ^ 1) shared slot. Slots start as 0xee bytes; the source
// rows are 4 KiB apart. Variant `w0`: wait_group 0; `w1`: wait_group 1 (two groups on the warp
// scoreboard, one per path, but one per thread).
.version 8.8
.target sm_103a
.address_size 64
.visible .entry cpasync_warp(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<10>; .reg .b32 %r<40>; .reg .pred %p<4>;
  .shared .align 16 .b8 sm[512];
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mov.u32 %r30, %ctaid.x;
  mad.lo.s32 %r31, %r30, 32, %r1;
  mul.wide.u32 %rd3, %r31, 4096; add.s64 %rd4, %rd1, %rd3;
  mov.u32 %r2, sm; shl.b32 %r3, %r1, 4; add.s32 %r4, %r2, %r3;
  mov.u32 %r20, 0xeeeeeeee;
  st.shared.v4.u32 [%r4], {%r20,%r20,%r20,%r20};
  bar.warp.sync -1;
  and.b32 %r5, %r1, 1;
  setp.eq.u32 %p1, %r5, 0;
  @%p1 bra EVEN;
  cp.async.cg.shared.global [%r4], [%rd4], 16;
  cp.async.commit_group;
  bra.uni JOIN;
EVEN:
  cp.async.cg.shared.global [%r4], [%rd4+16], 16;
  cp.async.commit_group;
JOIN:
  cp.async.wait_group 0; // @WAIT
  bar.warp.sync -1;
  xor.b32 %r6, %r1, 1; shl.b32 %r7, %r6, 4; add.s32 %r8, %r2, %r7;
  ld.shared.v4.u32 {%r10,%r11,%r12,%r13}, [%r8];
  mul.wide.u32 %rd5, %r31, 16; add.s64 %rd6, %rd2, %rd5;
  st.global.v4.u32 [%rd6], {%r10,%r11,%r12,%r13};
  ret; }
