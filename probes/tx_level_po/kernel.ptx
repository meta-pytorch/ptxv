// Repro (MISS 273, RDP2 finding E2, txfuzz case c2_0282): count 1. Warp 0: st s0; fence;
// complete_tx 4 (D1). Warp 1: st s1; fence; complete_tx 8 (D2); arrive.expect_tx 8 (A, the last
// arrival, level 8) in program order (a copy landing before its producer's arrive.expect_tx, the
// pattern of fixtures/c_smm_nvf4). Warp 2 waits for phase 0 and sums the slots. D2, A complete
// phase 0 before D1 lands (race on s0); D1 first: tx -12, then -4, a deadlock. The default
// explorer missed the race too (space 16 is in the synchronization reduction's footprints).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tx_level_po(.param .u64 out_p)
.maxntid 96, 1, 1
{
    .reg .b32 %r<40>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 4 .b32 s[8];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r8, s;
    shr.u32 %r2, %r1, 5;
    and.b32 %r3, %r1, 31;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    st.shared.u32 [%r8+0], 0;
    st.shared.u32 [%r8+4], 0;
    st.shared.u32 [%r8+8], 0;
    st.shared.u32 [%r8+12], 0;
    st.shared.u32 [%r8+16], 0;
    st.shared.u32 [%r8+20], 0;
    st.shared.u32 [%r8+24], 0;
    st.shared.u32 [%r8+28], 0;
INIT_DONE:
    bar.sync 0;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra END;
    setp.eq.u32 %p3, %r2, 0;
    @%p3 bra W0;
    setp.eq.u32 %p3, %r2, 1;
    @%p3 bra W1;
    bra WAITER;
W0:
    mov.u32 %r9, 1;
    st.shared.u32 [%r8+0], %r9;
    fence.acq_rel.cta;
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%r4], 4;
    bra END;
W1:
    mov.u32 %r9, 2;
    st.shared.u32 [%r8+4], %r9;
    fence.acq_rel.cta;
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%r4], 8;
    mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _, [%r4], 8;
    bra END;
WAITER:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra WAITER;
    mov.u32 %r20, 0;
    ld.shared.u32 %r21, [%r8+0];
    add.u32 %r20, %r20, %r21;
    ld.shared.u32 %r21, [%r8+4];
    add.u32 %r20, %r20, %r21;
    st.global.u32 [%rd1], %r20;
END:
    ret;
}
