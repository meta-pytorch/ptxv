// Probe (N-BF16X2) for bf16 abs: abs.bf16x2 / abs.bf16 (SASS HFMA2.BF16_V2 d, -RZ.H0_H0,
// RZ.H0_H0, |R|) on every 16-bit pattern class: signed zeros, subnormals, Inf, NaNs.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry bf16abs(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<8>; .reg .b16 %h<4>;
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mov.u32 %r2, %ctaid.x; mov.u32 %r3, %ntid.x; mad.lo.s32 %r1, %r2, %r3, %r1;
  mul.wide.u32 %rd3, %r1, 4; add.s64 %rd4, %rd1, %rd3;
  mul.wide.u32 %rd5, %r1, 8; add.s64 %rd6, %rd2, %rd5;
  ld.global.u32 %r4, [%rd4];
  abs.bf16x2 %r5, %r4;
  mov.b32 {%h1, %h2}, %r4;
  abs.bf16 %h3, %h2;
  cvt.u32.u16 %r6, %h3;
  st.global.v2.u32 [%rd6], {%r5, %r6};
  ret; }
