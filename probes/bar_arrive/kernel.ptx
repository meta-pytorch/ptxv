// Probe for E-BAR-ARRIVE: does bar.arrive (BAR.ARV) return without waiting, and does it count
// toward a bar.sync on the same barrier? 64 threads, no spinning.
//   warp 0: bar.arrive 1, 64;  bar.sync 2, 64;  thread 0 writes out[1] = 2
//   warp 1: bar.sync 2, 64;    bar.sync 1, 64;  thread 32 writes out[0] = 1
// If the arrive waited for barrier 1 to complete, warp 0 would wait on barrier 1 while warp 1
// waits on barrier 2: a hang. If it did not count, warp 1's bar.sync 1, 64 would hang.
.version 9.0
.target sm_103a
.address_size 64

.visible .entry probe_bar_arrive(.param .u64 out_p)
{
    .reg .b32 %r<8>;
    .reg .b64 %rd<4>;
    .reg .pred %p<4>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    setp.ge.u32 %p1, %r1, 32;
    @%p1 bra CONSUMER;
    bar.arrive 1, 64;                    // @ARRIVE
    bar.sync 2, 64;
    setp.ne.u32 %p2, %r1, 0;
    @%p2 bra DONE;
    mov.u32 %r3, 2;
    st.global.u32 [%rd1+4], %r3;
    bra DONE;
CONSUMER:
    bar.sync 2, 64;
    bar.sync 1, 64;                      // @SYNC1
    setp.ne.u32 %p2, %r1, 32;
    @%p2 bra DONE;
    mov.u32 %r3, 1;
    st.global.u32 [%rd1], %r3;
DONE:
    ret;
}
