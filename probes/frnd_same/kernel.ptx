// RVS2 probe: FRND by FRND (f32) and FRND.F64 by FRND.F64.
.version 9.0
.target sm_103a
.address_size 64
.visible .entry frnds(.param .u64 out_p)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<16>;
    .reg .f64 %fd<16>;
    .reg .b64 %rd<16>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    cvt.rn.f64.u32 %fd1, %r1;
    mul.f64 %fd1, %fd1, 0d3FF5EB851EB851EC;
    mul.f64 %fd3, %fd1, 0d3FF8000000000000;
    cvt.rn.f32.u32 %f1, %r1;
    mul.f32 %f2, %f1, 0f3FC00000;
    mul.f32 %f4, %f1, 0f3FAE147B;
    cvt.rni.f64.f64 %fd2, %fd1;
    cvt.rmi.f64.f64 %fd4, %fd3;
    cvt.rni.f32.f32 %f3, %f2;
    cvt.rmi.f32.f32 %f5, %f4;
    mul.wide.u32 %rd6, %r1, 32;
    add.s64 %rd7, %rd1, %rd6;
    st.global.f64 [%rd7], %fd2;
    st.global.f64 [%rd7+8], %fd4;
    st.global.f32 [%rd7+16], %f3;
    st.global.f32 [%rd7+20], %f5;
    st.global.f64 [%rd7+24], %fd1;
    ret;
}
