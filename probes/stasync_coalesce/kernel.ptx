// Review repro: one warp instruction's st.async words coalesce into one pending op (push_remote),
// whose actor is the first lane's. Lanes 0 and 1 of rank 0 st.async x (lane 0) and y (lane 1)
// into rank 1, both on M1. Then only lane L (L = 0 default, 1 in variant C1) runs
// fence.acq_rel.cluster and a remote .release.cluster arrive on M2. Rank 1 waits on M2, reads y
// (lane 1's word), then waits on M1.
// PTX: lane 1's st.async is ordered before the reader only if lane 1 released (C1).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry stasync_coalesce(.param .u64 out_p)
.maxntid 32, 1, 1
.reqnctapercluster 2, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 8 .b64 m2;
    .shared .align 8 .b32 xy[2];
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r3, %cluster_ctarank;
    mov.u32 %r4, m1;
    mov.u32 %r5, m2;
    mov.u32 %r8, xy;
    setp.ne.u32 %p0, %r3, 1;
    setp.ne.u32 %p1, %r1, 0;
    or.pred %p2, %p0, %p1;
    @%p2 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    mbarrier.init.shared::cta.b64 [%r5], 1;
    fence.mbarrier_init.release.cluster;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r4], 8;
INIT_DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.gt.u32 %p3, %r1, 1;
    @%p3 bra END;
    @!%p0 bra RANK1;
    mapa.shared::cluster.u32 %r9, %r4, 1;
    mapa.shared::cluster.u32 %r10, %r5, 1;
    shl.b32 %r12, %r1, 2;
    add.u32 %r12, %r8, %r12;
    mapa.shared::cluster.u32 %r13, %r12, 1;
    mov.u32 %r14, 42;
    st.async.shared::cluster.mbarrier::complete_tx::bytes.b32 [%r13], %r14, [%r9];
    setp.ne.u32 %p6, %r1, 0;     // @LANE
    @%p6 bra END;
    fence.acq_rel.cluster;
    mbarrier.arrive.release.cluster.shared::cluster.b64 _, [%r10];
    bra END;
RANK1:
    @%p1 bra END;
WAIT2:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p5, [%r5], 0;
    @!%p5 bra WAIT2;
    ld.shared.u32 %r15, [%r8+4];
    st.global.u32 [%rd1], %r15;
WAIT:
    mbarrier.try_wait.parity.acquire.cluster.shared::cta.b64 %p4, [%r4], 0;
    @!%p4 bra WAIT;
END:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
