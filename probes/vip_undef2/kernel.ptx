// RDP2 variants of probes/vip_undef_load (MISS 282 follow-up); see case.toml.

// Repro (MISS 282, RDP2 finding K): a volatile (strong) load of never-written shared memory whose
// value reaches out. Count-2 mbarrier m1; warp 0 arrives; warp 1 arrives, then loads the low word
// of m1 with ld.volatile and stores it to out (@T; variant LDY: a never-written word y, LDYP: the
// same with a plain load). On PTX, mbarrier.init writes the model's mbarrier, not the bytes, so the
// word holds garbage (S-INIT) and out is undefined at exit. E-POLL-ANY took the load for a
// value-insensitive poll: the values it tries are the location's explored writes and its current
// bytes, which for a never-written word is the fill alone, so every value "ended the same" and the
// loaded value lost its undefined bits (default [clean] against DPOR [violation]). Variant UST:
// scr[2] holds a defined 0 (thread 0, before the barrier); warp 1 copies the never-written scr[1]
// (undefined, bytes 0) into it with a strong store, and warp 2 loads it with a strong load and
// stores it to out. The learned values are {0} and the current bytes are defined, so the load
// passed for a poll before the store ran, and the order with the store first was cut.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry vip_undef_load(.param .u64 out_p, .param .u64 scr_p)
.maxntid 96, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 4 .b32 x;
    .shared .align 4 .b32 y;
    .shared .align 16 .b8 buf[16];
    .shared .align 16 .b8 ubuf[16];
    .shared .align 8 .b64 m2;
    ld.param.u64 %rd1, [out_p];
    ld.param.u64 %rd2, [scr_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r8, x;
    shr.u32 %r2, %r1, 5;
    and.b32 %r3, %r1, 31;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 2;
    mov.u32 %r10, m2;
    mbarrier.init.shared::cta.b64 [%r10], 1;
    mov.u32 %r11, buf;
    st.shared.v4.u32 [%r11], {%r1, %r1, %r1, %r1};
    fence.proxy.async.shared::cta;
    st.shared.u32 [%r8], 0;
    cvta.to.global.u64 %rd3, %rd2;
    st.global.u32 [%rd3+8], 0;
    st.global.v4.u32 [%rd3+16], {%r1, %r1, %r1, %r1};
INIT_DONE:
    bar.sync 0;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra END;
    setp.eq.u32 %p3, %r2, 1;
    @%p3 bra B;
    setp.eq.u32 %p3, %r2, 2;
    @%p3 bra Z;
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    bra END;
B:
    mbarrier.arrive.release.cta.shared::cta.b64 _, [%r4];
    ld.volatile.shared.u32 %r16, [%r4];  // @T
    mov.u32 %r15, %r16;
    st.global.u32 [%rd1], %r15;  // @S
    bra END;
Z:
    // @Z

END:
    ret;
}
