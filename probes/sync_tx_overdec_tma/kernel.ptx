// Stateful and DPOR repro (MISS 231 follow-up, MISS 268, TMA; from a review repro): expect_tx smaller than one copy. Thread 0:
// arrive.expect_tx M, 16 (pending 0, tx 16), then two bulk copies on M: A (32 bytes into ta,
// @A) and B (16 bytes into tb). Thread 32 waits for phase 0 and reads ta.
// A lands first: tx 16 -> -16 -> -32, phase 0 never completes (deadlock).
// B lands first: tx 16 -> 0, phase 0 completes, thread 32 reads ta while A is still in flight
// (race), and A's complete_tx lands in phase 1.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tx_overdec_tma(.param .u64 in_p, .param .u64 out_p)
.maxntid 64, 1, 1
{
    .shared .align 16 .b8 ta[32];
    .shared .align 16 .b8 tb[16];
    .shared .align 8 .b64 m1;
    .reg .b32 %r<24>;
    .reg .b64 %rd<8>;
    .reg .pred %p<8>;
    ld.param.u64 %rd1, [in_p];
    ld.param.u64 %rd2, [out_p];
    cvta.to.global.u64 %rd2, %rd2;
    add.u64 %rd3, %rd1, 32;
    mov.u32 %r1, %tid.x;
    mov.u32 %r2, ta;
    mov.u32 %r3, tb;
    mov.u32 %r4, m1;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    fence.proxy.async.shared::cta;
INIT_DONE:
    bar.sync 0;
    setp.eq.u32 %p3, %r1, 32;
    @%p3 bra W;
    @%p1 bra END;
    mbarrier.arrive.expect_tx.shared::cta.b64 _, [%r4], 16;   // @E
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r2], [%rd1], 32, [%r4];   // @A
    cp.async.bulk.shared::cluster.global.mbarrier::complete_tx::bytes [%r3], [%rd3], 16, [%r4];
    mov.u32 %r20, 0;  // @L
    bra END;
W:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra W;
    ld.shared.u32 %r15, [%r2];
    st.global.u32 [%rd2], %r15;
END:
    ret;
}
