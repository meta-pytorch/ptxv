// Probe (L-OPCLASS, E-HW-SB-QUEUE): an I2F.S8 and a later I2F.S16 (two full opcodes of one base
// opcode, the order of the captured Triton dequantize_kv kernel). The variants take the I2F.S8's
// write scoreboard away and let its reader wait on the later I2F.S16's scoreboard only (COVER) or
// on nothing (NOWAIT, positive control).
.version 9.0
.target sm_103a
.address_size 64
.visible .entry i2f8q(.param .u64 out_p, .param .u32 seed)
{
    .reg .b32 %r<16>;
    .reg .b16 %h<4>;
    .reg .f32 %f<16>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u32 %r2, [seed];
    mov.u32 %r1, %tid.x;
    mul.lo.u32 %r3, %r1, %r2;
    shr.u32 %r4, %r3, 7;
    cvt.u16.u32 %h1, %r3;
    cvt.u16.u32 %h2, %r4;
    cvt.rn.f32.s8 %f1, %h1;        // I2F.S8
    cvt.rn.f32.s16 %f2, %h2;       // I2F.S16
    mul.wide.u32 %rd2, %r1, 8;
    add.s64 %rd3, %rd1, %rd2;
    st.global.f32 [%rd3], %f1;
    st.global.f32 [%rd3+4], %f2;
    ret;
}
