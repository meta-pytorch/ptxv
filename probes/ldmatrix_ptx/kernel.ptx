// Probe (L-ROSETTA) for PTX ldmatrix: m8n8.x1 / .x2 / .x4 / .x4.trans .shared.b16 (SASS LDSM.16.M88.N
// / .MT88.4), one warp, a 32x32 b16 tile in shared memory (row r at 64 r bytes); lane l gives
// the address of row l (x4: matrices 0-3 from rows 0-7, 8-15, ...), x1 / x2 lanes 0-7 / 0-15.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry ldm(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<40>;
  .shared .align 16 .b8 tile[2048];
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mov.u32 %r2, tile;
  mul.wide.u32 %rd3, %r1, 64; add.s64 %rd4, %rd1, %rd3;
  shl.b32 %r3, %r1, 6; add.u32 %r4, %r2, %r3;
  ld.global.v4.u32 {%r5,%r6,%r7,%r8}, [%rd4];
  st.shared.v4.u32 [%r4], {%r5,%r6,%r7,%r8};
  ld.global.v4.u32 {%r5,%r6,%r7,%r8}, [%rd4+16];
  st.shared.v4.u32 [%r4+16], {%r5,%r6,%r7,%r8};
  ld.global.v4.u32 {%r5,%r6,%r7,%r8}, [%rd4+32];
  st.shared.v4.u32 [%r4+32], {%r5,%r6,%r7,%r8};
  ld.global.v4.u32 {%r5,%r6,%r7,%r8}, [%rd4+48];
  st.shared.v4.u32 [%r4+48], {%r5,%r6,%r7,%r8};
  bar.sync 0;
  ldmatrix.sync.aligned.m8n8.x4.shared.b16 {%r10,%r11,%r12,%r13}, [%r4];
  ldmatrix.sync.aligned.m8n8.x4.trans.shared.b16 {%r14,%r15,%r16,%r17}, [%r4+16];
  ldmatrix.sync.aligned.m8n8.x1.shared.b16 {%r18}, [%r4+32];
  ldmatrix.sync.aligned.m8n8.x2.trans.shared.b16 {%r20,%r19}, [%r4+48];
  mul.wide.u32 %rd5, %r1, 48; add.s64 %rd6, %rd2, %rd5;
  st.global.v4.u32 [%rd6], {%r10,%r11,%r12,%r13};
  st.global.v4.u32 [%rd6+16], {%r14,%r15,%r16,%r17};
  st.global.v4.u32 [%rd6+32], {%r18,%r19,%r20,%r1};
  ret; }
