// Probe (L-OPCLASS) for the f64 pipe's scoreboards: ptxas for sm_103a gives some DADD / DFMA /
// DMUL no write scoreboard and reads their result after a wait on a later f64 op's (here
// DFMA R2 at 0x200, read at 0x2b0 after a wait on DADD R6's SB0).
.version 8.8
.target sm_103a
.address_size 64
.visible .entry f64q(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .f64 %fd<20>; .reg .b32 %r<4>;
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mov.u32 %r2, %ctaid.x; mov.u32 %r3, %ntid.x; mad.lo.s32 %r1, %r2, %r3, %r1;
  mul.wide.u32 %rd3, %r1, 16; add.s64 %rd4, %rd1, %rd3;
  ld.global.v2.f64 {%fd1, %fd2}, [%rd4];
  add.rn.f64 %fd3, %fd1, 0dBFF0000000000000;
  add.rn.f64 %fd4, %fd1, 0d3FF0000000000000;
  sub.rn.f64 %fd5, %fd2, %fd1;
  mul.rn.f64 %fd6, %fd2, %fd2;
  div.rn.f64 %fd7, %fd3, %fd4;
  fma.rn.f64 %fd8, %fd5, %fd6, %fd7;
  mul.wide.u32 %rd5, %r1, 32; add.s64 %rd6, %rd2, %rd5;
  st.global.v2.f64 [%rd6], {%fd7, %fd8};
  st.global.v2.f64 [%rd6+16], {%fd5, %fd6};
  ret; }
