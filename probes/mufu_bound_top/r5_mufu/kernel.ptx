.version 9.0
.target sm_103a
.address_size 64

.visible .entry r5_mufu(.param .u64 px, .param .u64 pout, .param .u64 pz)
{
    .reg .pred %p<8>;
    .reg .b16 %rs<40>;
    .reg .b32 %r<80>;
    .reg .f32 %f<80>;
    .reg .b64 %rd<64>;
    ld.param.u64 %rd1, [px];
    ld.param.u64 %rd15, [pz];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd15, %rd15;
    mov.u32 %r0, %tid.x;
    mul.wide.u32 %rd3, %r0, 4;
    add.s64 %rd4, %rd1, %rd3;
    mul.wide.u32 %rd9, %r0, 16;
    add.s64 %rd10, %rd15, %rd9;
    ld.global.f32 %f4, [%rd4];
    ld.param.u64 %rd40, [pout];
    cvta.to.global.u64 %rd40, %rd40;
    add.s64 %rd6, %rd40, %rd3;
    rcp.approx.ftz.f32 %f20, %f4;
    st.global.f32 [%rd6], %f20;
    rcp.approx.f32 %f21, %f4;
    st.global.f32 [%rd6+128], %f21;
    ex2.approx.ftz.f32 %f22, %f4;
    st.global.f32 [%rd6+256], %f22;
    ex2.approx.f32 %f23, %f4;
    st.global.f32 [%rd6+384], %f23;
    ret;
}
