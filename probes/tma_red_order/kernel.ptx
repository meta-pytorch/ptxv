// probes/tma_red_order: the order of two bf16 tensor bulk reductions (UTMAREDG.2D.ADD) into
// one 64 x 64 box. A cluster of two CTAs (128 threads each); CTA r copies a[r] (4096 bf16)
// into shared memory and fences the async proxy; after a cluster barrier, mode 0: thread 0 of
// each CTA adds its box into g (both issued at once); mode 1: CTA 0 adds a[0] then a[1] (from
// its own shared copy of both) back to back. gen.py picks (g, a0, a1) per element so that
// a0-first, a1-first and a single rounding of g + a0 + a1 give three different bf16 words.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tma_red_order(
    .param .u64 pa,
    .param .u32 mode,
    .param .align 64 .b8 tmg[128]
) .reqnctapercluster 2, 1, 1
.maxntid 128, 1, 1
{
    .reg .pred  %p<4>;
    .reg .b32   %r<32>;
    .reg .b16   %h<4>;
    .reg .b64   %rd<16>;
    .shared .align 128 .b8 s0[8192];
    .shared .align 128 .b8 s1[8192];

    ld.param.u64    %rd1, [pa];
    ld.param.u32    %r20, [mode];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32         %r1, %tid.x;
    mov.u32         %r11, %cluster_ctarank;
    mov.u32         %r2, s0;
    mov.u32         %r3, s1;
    mov.u32         %r5, 0;
L0:
    mad.lo.u32      %r6, %r5, 128, %r1;
    mul.wide.u32    %rd3, %r6, 2;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.b16   %h1, [%rd4];
    ld.global.b16   %h2, [%rd4+8192];
    shl.b32         %r7, %r6, 1;
    add.u32         %r8, %r2, %r7;
    add.u32         %r9, %r3, %r7;
    setp.eq.u32     %p3, %r11, 0;
    @%p3 st.shared.b16 [%r8], %h1;
    @!%p3 st.shared.b16 [%r8], %h2;
    st.shared.b16   [%r9], %h2;
    add.u32         %r5, %r5, 1;
    setp.lt.u32     %p1, %r5, 32;
    @%p1 bra        L0;
    fence.proxy.async.shared::cta;
    bar.sync        0;
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    setp.ne.u32     %p2, %r1, 0;
    @%p2 bra        DONE;
    mov.b64         %rd8, tmg;
    cvta.param.u64  %rd5, %rd8;
    mov.u32         %r10, 0;
    setp.eq.u32     %p1, %r20, 0;
    @%p1 bra        ONE;
    @!%p3 bra       DONE;
    cp.reduce.async.bulk.tensor.2d.global.shared::cta.add.tile.bulk_group [%rd5, {%r10, %r10}], [%r2];
    cp.reduce.async.bulk.tensor.2d.global.shared::cta.add.tile.bulk_group [%rd5, {%r10, %r10}], [%r3];
    bra             WAIT;
ONE:
    cp.reduce.async.bulk.tensor.2d.global.shared::cta.add.tile.bulk_group [%rd5, {%r10, %r10}], [%r2];
WAIT:
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group 0;
DONE:
    barrier.cluster.arrive.release.aligned;
    barrier.cluster.wait.acquire.aligned;
    ret;
}
