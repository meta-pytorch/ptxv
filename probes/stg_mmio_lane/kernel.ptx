// MISS 168 repro (gb300 profile, E-HW-STG-LOWEST): the 32 lanes of one global store write their
// tid to one word; after bar.warp.sync every lane reads the word back and traps on lane 0's
// value. The variants make the store st.mmio.relaxed.sys (SASS STG.E.MMIO.SYS) and change the
// trap value (case.toml).
.version 9.0
.target sm_103a
.address_size 64

.visible .entry stg_mmio_lane(.param .u64 w_p, .param .u64 out_p)
.maxntid 32, 1, 1
{
    .reg .b32 %r<16>;
    .reg .b64 %rd<8>;
    .reg .pred %p<4>;
    ld.param.u64 %rd4, [w_p];
    cvta.to.global.u64 %rd4, %rd4;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    add.u32 %r7, %r1, 100;
    st.relaxed.gpu.global.u32 [%rd4], %r1;   // @ST
    bar.warp.sync -1;
    ld.relaxed.gpu.global.u32 %r3, [%rd4];
    setp.eq.u32 %p1, %r3, 0;   // @CMP
    @%p1 trap;                 // @TRAP
    mul.wide.u32 %rd2, %r1, 4;
    add.s64 %rd3, %rd1, %rd2;
    st.global.u32 [%rd3], %r3;
    ret;
}
