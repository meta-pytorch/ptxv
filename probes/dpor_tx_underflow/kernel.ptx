// DPOR repro (MISS 231 follow-up): a decrement that takes tx below 0 while an arrival is
// pending, against the phase's last arrival. M (count 1, tx 0).
// Thread 32: st b = 1; fence; complete_tx M, 4 (no expect_tx: the bug).
// Thread 64: arrive M (the last arrival; @ARV).
// Thread 96: waits for phase 0 of M, reads b.
// Thread 64 first: pending 0 and tx 0, phase 0 completes; thread 96 reads b unordered with
// thread 32's store (race), and thread 32's complete_tx lands in phase 1. Thread 32 first: tx
// -4, then the arrival leaves tx at -4 and phase 0 never completes (deadlock). The decrement
// reads the phase's last-arrival key, which the last arrival writes (exec.rs `rec_tx`).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tx_underflow(.param .u64 out_p)
.maxntid 128, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 4 .b32 b;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r8, b;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    st.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    setp.eq.u32 %p2, %r1, 32;
    @%p2 bra T1;
    setp.eq.u32 %p3, %r1, 64;
    @%p3 bra T2;
    setp.eq.u32 %p4, %r1, 96;
    @%p4 bra W;
    bra END;
T1:
    mov.u32 %r9, 1;
    st.shared.u32 [%r8], %r9;
    fence.acq_rel.cta;
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%r4], 4;
    bra END;
T2:
    mbarrier.arrive.shared::cta.b64 _, [%r4];   // @ARV
    bra END;
W:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra W;
    ld.shared.u32 %r15, [%r8];
    st.global.u32 [%rd1], %r15;
END:
    ret;
}
