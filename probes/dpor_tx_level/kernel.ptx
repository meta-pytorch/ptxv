// DPOR repro (MISS 273): a decrement's deficit depends on the decrements run before it.
// mbarrier count 1, tx 0. Warp 0: st b; fence; complete_tx 4 (D1). Warp 1: arrive.expect_tx 8
// (A, the last arrival, increment level 8). Warp 2: complete_tx 8 (D2). Warp 3 waits for phase 0
// and reads b. D2 then A completes phase 0 with D1 still to land: a race on b. D1 first leaves
// tx -4 (deficit 4 <= 8: D1 and A commute there); after D2 it leaves tx -12 (deficit 12 > 8: they
// do not). Variant D1D2A swaps warps 1 and 2 (the warp order decides the order explored first).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry tx_level(.param .u64 out_p)
.maxntid 128, 1, 1
{
    .reg .b32 %r<24>;
    .reg .b64 %rd<4>;
    .reg .pred %p<8>;
    .shared .align 8 .b64 m1;
    .shared .align 4 .b32 b;
    ld.param.u64 %rd1, [out_p];
    cvta.to.global.u64 %rd1, %rd1;
    mov.u32 %r1, %tid.x;
    mov.u32 %r4, m1;
    mov.u32 %r8, b;
    shr.u32 %r2, %r1, 5;
    and.b32 %r3, %r1, 31;
    setp.ne.u32 %p1, %r1, 0;
    @%p1 bra INIT_DONE;
    mbarrier.init.shared::cta.b64 [%r4], 1;
    st.shared.u32 [%r8], 0;
INIT_DONE:
    bar.sync 0;
    setp.ne.u32 %p2, %r3, 0;
    @%p2 bra END;
    setp.eq.u32 %p3, %r2, 0;
    @%p3 bra W0;
    setp.eq.u32 %p3, %r2, 1;
    @%p3 bra W1;
    setp.eq.u32 %p3, %r2, 2;
    @%p3 bra W2;
WAITER:
    mbarrier.try_wait.parity.acquire.cta.shared::cta.b64 %p5, [%r4], 0;
    @!%p5 bra WAITER;
    ld.shared.u32 %r15, [%r8];
    st.global.u32 [%rd1], %r15;
    bra END;
W0:
    mov.u32 %r9, 1;
    st.shared.u32 [%r8], %r9;
    fence.acq_rel.cta;
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%r4], 4;
    bra END;
W1:
    mbarrier.arrive.expect_tx.release.cta.shared::cta.b64 _, [%r4], 8;  // @W1
    bra END;
W2:
    mbarrier.complete_tx.relaxed.cta.shared::cta.b64 [%r4], 8;  // @W2
    bra END;
END:
    ret;
}
