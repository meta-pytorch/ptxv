// probes/ldc_u16: LDC.U16 (ld.param.u16 / .s16 of 16-bit parameters at 2-byte-aligned offsets,
// odd halfwords of a word included). Parameters: out, then u8 p0, u16 p1, u16 p2, u16 p3, u8 p4,
// u16 p5, s16 p6, u16 p7; thread 0 stores each 16-bit value zero- (u16) or sign- (s16)
// extended to 32 bits, and p1 + p5 (a 16-bit add widened), into out[0..9].
.version 9.0
.target sm_103a
.address_size 64
.visible .entry ldc_u16(.param .u64 out, .param .u8 p0, .param .u16 p1, .param .u16 p2,
    .param .u16 p3, .param .u8 p4, .param .u16 p5, .param .s16 p6, .param .u16 p7)
{
  .reg .b16 %h<10>; .reg .b32 %r<16>; .reg .b64 %rd<4>;
  ld.param.u64 %rd1, [out]; cvta.to.global.u64 %rd1, %rd1;
  ld.param.u8 %h0, [p0]; ld.param.u16 %h1, [p1]; ld.param.u16 %h2, [p2]; ld.param.u16 %h3, [p3];
  ld.param.u8 %h4, [p4]; ld.param.u16 %h5, [p5]; ld.param.s16 %h6, [p6]; ld.param.u16 %h7, [p7];
  cvt.u32.u16 %r0, %h0; cvt.u32.u16 %r1, %h1; cvt.u32.u16 %r2, %h2; cvt.u32.u16 %r3, %h3;
  cvt.u32.u16 %r4, %h4; cvt.u32.u16 %r5, %h5; cvt.s32.s16 %r6, %h6; cvt.u32.u16 %r7, %h7;
  add.u16 %h8, %h1, %h5; cvt.u32.u16 %r8, %h8;
  st.global.v4.u32 [%rd1], {%r0, %r1, %r2, %r3};
  st.global.v4.u32 [%rd1+16], {%r4, %r5, %r6, %r7};
  st.global.u32 [%rd1+32], %r8;
  ret;
}
