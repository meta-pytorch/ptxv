// Probe for abs.f32, abs.ftz.f32 (FADD[.FTZ] |a|, -RZ) and abs.s32 (IABS) on every special
// pattern: zeros, subnormals, infinities, NaN payloads of both signs, INT_MIN.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry abs_f32(.param .u64 pin, .param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<20>; .reg .f32 %f<8>;
  ld.param.u64 %rd1, [pin]; ld.param.u64 %rd2, [pout];
  cvta.to.global.u64 %rd1, %rd1; cvta.to.global.u64 %rd2, %rd2;
  mov.u32 %r1, %tid.x; mul.wide.u32 %rd3, %r1, 4; add.s64 %rd4, %rd1, %rd3; add.s64 %rd5, %rd2, %rd3;
  ld.global.f32 %f1, [%rd4];
  ld.global.s32 %r2, [%rd4];
  abs.f32 %f2, %f1;
  abs.ftz.f32 %f3, %f1;
  abs.s32 %r3, %r2;
  st.global.f32 [%rd5], %f2;
  st.global.f32 [%rd5+4096], %f3;
  st.global.s32 [%rd5+8192], %r3;
  ret; }
