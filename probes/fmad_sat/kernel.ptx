// probes/fmad_sat (genptx.py): a mul.sat.f32 read by plain add / sub. ptxas 13.0 and 13.3 keep
// the FMUL.SAT and emit FADD (no contraction: the clamp sits between the product and the sum),
// while a plain mul read by an add.sat / sub.sat is one FFMA.SAT. 32 CTAs x 256 threads;
// i = 256 ctaid + tid; form k reads (a, b, c) = in[3 j ..], j = (i + 1024 k) mod 8192 (gen.py);
// out[8 i + k]:
//   0: mul.sat(a, b) + c
//   1: c - mul.sat(a, b)
//   2: mul.sat(a, b)
//   3: add.sat(mul(a, c), b)
//   4: sub.sat(mul(a, c), b)
//   5: sub.sat(b, mul(a, c))
//   6: mul.ftz.sat(a, b) + c (.ftz)
//   7: add.ftz.sat(mul.ftz(a, c), b)
.version 8.8
.target sm_103a
.address_size 64

.visible .entry fmad_sat(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<90>;
    .reg .b64   %rd<26>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %tid.x;
    mad.lo.u32      %r1, %r2, 256, %r3;
    mul.wide.u32    %rd5, %r1, 32;
    add.s64         %rd6, %rd2, %rd5;
    add.u32         %r10, %r1, 0;
    and.b32         %r10, %r10, 8191;
    mul.wide.u32    %rd10, %r10, 12;
    add.s64         %rd11, %rd1, %rd10;
    ld.global.f32   %r12, [%rd11+0];
    ld.global.f32   %r13, [%rd11+4];
    ld.global.f32   %r14, [%rd11+8];
    mul.sat.f32 %r15, %r12, %r13;
    add.f32 %r16, %r15, %r14;
    add.u32         %r20, %r1, 1024;
    and.b32         %r20, %r20, 8191;
    mul.wide.u32    %rd12, %r20, 12;
    add.s64         %rd13, %rd1, %rd12;
    ld.global.f32   %r22, [%rd13+0];
    ld.global.f32   %r23, [%rd13+4];
    ld.global.f32   %r24, [%rd13+8];
    mul.sat.f32 %r25, %r22, %r23;
    sub.f32 %r26, %r24, %r25;
    add.u32         %r30, %r1, 2048;
    and.b32         %r30, %r30, 8191;
    mul.wide.u32    %rd14, %r30, 12;
    add.s64         %rd15, %rd1, %rd14;
    ld.global.f32   %r32, [%rd15+0];
    ld.global.f32   %r33, [%rd15+4];
    ld.global.f32   %r34, [%rd15+8];
    mul.sat.f32 %r36, %r32, %r33;
    add.u32         %r40, %r1, 3072;
    and.b32         %r40, %r40, 8191;
    mul.wide.u32    %rd16, %r40, 12;
    add.s64         %rd17, %rd1, %rd16;
    ld.global.f32   %r42, [%rd17+0];
    ld.global.f32   %r43, [%rd17+4];
    ld.global.f32   %r44, [%rd17+8];
    mul.f32 %r45, %r42, %r44;
    add.sat.f32 %r46, %r45, %r43;
    add.u32         %r50, %r1, 4096;
    and.b32         %r50, %r50, 8191;
    mul.wide.u32    %rd18, %r50, 12;
    add.s64         %rd19, %rd1, %rd18;
    ld.global.f32   %r52, [%rd19+0];
    ld.global.f32   %r53, [%rd19+4];
    ld.global.f32   %r54, [%rd19+8];
    mul.f32 %r55, %r52, %r54;
    sub.sat.f32 %r56, %r55, %r53;
    add.u32         %r60, %r1, 5120;
    and.b32         %r60, %r60, 8191;
    mul.wide.u32    %rd20, %r60, 12;
    add.s64         %rd21, %rd1, %rd20;
    ld.global.f32   %r62, [%rd21+0];
    ld.global.f32   %r63, [%rd21+4];
    ld.global.f32   %r64, [%rd21+8];
    mul.f32 %r65, %r62, %r64;
    sub.sat.f32 %r66, %r63, %r65;
    add.u32         %r70, %r1, 6144;
    and.b32         %r70, %r70, 8191;
    mul.wide.u32    %rd22, %r70, 12;
    add.s64         %rd23, %rd1, %rd22;
    ld.global.f32   %r72, [%rd23+0];
    ld.global.f32   %r73, [%rd23+4];
    ld.global.f32   %r74, [%rd23+8];
    mul.ftz.sat.f32 %r75, %r72, %r73;
    add.ftz.f32 %r76, %r75, %r74;
    add.u32         %r80, %r1, 7168;
    and.b32         %r80, %r80, 8191;
    mul.wide.u32    %rd24, %r80, 12;
    add.s64         %rd25, %rd1, %rd24;
    ld.global.f32   %r82, [%rd25+0];
    ld.global.f32   %r83, [%rd25+4];
    ld.global.f32   %r84, [%rd25+8];
    mul.ftz.f32 %r85, %r82, %r84;
    add.ftz.sat.f32 %r86, %r85, %r83;
    st.global.v4.f32 [%rd6], {%r16, %r26, %r36, %r46};
    st.global.v4.f32 [%rd6+16], {%r56, %r66, %r76, %r86};
    ret;
}
