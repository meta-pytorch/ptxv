// Probe (L-ROSETTA) for stmatrix.sync.aligned.m16n8.x{1,2,4}.trans.shared.b8 (SASS
// STSM.8.MT168[.2|.4], trtllm-gen FMHA): byte k of each lane's register is lane * 4 + k, the
// second register of a pair has bit 7 set (two x4 stores with the bit on registers 1, 3 and
// 2, 3 name the register); lane l's row address is shared slot (13 l mod 32) * 32 bytes. The
// 5120 bytes of the four destination regions are dumped to out.
.version 8.8
.target sm_103a
.address_size 64
.visible .entry stsm8(.param .u64 pout)
{ .reg .b64 %rd<8>; .reg .b32 %r<40>; .reg .pred %p<2>;
  .shared .align 16 .b8 sm[12288];
  ld.param.u64 %rd1, [pout]; cvta.to.global.u64 %rd1, %rd1;
  mov.u32 %r1, %tid.x;
  // zero shared
  mov.u32 %r2, sm;
  mov.u32 %r3, 0;
Z: shl.b32 %r4, %r3, 9; shl.b32 %r5, %r1, 4; add.u32 %r4, %r4, %r5; add.u32 %r4, %r4, %r2;
  mov.u32 %r30, 0; st.shared.v4.u32 [%r4], {%r30, %r30, %r30, %r30};
  add.u32 %r3, %r3, 1; setp.lt.u32 %p1, %r3, 24; @%p1 bra Z;
  bar.sync 0;
  // v: byte k = lane*4 + k (0..127); w = v | 0x80808080
  shl.b32 %r6, %r1, 2;
  mul.lo.u32 %r8, %r6, 0x01010101; add.u32 %r10, %r8, 0x03020100; or.b32 %r11, %r10, 0x80808080;
  mul.lo.u32 %r14, %r1, 13; and.b32 %r14, %r14, 31; shl.b32 %r14, %r14, 5; add.u32 %r15, %r2, %r14;
  stmatrix.sync.aligned.m16n8.x1.trans.shared.b8 [%r15], {%r10};
  add.u32 %r16, %r15, 1024;
  stmatrix.sync.aligned.m16n8.x2.trans.shared.b8 [%r16], {%r10, %r11};
  add.u32 %r17, %r15, 2048;
  stmatrix.sync.aligned.m16n8.x4.trans.shared.b8 [%r17], {%r10, %r11, %r10, %r11};
  add.u32 %r18, %r15, 4096;
  stmatrix.sync.aligned.m16n8.x4.trans.shared.b8 [%r18], {%r10, %r10, %r11, %r11};
  bar.sync 0;
  // dump 3072 bytes
  mov.u32 %r3, 0;
D: shl.b32 %r4, %r3, 9; shl.b32 %r5, %r1, 4; add.u32 %r4, %r4, %r5;
  add.u32 %r20, %r4, %r2; ld.shared.v4.u32 {%r21, %r22, %r23, %r24}, [%r20];
  cvt.u64.u32 %rd2, %r4; add.s64 %rd3, %rd1, %rd2; st.global.v4.u32 [%rd3], {%r21, %r22, %r23, %r24};
  add.u32 %r3, %r3, 1; setp.lt.u32 %p1, %r3, 10; @%p1 bra D;
  ret; }
