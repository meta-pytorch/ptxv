// probes/bf16_ext (generated by gen_ptx.py): mixed bf16 / f32 FMA and add, bf16 min / max,
// and f32x2 in the directed rounding modes, against GB300. Thread g (16 CTAs x 256) loads
// (a, b, c, e) = in[g] (gen.py; a, b packed bf16x2, c, e f32) and stores out[j][g]:
//   j = 0: fma.rn.f32.bf16 (FHFMA.BF16: a.lo * b.lo + c)
//   j = 1: fma.rz.f32.bf16 (FHFMA.BF16.RZ: a.hi * b.hi + c)
//   j = 2: fma.rm.f32.bf16 (FHFMA.BF16.RM: a.lo * b.hi + e)
//   j = 3: fma.rp.f32.bf16 (FHFMA.BF16.RP: a.hi * b.lo + e)
//   j = 4: fma.rn.sat.f32.bf16 (FHFMA.BF16.SAT: a.lo * b.lo + e)
//   j = 5: add.rn.f32.bf16 (FHADD.BF16: a.lo + c)
//   j = 6: sub.rz.f32.bf16 (FHADD.BF16.RZ: a.hi - e)
//   j = 7: add.rp.f32.bf16 (FHADD.BF16.RP: b.hi + c)
//   j = 8: add.rm.f32.bf16 (FHADD.BF16.RM: b.lo + e)
//   j = 9: min.bf16x2 (HMNMX2.BF16_V2 a, b, PT)
//   j = 10: max.bf16x2 (HMNMX2.BF16_V2 a, b, !PT)
//   j = 11: min.NaN.bf16x2 (HMNMX2.BF16_V2.NAN)
//   j = 12: max.xorsign.abs.bf16x2 (HMNMX2.BF16_V2.XORSIGN)
//   j = 13: min.NaN.xorsign.abs.bf16x2 (HMNMX2.BF16_V2.NAN.XORSIGN)
//   j = 14: min.bf16 (lanes min.bf16 a.lo, b.hi / max.NaN.bf16 a.hi, b.lo (.H0_H0 / .H1_H1))
//   j = 15, 16: lanes of fma.rz.f32x2 {c, e}, {a, b}, {e, c} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 17, 18: lanes of fma.rm.f32x2 {c, e}, {a, b}, {e, c} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 19, 20: lanes of fma.rp.f32x2 {c, e}, {a, b}, {e, c} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 21, 22: lanes of mul.rm.f32x2 {c, e}, {a, b} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 23, 24: lanes of add.rz.f32x2 {c, e}, {a, b} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 25, 26: lanes of mul.rp.f32x2 {c, e}, {a, b} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 27, 28: lanes of add.rm.f32x2 {c, e}, {a, b} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
//   j = 29, 30: lanes of sub.rp.f32x2 {c, e}, {a, b} (FFMA2 / FMUL2 / FADD2 with a rounding mode)
.version 8.8
.target sm_103a
.address_size 64

.visible .entry bf16_ext(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<64>;
    .reg .b16   %h<16>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    mad.lo.u32      %r3, %r2, 256, %r1;
    mul.wide.u32    %rd3, %r3, 16;
    add.s64         %rd3, %rd1, %rd3;
    ld.global.v4.u32 {%r4, %r5, %r6, %r7}, [%rd3];
    mul.wide.u32    %rd4, %r3, 4;
    add.s64         %rd5, %rd2, %rd4;
    mov.b32         {%h1, %h2}, %r4;
    mov.b32         {%h3, %h4}, %r5;
    mov.b64         %rd6, {%r6, %r7};
    mov.b64         %rd7, {%r4, %r5};
    mov.b64         %rd8, {%r7, %r6};
    fma.rn.f32.bf16 %r20, %h1, %h3, %r6;
    fma.rz.f32.bf16 %r21, %h2, %h4, %r6;
    fma.rm.f32.bf16 %r22, %h1, %h4, %r7;
    fma.rp.f32.bf16 %r23, %h2, %h3, %r7;
    fma.rn.sat.f32.bf16 %r24, %h1, %h3, %r7;
    add.rn.f32.bf16 %r25, %h1, %r6;
    sub.rz.f32.bf16 %r26, %h2, %r7;
    add.rp.f32.bf16 %r27, %h4, %r6;
    add.rm.f32.bf16 %r28, %h3, %r7;
    min.bf16x2 %r29, %r4, %r5;
    max.bf16x2 %r30, %r4, %r5;
    min.NaN.bf16x2 %r31, %r4, %r5;
    max.xorsign.abs.bf16x2 %r32, %r4, %r5;
    min.NaN.xorsign.abs.bf16x2 %r33, %r4, %r5;
    min.bf16 %h10, %h1, %h4; max.NaN.bf16 %h11, %h2, %h3; mov.b32 %r34, {%h10, %h11};
    fma.rz.f32x2 %rd9, %rd6, %rd7, %rd8;
    mov.b64 {%r35, %r36}, %rd9;
    fma.rm.f32x2 %rd9, %rd6, %rd7, %rd8;
    mov.b64 {%r37, %r38}, %rd9;
    fma.rp.f32x2 %rd9, %rd6, %rd7, %rd8;
    mov.b64 {%r39, %r40}, %rd9;
    mul.rm.f32x2 %rd9, %rd6, %rd7;
    mov.b64 {%r41, %r42}, %rd9;
    add.rz.f32x2 %rd9, %rd6, %rd7;
    mov.b64 {%r43, %r44}, %rd9;
    mul.rp.f32x2 %rd9, %rd6, %rd7;
    mov.b64 {%r45, %r46}, %rd9;
    add.rm.f32x2 %rd9, %rd6, %rd7;
    mov.b64 {%r47, %r48}, %rd9;
    sub.rp.f32x2 %rd9, %rd6, %rd7;
    mov.b64 {%r49, %r50}, %rd9;
    st.global.u32   [%rd5+0], %r20;
    st.global.u32   [%rd5+16384], %r21;
    st.global.u32   [%rd5+32768], %r22;
    st.global.u32   [%rd5+49152], %r23;
    st.global.u32   [%rd5+65536], %r24;
    st.global.u32   [%rd5+81920], %r25;
    st.global.u32   [%rd5+98304], %r26;
    st.global.u32   [%rd5+114688], %r27;
    st.global.u32   [%rd5+131072], %r28;
    st.global.u32   [%rd5+147456], %r29;
    st.global.u32   [%rd5+163840], %r30;
    st.global.u32   [%rd5+180224], %r31;
    st.global.u32   [%rd5+196608], %r32;
    st.global.u32   [%rd5+212992], %r33;
    st.global.u32   [%rd5+229376], %r34;
    st.global.u32   [%rd5+245760], %r35;
    st.global.u32   [%rd5+262144], %r36;
    st.global.u32   [%rd5+278528], %r37;
    st.global.u32   [%rd5+294912], %r38;
    st.global.u32   [%rd5+311296], %r39;
    st.global.u32   [%rd5+327680], %r40;
    st.global.u32   [%rd5+344064], %r41;
    st.global.u32   [%rd5+360448], %r42;
    st.global.u32   [%rd5+376832], %r43;
    st.global.u32   [%rd5+393216], %r44;
    st.global.u32   [%rd5+409600], %r45;
    st.global.u32   [%rd5+425984], %r46;
    st.global.u32   [%rd5+442368], %r47;
    st.global.u32   [%rd5+458752], %r48;
    st.global.u32   [%rd5+475136], %r49;
    st.global.u32   [%rd5+491520], %r50;
    ret;
}
