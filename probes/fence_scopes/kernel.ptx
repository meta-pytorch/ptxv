// probes/fence_scopes: message passing with membar.{cta,gl,sys} (= fence.sc.<scope>) and
// fence.acquire.{cta,cluster,gpu,sys}. Two CTAs of 64 threads (no cluster). Across CTAs: CTA 0
// thread 0 writes data[0..3], `membar.gl` (@RELG), then flag[0] = 1 (relaxed.gpu); CTA 1 thread
// 0 polls flag[0] (relaxed.gpu), `fence.acquire.gpu` (@ACQG), reads data[0..3] into out[0..3].
// Within CTA 1: thread 32 writes data[4..7], `membar.cta` (@RELC), flag[1] = 1 (relaxed.cta);
// thread 0 polls it, `fence.acquire.gpu` (@ACQC; variant acq_cta_local: `.cta`), reads
// data[4..7] into out[4..7].
.version 8.8
.target sm_103a
.address_size 64

.visible .entry fence_scopes(
    .param .u64 pdata,
    .param .u64 pflag,
    .param .u64 pout
)
.maxntid 64, 1, 1
{
    .reg .pred  %p<8>;
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pdata];
    ld.param.u64    %rd2, [pflag];
    ld.param.u64    %rd3, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    cvta.to.global.u64 %rd3, %rd3;
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    setp.ne.u32     %p1, %r2, 0;
    @%p1 bra        CTA1;
    setp.ne.u32     %p2, %r1, 0;
    @%p2 bra        DONE;
    st.global.u32   [%rd1], 11;
    st.global.u32   [%rd1+4], 12;
    st.global.u32   [%rd1+8], 13;
    st.global.u32   [%rd1+12], 14;
    membar.gl;                                  // @RELG
    st.relaxed.gpu.global.u32 [%rd2], 1;
    bra.uni         DONE;
CTA1:
    setp.eq.u32     %p3, %r1, 32;
    @%p3 bra        PRODC;
    setp.ne.u32     %p4, %r1, 0;
    @%p4 bra        DONE;
WAITG:
    ld.relaxed.gpu.global.u32 %r3, [%rd2];
    setp.eq.u32     %p5, %r3, 0;
    @%p5 bra        WAITG;
    fence.acquire.gpu;                          // @ACQG
    ld.global.u32   %r4, [%rd1];
    ld.global.u32   %r5, [%rd1+4];
    ld.global.u32   %r6, [%rd1+8];
    ld.global.u32   %r7, [%rd1+12];
    st.global.v4.u32 [%rd3], {%r4, %r5, %r6, %r7};
WAITC:
    ld.relaxed.cta.global.u32 %r8, [%rd2+4];
    setp.eq.u32     %p6, %r8, 0;
    @%p6 bra        WAITC;
    fence.acquire.gpu;                          // @ACQC
    ld.global.u32   %r9, [%rd1+16];
    ld.global.u32   %r10, [%rd1+20];
    ld.global.u32   %r11, [%rd1+24];
    ld.global.u32   %r12, [%rd1+28];
    st.global.v4.u32 [%rd3+16], {%r9, %r10, %r11, %r12};
    bra.uni         DONE;
PRODC:
    st.global.u32   [%rd1+16], 21;
    st.global.u32   [%rd1+20], 22;
    st.global.u32   [%rd1+24], 23;
    st.global.u32   [%rd1+28], 24;
    membar.cta;                                 // @RELC
    st.relaxed.cta.global.u32 [%rd2+4], 1;
DONE:
    ret;
}
