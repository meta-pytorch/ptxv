// probes/red_vec: vector float reductions red.global.add.v4.f32 / .v2.f32 (SASS
// REDG.E.ADD.F32x4.FTZ.RN.STRONG.GPU / F32x2). 128 threads; thread t loads four f32 x = in[4 t
// .. 4 t + 3] (gen.py: small integers and halves, so every sum is exact in any order) and adds
// them into out[4 (t % 8) ..] (v4) and its first two into out[32 + 2 (t % 4) ..] (v2); out
// starts at zero.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry red_vec(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 128, 1, 1
{
    .reg .b32   %r<8>;
    .reg .f32   %f<8>;
    .reg .b64   %rd<12>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 16;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.v4.f32 {%f1, %f2, %f3, %f4}, [%rd4];
    and.b32         %r2, %r1, 7;
    mul.wide.u32    %rd5, %r2, 16;
    add.s64         %rd6, %rd2, %rd5;
    red.global.add.v4.f32 [%rd6], {%f1, %f2, %f3, %f4};
    and.b32         %r3, %r1, 3;
    mul.wide.u32    %rd7, %r3, 8;
    add.s64         %rd8, %rd2, %rd7;
    red.global.add.v2.f32 [%rd8+128], {%f3, %f1};
    ret;
}
