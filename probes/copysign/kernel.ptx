// probes/copysign: PTX copysign.f32 d, a, b = b with the sign bit of a (a pure bit
// operation). 256 threads; a, b = in[2 t], in[2 t + 1] (gen.py: random words, NaN payloads,
// signed zeros, Inf, subnormals); out[3 t] = copysign(a, b), out[3 t + 1] = copysign(b, a),
// out[3 t + 2] = copysign(a, -1.5) (an immediate magnitude).
.version 8.8
.target sm_103a
.address_size 64

.visible .entry copysign(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 256, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mul.wide.u32    %rd3, %r1, 8;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.v2.f32 {%r2, %r3}, [%rd4];
    mul.wide.u32    %rd5, %r1, 12;
    add.s64         %rd6, %rd2, %rd5;
    copysign.f32    %r4, %r2, %r3;
    copysign.f32    %r5, %r3, %r2;
    copysign.f32    %r6, %r2, 0fBFC00000;
    st.global.f32   [%rd6], %r4;
    st.global.f32   [%rd6+4], %r5;
    st.global.f32   [%rd6+8], %r6;
    ret;
}
