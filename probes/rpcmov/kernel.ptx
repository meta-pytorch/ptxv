// probes/rpcmov: thread g (2 CTAs x 128) loads a = in[g], b = in[256 + g] and stores
// out[0][g] = b + 0x5678, out[1][g] = b, out[2][g] = a ^ b, out[3][g] = x = a + 0x1234.
// patch.py inserts `RPCMOV.32 Rpc.LO, Ra` (save a) right after the loads and
// `RPCMOV.32 Rx, Rpc.LO` (restore) right after the add that computes x, so the patched kernel
// stores out[3][g] = a: a per-thread value through Rpc.LO.
.version 8.8
.target sm_103a
.address_size 64

.visible .entry rpcmov(
    .param .u64 pin,
    .param .u64 pout
)
.maxntid 128, 1, 1
{
    .reg .b32   %r<16>;
    .reg .b64   %rd<8>;

    ld.param.u64    %rd1, [pin];
    ld.param.u64    %rd2, [pout];
    cvta.to.global.u64 %rd1, %rd1;
    cvta.to.global.u64 %rd2, %rd2;
    mov.u32         %r1, %tid.x;
    mov.u32         %r2, %ctaid.x;
    mad.lo.u32      %r3, %r2, 128, %r1;
    mul.wide.u32    %rd3, %r3, 4;
    add.s64         %rd4, %rd1, %rd3;
    ld.global.u32   %r4, [%rd4];
    ld.global.u32   %r5, [%rd4+1024];
    add.s32         %r6, %r4, 4660;
    add.s32         %r7, %r5, 22136;
    xor.b32         %r8, %r4, %r5;
    add.s64         %rd5, %rd2, %rd3;
    st.global.u32   [%rd5], %r7;
    st.global.u32   [%rd5+1024], %r5;
    st.global.u32   [%rd5+2048], %r8;
    st.global.u32   [%rd5+3072], %r6;
    ret;
}
