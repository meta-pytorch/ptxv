.version 8.8
.target sm_103a
.address_size 64

.visible .entry glb_atom(.param .u64 pbase, .param .u64 px, .param .u64 pout, .param .u64 pold)
{
    .reg .b32 %r<16>;
    .reg .f32 %f<8>;
    .reg .b64 %rd<16>;
    .shared .align 4 .b32 s[32];
    mov.u32 %r1, %tid.x;
    ld.param.u64 %rd1, [pbase];
    cvta.to.global.u64 %rd1, %rd1;
    ld.param.u64 %rd2, [px];
    cvta.to.global.u64 %rd2, %rd2;
    ld.param.u64 %rd3, [pout];
    cvta.to.global.u64 %rd3, %rd3;
    ld.param.u64 %rd11, [pold];
    cvta.to.global.u64 %rd11, %rd11;
    mul.wide.u32 %rd4, %r1, 4;
    add.u64 %rd5, %rd1, %rd4;
    ld.global.f32 %f1, [%rd5];
    add.u64 %rd6, %rd2, %rd4;
    ld.global.f32 %f2, [%rd6];
    add.u64 %rd7, %rd3, %rd4;
    add.u64 %rd10, %rd11, %rd4;
    mov.u32 %r2, s;
    shl.b32 %r3, %r1, 2;
    add.u32 %r4, %r2, %r3;
    cvt.u64.u32 %rd8, %r4;
    st.global.f32 [%rd7], %f1;
    atom.global.add.f32 %f4, [%rd7], %f2;
    st.global.f32 [%rd10], %f4;
    ret;
}
